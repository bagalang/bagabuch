// actions/saft.baga — SAF-T BG експорт (XML) по BG_SAFT_Schema V1.0.1.
// Секции: Header, MasterFiles<режим>, GeneralLedgerEntries, SourceDocuments<режим>.
// Режими: monthly/ondemand/annual. Сумите са десимални (bagadecimal) като стрингове.

import "../models/company.baga"
import "../models/account.baga"
import "../models/counterpart.baga"
import "../models/product.baga"
import "../models/invoice.baga"
import "../models/journal.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "ormbaga/orm.baga"
import "httpdbaga/http.baga"
import "xmlbaga/xml.baga"
import "std/str/str.baga"

fn sf_open(name: str) -> str {
    return xml_open(name, xml_attrs_new())
}

fn sf_text(name: str, text: str) -> str {
    return xml_elem(name, xml_attrs_new(), text)
}

fn sf_empty(name: str) -> str {
    return xml_open_empty(name, xml_attrs_new())
}

// Сума-елемент: <nsSAFT:X><Amount/><CurrencyCode/><CurrencyAmount/></nsSAFT:X>
fn sf_amount(name: str, amount: str, currency: str) -> str {
    let mut out = ""
    out = concat(out, sf_open(name))
    out = concat(out, sf_text("nsSAFT:Amount", amount))
    out = concat(out, sf_text("nsSAFT:CurrencyCode", currency))
    out = concat(out, sf_text("nsSAFT:CurrencyAmount", amount))
    out = concat(out, xml_close(name))
    return out
}

fn act_saft_export(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let period = fmr_query(ctx, "period")
    if period == "" {
        return act_err(db, 400, "period е задължителен (YYYY-MM-01)")
    }
    let mode_q = fmr_query(ctx, "mode")
    let mut mode = "monthly"
    if mode_q == "annual" || mode_q == "ondemand" {
        mode = mode_q
    }
    let mut sfx = "Monthly"
    if mode == "annual" {
        sfx = "Annual"
    }
    if mode == "ondemand" {
        sfx = "OnDemand"
    }
    let year = parse_int(substr(period, 0, 4))
    let month = parse_int(substr(period, 5, 7))
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    // Фирма (първата) — за Header.Company.
    let cq = company_all(db)?
    if orm_ok_q(cq) == 0 {
        return act_err(orm_db_q(cq), 500, orm_err_q(cq))
    }
    if orm_nrows(cq) < 1 {
        return act_err(db, 422, "няма фирма за експорт")
    }
    let company_name = orm_cell_by(cq, 0, "name")
    let company_eik = orm_cell_by(cq, 0, "eik")
    let company_vat = orm_cell_by(cq, 0, "vat_number")
    let company_city = orm_cell_by(cq, 0, "city")
    let company_post = orm_cell_by(cq, 0, "post_code")
    let currency = orm_cell_by(cq, 0, "currency")
    let mut db2 = orm_db_q(cq)
    let mut cur = "BGN"
    if currency != "" {
        cur = currency
    }

    let mut out = ""
    out = concat(out, xml_decl())
    let root_attrs = xml_attrs_new()
    map_set(root_attrs, "xmlns:nsSAFT", "mf:nra:dgti:dxxxx:declaration:v1")
    out = concat(out, xml_open("nsSAFT:AuditFile", root_attrs))

    // ---- Header ----
    out = concat(out, sf_open("nsSAFT:Header"))
    out = concat(out, sf_text("nsSAFT:AuditFileVersion", "007"))
    out = concat(out, sf_text("nsSAFT:AuditFileCountry", "BG"))
    out = concat(out, sf_text("nsSAFT:AuditFileDateCreated", period))
    out = concat(out, sf_text("nsSAFT:SoftwareCompanyName", "baga"))
    out = concat(out, sf_text("nsSAFT:SoftwareID", "bagabuch"))
    out = concat(out, sf_text("nsSAFT:SoftwareVersion", "1.0"))
    out = concat(out, sf_open("nsSAFT:Company"))
    out = concat(out, sf_text("nsSAFT:RegistrationNumber", company_eik))
    out = concat(out, sf_text("nsSAFT:Name", company_name))
    out = concat(out, sf_open("nsSAFT:Address"))
    out = concat(out, sf_text("nsSAFT:StreetName", ""))
    out = concat(out, sf_text("nsSAFT:City", company_city))
    out = concat(out, sf_text("nsSAFT:PostalCode", company_post))
    out = concat(out, sf_text("nsSAFT:Country", "BG"))
    out = concat(out, xml_close("nsSAFT:Address"))
    out = concat(out, sf_open("nsSAFT:TaxRegistration"))
    out = concat(out, sf_text("nsSAFT:TaxRegistrationNumber", company_eik))
    out = concat(out, sf_text("nsSAFT:TaxType", "100010"))
    out = concat(out, sf_text("nsSAFT:TaxNumber", company_vat))
    out = concat(out, xml_close("nsSAFT:TaxRegistration"))
    out = concat(out, xml_close("nsSAFT:Company"))
    out = concat(out, sf_text("nsSAFT:DefaultCurrencyCode", cur))
    out = concat(out, sf_open("nsSAFT:SelectionCriteria"))
    out = concat(out, sf_text("nsSAFT:TaxReportingJurisdiction", "NRA"))
    out = concat(out, sf_text("nsSAFT:PeriodStart", int_to_str(month)))
    out = concat(out, sf_text("nsSAFT:PeriodStartYear", int_to_str(year)))
    out = concat(out, sf_text("nsSAFT:PeriodEnd", int_to_str(month)))
    out = concat(out, sf_text("nsSAFT:PeriodEndYear", int_to_str(year)))
    out = concat(out, sf_text("nsSAFT:DocumentType", "F"))
    out = concat(out, xml_close("nsSAFT:SelectionCriteria"))
    out = concat(out, sf_text("nsSAFT:TaxAccountingBasis", "A"))
    out = concat(out, sf_text("nsSAFT:TaxEntity", "Company"))
    out = concat(out, xml_close("nsSAFT:Header"))

    // ---- MasterFiles ----
    out = concat(out, sf_open(concat("nsSAFT:MasterFiles", sfx)))
    // Сметкоплан
    let aq = account_all(db2)?
    if orm_ok_q(aq) == 0 {
        return act_err(orm_db_q(aq), 500, orm_err_q(aq))
    }
    db2 = orm_db_q(aq)
    out = concat(out, sf_open("nsSAFT:GeneralLedgerAccounts"))
    let mut i: i64 = 0
    while i < orm_nrows(aq) {
        out = concat(out, sf_open("nsSAFT:Account"))
        out = concat(out, sf_text("nsSAFT:AccountID", orm_cell_by(aq, i, "number")))
        out = concat(out, sf_text("nsSAFT:AccountDescription", orm_cell_by(aq, i, "name")))
        out = concat(out, sf_text("nsSAFT:AccountType", "Bifunctional"))
        out = concat(out, xml_close("nsSAFT:Account"))
        i = i + 1
    }
    out = concat(out, xml_close("nsSAFT:GeneralLedgerAccounts"))
    // Контрагенти (клиенти/доставчици от типа)
    let kq = counterpart_all(db2)?
    if orm_ok_q(kq) == 0 {
        return act_err(orm_db_q(kq), 500, orm_err_q(kq))
    }
    db2 = orm_db_q(kq)
    out = concat(out, sf_open("nsSAFT:Customers"))
    i = 0
    while i < orm_nrows(kq) {
        let ic = orm_cell_by_i64(kq, i, "is_client")
        let is_ = orm_cell_by_i64(kq, i, "is_supplier")
        if ic == 1 {
            out = concat(out, sf_open("nsSAFT:Customer"))
            out = concat(out, sf_text("nsSAFT:CustomerID", orm_cell_by(kq, i, "eik")))
            out = concat(out, sf_text("nsSAFT:CompanyName", orm_cell_by(kq, i, "name")))
            out = concat(out, sf_text("nsSAFT:CustomerTaxID", orm_cell_by(kq, i, "vat_number")))
            out = concat(out, xml_close("nsSAFT:Customer"))
        }
        i = i + 1
    }
    out = concat(out, xml_close("nsSAFT:Customers"))
    out = concat(out, sf_open("nsSAFT:Suppliers"))
    i = 0
    while i < orm_nrows(kq) {
        let is_ = orm_cell_by_i64(kq, i, "is_supplier")
        if is_ == 1 {
            out = concat(out, sf_open("nsSAFT:Supplier"))
            out = concat(out, sf_text("nsSAFT:SupplierID", orm_cell_by(kq, i, "eik")))
            out = concat(out, sf_text("nsSAFT:CompanyName", orm_cell_by(kq, i, "name")))
            out = concat(out, sf_text("nsSAFT:SupplierTaxID", orm_cell_by(kq, i, "vat_number")))
            out = concat(out, xml_close("nsSAFT:Supplier"))
        }
        i = i + 1
    }
    out = concat(out, xml_close("nsSAFT:Suppliers"))
    // Продукти
    let pq = product_all(db2)?
    if orm_ok_q(pq) == 0 {
        return act_err(orm_db_q(pq), 500, orm_err_q(pq))
    }
    db2 = orm_db_q(pq)
    out = concat(out, sf_open("nsSAFT:Products"))
    i = 0
    while i < orm_nrows(pq) {
        out = concat(out, sf_open("nsSAFT:Product"))
        out = concat(out, sf_text("nsSAFT:ProductCode", orm_cell_by(pq, i, "code")))
        out = concat(out, sf_text("nsSAFT:ProductDescription", orm_cell_by(pq, i, "name")))
        out = concat(out, xml_close("nsSAFT:Product"))
        i = i + 1
    }
    out = concat(out, xml_close("nsSAFT:Products"))
    out = concat(out, xml_close(concat("nsSAFT:MasterFiles", sfx)))

    // ---- GeneralLedgerEntries ----
    let jq = journal_by_period(db2, period)?
    if orm_ok_q(jq) == 0 {
        return act_err(orm_db_q(jq), 500, orm_err_q(jq))
    }
    db2 = orm_db_q(jq)
    out = concat(out, sf_open("nsSAFT:GeneralLedgerEntries"))
    out = concat(out, sf_text("nsSAFT:NumberOfEntries", int_to_str(orm_nrows(jq))))
    out = concat(out, sf_text("nsSAFT:TotalDebit", "0"))
    out = concat(out, sf_text("nsSAFT:TotalCredit", "0"))
    out = concat(out, sf_open("nsSAFT:Journal"))
    out = concat(out, sf_text("nsSAFT:JournalID", "GL"))
    out = concat(out, sf_text("nsSAFT:Description", "Счетоводни записи"))
    out = concat(out, sf_text("nsSAFT:Type", "GLEntry"))
    i = 0
    while i < orm_nrows(jq) {
        let entry_id = orm_cell_by_i64(jq, i, "id")
        let entry_date = orm_cell_by(jq, i, "entry_date")
        out = concat(out, sf_open("nsSAFT:Transaction"))
        out = concat(out, sf_text("nsSAFT:TransactionID", int_to_str(entry_id)))
        out = concat(out, sf_text("nsSAFT:Period", int_to_str(month)))
        out = concat(out, sf_text("nsSAFT:PeriodYear", int_to_str(year)))
        out = concat(out, sf_text("nsSAFT:TransactionDate", entry_date))
        out = concat(out, sf_text("nsSAFT:TransactionType", "Normal"))
        out = concat(out, sf_text("nsSAFT:Description", orm_cell_by(jq, i, "description")))
        out = concat(out, sf_text("nsSAFT:SystemEntryDate", entry_date))
        out = concat(out, sf_text("nsSAFT:GLPostingDate", entry_date))
        let lq = journal_lines_by_entry(db2, entry_id)?
        db2 = orm_db_q(lq)
        let mut li: i64 = 0
        while li < orm_nrows(lq) {
            let line_id = orm_cell_by_i64(lq, li, "id")
            let amount = orm_cell_by(lq, li, "amount")
            let vat = orm_cell_by(lq, li, "vat_amount")
            out = concat(out, sf_open("nsSAFT:TransactionLine"))
            out = concat(out, sf_text("nsSAFT:RecordID", int_to_str(line_id)))
            out = concat(out, sf_text("nsSAFT:AccountID", int_to_str(orm_cell_by_i64(lq, li, "account_id"))))
            out = concat(out, sf_text("nsSAFT:ValueDate", entry_date))
            if orm_cell_by(lq, li, "direction") == "debit" {
                out = concat(out, sf_amount("nsSAFT:DebitAmount", amount, cur))
            } else {
                out = concat(out, sf_amount("nsSAFT:CreditAmount", amount, cur))
            }
            if vat != "" && vat != "0" {
                out = concat(out, sf_open("nsSAFT:TaxInformation"))
                out = concat(out, sf_text("nsSAFT:TaxType", "100010"))
                out = concat(out, sf_text("nsSAFT:TaxCode", "110010"))
                out = concat(out, sf_amount("nsSAFT:TaxAmount", vat, cur))
                out = concat(out, xml_close("nsSAFT:TaxInformation"))
            }
            out = concat(out, xml_close("nsSAFT:TransactionLine"))
            li = li + 1
        }
        out = concat(out, xml_close("nsSAFT:Transaction"))
        i = i + 1
    }
    out = concat(out, xml_close("nsSAFT:Journal"))
    out = concat(out, xml_close("nsSAFT:GeneralLedgerEntries"))

    // ---- SourceDocuments ----
    let iq = invoice_by_period(db2, period)?
    if orm_ok_q(iq) == 0 {
        return act_err(orm_db_q(iq), 500, orm_err_q(iq))
    }
    db2 = orm_db_q(iq)
    out = concat(out, sf_open(concat("nsSAFT:SourceDocuments", sfx)))
    out = concat(out, sf_open("nsSAFT:SalesInvoices"))
    i = 0
    while i < orm_nrows(iq) {
        if orm_cell_by(iq, i, "direction") == "out" {
            out = concat(out, sf_open("nsSAFT:Invoice"))
            out = concat(out, sf_text("nsSAFT:InvoiceNo", orm_cell_by(iq, i, "number")))
            out = concat(out, sf_text("nsSAFT:InvoiceDate", orm_cell_by(iq, i, "issue_date")))
            out = concat(out, sf_text("nsSAFT:InvoiceType", "01"))
            out = concat(out, sf_text("nsSAFT:Period", int_to_str(month)))
            out = concat(out, sf_text("nsSAFT:PeriodYear", int_to_str(year)))
            out = concat(out, sf_amount("nsSAFT:InvoiceLineAmount", orm_cell_by(iq, i, "total_amount"), cur))
            out = concat(out, sf_open("nsSAFT:DocumentTotals"))
            out = concat(out, sf_text("nsSAFT:TaxPayable", orm_cell_by(iq, i, "vat_amount")))
            out = concat(out, sf_text("nsSAFT:NetTotal", orm_cell_by(iq, i, "net_amount")))
            out = concat(out, sf_text("nsSAFT:GrossTotal", orm_cell_by(iq, i, "total_amount")))
            out = concat(out, xml_close("nsSAFT:DocumentTotals"))
            out = concat(out, xml_close("nsSAFT:Invoice"))
        }
        i = i + 1
    }
    out = concat(out, xml_close("nsSAFT:SalesInvoices"))
    out = concat(out, sf_open("nsSAFT:PurchaseInvoices"))
    i = 0
    while i < orm_nrows(iq) {
        if orm_cell_by(iq, i, "direction") == "in" {
            out = concat(out, sf_open("nsSAFT:Invoice"))
            out = concat(out, sf_text("nsSAFT:InvoiceNo", orm_cell_by(iq, i, "number")))
            out = concat(out, sf_text("nsSAFT:InvoiceDate", orm_cell_by(iq, i, "issue_date")))
            out = concat(out, sf_text("nsSAFT:InvoiceType", "01"))
            out = concat(out, sf_text("nsSAFT:Period", int_to_str(month)))
            out = concat(out, sf_text("nsSAFT:PeriodYear", int_to_str(year)))
            out = concat(out, sf_open("nsSAFT:DocumentTotals"))
            out = concat(out, sf_text("nsSAFT:TaxPayable", orm_cell_by(iq, i, "vat_amount")))
            out = concat(out, sf_text("nsSAFT:NetTotal", orm_cell_by(iq, i, "net_amount")))
            out = concat(out, sf_text("nsSAFT:GrossTotal", orm_cell_by(iq, i, "total_amount")))
            out = concat(out, xml_close("nsSAFT:DocumentTotals"))
            out = concat(out, xml_close("nsSAFT:Invoice"))
        }
        i = i + 1
    }
    out = concat(out, xml_close("nsSAFT:PurchaseInvoices"))
    out = concat(out, xml_close(concat("nsSAFT:SourceDocuments", sfx)))

    out = concat(out, xml_close("nsSAFT:AuditFile"))

    // Отговор: XML като текст
    let mut resp = http_response(200, out)
    resp = http_set_header(resp, "Content-Type", "application/xml; charset=utf-8")
    return fmr_out(resp, db2)
}
