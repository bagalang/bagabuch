// actions/dashboard.baga — табло: ключови числа за активната фирма.
// Един GET /v1/dashboard връща всичко нужно за началния екран, за да не
// прави фронтендът няколко заявки при отваряне.
//
// Числата:
//   invoices_draft / invoices_posted — брой фактури по статус
//   receivables   — вземания: осчетоводени изходящи (Дт 411)
//   payables      — задължения: осчетоводени входящи (Кт 401)
//   vat_output / vat_input — ДДС на изхода/входа по осчетоводени документи
//   revenue_ytd / expense_ytd — приходи (кл. 70) / разходи (кл. 60) за годината
//   bank_total    — сбор на салдата по банковите сметки на фирмата
//   recent        — последните 5 фактури
//
// Приходи/разходи се смятат по номера на сметката от дневника: 70x = приход,
// 60x = разход. Клас 61 (611, 612) е смяна на запаси, не е разход. Дебитът
// на приходна сметка намалява прихода, кредитът на разходна намалява разхода
// (така кредитните известия с отрицателни суми излизат правилно).
// Опростено е съзнателно — за точни числа има справки.

import "../models/invoice.baga"
import "../models/journal.baga"
import "../models/account.baga"
import "../models/bank_account.baga"
import "acl.baga"
import "active_company.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "bagadecimal/src/decimal.baga"
import "std/str/str.baga"
import "std/time/time.baga"

// Текуща година (UTC) — за приходи/разходи по подразбиране.
fn dash_year_now() -> i64 !Time {
    let ms = time_now_ms()?
    if ms < 0 {
        return 0
    }
    // 1970-01-01 + ms. Достатъчно точно за година чрез 365.2425 дни.
    let days = ms / 86400000
    return 1970 + (days / 365)
}

// Ако ?year= липсва или е невалиден → текущата година.
fn dash_year_ok(year_in: i64) -> i64 !Time {
    if year_in >= 2000 && year_in <= 2100 {
        return year_in
    }
    return dash_year_now()?
}

fn dash_zero() -> str {
    return "0"
}

fn dash_add(a: str, b: str) -> str {
    let pa = dec_parse(a)
    let pb = dec_parse(b)
    if pa.ok == 0 {
        return b
    }
    if pb.ok == 0 {
        return a
    }
    let s = dec_add(pa.value, pb.value)
    if s.ok == 0 {
        return a
    }
    return dec_to_string(s.value)
}

// Отрицателна стойност на стринг сума (-"12.50" → "-12.50"). Няма dec_neg,
// затова изваждаме от нула.
fn dash_neg(a: str) -> str {
    let s = dec_sub(dec_zero(), dec_parse_ok(a))
    if s.ok == 0 {
        return a
    }
    return dec_to_string(s.value)
}

fn dec_parse_ok(a: str) -> Decimal {
    let p = dec_parse(a)
    if p.ok == 0 {
        return dec_zero()
    }
    return p.value
}

fn dash_starts(s: str, p: str) -> i64 {
    if len(p) == 0 {
        return 1
    }
    if len(s) < len(p) {
        return 0
    }
    if substr(s, 0, len(p)) == p {
        return 1
    }
    return 0
}

fn dash_is_revenue(number: str) -> i64 {
    return dash_starts(number, "70")
}

fn dash_is_expense(number: str) -> i64 {
    return dash_starts(number, "60")
}

fn act_dashboard(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Time {
    let auth = act_require_perm(ctx, db, "report:read")?
    if auth.ok == 0 {
        return auth.out
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    let cid = ac.id
    let mut d0 = ac.db

    let mut inv_draft: i64 = 0
    let mut inv_posted: i64 = 0
    let mut receivables = dash_zero()
    let mut payables = dash_zero()
    let mut vat_output = dash_zero()
    let mut vat_input = dash_zero()
    let mut recent = jarr_new()
    let mut recent_n: i64 = 0

    let iq = invoice_all(d0)?
    if orm_ok_q(iq) == 0 {
        return act_err(orm_db_q(iq), 500, orm_err_q(iq))
    }
    d0 = orm_db_q(iq)
    let mut i: i64 = 0
    while i < orm_nrows(iq) {
        if invoice_row_in_company(iq, i, cid) == 1 {
            let status = orm_cell_by(iq, i, "status")
            if status == "draft" {
                inv_draft = inv_draft + 1
            }
            if status == "posted" {
                inv_posted = inv_posted + 1
                let dir = orm_cell_by(iq, i, "direction")
                if dir == "out" {
                    receivables = dash_add(receivables, orm_cell_by(iq, i, "total_amount"))
                    vat_output = dash_add(vat_output, orm_cell_by(iq, i, "vat_amount"))
                } else {
                    payables = dash_add(payables, orm_cell_by(iq, i, "total_amount"))
                    vat_input = dash_add(vat_input, orm_cell_by(iq, i, "vat_amount"))
                }
            }
            if recent_n < 5 {
                recent = jarr_obj(recent, invoice_to_json(iq, i))
                recent_n = recent_n + 1
            }
        }
        i = i + 1
    }

    let year_in = parse_int(fmr_query(ctx, "year"))
    let year = dash_year_ok(year_in)?

    let mut revenue = dash_zero()
    let mut expense = dash_zero()
    let aq = account_all(d0)?
    if orm_ok_q(aq) == 0 {
        return act_err(orm_db_q(aq), 500, orm_err_q(aq))
    }
    d0 = orm_db_q(aq)
    let jq = journal_all_dated(d0)?
    if orm_ok_q(jq) == 0 {
        return act_err(orm_db_q(jq), 500, orm_err_q(jq))
    }
    d0 = orm_db_q(jq)
    let lq = journal_lines_all(d0)?
    if orm_ok_q(lq) == 0 {
        return act_err(orm_db_q(lq), 500, orm_err_q(lq))
    }
    d0 = orm_db_q(lq)
    let mut ei: i64 = 0
    while ei < orm_nrows(jq) {
        if journal_row_in_company(jq, ei, cid) == 1 {
            let eid = orm_cell_by_i64(jq, ei, "id")
            if dash_starts(orm_cell_by(jq, ei, "entry_date"), int_to_str(year)) == 1 {
                let mut li: i64 = 0
                while li < orm_nrows(lq) {
                    if orm_cell_by_i64(lq, li, "entry_id") == eid {
                        let number = account_number_of(aq, orm_cell_by_i64(lq, li, "account_id"))
                        let amount = orm_cell_by(lq, li, "amount")
                        let dir = orm_cell_by(lq, li, "direction")
                        if dash_is_revenue(number) == 1 {
                            if dir == "credit" {
                                revenue = dash_add(revenue, amount)
                            } else {
                                revenue = dash_add(revenue, dash_neg(amount))
                            }
                        }
                        if dash_is_expense(number) == 1 {
                            if dir == "debit" {
                                expense = dash_add(expense, amount)
                            } else {
                                expense = dash_add(expense, dash_neg(amount))
                            }
                        }
                    }
                    li = li + 1
                }
            }
        }
        ei = ei + 1
    }

    let mut bank_total = dash_zero()
    if cid > 0 {
        let bq = bank_account_by_company(d0, cid)?
        if orm_ok_q(bq) == 0 {
            return act_err(orm_db_q(bq), 500, orm_err_q(bq))
        }
        d0 = orm_db_q(bq)
        let mut bi: i64 = 0
        while bi < orm_nrows(bq) {
            bank_total = dash_add(bank_total, orm_cell_by(bq, bi, "balance"))
            bi = bi + 1
        }
    }

    let mut o = jobj_new()
    o = jobj_i64(o, "company_id", cid)
    o = jobj_i64(o, "year", year)
    o = jobj_i64(o, "invoices_draft", inv_draft)
    o = jobj_i64(o, "invoices_posted", inv_posted)
    o = jobj_str(o, "receivables", receivables)
    o = jobj_str(o, "payables", payables)
    o = jobj_str(o, "vat_output", vat_output)
    o = jobj_str(o, "vat_input", vat_input)
    o = jobj_str(o, "revenue_ytd", revenue)
    o = jobj_str(o, "expense_ytd", expense)
    o = jobj_str(o, "bank_total", bank_total)
    o = jobj_arr(o, "recent", recent)
    return act_ok(d0, o)
}

// Номерът на сметка по id, от вече заредената таблица accounts.
fn account_number_of(aq: OrmQuery, account_id: i64) -> str {
    let mut i: i64 = 0
    while i < orm_nrows(aq) {
        if orm_cell_by_i64(aq, i, "id") == account_id {
            return orm_cell_by(aq, i, "number")
        }
        i = i + 1
    }
    return ""
}
