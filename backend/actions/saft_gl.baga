// actions/saft_gl.baga — сметкоплан и дневник за месечния SAF-T.
// AccountID е код на НАП (3–5 цифри). TaxpayerAccountID е номерът във фирмата.
// Салдото е нето: дебит минус кредит, от начални салда и движения преди периода.

import "../models/account.baga"
import "../models/journal.baga"
import "../models/opening_balance.baga"
import "../models/counterpart.baga"
import "vat_fmt.baga"
import "bagadecimal/src/decimal.baga"
import "xmlbaga/xml.baga"
import "std/str/str.baga"

struct SftGl {
    ok: i64,
    err: str,
    db: OrmDb,
    xml: str,
    codes: Map<str, str>
}

struct SftSide {
    debit: i64,
    text: str
}

fn sftg_open(name: str) -> str {
    return xml_open(name, xml_attrs_new())
}

fn sftg_text(name: str, text: str) -> str {
    return xml_elem(name, xml_attrs_new(), text)
}

fn sftg_clip(s: str, n: i64) -> str {
    let t = str_trim(s)
    if t == "" || n <= 0 {
        return ""
    }
    if len(t) <= n {
        return t
    }
    return substr(t, 0, n)
}

fn sftg_nra_ok(s: str) -> i64 {
    let t = str_trim(s)
    let n = len(t)
    if n < 3 || n > 5 {
        return 0
    }
    let c0 = char_at(t, 0)
    if c0 < 49 || c0 > 57 {
        return 0
    }
    let mut i: i64 = 1
    while i < n {
        let c = char_at(t, i)
        if c < 48 || c > 57 {
            return 0
        }
        i = i + 1
    }
    return 1
}

fn sftg_code(saft_type: str, number: str) -> str {
    let firm = str_trim(number)
    let mut nra = ""
    if sftg_nra_ok(saft_type) == 1 {
        nra = str_trim(saft_type)
    } else {
        if sftg_nra_ok(firm) == 1 {
            nra = firm
        }
    }
    if nra == "" {
        return ""
    }
    let mut tax = firm
    if tax == "" {
        tax = nra
    }
    return concat(concat(nra, "|"), sftg_clip(tax, 35))
}

fn sftg_nra(packed: str) -> str {
    let bar = str_find(packed, "|")
    if bar < 1 {
        return ""
    }
    return substr(packed, 0, bar)
}

fn sftg_firm(packed: str) -> str {
    let bar = str_find(packed, "|")
    if bar < 0 {
        return ""
    }
    return substr(packed, bar + 1, len(packed))
}

fn sftg_ymd(y: i64, m: i64, d: i64) -> str {
    let mut ms = int_to_str(m)
    if len(ms) == 1 {
        ms = concat("0", ms)
    }
    let mut ds = int_to_str(d)
    if len(ds) == 1 {
        ds = concat("0", ds)
    }
    return concat(concat(concat(concat(int_to_str(y), "-"), ms), "-"), ds)
}

fn sftg_ge(a: str, b: str) -> i64 {
    let mut n = len(a)
    if len(b) < n {
        n = len(b)
    }
    let mut i: i64 = 0
    while i < n {
        let ca = char_at(a, i)
        let cb = char_at(b, i)
        if ca > cb {
            return 1
        }
        if ca < cb {
            return 0
        }
        i = i + 1
    }
    if len(a) >= len(b) {
        return 1
    }
    return 0
}

fn sftg_co(row_co: i64, cid: i64) -> i64 {
    if cid <= 0 {
        return 1
    }
    if row_co == 0 || row_co == cid {
        return 1
    }
    return 0
}

fn sftg_map_add(m: Map<str, str>, key: str, add: str) {
    let sum = vat_dadd(vat_parse_amt(map_get(m, key)), vat_parse_amt(add))
    map_set(m, key, vat_money(sum))
}

fn sftg_side(debit: str, credit: str) -> SftSide {
    let d = vat_parse_amt(debit)
    let c = vat_parse_amt(credit)
    if dec_ge(d, c) == 1 {
        let r = dec_sub(d, c)
        let mut v = dec_zero()
        if r.ok == 1 {
            v = r.value
        }
        return SftSide { debit: 1, text: vat_money(v) }
    }
    let r = dec_sub(c, d)
    let mut v = dec_zero()
    if r.ok == 1 {
        v = r.value
    }
    return SftSide { debit: 0, text: vat_money(v) }
}

fn sftg_sum(a: str, b: str) -> str {
    return vat_money(vat_dadd(vat_parse_amt(a), vat_parse_amt(b)))
}

fn sftg_bal(name_d: str, name_c: str, side: SftSide) -> str {
    if side.debit == 1 {
        return sftg_text(name_d, side.text)
    }
    return sftg_text(name_c, side.text)
}

fn sftg_amount(name: str, amount: str, currency: str) -> str {
    let text = vat_money(vat_parse_amt(amount))
    let mut out = ""
    out = concat(out, sftg_open(name))
    out = concat(out, sftg_text("nsSAFT:Amount", text))
    out = concat(out, sftg_text("nsSAFT:CurrencyCode", currency))
    out = concat(out, sftg_text("nsSAFT:CurrencyAmount", text))
    out = concat(out, xml_close(name))
    return out
}

fn sft_gl_accounts(db: OrmDb, company_id: i64, year: i64, month: i64, fys: i64) -> SftGl !IO !Net {
    let mut start_m = fys
    if start_m < 1 || start_m > 12 {
        start_m = 1
    }
    let mut fy = year
    if month < start_m {
        fy = year - 1
    }
    let fy_start = sftg_ymd(fy, start_m, 1)
    let start = sftg_ymd(year, month, 1)
    let mut ny = year
    let mut nm = month + 1
    if nm > 12 {
        nm = 1
        ny = year + 1
    }
    let next = sftg_ymd(ny, nm, 1)
    let aq = account_all(db)?
    if orm_ok_q(aq) == 0 {
        return SftGl { ok: 0, err: orm_err_q(aq), db: orm_db_q(aq), xml: "", codes: map_new() }
    }
    let codes: Map<str, str> = map_new()
    let mut i: i64 = 0
    while i < orm_nrows(aq) {
        let packed = sftg_code(orm_cell_by(aq, i, "saft_account_type"), orm_cell_by(aq, i, "number"))
        if packed != "" {
            map_set(codes, int_to_str(orm_cell_by_i64(aq, i, "id")), packed)
        }
        i = i + 1
    }
    let oq = ob_by_year(orm_db_q(aq), fy)?
    if orm_ok_q(oq) == 0 {
        return SftGl { ok: 0, err: orm_err_q(oq), db: orm_db_q(oq), xml: "", codes: codes }
    }
    let bal: Map<str, str> = map_new()
    i = 0
    while i < orm_nrows(oq) {
        let id = int_to_str(orm_cell_by_i64(oq, i, "account_id"))
        if map_get(codes, id) != "" {
            sftg_map_add(bal, concat(id, ":od"), orm_cell_by(oq, i, "debit"))
            sftg_map_add(bal, concat(id, ":oc"), orm_cell_by(oq, i, "credit"))
        }
        i = i + 1
    }
    let lq = journal_lines_for_saft(orm_db_q(oq))?
    if orm_ok_q(lq) == 0 {
        return SftGl { ok: 0, err: orm_err_q(lq), db: orm_db_q(lq), xml: "", codes: codes }
    }
    i = 0
    while i < orm_nrows(lq) {
        let id = int_to_str(orm_cell_by_i64(lq, i, "account_id"))
        let day = orm_cell_by(lq, i, "entry_date")
        if map_get(codes, id) != "" && len(day) >= 10 && sftg_co(orm_cell_by_i64(lq, i, "company_id"), company_id) == 1 {
            let date = substr(day, 0, 10)
            let mut key = ""
            if sftg_ge(date, fy_start) == 1 && sftg_ge(date, start) == 0 {
                if orm_cell_by(lq, i, "direction") == "debit" {
                    key = concat(id, ":od")
                } else {
                    key = concat(id, ":oc")
                }
            }
            if sftg_ge(date, start) == 1 && sftg_ge(date, next) == 0 {
                if orm_cell_by(lq, i, "direction") == "debit" {
                    key = concat(id, ":pd")
                } else {
                    key = concat(id, ":pc")
                }
            }
            if key != "" {
                sftg_map_add(bal, key, orm_cell_by(lq, i, "amount"))
            }
        }
        i = i + 1
    }
    let mut xml = ""
    xml = concat(xml, sftg_open("nsSAFT:GeneralLedgerAccounts"))
    i = 0
    while i < orm_nrows(aq) {
        let id = int_to_str(orm_cell_by_i64(aq, i, "id"))
        let packed = map_get(codes, id)
        if packed != "" {
            let mut desc = sftg_clip(orm_cell_by(aq, i, "name"), 256)
            if desc == "" {
                desc = sftg_nra(packed)
            }
            let od = map_get(bal, concat(id, ":od"))
            let oc = map_get(bal, concat(id, ":oc"))
            let pd = map_get(bal, concat(id, ":pd"))
            let pc = map_get(bal, concat(id, ":pc"))
            let open = sftg_side(od, oc)
            let close = sftg_side(sftg_sum(od, pd), sftg_sum(oc, pc))
            xml = concat(xml, sftg_open("nsSAFT:Account"))
            xml = concat(xml, sftg_text("nsSAFT:AccountID", sftg_nra(packed)))
            xml = concat(xml, sftg_text("nsSAFT:AccountDescription", desc))
            xml = concat(xml, sftg_text("nsSAFT:TaxpayerAccountID", sftg_firm(packed)))
            xml = concat(xml, sftg_text("nsSAFT:AccountType", "Bifunctional"))
            xml = concat(xml, sftg_bal("nsSAFT:OpeningDebitBalance", "nsSAFT:OpeningCreditBalance", open))
            xml = concat(xml, sftg_bal("nsSAFT:ClosingDebitBalance", "nsSAFT:ClosingCreditBalance", close))
            xml = concat(xml, xml_close("nsSAFT:Account"))
        }
        i = i + 1
    }
    xml = concat(xml, xml_close("nsSAFT:GeneralLedgerAccounts"))
    return SftGl { ok: 1, err: "", db: orm_db_q(lq), xml: xml, codes: codes }
}

struct SftWho {
    customer: str,
    supplier: str
}

fn sftg_who(packed: str, direction: str) -> SftWho {
    if packed == "" {
        return SftWho { customer: "0", supplier: "0" }
    }
    let bar = str_find(packed, "|")
    if bar < 1 {
        return SftWho { customer: "0", supplier: "0" }
    }
    let eik = substr(packed, 0, bar)
    let rest = substr(packed, bar + 1, len(packed))
    let bar2 = str_find(rest, "|")
    if bar2 < 0 {
        return SftWho { customer: "0", supplier: "0" }
    }
    let client = substr(rest, 0, bar2)
    let supplier = substr(rest, bar2 + 1, len(rest))
    if client == "1" && supplier != "1" {
        return SftWho { customer: eik, supplier: "0" }
    }
    if supplier == "1" && client != "1" {
        return SftWho { customer: "0", supplier: eik }
    }
    if direction == "debit" {
        return SftWho { customer: eik, supplier: "0" }
    }
    return SftWho { customer: "0", supplier: eik }
}

fn sft_gl_entries(db: OrmDb, company_id: i64, year: i64, month: i64, cur: str, codes: Map<str, str>) -> SftGl !IO !Net {
    let period = sftg_ymd(year, month, 1)
    let prefix = substr(period, 0, 7)
    let jq = journal_all_dated(db)?
    if orm_ok_q(jq) == 0 {
        return SftGl { ok: 0, err: orm_err_q(jq), db: orm_db_q(jq), xml: "", codes: codes }
    }
    let cq = counterpart_all(orm_db_q(jq))?
    if orm_ok_q(cq) == 0 {
        return SftGl { ok: 0, err: orm_err_q(cq), db: orm_db_q(cq), xml: "", codes: codes }
    }
    let parties: Map<str, str> = map_new()
    let mut pi: i64 = 0
    while pi < orm_nrows(cq) {
        let eik = sftg_clip(orm_cell_by(cq, pi, "eik"), 35)
        let mut id = eik
        if id == "" {
            id = "0"
        }
        map_set(parties, int_to_str(orm_cell_by_i64(cq, pi, "id")), concat(concat(concat(concat(id, "|"), int_to_str(orm_cell_by_i64(cq, pi, "is_client"))), "|"), int_to_str(orm_cell_by_i64(cq, pi, "is_supplier"))))
        pi = pi + 1
    }
    let mut db2 = orm_db_q(cq)
    let mut body = ""
    let mut n: i64 = 0
    let mut debit = dec_zero()
    let mut credit = dec_zero()
    let mut i: i64 = 0
    while i < orm_nrows(jq) {
        if sftg_co(orm_cell_by_i64(jq, i, "company_id"), company_id) == 1 {
            let raw_date = orm_cell_by(jq, i, "entry_date")
            if len(raw_date) >= 10 && substr(raw_date, 0, 7) == prefix {
                let day = substr(raw_date, 0, 10)
                let entry_id = orm_cell_by_i64(jq, i, "id")
                let lq = journal_lines_by_entry(db2, entry_id)?
                db2 = orm_db_q(lq)
                let mut lines = ""
                let mut lc: i64 = 0
                let mut li: i64 = 0
                let mut tx_c = "0"
                let mut tx_s = "0"
                while li < orm_nrows(lq) {
                    let packed = map_get(codes, int_to_str(orm_cell_by_i64(lq, li, "account_id")))
                    if packed != "" {
                        let amount = orm_cell_by(lq, li, "amount")
                        let vat = vat_parse_amt(orm_cell_by(lq, li, "vat_amount"))
                        if orm_cell_by(lq, li, "direction") == "debit" {
                            debit = vat_dadd(debit, vat_parse_amt(amount))
                        } else {
                            credit = vat_dadd(credit, vat_parse_amt(amount))
                        }
                        let mut one = ""
                        one = concat(one, sftg_open("nsSAFT:TransactionLine"))
                        one = concat(one, sftg_text("nsSAFT:RecordID", int_to_str(orm_cell_by_i64(lq, li, "id"))))
                        one = concat(one, sftg_text("nsSAFT:AccountID", sftg_nra(packed)))
                        one = concat(one, sftg_text("nsSAFT:TaxpayerAccountID", sftg_firm(packed)))
                        one = concat(one, sftg_text("nsSAFT:ValueDate", day))
                        let who = sftg_who(map_get(parties, int_to_str(orm_cell_by_i64(lq, li, "counterpart_id"))), orm_cell_by(lq, li, "direction"))
                        if who.customer != "0" {
                            tx_c = who.customer
                        }
                        if who.supplier != "0" {
                            tx_s = who.supplier
                        }
                        one = concat(one, sftg_text("nsSAFT:CustomerID", who.customer))
                        one = concat(one, sftg_text("nsSAFT:SupplierID", who.supplier))
                        let mut desc = sftg_clip(orm_cell_by(jq, i, "description"), 256)
                        if desc == "" {
                            desc = "Запис"
                        }
                        one = concat(one, sftg_text("nsSAFT:Description", desc))
                        if orm_cell_by(lq, li, "direction") == "debit" {
                            one = concat(one, sftg_amount("nsSAFT:DebitAmount", amount, cur))
                        } else {
                            one = concat(one, sftg_amount("nsSAFT:CreditAmount", amount, cur))
                        }
                        one = concat(one, sftg_open("nsSAFT:TaxInformation"))
                        if dec_is_zero(vat) == 0 {
                            one = concat(one, sftg_text("nsSAFT:TaxType", "100"))
                            one = concat(one, sftg_text("nsSAFT:TaxCode", "100211"))
                            one = concat(one, sftg_amount("nsSAFT:TaxAmount", orm_cell_by(lq, li, "vat_amount"), cur))
                        } else {
                            one = concat(one, sftg_text("nsSAFT:TaxType", "000"))
                            one = concat(one, sftg_text("nsSAFT:TaxCode", "000000"))
                            one = concat(one, sftg_amount("nsSAFT:TaxAmount", "0", cur))
                        }
                        one = concat(one, xml_close("nsSAFT:TaxInformation"))
                        one = concat(one, xml_close("nsSAFT:TransactionLine"))
                        lines = concat(lines, one)
                        lc = lc + 1
                    }
                    li = li + 1
                }
                if lc > 0 {
                    let mut desc = sftg_clip(orm_cell_by(jq, i, "description"), 256)
                    if desc == "" {
                        desc = "Запис"
                    }
                    let mut tx = ""
                    tx = concat(tx, sftg_open("nsSAFT:Transaction"))
                    tx = concat(tx, sftg_text("nsSAFT:TransactionID", int_to_str(entry_id)))
                    tx = concat(tx, sftg_text("nsSAFT:Period", int_to_str(month)))
                    tx = concat(tx, sftg_text("nsSAFT:PeriodYear", int_to_str(year)))
                    tx = concat(tx, sftg_text("nsSAFT:TransactionDate", day))
                    tx = concat(tx, sftg_text("nsSAFT:TransactionType", "Normal"))
                    tx = concat(tx, sftg_text("nsSAFT:Description", desc))
                    tx = concat(tx, sftg_text("nsSAFT:SystemEntryDate", day))
                    tx = concat(tx, sftg_text("nsSAFT:GLPostingDate", day))
                    tx = concat(tx, sftg_text("nsSAFT:CustomerID", tx_c))
                    tx = concat(tx, sftg_text("nsSAFT:SupplierID", tx_s))
                    tx = concat(tx, lines)
                    tx = concat(tx, xml_close("nsSAFT:Transaction"))
                    body = concat(body, tx)
                    n = n + 1
                }
            }
        }
        i = i + 1
    }
    let mut xml = ""
    xml = concat(xml, sftg_open("nsSAFT:GeneralLedgerEntries"))
    xml = concat(xml, sftg_text("nsSAFT:NumberOfEntries", int_to_str(n)))
    xml = concat(xml, sftg_text("nsSAFT:TotalDebit", vat_money(debit)))
    xml = concat(xml, sftg_text("nsSAFT:TotalCredit", vat_money(credit)))
    xml = concat(xml, sftg_open("nsSAFT:Journal"))
    xml = concat(xml, sftg_text("nsSAFT:JournalID", "GL"))
    xml = concat(xml, sftg_text("nsSAFT:Description", "Счетоводни записи"))
    xml = concat(xml, sftg_text("nsSAFT:Type", "GLEntry"))
    xml = concat(xml, body)
    xml = concat(xml, xml_close("nsSAFT:Journal"))
    xml = concat(xml, xml_close("nsSAFT:GeneralLedgerEntries"))
    return SftGl { ok: 1, err: "", db: db2, xml: xml, codes: codes }
}
