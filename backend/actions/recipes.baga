// actions/recipes.baga — технологични карти (BOM): продукт + материали.
// Количеството на материала е за output_quantity единици готова продукция.

import "../models/production.baga"
import "../models/product.baga"
import "active_company.baga"
import "txn.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "std/json/json.baga"
import "std/str/str.baga"

fn recipe_pack(rq: OrmQuery, lq: OrmQuery) -> JObj {
    let mut o = recipe_to_json(rq, 0)
    o = jobj_arr(o, "lines", rline_list_json(lq))
    return o
}

fn recipe_insert_lines(db: OrmDb, recipe_id: i64, doc: JsonDoc, root: i64) -> FmrOut !IO !Net {
    let lines_node = json_get(doc, root, "lines")
    if lines_node < 0 || json_tag(doc, lines_node) != 5 {
        return act_ok(db, jobj_new())
    }
    let n = json_count(doc, lines_node)
    let mut db2 = db
    let mut i: i64 = 0
    while i < n {
        let elem = json_at(doc, lines_node, i)
        if json_tag(doc, elem) != 6 {
            return act_err_rb(db2, 422, "lines[i] трябва да е обект")
        }
        let pid = jreq_i64(doc, elem, "product_id")
        if pid.ok == 0 || pid.num <= 0 {
            return act_err_rb(db2, 422, "рецептата иска артикул на всеки ред")
        }
        let qty = jopt_str(doc, elem, "quantity", "0")
        let unit = jopt_str(doc, elem, "unit", "")
        let wast = jopt_str(doc, elem, "wastage_percent", "0")
        let ins = rline_create(db2, recipe_id, pid.num, qty.val, unit.val, wast.val, i + 1)?
        if orm_ok_q(ins) == 0 {
            return act_err_rb(orm_db_q(ins), 500, orm_err_q(ins))
        }
        db2 = orm_db_q(ins)
        i = i + 1
    }
    return act_ok(db2, jobj_new())
}

fn act_recipes_index(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    if ac.id <= 0 {
        return act_err(ac.db, 422, "няма избрана активна фирма")
    }
    let q = recipe_by_company(ac.db, ac.id)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        if orm_cell_by_i64(q, i, "is_active") != 0 {
            arr = jarr_obj(arr, recipe_to_json(q, i))
        }
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", vec_len(arr.items))
    return act_ok(orm_db_q(q), o)
}

fn act_recipes_show(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    if ac.id <= 0 {
        return act_err(ac.db, 422, "няма избрана активна фирма")
    }
    let q = recipe_find(ac.db, id)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    if orm_nrows(q) < 1 || orm_cell_by_i64(q, 0, "company_id") != ac.id {
        return act_404(orm_db_q(q), "Рецептата не е намерена")
    }
    let lq = rline_by_recipe(orm_db_q(q), id)?
    if orm_ok_q(lq) == 0 {
        return act_err(orm_db_q(lq), 500, orm_err_q(lq))
    }
    return act_ok(orm_db_q(lq), recipe_pack(q, lq))
}

fn act_recipes_create(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let name = jreq_str(b.doc, b.root, "name")
    if name.ok == 0 {
        return act_422_field(db, "name", name)
    }
    let outp = jreq_i64(b.doc, b.root, "output_product_id")
    if outp.ok == 0 || outp.num <= 0 {
        return act_err(db, 422, "изходният артикул е задължителен")
    }
    let code = jopt_str(b.doc, b.root, "code", "")
    let oqty = jopt_str(b.doc, b.root, "output_quantity", "1")
    let ounit = jopt_str(b.doc, b.root, "output_unit", "")
    let notes = jopt_str(b.doc, b.root, "notes", "")
    let ac = active_company_id(db, auth.ctx.user_sub)?
    if ac.id <= 0 {
        return act_err(ac.db, 422, "няма избрана активна фирма")
    }
    let bgn = bb_begin(ac.db)?
    if orm_ok(bgn) == 0 {
        return act_err(orm_db_exec(bgn), 500, orm_err_exec(bgn))
    }
    let ins = recipe_create(orm_db_exec(bgn), ac.id, code.val, name.val, outp.num, oqty.val, ounit.val, notes.val)?
    if orm_ok_q(ins) == 0 || orm_nrows(ins) < 1 {
        return act_err_rb(orm_db_q(ins), 500, "recipe insert failed")
    }
    let rid = orm_cell_by_i64(ins, 0, "id")
    let fill = recipe_insert_lines(orm_db_q(ins), rid, b.doc, b.root)?
    if fill.resp.status != 200 {
        return fill
    }
    let cmt = bb_commit(fill.db)?
    if orm_ok(cmt) == 0 {
        return act_err(orm_db_exec(cmt), 500, orm_err_exec(cmt))
    }
    let q = recipe_find(orm_db_exec(cmt), rid)?
    let lq = rline_by_recipe(orm_db_q(q), rid)?
    return act_created(orm_db_q(lq), recipe_pack(q, lq))
}

fn act_recipes_update(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    if ac.id <= 0 {
        return act_err(ac.db, 422, "няма избрана активна фирма")
    }
    let q = recipe_find(ac.db, id)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 || orm_cell_by_i64(q, 0, "company_id") != ac.id {
        return act_404(orm_db_q(q), "Рецептата не е намерена")
    }
    let cols = vec_new()
    let vals = vec_new()
    let name = jreq_str(b.doc, b.root, "name")
    if name.present == 1 {
        if name.ok == 0 {
            return act_422_field(orm_db_q(q), "name", name)
        }
        vec_push(cols, "name")
        vec_push(vals, name.val)
    }
    let code = jreq_str(b.doc, b.root, "code")
    if code.present == 1 && code.ok == 1 {
        vec_push(cols, "code")
        vec_push(vals, code.val)
    }
    let outp = jreq_i64(b.doc, b.root, "output_product_id")
    if outp.present == 1 && outp.ok == 1 {
        vec_push(cols, "output_product_id")
        vec_push(vals, int_to_str(outp.num))
    }
    let oqty = jreq_str(b.doc, b.root, "output_quantity")
    if oqty.present == 1 && oqty.ok == 1 {
        vec_push(cols, "output_quantity")
        vec_push(vals, oqty.val)
    }
    let ounit = jreq_str(b.doc, b.root, "output_unit")
    if ounit.present == 1 && ounit.ok == 1 {
        vec_push(cols, "output_unit")
        vec_push(vals, ounit.val)
    }
    let notes = jreq_str(b.doc, b.root, "notes")
    if notes.present == 1 && notes.ok == 1 {
        vec_push(cols, "notes")
        vec_push(vals, notes.val)
    }
    let bgn = bb_begin(orm_db_q(q))?
    if orm_ok(bgn) == 0 {
        return act_err(orm_db_exec(bgn), 500, orm_err_exec(bgn))
    }
    let mut db2 = orm_db_exec(bgn)
    if vec_len(cols) > 0 {
        let up = orm_update_by_id(db2, recipe_table(), id, cols, vals)?
        if orm_ok(up) == 0 {
            return act_err_rb(orm_db_exec(up), 500, orm_err_exec(up))
        }
        db2 = orm_db_exec(up)
    }
    let lines_node = json_get(b.doc, b.root, "lines")
    if lines_node >= 0 && json_tag(b.doc, lines_node) == 5 {
        let del = rline_delete_by_recipe(db2, id)?
        if orm_ok(del) == 0 {
            return act_err_rb(orm_db_exec(del), 500, orm_err_exec(del))
        }
        let fill = recipe_insert_lines(orm_db_exec(del), id, b.doc, b.root)?
        if fill.resp.status != 200 {
            return fill
        }
        db2 = fill.db
    }
    let cmt = bb_commit(db2)?
    if orm_ok(cmt) == 0 {
        return act_err(orm_db_exec(cmt), 500, orm_err_exec(cmt))
    }
    let nq = recipe_find(orm_db_exec(cmt), id)?
    let lq = rline_by_recipe(orm_db_q(nq), id)?
    return act_ok(orm_db_q(lq), recipe_pack(nq, lq))
}

fn act_recipes_delete(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    if ac.id <= 0 {
        return act_err(ac.db, 422, "няма избрана активна фирма")
    }
    let q = recipe_find(ac.db, id)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 || orm_cell_by_i64(q, 0, "company_id") != ac.id {
        return act_404(orm_db_q(q), "Рецептата не е намерена")
    }
    let oq = pord_by_company(orm_db_q(q), ac.id)?
    if orm_ok_q(oq) == 0 {
        return act_err(orm_db_q(oq), 500, orm_err_q(oq))
    }
    let mut i: i64 = 0
    while i < orm_nrows(oq) {
        if orm_cell_by_i64(oq, i, "recipe_id") == id {
            return act_err(orm_db_q(oq), 422, "рецептата се ползва в производствена поръчка")
        }
        i = i + 1
    }
    let del = rline_delete_by_recipe(orm_db_q(oq), id)?
    if orm_ok(del) == 0 {
        return act_err(orm_db_exec(del), 500, orm_err_exec(del))
    }
    let del2 = recipe_delete(orm_db_exec(del), id)?
    if orm_ok(del2) == 0 {
        return act_err(orm_db_exec(del2), 500, orm_err_exec(del2))
    }
    return act_no_content(orm_db_exec(del2))
}
