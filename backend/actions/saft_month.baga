// actions/saft_month.baga — месечен SAF-T: TaxTable и Payments.
// TaxTable е ДДС от номенклатурата на НАП (100 / 100211, 100213, 100214, 100219).
// Payments са осчетоводени банкови движения за месеца. Метод 03, механизъм 42.

import "../models/bank_transaction.baga"
import "../models/bank_account.baga"
import "../models/account.baga"
import "../models/counterpart.baga"
import "vat_fmt.baga"
import "bagadecimal/src/decimal.baga"
import "xmlbaga/xml.baga"
import "std/str/str.baga"

struct SftPay {
    ok: i64,
    err: str,
    db: OrmDb,
    xml: str
}

struct SftGl {
    db: OrmDb,
    code: str
}

fn sft_open(name: str) -> str {
    return xml_open(name, xml_attrs_new())
}

fn sft_text(name: str, text: str) -> str {
    return xml_elem(name, xml_attrs_new(), text)
}

fn sft_clip(s: str, n: i64) -> str {
    let t = str_trim(s)
    if t == "" || n <= 0 {
        return ""
    }
    if len(t) <= n {
        return t
    }
    return substr(t, 0, n)
}

fn sft_digits(s: str) -> i64 {
    if s == "" {
        return 0
    }
    let mut i: i64 = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c < 48 || c > 57 {
            return 0
        }
        i = i + 1
    }
    return 1
}

fn sft_amount(name: str, amount: str, currency: str) -> str {
    let mut out = ""
    out = concat(out, sft_open(name))
    out = concat(out, sft_text("nsSAFT:Amount", amount))
    out = concat(out, sft_text("nsSAFT:CurrencyCode", currency))
    out = concat(out, sft_text("nsSAFT:CurrencyAmount", amount))
    out = concat(out, xml_close(name))
    return out
}

fn sft_tax_code(code: str, rate: str, desc: str) -> str {
    let mut out = ""
    out = concat(out, sft_open("nsSAFT:TaxCodeDetails"))
    out = concat(out, sft_text("nsSAFT:TaxCode", code))
    out = concat(out, sft_text("nsSAFT:Description", desc))
    out = concat(out, sft_text("nsSAFT:TaxPercentage", rate))
    out = concat(out, sft_text("nsSAFT:Country", "BG"))
    out = concat(out, xml_close("nsSAFT:TaxCodeDetails"))
    return out
}

fn sft_tax_table() -> str {
    let mut out = ""
    out = concat(out, sft_open("nsSAFT:TaxTable"))
    out = concat(out, sft_open("nsSAFT:TaxTableEntry"))
    out = concat(out, sft_text("nsSAFT:TaxType", "100"))
    out = concat(out, sft_text("nsSAFT:Description", "ДАНЪК ВЪРХУ ДОБАВЕНАТА СТОЙНОСТ"))
    out = concat(out, sft_tax_code("100211", "20.00", "Данъчна основа на облагаемите доставки със ставка 20 %"))
    out = concat(out, sft_tax_code("100213", "9.00", "ДО на облагаемите доставки със ставка 9 %"))
    out = concat(out, sft_tax_code("100214", "0.00", "ДО на доставките със ставка 0 % по глава трета от ЗДДС"))
    out = concat(out, sft_tax_code("100219", "0.00", "ДО на освободени доставки и освободените ВОП"))
    out = concat(out, xml_close("nsSAFT:TaxTableEntry"))
    out = concat(out, sft_open("nsSAFT:TaxTableEntry"))
    out = concat(out, sft_text("nsSAFT:TaxType", "000"))
    out = concat(out, sft_text("nsSAFT:Description", "Неприложимо"))
    out = concat(out, sft_tax_code("000000", "0.00", "Неприложим код"))
    out = concat(out, xml_close("nsSAFT:TaxTableEntry"))
    out = concat(out, xml_close("nsSAFT:TaxTable"))
    return out
}

fn sft_in_month(date: str, prefix: str) -> i64 {
    if len(date) < 7 || prefix == "" {
        return 0
    }
    if substr(date, 0, 7) == prefix {
        return 1
    }
    return 0
}

fn sft_gl_number(db: OrmDb, bank_id: i64) -> SftGl !IO !Net {
    if bank_id <= 0 {
        return SftGl { db: db, code: "" }
    }
    let bq = bank_account_find(db, bank_id)?
    if orm_ok_q(bq) == 0 || orm_nrows(bq) < 1 {
        return SftGl { db: orm_db_q(bq), code: "" }
    }
    let gid = orm_cell_by_i64(bq, 0, "gl_account_id")
    if gid <= 0 {
        return SftGl { db: orm_db_q(bq), code: "" }
    }
    let aq = account_find(orm_db_q(bq), gid)?
    if orm_ok_q(aq) == 0 || orm_nrows(aq) < 1 {
        return SftGl { db: orm_db_q(aq), code: "" }
    }
    let num = str_trim(orm_cell_by(aq, 0, "number"))
    if sft_digits(num) == 0 {
        return SftGl { db: orm_db_q(aq), code: "" }
    }
    return SftGl { db: orm_db_q(aq), code: num }
}

fn sft_party(q: OrmQuery, name: str) -> str {
    let want = str_trim(name)
    if want == "" {
        return "0"
    }
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        if str_trim(orm_cell_by(q, i, "name")) == want {
            let eik = sft_clip(orm_cell_by(q, i, "eik"), 35)
            if eik != "" {
                return eik
            }
        }
        i = i + 1
    }
    return "0"
}

fn sft_payment(refno: str, month: str, year: str, txn_id: str, date: str, desc: str, account: str, customer: str, supplier: str, indicator: str, amount: str, currency: str, source: str) -> str {
    let mut out = ""
    out = concat(out, sft_open("nsSAFT:Payment"))
    out = concat(out, sft_text("nsSAFT:PaymentRefNo", refno))
    out = concat(out, sft_text("nsSAFT:Period", month))
    out = concat(out, sft_text("nsSAFT:PeriodYear", year))
    out = concat(out, sft_text("nsSAFT:TransactionID", txn_id))
    out = concat(out, sft_text("nsSAFT:TransactionDate", date))
    out = concat(out, sft_text("nsSAFT:PaymentMethod", "03"))
    out = concat(out, sft_text("nsSAFT:Description", desc))
    out = concat(out, sft_text("nsSAFT:SystemID", refno))
    out = concat(out, sft_text("nsSAFT:SourceID", "bagabuch"))
    out = concat(out, sft_open("nsSAFT:PaymentLine"))
    out = concat(out, sft_text("nsSAFT:LineNumber", "1"))
    if source != "" {
        out = concat(out, sft_text("nsSAFT:SourceDocumentID", source))
    }
    out = concat(out, sft_text("nsSAFT:AccountID", account))
    out = concat(out, sft_text("nsSAFT:CustomerID", customer))
    out = concat(out, sft_text("nsSAFT:SupplierID", supplier))
    out = concat(out, sft_text("nsSAFT:TaxPointDate", date))
    out = concat(out, sft_text("nsSAFT:Description", desc))
    out = concat(out, sft_text("nsSAFT:DebitCreditIndicator", indicator))
    out = concat(out, sft_amount("nsSAFT:PaymentLineAmount", amount, currency))
    out = concat(out, xml_close("nsSAFT:PaymentLine"))
    out = concat(out, sft_open("nsSAFT:PaymentSettlement"))
    out = concat(out, sft_amount("nsSAFT:SettlementAmount", amount, currency))
    out = concat(out, sft_text("nsSAFT:SettlementDate", date))
    out = concat(out, sft_text("nsSAFT:PaymentMechanism", "42"))
    out = concat(out, xml_close("nsSAFT:PaymentSettlement"))
    out = concat(out, sft_open("nsSAFT:PaymentDocumentTotals"))
    out = concat(out, sft_text("nsSAFT:NetTotal", amount))
    out = concat(out, sft_text("nsSAFT:GrossTotal", amount))
    out = concat(out, xml_close("nsSAFT:PaymentDocumentTotals"))
    out = concat(out, xml_close("nsSAFT:Payment"))
    return out
}

fn sft_payments(db: OrmDb, company_id: i64, period: str, currency: str) -> SftPay !IO !Net {
    let prefix = substr(period, 0, 7)
    let month = int_to_str(parse_int(substr(period, 5, 7)))
    let year = substr(period, 0, 4)
    let kq = counterpart_all(db)?
    if orm_ok_q(kq) == 0 {
        return SftPay { ok: 0, err: orm_err_q(kq), db: orm_db_q(kq), xml: "" }
    }
    let tq = bank_tx_by_company(orm_db_q(kq), company_id)?
    if orm_ok_q(tq) == 0 {
        return SftPay { ok: 0, err: orm_err_q(tq), db: orm_db_q(tq), xml: "" }
    }
    let mut db2 = orm_db_q(tq)
    let mut body = ""
    let mut n: i64 = 0
    let mut debit = dec_zero()
    let mut credit = dec_zero()
    let mut i: i64 = 0
    while i < orm_nrows(tq) {
        let booked = orm_cell_by_i64(tq, i, "is_booked")
        let date = orm_cell_by(tq, i, "txn_date")
        if booked == 1 && sft_in_month(date, prefix) == 1 {
            let gl = sft_gl_number(db2, orm_cell_by_i64(tq, i, "bank_account_id"))?
            db2 = gl.db
            let raw = vat_parse_amt(orm_cell_by(tq, i, "amount"))
            let neg = dec_is_negative(raw)
            let mut mag = raw
            if neg == 1 {
                mag = dec_abs(raw)
            }
            if gl.code != "" && dec_is_zero(mag) == 0 && len(date) >= 10 {
                let text = vat_money(mag)
                let mut ind = "D"
                if orm_cell_by(tq, i, "transaction_type") == "WITHDRAWAL" {
                    ind = "C"
                }
                if neg == 1 {
                    if ind == "D" {
                        ind = "C"
                    } else {
                        ind = "D"
                    }
                }
                if ind == "D" {
                    debit = vat_dadd(debit, mag)
                } else {
                    credit = vat_dadd(credit, mag)
                }
                let party = sft_party(kq, orm_cell_by(tq, i, "counterpart_name"))
                let mut customer = "0"
                let mut supplier = "0"
                if ind == "D" {
                    customer = party
                } else {
                    supplier = party
                }
                let mut refno = sft_clip(orm_cell_by(tq, i, "reference"), 35)
                if refno == "" {
                    refno = concat("PAY-", int_to_str(orm_cell_by_i64(tq, i, "id")))
                }
                let mut txn = int_to_str(orm_cell_by_i64(tq, i, "journal_entry_id"))
                if txn == "0" {
                    txn = int_to_str(orm_cell_by_i64(tq, i, "id"))
                }
                let mut desc = sft_clip(orm_cell_by(tq, i, "description"), 256)
                if desc == "" {
                    desc = "Плащане по банка"
                }
                let mut cur = str_trim(orm_cell_by(tq, i, "currency"))
                if cur == "" {
                    cur = currency
                }
                let day = substr(date, 0, 10)
                let source = sft_clip(orm_cell_by(tq, i, "reference"), 35)
                body = concat(body, sft_payment(refno, month, year, txn, day, desc, gl.code, customer, supplier, ind, text, cur, source))
                n = n + 1
            }
        }
        i = i + 1
    }
    let mut out = ""
    out = concat(out, sft_open("nsSAFT:Payments"))
    out = concat(out, sft_text("nsSAFT:NumberOfEntries", int_to_str(n)))
    out = concat(out, sft_text("nsSAFT:TotalDebit", vat_money(debit)))
    out = concat(out, sft_text("nsSAFT:TotalCredit", vat_money(credit)))
    out = concat(out, body)
    out = concat(out, xml_close("nsSAFT:Payments"))
    return SftPay { ok: 1, err: "", db: db2, xml: out }
}
