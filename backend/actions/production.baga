// actions/production.baga — производствени поръчки (чернова от рецепта).
// Потвърждението е в production_confirm.baga: изписване + заприхождаване.

import "../models/production.baga"
import "../models/product.baga"
import "active_company.baga"
import "txn.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "bagadecimal/src/decimal.baga"
import "std/str/str.baga"

fn mfg_dec(s: str) -> Decimal {
    let p = dec_parse(s)
    if p.ok == 1 {
        return p.value
    }
    return dec_zero()
}

fn mfg_qty(d: Decimal) -> str {
    let r = dec_round_dp(d, 4)
    if r.ok == 1 {
        return dec_to_string(r.value)
    }
    return dec_to_string(d)
}

fn mfg_need(line_qty: str, wastage: str, order_qty: str, recipe_out: str) -> str {
    let lq = mfg_dec(line_qty)
    let oq = mfg_dec(order_qty)
    let mut outq = mfg_dec(recipe_out)
    if dec_is_zero(outq) == 1 {
        outq = mfg_dec("1")
    }
    let w = mfg_dec(wastage)
    let mul = dec_mul(lq, oq)
    if mul.ok == 0 {
        return "0"
    }
    let dv = dec_div(mul.value, outq)
    if dv.ok == 0 {
        return "0"
    }
    let hundred = mfg_dec("100")
    let wr = dec_div(w, hundred)
    let mut factor = mfg_dec("1")
    if wr.ok == 1 {
        let a = dec_add(factor, wr.value)
        if a.ok == 1 {
            factor = a.value
        }
    }
    let need = dec_mul(dv.value, factor)
    if need.ok == 0 {
        return "0"
    }
    return mfg_qty(need.value)
}

fn pord_pack(oq: OrmQuery, lq: OrmQuery) -> JObj {
    let mut o = pord_to_json(oq, 0)
    o = jobj_arr(o, "lines", pline_list_json(lq))
    return o
}

fn pord_copy_recipe(db: OrmDb, order_id: i64, recipe_id: i64, order_qty: str) -> FmrOut !IO !Net {
    let rq = recipe_find(db, recipe_id)?
    if orm_ok_q(rq) == 0 {
        return act_err_rb(orm_db_q(rq), 500, orm_err_q(rq))
    }
    if orm_nrows(rq) < 1 {
        return act_err_rb(orm_db_q(rq), 422, "рецептата не е намерена")
    }
    let outq = orm_cell_by(rq, 0, "output_quantity")
    let lq = rline_by_recipe(orm_db_q(rq), recipe_id)?
    if orm_ok_q(lq) == 0 {
        return act_err_rb(orm_db_q(lq), 500, orm_err_q(lq))
    }
    let mut db2 = orm_db_q(lq)
    let mut i: i64 = 0
    while i < orm_nrows(lq) {
        let pid = orm_cell_by_i64(lq, i, "product_id")
        let mut pname = ""
        let mut unit = orm_cell_by(lq, i, "unit")
        let pq = product_find(db2, pid)?
        if orm_ok_q(pq) == 0 {
            return act_err_rb(orm_db_q(pq), 500, orm_err_q(pq))
        }
        db2 = orm_db_q(pq)
        if orm_nrows(pq) > 0 {
            pname = orm_cell_by(pq, 0, "name")
            if unit == "" {
                unit = orm_cell_by(pq, 0, "unit")
            }
        }
        let need = mfg_need(orm_cell_by(lq, i, "quantity"), orm_cell_by(lq, i, "wastage_percent"), order_qty, outq)
        let ins = pline_create(db2, order_id, pid, pname, need, unit)?
        if orm_ok_q(ins) == 0 {
            return act_err_rb(orm_db_q(ins), 500, orm_err_q(ins))
        }
        db2 = orm_db_q(ins)
        i = i + 1
    }
    return act_ok(db2, jobj_new())
}

fn act_pord_index(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    if ac.id <= 0 {
        return act_err(ac.db, 422, "няма избрана активна фирма")
    }
    let q = pord_by_company(ac.db, ac.id)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, pord_to_json(q, i))
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", orm_nrows(q))
    return act_ok(orm_db_q(q), o)
}

fn act_pord_show(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    if ac.id <= 0 {
        return act_err(ac.db, 422, "няма избрана активна фирма")
    }
    let q = pord_find(ac.db, id)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 || orm_cell_by_i64(q, 0, "company_id") != ac.id {
        return act_404(orm_db_q(q), "Поръчката не е намерена")
    }
    let lq = pline_by_order(orm_db_q(q), id)?
    if orm_ok_q(lq) == 0 {
        return act_err(orm_db_q(lq), 500, orm_err_q(lq))
    }
    return act_ok(orm_db_q(lq), pord_pack(q, lq))
}

fn act_pord_create(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let rid = jreq_i64(b.doc, b.root, "recipe_id")
    if rid.ok == 0 || rid.num <= 0 {
        return act_err(db, 422, "рецептата е задължителна")
    }
    let qty = jreq_str(b.doc, b.root, "quantity")
    if qty.ok == 0 {
        return act_422_field(db, "quantity", qty)
    }
    if dec_is_zero(mfg_dec(qty.val)) == 1 || dec_is_negative(mfg_dec(qty.val)) == 1 {
        return act_err(db, 422, "количеството трябва да е по-голямо от 0")
    }
    let loc = jreq_i64(b.doc, b.root, "location_id")
    let mut location_id: i64 = 0
    if loc.ok == 1 {
        location_id = loc.num
    }
    let date = jopt_str(b.doc, b.root, "order_date", "")
    let notes = jopt_str(b.doc, b.root, "notes", "")
    let num_in = jopt_str(b.doc, b.root, "number", "")
    let ac = active_company_id(db, auth.ctx.user_sub)?
    if ac.id <= 0 {
        return act_err(ac.db, 422, "няма избрана активна фирма")
    }
    let rq = recipe_find(ac.db, rid.num)?
    if orm_ok_q(rq) == 0 || orm_nrows(rq) < 1 || orm_cell_by_i64(rq, 0, "company_id") != ac.id {
        return act_404(orm_db_q(rq), "Рецептата не е намерена")
    }
    let out_pid = orm_cell_by_i64(rq, 0, "output_product_id")
    let bgn = bb_begin(orm_db_q(rq))?
    if orm_ok(bgn) == 0 {
        return act_err(orm_db_exec(bgn), 500, orm_err_exec(bgn))
    }
    let nxt = mfg_next(orm_db_exec(bgn), pord_table())?
    let mut number = num_in.val
    if number == "" {
        number = concat("ПР-", int_to_str(orm_count_n(nxt) + 1))
    }
    let ins = pord_create(orm_db_c(nxt), ac.id, number, rid.num, out_pid, qty.val, location_id, date.val, notes.val)?
    if orm_ok_q(ins) == 0 || orm_nrows(ins) < 1 {
        return act_err_rb(orm_db_q(ins), 500, "order insert failed")
    }
    let oid = orm_cell_by_i64(ins, 0, "id")
    let copy = pord_copy_recipe(orm_db_q(ins), oid, rid.num, qty.val)?
    if copy.resp.status != 200 {
        return copy
    }
    let cmt = bb_commit(copy.db)?
    if orm_ok(cmt) == 0 {
        return act_err(orm_db_exec(cmt), 500, orm_err_exec(cmt))
    }
    let q = pord_find(orm_db_exec(cmt), oid)?
    let lq = pline_by_order(orm_db_q(q), oid)?
    return act_created(orm_db_q(lq), pord_pack(q, lq))
}

fn act_pord_delete(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    if ac.id <= 0 {
        return act_err(ac.db, 422, "няма избрана активна фирма")
    }
    let q = pord_find(ac.db, id)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 || orm_cell_by_i64(q, 0, "company_id") != ac.id {
        return act_404(orm_db_q(q), "Поръчката не е намерена")
    }
    if orm_cell_by(q, 0, "status") != "draft" {
        return act_err(orm_db_q(q), 422, "завършена поръчка не се изтрива")
    }
    let del = pline_delete_by_order(orm_db_q(q), id)?
    if orm_ok(del) == 0 {
        return act_err(orm_db_exec(del), 500, orm_err_exec(del))
    }
    let del2 = pord_delete(orm_db_exec(del), id)?
    if orm_ok(del2) == 0 {
        return act_err(orm_db_exec(del2), 500, orm_err_exec(del2))
    }
    return act_no_content(orm_db_exec(del2))
}
