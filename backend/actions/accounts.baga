// actions/accounts.baga — сметкоплан: CRUD handlers.

import "../models/account.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "std/json/json.baga"

fn act_accounts_index(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let page = act_page(ctx, 50, 200)
    let q = account_all(db)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    let mut o = account_list_json(q)
    o = jobj_i64(o, "limit", page.limit)
    o = jobj_i64(o, "offset", page.offset)
    return act_ok(orm_db_q(q), o)
}

fn act_accounts_create(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let number = jreq_str(b.doc, b.root, "number")
    if number.ok == 0 {
        return act_422_field(db, "number", number)
    }
    let name = jreq_str(b.doc, b.root, "name")
    if name.ok == 0 {
        return act_422_field(db, "name", name)
    }
    let saft_account_type = jopt_str(b.doc, b.root, "saft_account_type", "")
    let analytic_type = jopt_str(b.doc, b.root, "analytic_type", "none")
    // parent_id: липсва → NULL; грешен тип → 422.
    let pid = jreq_i64(b.doc, b.root, "parent_id")
    let mut parent_id: i64 = 0
    let mut parent_null: i64 = 1
    if pid.present == 1 {
        if pid.ok == 0 {
            return act_422_field(db, "parent_id", pid)
        }
        parent_id = pid.num
        parent_null = 0
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let ins = account_create(db, number.val, name.val, saft_account_type.val, analytic_type.val, parent_id, parent_null)?
    if orm_ok(ins) == 0 {
        return act_err(orm_db_exec(ins), 409, orm_err_exec(ins))
    }
    let q = account_all(orm_db_exec(ins))?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_err(orm_db_q(q), 500, "insert ok but row missing")
    }
    return act_created(orm_db_q(q), account_to_json(q, orm_nrows(q) - 1))
}

fn act_accounts_show(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let q = account_find(db, id)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    if orm_nrows(q) < 1 {
        return act_404(orm_db_q(q), "Account not found")
    }
    return act_ok(orm_db_q(q), account_to_json(q, 0))
}

fn act_accounts_update(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    // Частичен PATCH: само присъстващите полета влизат в SET.
    let cols = vec_new()
    let vals = vec_new()
    let nulls = vec_new()
    let number = jreq_str(b.doc, b.root, "number")
    if number.present == 1 {
        if number.ok == 0 {
            return act_422_field(db, "number", number)
        }
        vec_push(cols, "number")
        vec_push(vals, number.val)
        vec_push(nulls, 0)
    }
    let name = jreq_str(b.doc, b.root, "name")
    if name.present == 1 {
        if name.ok == 0 {
            return act_422_field(db, "name", name)
        }
        vec_push(cols, "name")
        vec_push(vals, name.val)
        vec_push(nulls, 0)
    }
    let saft_account_type = jreq_str(b.doc, b.root, "saft_account_type")
    if saft_account_type.present == 1 {
        if saft_account_type.ok == 0 {
            return act_422_field(db, "saft_account_type", saft_account_type)
        }
        vec_push(cols, "saft_account_type")
        vec_push(vals, saft_account_type.val)
        vec_push(nulls, 0)
    }
    let analytic_type = jreq_str(b.doc, b.root, "analytic_type")
    if analytic_type.present == 1 {
        if analytic_type.ok == 0 {
            return act_422_field(db, "analytic_type", analytic_type)
        }
        vec_push(cols, "analytic_type")
        vec_push(vals, analytic_type.val)
        vec_push(nulls, 0)
    }
    // parent_id: присъства → стойност или null (JSON null → NULL в БД).
    let pn = json_get(b.doc, b.root, "parent_id")
    if pn >= 0 {
        if json_tag(b.doc, pn) == 0 {
            vec_push(cols, "parent_id")
            vec_push(vals, "")
            vec_push(nulls, 1)
        } else {
            let pid = jreq_i64(b.doc, b.root, "parent_id")
            if pid.ok == 0 {
                return act_422_field(db, "parent_id", pid)
            }
            vec_push(cols, "parent_id")
            vec_push(vals, int_to_str(pid.num))
            vec_push(nulls, 0)
        }
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    if vec_len(cols) == 0 {
        let q0 = account_find(db, id)?
        if orm_ok_q(q0) == 0 {
            return act_err(orm_db_q(q0), 500, orm_err_q(q0))
        }
        if orm_nrows(q0) < 1 {
            return act_404(orm_db_q(q0), "Account not found")
        }
        return act_ok(orm_db_q(q0), account_to_json(q0, 0))
    }
    let upd = orm_update_by_id_full(db, account_table(), id, cols, vals, nulls)?
    if orm_ok(upd) == 0 {
        return act_err(orm_db_exec(upd), 500, orm_err_exec(upd))
    }
    let q = account_find(orm_db_exec(upd), id)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_404(orm_db_q(q), "Account not found")
    }
    return act_ok(orm_db_q(q), account_to_json(q, 0))
}

fn act_accounts_delete(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let del = account_delete(db, id)?
    if orm_ok(del) == 0 {
        return act_err(orm_db_exec(del), 500, orm_err_exec(del))
    }
    return act_no_content(orm_db_exec(del))
}
