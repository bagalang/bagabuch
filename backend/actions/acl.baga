// actions/acl.baga — права по роля (baraba: super_admin / admin / accountant / viewer).
// Кодовете са като в secret/barara (invoice:read, accounting:post, …). "*" е всичко.
// Супер-админът минава. Празен users = bootstrap (seed / първи вход).

import "../models/user.baga"
import "../models/role.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "std/json/json.baga"
import "std/str/str.baga"

fn perm_one_matches(have: str, need: str) -> i64 {
    if have == "*" {
        return 1
    }
    if have == need {
        return 1
    }
    if str_ends_with(have, ":*") {
        let cat = substr(have, 0, len(have) - 1)
        if str_starts_with(need, cat) {
            return 1
        }
    }
    return 0
}

fn perm_json_has(perms: str, need: str) -> i64 {
    if perms == "" || perms == "[]" {
        return 0
    }
    let d = json_parse(perms)
    let root = json_root(d)
    if json_tag(d, root) != 5 {
        return 0
    }
    let n = json_count(d, root)
    let mut i: i64 = 0
    while i < n {
        let el = json_at(d, root, i)
        let raw = json_serialize(d, el)
        let mut p = raw
        if len(raw) >= 2 && char_at(raw, 0) == 34 {
            p = substr(raw, 1, len(raw) - 1)
        }
        if perm_one_matches(p, need) == 1 {
            return 1
        }
        i = i + 1
    }
    return 0
}

fn user_count(db: OrmDb) -> OrmCount !IO !Net {
    return orm_count_sql(db, "SELECT COUNT(*) AS count FROM users")?
}

fn act_require_perm(ctx: FmrCtx, db: OrmDb, need: str) -> ActAuth !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth
    }
    if orm_ok_db(db) == 0 {
        return ActAuth { ok: 0, ctx: auth.ctx, out: act_err(db, 503, "database unavailable") }
    }
    let c = user_count(db)?
    if orm_ok_c(c) == 0 {
        return ActAuth { ok: 0, ctx: auth.ctx, out: act_err(orm_db_c(c), 500, orm_err_c(c)) }
    }
    if orm_count_n(c) < 1 {
        return ActAuth { ok: 1, ctx: auth.ctx, out: act_ok(orm_db_c(c), jobj_new()) }
    }
    let uq = user_by_email(orm_db_c(c), auth.ctx.user_sub)?
    if orm_ok_q(uq) == 0 {
        return ActAuth { ok: 0, ctx: auth.ctx, out: act_err(orm_db_q(uq), 500, orm_err_q(uq)) }
    }
    if orm_nrows(uq) < 1 {
        return ActAuth { ok: 0, ctx: auth.ctx, out: act_err(orm_db_q(uq), 403, "няма такъв потребител") }
    }
    if orm_cell_by_i64(uq, 0, "is_active") == 0 {
        return ActAuth { ok: 0, ctx: auth.ctx, out: act_err(orm_db_q(uq), 403, "потребителят е неактивен") }
    }
    if orm_cell_by_i64(uq, 0, "is_super_admin") == 1 {
        return ActAuth { ok: 1, ctx: auth.ctx, out: act_ok(orm_db_q(uq), jobj_new()) }
    }
    let rid = orm_cell_by_i64(uq, 0, "role_id")
    if rid <= 0 {
        return ActAuth { ok: 0, ctx: auth.ctx, out: act_err(orm_db_q(uq), 403, "няма назначена роля") }
    }
    let rq = role_find(orm_db_q(uq), rid)?
    if orm_ok_q(rq) == 0 {
        return ActAuth { ok: 0, ctx: auth.ctx, out: act_err(orm_db_q(rq), 500, orm_err_q(rq)) }
    }
    if orm_nrows(rq) < 1 {
        return ActAuth { ok: 0, ctx: auth.ctx, out: act_err(orm_db_q(rq), 403, "ролята липсва") }
    }
    let perms = orm_cell_by(rq, 0, "permissions")
    if perm_json_has(perms, need) == 1 {
        return ActAuth { ok: 1, ctx: auth.ctx, out: act_ok(orm_db_q(rq), jobj_new()) }
    }
    return ActAuth { ok: 0, ctx: auth.ctx, out: act_err(orm_db_q(rq), 403, concat("няма право ", need)) }
}

fn acl_user_perms_json(db: OrmDb, sub: str) -> str !IO !Net {
    let uq = user_by_email(db, sub)?
    if orm_ok_q(uq) == 0 || orm_nrows(uq) < 1 {
        return "[]"
    }
    if orm_cell_by_i64(uq, 0, "is_super_admin") == 1 {
        return "[\"*\"]"
    }
    let rid = orm_cell_by_i64(uq, 0, "role_id")
    if rid <= 0 {
        return "[]"
    }
    let rq = role_find(orm_db_q(uq), rid)?
    if orm_ok_q(rq) == 0 || orm_nrows(rq) < 1 {
        return "[]"
    }
    let p = orm_cell_by(rq, 0, "permissions")
    if p == "" {
        return "[]"
    }
    return p
}
