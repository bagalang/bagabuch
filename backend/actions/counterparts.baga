// actions/counterparts.baga — контрагенти: CRUD handlers.

import "../models/counterpart.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"

// Проверява типа (customer/supplier/both).
fn counterpart_type_ok(t: str) -> i64 {
    if t == "customer" || t == "supplier" || t == "both" {
        return 1
    }
    return 0
}

fn act_counterparts_index(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let page = act_page(ctx, 50, 200)
    let q = counterpart_all(db)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    let mut o = counterpart_list_json(q)
    o = jobj_i64(o, "limit", page.limit)
    o = jobj_i64(o, "offset", page.offset)
    return act_ok(orm_db_q(q), o)
}

fn act_counterparts_create(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let name = jreq_str(b.doc, b.root, "name")
    if name.ok == 0 {
        return act_422_field(db, "name", name)
    }
    let counterpart_type = jopt_str(b.doc, b.root, "counterpart_type", "both")
    if counterpart_type_ok(counterpart_type.val) == 0 {
        return act_err(db, 422, "counterpart_type трябва да е customer/supplier/both")
    }
    let eik = jopt_str(b.doc, b.root, "eik", "")
    let vat_number = jopt_str(b.doc, b.root, "vat_number", "")
    let address = jopt_str(b.doc, b.root, "address", "")
    let city = jopt_str(b.doc, b.root, "city", "")
    let country = jopt_str(b.doc, b.root, "country", "BG")
    let post_code = jopt_str(b.doc, b.root, "post_code", "")
    let contact_person = jopt_str(b.doc, b.root, "contact_person", "")
    let email = jopt_str(b.doc, b.root, "email", "")
    let phone = jopt_str(b.doc, b.root, "phone", "")
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let ins = counterpart_create(db, name.val, counterpart_type.val, eik.val, vat_number.val, address.val, city.val, country.val, post_code.val, contact_person.val, email.val, phone.val)?
    if orm_ok(ins) == 0 {
        return act_err(orm_db_exec(ins), 409, orm_err_exec(ins))
    }
    let q = counterpart_all(orm_db_exec(ins))?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_err(orm_db_q(q), 500, "insert ok but row missing")
    }
    return act_created(orm_db_q(q), counterpart_to_json(q, orm_nrows(q) - 1))
}

fn act_counterparts_show(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let q = counterpart_find(db, id)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    if orm_nrows(q) < 1 {
        return act_404(orm_db_q(q), "Counterpart not found")
    }
    return act_ok(orm_db_q(q), counterpart_to_json(q, 0))
}

fn act_counterparts_update(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    // Частичен PATCH: само присъстващите полета влизат в SET.
    let cols = vec_new()
    let vals = vec_new()
    let name = jreq_str(b.doc, b.root, "name")
    if name.present == 1 {
        if name.ok == 0 {
            return act_422_field(db, "name", name)
        }
        vec_push(cols, "name")
        vec_push(vals, name.val)
    }
    let counterpart_type = jreq_str(b.doc, b.root, "counterpart_type")
    if counterpart_type.present == 1 {
        if counterpart_type.ok == 0 {
            return act_422_field(db, "counterpart_type", counterpart_type)
        }
        if counterpart_type_ok(counterpart_type.val) == 0 {
            return act_err(db, 422, "counterpart_type трябва да е customer/supplier/both")
        }
        vec_push(cols, "is_client")
        vec_push(vals, int_to_str(counterpart_is_client(counterpart_type.val)))
        vec_push(cols, "is_supplier")
        vec_push(vals, int_to_str(counterpart_is_supplier(counterpart_type.val)))
    }
    let eik = jreq_str(b.doc, b.root, "eik")
    if eik.present == 1 {
        if eik.ok == 0 {
            return act_422_field(db, "eik", eik)
        }
        vec_push(cols, "eik")
        vec_push(vals, eik.val)
    }
    let vat_number = jreq_str(b.doc, b.root, "vat_number")
    if vat_number.present == 1 {
        if vat_number.ok == 0 {
            return act_422_field(db, "vat_number", vat_number)
        }
        vec_push(cols, "vat_number")
        vec_push(vals, vat_number.val)
    }
    let address = jreq_str(b.doc, b.root, "address")
    if address.present == 1 {
        if address.ok == 0 {
            return act_422_field(db, "address", address)
        }
        vec_push(cols, "address")
        vec_push(vals, address.val)
    }
    let city = jreq_str(b.doc, b.root, "city")
    if city.present == 1 {
        if city.ok == 0 {
            return act_422_field(db, "city", city)
        }
        vec_push(cols, "city")
        vec_push(vals, city.val)
    }
    let country = jreq_str(b.doc, b.root, "country")
    if country.present == 1 {
        if country.ok == 0 {
            return act_422_field(db, "country", country)
        }
        vec_push(cols, "country")
        vec_push(vals, country.val)
    }
    let post_code = jreq_str(b.doc, b.root, "post_code")
    if post_code.present == 1 {
        if post_code.ok == 0 {
            return act_422_field(db, "post_code", post_code)
        }
        vec_push(cols, "post_code")
        vec_push(vals, post_code.val)
    }
    let contact_person = jreq_str(b.doc, b.root, "contact_person")
    if contact_person.present == 1 {
        if contact_person.ok == 0 {
            return act_422_field(db, "contact_person", contact_person)
        }
        vec_push(cols, "contact_person")
        vec_push(vals, contact_person.val)
    }
    let email = jreq_str(b.doc, b.root, "email")
    if email.present == 1 {
        if email.ok == 0 {
            return act_422_field(db, "email", email)
        }
        vec_push(cols, "email")
        vec_push(vals, email.val)
    }
    let phone = jreq_str(b.doc, b.root, "phone")
    if phone.present == 1 {
        if phone.ok == 0 {
            return act_422_field(db, "phone", phone)
        }
        vec_push(cols, "phone")
        vec_push(vals, phone.val)
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    if vec_len(cols) == 0 {
        let q0 = counterpart_find(db, id)?
        if orm_ok_q(q0) == 0 {
            return act_err(orm_db_q(q0), 500, orm_err_q(q0))
        }
        if orm_nrows(q0) < 1 {
            return act_404(orm_db_q(q0), "Counterpart not found")
        }
        return act_ok(orm_db_q(q0), counterpart_to_json(q0, 0))
    }
    let upd = orm_update_by_id(db, counterpart_table(), id, cols, vals)?
    if orm_ok(upd) == 0 {
        return act_err(orm_db_exec(upd), 500, orm_err_exec(upd))
    }
    let q = counterpart_find(orm_db_exec(upd), id)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_404(orm_db_q(q), "Counterpart not found")
    }
    return act_ok(orm_db_q(q), counterpart_to_json(q, 0))
}

fn act_counterparts_delete(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let del = counterpart_delete(db, id)?
    if orm_ok(del) == 0 {
        return act_err(orm_db_exec(del), 500, orm_err_exec(del))
    }
    return act_no_content(orm_db_exec(del))
}
