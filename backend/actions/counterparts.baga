fn vies_anchor_der() -> bytes !IO {
    let f = env("BAGABUCH_VIES_ANCHOR_FILE")?
    if f != "" {
        if file_readable(f)? == 1 {
            let pem = read_file(f)?
            return pem_der_block(pem, "CERTIFICATE")
        }
    }
    return pem_der_block(vies_anchor_pem(), "CERTIFICATE")
}

// Една споделена точка за VIES заявката + JSON парсването на отговора.
fn vies_fetch(vat: str) -> ViesResult !IO !Net !Random {
    let cc = substr(vat, 0, 2)
    let num = substr(vat, 2, len(vat))
    let headers: Map<str, str> = map_new()
    map_set(headers, "user-agent", "bagabuch/0.1")
    let anchor = vies_anchor_der()?
    let resp = http_request_anchor("GET", vies_api_url(cc, num), headers, "", 15, anchor)?
    if resp.ok == 0 {
        return ViesResult { ok: 0, err: "VIES услугата е недостъпна (мрежова грешка)", valid: 0, name: "", address: "", user_error: "", request_date: "" }
    }
    if resp.status != 200 {
        return ViesResult { ok: 0, err: concat(concat("VIES върна статус ", int_to_str(resp.status)), " — опитайте пак"), valid: 0, name: "", address: "", user_error: "", request_date: "" }
    }
    let body = jbody_parse_str(resp.body)
    if body.ok == 0 {
        return ViesResult { ok: 0, err: "невалиден JSON отговор от VIES", valid: 0, name: "", address: "", user_error: "", request_date: "" }
    }
    let mut valid: i64 = 0
    let vf = jreq_bool(body.doc, body.root, "isValid")
    if vf.ok == 1 {
        valid = vf.num
    }
    return ViesResult {
        ok: 1,
        err: "",
        valid: valid,
        name: jopt_str(body.doc, body.root, "name", "").val,
        address: jopt_str(body.doc, body.root, "address", "").val,
        user_error: jopt_str(body.doc, body.root, "userError", "").val,
        request_date: jopt_str(body.doc, body.root, "requestDate", "").val
    }
}

// GET /v1/counterparts/vies-lookup?vat=BG123456789 — само справка, без запис.
fn act_counterparts_vies_lookup(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Random {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let vat = vies_normalize_vat(fmr_query(ctx, "vat"))
    if vies_vat_shape_ok(vat) == 0 {
        return act_err(db, 422, "vat трябва да е ЕС ДДС номер (напр. BG123456789)")
    }
    let mk = company_mistral_key(db, auth.ctx.user_sub)?
    let r = vies_fetch(vat)?
    if r.ok == 0 {
        return act_err(mk.db, 502, r.err)
    }
    let mut parts = addr_parts_empty()
    if mk.key != "" && r.address != "" && r.address != "---" {
        parts = mistral_parse_address(mk.key, r.address, substr(vat, 0, 2))?
    }
    let mut o = jobj_new()
    o = jobj_bool(o, "valid", r.valid)
    o = jobj_str(o, "name", r.name)
    o = jobj_str(o, "address", r.address)
    o = jobj_str(o, "vies_address", r.address)
    o = jobj_str(o, "street_name", parts.street_name)
    o = jobj_str(o, "building_number", parts.building_number)
    o = jobj_str(o, "city", parts.city)
    o = jobj_str(o, "post_code", parts.post_code)
    o = jobj_str(o, "region", parts.region)
    o = jobj_str(o, "user_error", r.user_error)
    o = jobj_str(o, "request_date", r.request_date)
    o = jobj_str(o, "vat_number", vat)
    o = jobj_str(o, "country_code", substr(vat, 0, 2))
    o = jobj_bool(o, "parse_ok", parts.ok)
    o = jobj_str(o, "parse_note", vies_parse_note(mk.key, parts))
    return act_ok(mk.db, o)
}

// POST /v1/counterparts/vies — създава контрагент от VIES данни.
// Дългият адрес отива в vies_address и address; split полетата — от Mistral.
fn act_counterparts_vies_create(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Random {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let vat_f = jreq_str(b.doc, b.root, "vat_number")
    if vat_f.ok == 0 {
        return act_422_field(db, "vat_number", vat_f)
    }
    let vat = vies_normalize_vat(vat_f.val)
    if vies_vat_shape_ok(vat) == 0 {
        return act_err(db, 422, "vat_number трябва да е ЕС ДДС номер (напр. BG123456789)")
    }
    let counterpart_type = jopt_str(b.doc, b.root, "counterpart_type", "both")
    if counterpart_type_ok(counterpart_type.val) == 0 {
        return act_err(db, 422, "counterpart_type трябва да е customer/supplier/both")
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let mk = company_mistral_key(db, auth.ctx.user_sub)?
    let r = vies_fetch(vat)?
    if r.ok == 0 {
        return act_err(mk.db, 502, r.err)
    }
    if r.valid == 0 {
        return act_err(mk.db, 422, "ДДС номерът не е намерен във VIES")
    }
    // name е NOT NULL; някои държави (DE) не връзат име/адрес → "---".
    let mut name = r.name
    if name == "" || name == "---" {
        name = concat("VIES ", vat)
    }
    let mut addr = r.address
    if addr == "---" {
        addr = ""
    }
    let cc = substr(vat, 0, 2)
    let mut eik = ""
    if cc == "BG" {
        eik = substr(vat, 2, len(vat))
    }
    let mut parts = addr_parts_empty()
    if mk.key != "" && addr != "" {
        parts = mistral_parse_address(mk.key, addr, cc)?
    }
    let mut city = parts.city
    let mut post = parts.post_code
    let mut country = cc
    if parts.country != "" {
        country = parts.country
    }
    let ins = counterpart_create(mk.db, name, counterpart_type.val, eik, vat, addr, addr, city, country, post, parts.street_name, parts.building_number, parts.region, "", "", "")?
    if orm_ok(ins) == 0 {
        return act_err(orm_db_exec(ins), 409, orm_err_exec(ins))
    }
    let q = counterpart_all(orm_db_exec(ins))?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_err(orm_db_q(q), 500, "insert ok but row missing")
    }
    return act_created(orm_db_q(q), counterpart_to_json(q, orm_nrows(q) - 1))
}
