// actions/production_confirm.baga — потвърждение: изписване на материали,
// заприхождаване на готова продукция, счетоводен запис.
// Дт 611 / Кт складова на материала; Дт складова на продукцията / Кт 611.

import "../models/production.baga"
import "../models/product.baga"
import "../models/account.baga"
import "../models/company.baga"
import "../models/journal.baga"
import "inventory.baga"
import "production.baga"
import "periods.baga"
import "txn.baga"
import "active_company.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "bagadecimal/src/decimal.baga"
import "std/str/str.baga"

fn mfg_resolve_acc(db: OrmDb, number: str, out_id: Vec<i64>) -> FmrOut !IO !Net {
    let q = account_by_number(db, number)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    if orm_nrows(q) < 1 {
        return act_err(orm_db_q(q), 422, concat("липсва сметка с номер ", number))
    }
    vec_push(out_id, orm_cell_by_i64(q, 0, "id"))
    return act_ok(orm_db_q(q), jobj_new())
}

fn mfg_post_jl(db: OrmDb, entry_id: i64, account_id: i64, direction: str, amount: str, product_id: i64, location_id: i64) -> InvResult !IO !Net {
    let li = journal_line_insert(db, entry_id, account_id, direction, amount, "0", 0, product_id, location_id)?
    if orm_ok(li) == 0 {
        return inv_err(orm_db_exec(li), orm_err_exec(li))
    }
    return inv_ok(orm_db_exec(li), "")
}

fn mfg_valuation(db: OrmDb) -> InvResult !IO !Net {
    let cq = company_all(db)?
    if orm_ok_q(cq) == 0 {
        return inv_err(orm_db_q(cq), orm_err_q(cq))
    }
    let mut method = "WAC"
    if orm_nrows(cq) > 0 {
        let m = orm_cell_by(cq, 0, "inventory_valuation_method")
        if m != "" {
            method = m
        }
    }
    return InvResult { ok: 1, err: "", db: orm_db_q(cq), cost: method }
}

fn act_pord_confirm(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    if ac.id <= 0 {
        return act_err(ac.db, 422, "няма избрана активна фирма")
    }
    let q = pord_find(ac.db, id)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 || orm_cell_by_i64(q, 0, "company_id") != ac.id {
        return act_404(orm_db_q(q), "Поръчката не е намерена")
    }
    if orm_cell_by(q, 0, "status") != "draft" {
        return act_err(orm_db_q(q), 409, "поръчката е вече завършена")
    }
    let order_date = orm_cell_by(q, 0, "order_date")
    let location_id = orm_cell_by_i64(q, 0, "location_id")
    let out_pid = orm_cell_by_i64(q, 0, "output_product_id")
    let out_qty = orm_cell_by(q, 0, "quantity")
    let number = orm_cell_by(q, 0, "number")
    if location_id <= 0 {
        return act_err(orm_db_q(q), 422, "нужен е складов обект")
    }
    if out_pid <= 0 {
        return act_err(orm_db_q(q), 422, "липсва изходен артикул")
    }
    let pc = period_assert_open(orm_db_q(q), order_date)?
    if pc.ok == 0 {
        return act_err(pc.db, 422, pc.err)
    }
    let vm = mfg_valuation(pc.db)?
    if vm.ok == 0 {
        return act_err(vm.db, 500, vm.err)
    }
    let method = vm.cost
    let lq = pline_by_order(vm.db, id)?
    if orm_ok_q(lq) == 0 {
        return act_err(orm_db_q(lq), 500, orm_err_q(lq))
    }
    if orm_nrows(lq) < 1 {
        return act_err(orm_db_q(lq), 422, "поръчката няма материали")
    }
    let a611 = vec_new()
    let r611 = mfg_resolve_acc(orm_db_q(lq), "611", a611)?
    let mut db2 = r611.db
    if vec_len(a611) == 0 {
        let r601 = mfg_resolve_acc(db2, "601", a611)?
        if vec_len(a611) == 0 {
            return r601
        }
        db2 = r601.db
    } else {
        db2 = r611.db
    }
    let acc_prod = vec_get(a611, 0)
    let bgn = bb_begin(db2)?
    if orm_ok(bgn) == 0 {
        return act_err(orm_db_exec(bgn), 500, orm_err_exec(bgn))
    }
    db2 = orm_db_exec(bgn)
    let desc = concat("Производство ", number)
    let eq = journal_entry_insert(db2, order_date, "production", id, desc, "no_vat", 0, "", "", number, order_date, "", "0", "0")?
    if orm_ok_q(eq) == 0 || orm_nrows(eq) < 1 {
        return act_err_rb(orm_db_q(eq), 500, "journal entry insert failed")
    }
    let entry_id = orm_cell_by_i64(eq, 0, "id")
    db2 = orm_db_q(eq)
    let mut total = dec_zero()
    let mut i: i64 = 0
    while i < orm_nrows(lq) {
        let pid = orm_cell_by_i64(lq, i, "product_id")
        let pname = orm_cell_by(lq, i, "product_name")
        let qty = orm_cell_by(lq, i, "quantity")
        let iss = inv_issue(db2, pid, qty, method, pname, location_id)?
        if iss.ok == 0 {
            return act_err_rb(iss.db, 422, iss.err)
        }
        db2 = iss.db
        let cost = iss.cost
        let add = dec_add(total, mfg_dec(cost))
        if add.ok == 1 {
            total = add.value
        }
        let pq = product_find(db2, pid)?
        if orm_ok_q(pq) == 0 {
            return act_err_rb(orm_db_q(pq), 500, orm_err_q(pq))
        }
        db2 = orm_db_q(pq)
        let mut inv_acc: i64 = 0
        if orm_nrows(pq) > 0 {
            inv_acc = orm_cell_by_i64(pq, 0, "inventory_account_id")
        }
        if inv_acc <= 0 {
            let a302 = vec_new()
            let r302 = mfg_resolve_acc(db2, "302", a302)?
            if vec_len(a302) == 0 {
                let r304 = mfg_resolve_acc(r302.db, "304", a302)?
                if vec_len(a302) == 0 {
                    return act_err_rb(r304.db, 422, "липсва складова сметка 302/304")
                }
                db2 = r304.db
            } else {
                db2 = r302.db
            }
            inv_acc = vec_get(a302, 0)
        }
        if dec_is_zero(mfg_dec(cost)) == 0 {
            let p1 = mfg_post_jl(db2, entry_id, acc_prod, "debit", cost, pid, location_id)?
            if p1.ok == 0 {
                return act_err_rb(p1.db, 500, p1.err)
            }
            db2 = p1.db
            let p2 = mfg_post_jl(db2, entry_id, inv_acc, "credit", cost, pid, location_id)?
            if p2.ok == 0 {
                return act_err_rb(p2.db, 500, p2.err)
            }
            db2 = p2.db
        }
        let lid = orm_cell_by_i64(lq, i, "id")
        let ucols = vec_new()
        vec_push(ucols, "amount")
        vec_push(ucols, "unit_cost")
        let uvals = vec_new()
        vec_push(uvals, cost)
        let mut uc = "0"
        if dec_is_zero(mfg_dec(qty)) == 0 {
            let d = dec_div(mfg_dec(cost), mfg_dec(qty))
            if d.ok == 1 {
                uc = dec_to_string(d.value)
            }
        }
        vec_push(uvals, uc)
        let upl = orm_update_by_id(db2, pline_table(), lid, ucols, uvals)?
        if orm_ok(upl) == 0 {
            return act_err_rb(orm_db_exec(upl), 500, orm_err_exec(upl))
        }
        db2 = orm_db_exec(upl)
        i = i + 1
    }
    let tot_s = inv_money(total)
    let mut unit_cost = "0"
    if dec_is_zero(mfg_dec(out_qty)) == 0 {
        let d = dec_div(total, mfg_dec(out_qty))
        if d.ok == 1 {
            unit_cost = dec_to_string(d.value)
        }
    }
    let rec = inv_receive(db2, out_pid, id, 0, order_date, out_qty, unit_cost, location_id)?
    if rec.ok == 0 {
        return act_err_rb(rec.db, 422, rec.err)
    }
    db2 = rec.db
    let opq = product_find(db2, out_pid)?
    if orm_ok_q(opq) == 0 {
        return act_err_rb(orm_db_q(opq), 500, orm_err_q(opq))
    }
    db2 = orm_db_q(opq)
    let mut out_acc: i64 = 0
    if orm_nrows(opq) > 0 {
        out_acc = orm_cell_by_i64(opq, 0, "inventory_account_id")
    }
    if out_acc <= 0 {
        let a303 = vec_new()
        let r303 = mfg_resolve_acc(db2, "303", a303)?
        if vec_len(a303) == 0 {
            let r304 = mfg_resolve_acc(r303.db, "304", a303)?
            if vec_len(a303) == 0 {
                return act_err_rb(r304.db, 422, "липсва складова сметка 303/304 за готовата продукция")
            }
            db2 = r304.db
        } else {
            db2 = r303.db
        }
        out_acc = vec_get(a303, 0)
    }
    if dec_is_zero(total) == 0 {
        let p3 = mfg_post_jl(db2, entry_id, out_acc, "debit", tot_s, out_pid, location_id)?
        if p3.ok == 0 {
            return act_err_rb(p3.db, 500, p3.err)
        }
        db2 = p3.db
        let p4 = mfg_post_jl(db2, entry_id, acc_prod, "credit", tot_s, out_pid, location_id)?
        if p4.ok == 0 {
            return act_err_rb(p4.db, 500, p4.err)
        }
        db2 = p4.db
    }
    let ocols = vec_new()
    vec_push(ocols, "status")
    vec_push(ocols, "material_cost")
    vec_push(ocols, "journal_entry_id")
    let ovals = vec_new()
    vec_push(ovals, "completed")
    vec_push(ovals, tot_s)
    vec_push(ovals, int_to_str(entry_id))
    let uo = orm_update_by_id(db2, pord_table(), id, ocols, ovals)?
    if orm_ok(uo) == 0 {
        return act_err_rb(orm_db_exec(uo), 500, orm_err_exec(uo))
    }
    let cmt = bb_commit(orm_db_exec(uo))?
    if orm_ok(cmt) == 0 {
        return act_err(orm_db_exec(cmt), 500, orm_err_exec(cmt))
    }
    let nq = pord_find(orm_db_exec(cmt), id)?
    let nlq = pline_by_order(orm_db_q(nq), id)?
    let mut o = pord_to_json(nq, 0)
    o = jobj_arr(o, "lines", pline_list_json(nlq))
    return act_ok(orm_db_q(nlq), o)
}
