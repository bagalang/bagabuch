// actions/internal_docs_confirm.baga — потвърждение (без дневник) и печат.

import "../models/internal_doc.baga"
import "../models/fixed_asset.baga"
import "../models/company_related.baga"
import "../models/company.baga"
import "../models/setting.baga"
import "../models/product.baga"
import "inventory.baga"
import "periods.baga"
import "txn.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "httpdbaga/http.baga"
import "xmlbaga/xml.baga"
import "reportbaga/report.baga"
import "std/str/str.baga"

fn idoc_loc_name(db: OrmDb, id: i64) -> str !IO !Net {
    if id <= 0 {
        return ""
    }
    let q = cloc_find(db, id)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return ""
    }
    return orm_cell_by(q, 0, "name")
}

fn act_idoc_confirm(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let q = idoc_find(db, id)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    if orm_nrows(q) < 1 {
        return act_404(orm_db_q(q), "Internal document not found")
    }
    if orm_cell_by(q, 0, "status") != "draft" {
        return act_err(orm_db_q(q), 409, "протоколът е вече потвърден")
    }
    let pc = period_assert_open(orm_db_q(q), orm_cell_by(q, 0, "doc_date"))?
    if pc.ok == 0 {
        return act_err(pc.db, 422, pc.err)
    }
    let from_id = orm_cell_by_i64(q, 0, "from_location_id")
    let to_id = orm_cell_by_i64(q, 0, "to_location_id")
    let doc_date = orm_cell_by(q, 0, "doc_date")
    if from_id == to_id || from_id <= 0 || to_id <= 0 {
        return act_err(orm_db_q(q), 422, "нужни са два различни активни обекта")
    }
    let mut db2 = pc.db
    let fq = cloc_find(db2, from_id)?
    if orm_ok_q(fq) == 0 || orm_nrows(fq) < 1 {
        return act_err(orm_db_q(fq), 422, "обектът-източник не е намерен")
    }
    if orm_cell_by_i64(fq, 0, "is_active") == 0 {
        return act_err(orm_db_q(fq), 422, "обектът-източник е неактивен")
    }
    let from_name = orm_cell_by(fq, 0, "name")
    db2 = orm_db_q(fq)
    let tq = cloc_find(db2, to_id)?
    if orm_ok_q(tq) == 0 || orm_nrows(tq) < 1 {
        return act_err(orm_db_q(tq), 422, "обектът-приемник не е намерен")
    }
    if orm_cell_by_i64(tq, 0, "is_active") == 0 {
        return act_err(orm_db_q(tq), 422, "обектът-приемник е неактивен")
    }
    let to_name = orm_cell_by(tq, 0, "name")
    db2 = orm_db_q(tq)
    let lq = idoc_lines_by_doc(db2, id)?
    if orm_ok_q(lq) == 0 {
        return act_err(orm_db_q(lq), 500, orm_err_q(lq))
    }
    if orm_nrows(lq) < 1 {
        return act_err(orm_db_q(lq), 422, "протоколът трябва да има поне един ред")
    }
    db2 = orm_db_q(lq)
    let bgn = bb_begin(db2)?
    if orm_ok(bgn) == 0 {
        return act_err(orm_db_exec(bgn), 500, orm_err_exec(bgn))
    }
    db2 = orm_db_exec(bgn)
    let n = orm_nrows(lq)
    let mut i: i64 = 0
    while i < n {
        let kind = orm_cell_by(lq, i, "line_kind")
        if kind == "product" {
            let pid = orm_cell_by_i64(lq, i, "product_id")
            let qty = orm_cell_by(lq, i, "quantity")
            let mut pname = orm_cell_by(lq, i, "description")
            if pname == "" {
                pname = int_to_str(pid)
            }
            let mv = inv_transfer(db2, pid, qty, from_id, to_id, doc_date, pname)?
            if mv.ok == 0 {
                return act_err_rb(mv.db, 422, mv.err)
            }
            db2 = mv.db
        } else {
            let aid = orm_cell_by_i64(lq, i, "asset_id")
            let aq = fa_find(db2, aid)?
            if orm_ok_q(aq) == 0 {
                return act_err_rb(orm_db_q(aq), 500, orm_err_q(aq))
            }
            if orm_nrows(aq) < 1 {
                return act_err_rb(orm_db_q(aq), 422, concat("ДМА не е намерено: ", int_to_str(aid)))
            }
            let cur = orm_cell_by_i64(aq, 0, "location_id")
            if cur != from_id && cur != 0 {
                return act_err_rb(orm_db_q(aq), 422, concat(orm_cell_by(aq, 0, "name"), " не е в обекта-източник"))
            }
            db2 = orm_db_q(aq)
            let reason = concat(concat("протокол ", orm_cell_by(q, 0, "number")), concat(": ", concat(from_name, concat(" → ", to_name))))
            let ev = fae_create(db2, aid, "movement", doc_date, "", "", to_name, reason)?
            if orm_ok(ev) == 0 {
                return act_err_rb(orm_db_exec(ev), 500, orm_err_exec(ev))
            }
            db2 = orm_db_exec(ev)
            let cols = vec_new()
            vec_push(cols, "location_id")
            let vals = vec_new()
            vec_push(vals, int_to_str(to_id))
            let up = orm_update_by_id(db2, fa_table(), aid, cols, vals)?
            if orm_ok(up) == 0 {
                return act_err_rb(orm_db_exec(up), 500, orm_err_exec(up))
            }
            db2 = orm_db_exec(up)
        }
        i = i + 1
    }
    let scols = vec_new()
    vec_push(scols, "status")
    let svals = vec_new()
    vec_push(svals, "confirmed")
    let su = orm_update_by_id(db2, idoc_table(), id, scols, svals)?
    if orm_ok(su) == 0 {
        return act_err_rb(orm_db_exec(su), 500, orm_err_exec(su))
    }
    db2 = orm_db_exec(su)
    let cmt = bb_commit(db2)?
    if orm_ok(cmt) == 0 {
        return act_err_rb(orm_db_exec(cmt), 500, orm_err_exec(cmt))
    }
    db2 = orm_db_exec(cmt)
    let q2 = idoc_find(db2, id)?
    let mut o = idoc_to_json(q2, 0)
    let l2 = idoc_lines_by_doc(orm_db_q(q2), id)?
    o = jobj_arr(o, "lines", idoc_lines_list_json(l2))
    return act_ok(orm_db_q(l2), o)
}

fn idoc_h(s: str) -> str {
    return xml_escape_text(s)
}

fn act_idoc_print(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    let mut format = fmr_query(ctx, "format")
    if format == "" {
        format = "pdf"
    }
    if format != "pdf" && format != "docx" && format != "odt" {
        return act_err(db, 422, "format трябва да е pdf/docx/odt")
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let q = idoc_find(db, id)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_404(orm_db_q(q), "Internal document not found")
    }
    let number = orm_cell_by(q, 0, "number")
    let doc_date = orm_cell_by(q, 0, "doc_date")
    let from_id = orm_cell_by_i64(q, 0, "from_location_id")
    let to_id = orm_cell_by_i64(q, 0, "to_location_id")
    let notes = orm_cell_by(q, 0, "notes")
    let handed_by = orm_cell_by(q, 0, "handed_by")
    let received_by = orm_cell_by(q, 0, "received_by")
    let mut d = orm_db_q(q)
    let mut from_name = ""
    if from_id > 0 {
        let fnq = cloc_find(d, from_id)?
        if orm_ok_q(fnq) == 1 && orm_nrows(fnq) > 0 {
            from_name = orm_cell_by(fnq, 0, "name")
        }
        d = orm_db_q(fnq)
    }
    let mut to_name = ""
    if to_id > 0 {
        let tnq = cloc_find(d, to_id)?
        if orm_ok_q(tnq) == 1 && orm_nrows(tnq) > 0 {
            to_name = orm_cell_by(tnq, 0, "name")
        }
        d = orm_db_q(tnq)
    }
    let lq = idoc_lines_by_doc(d, id)?
    if orm_ok_q(lq) == 0 {
        return act_err(orm_db_q(lq), 500, orm_err_q(lq))
    }
    d = orm_db_q(lq)
    let mut co_name = ""
    let key = concat("активна_фирма:", auth.ctx.user_sub)
    let sq = setting_get_by_key(d, key)?
    if orm_ok_q(sq) == 1 && orm_nrows(sq) > 0 {
        let coid = parse_int(orm_cell_by(sq, 0, "value"))
        d = orm_db_q(sq)
        if coid > 0 {
            let coq = company_find(d, coid)?
            if orm_ok_q(coq) == 1 && orm_nrows(coq) > 0 {
                co_name = orm_cell_by(coq, 0, "name")
                d = orm_db_q(coq)
            }
        }
    }
    let mut html = "<html><head><meta charset=\"utf-8\"/><title>Приемо-предавателен протокол</title></head><body>"
    html = concat(html, concat("<h1>", concat(idoc_h(co_name), "</h1>")))
    html = concat(html, "<h2>ПРИЕМО-ПРЕДАВАТЕЛЕН ПРОТОКОЛ</h2>")
    html = concat(html, concat("<p>№ ", concat(idoc_h(number), concat(" · дата ", concat(idoc_h(doc_date), "</p>")))))
    html = concat(html, concat("<p>От обект: <strong>", concat(idoc_h(from_name), "</strong></p>")))
    html = concat(html, concat("<p>Към обект: <strong>", concat(idoc_h(to_name), "</strong></p>")))
    html = concat(html, "<table><tr><th>№</th><th>Вид</th><th>Наименование</th><th>К-во</th><th>Себестойност</th><th>Сума</th></tr>")
    let mut i: i64 = 0
    while i < orm_nrows(lq) {
        let kind = orm_cell_by(lq, i, "line_kind")
        let mut klabel = "Артикул"
        if kind == "fixed_asset" {
            klabel = "ДМА"
        }
        html = concat(html, "<tr>")
        html = concat(html, concat("<td>", concat(int_to_str(i + 1), "</td>")))
        html = concat(html, concat("<td>", concat(idoc_h(klabel), "</td>")))
        html = concat(html, concat("<td>", concat(idoc_h(orm_cell_by(lq, i, "description")), "</td>")))
        html = concat(html, concat("<td>", concat(idoc_h(orm_cell_by(lq, i, "quantity")), "</td>")))
        html = concat(html, concat("<td>", concat(idoc_h(orm_cell_by(lq, i, "unit_cost")), "</td>")))
        html = concat(html, concat("<td>", concat(idoc_h(orm_cell_by(lq, i, "amount")), "</td>")))
        html = concat(html, "</tr>")
        i = i + 1
    }
    html = concat(html, "</table>")
    if notes != "" {
        html = concat(html, concat("<p>Забележка: ", concat(idoc_h(notes), "</p>")))
    }
    html = concat(html, concat("<p>Предал: ", concat(idoc_h(handed_by), " _______________</p>")))
    html = concat(html, concat("<p>Приел: ", concat(idoc_h(received_by), " _______________</p>")))
    html = concat(html, "</body></html>")
    let fname = concat(concat("protokol-", number), concat(".", format))
    let out = report_from_html_io(html, format)?
    if out.ok == 0 {
        return act_err(d, 500, out.err)
    }
    let mut r = http_response_bytes(200, out.data)
    r = http_set_header(r, "Content-Type", "application/pdf")
    if format == "docx" {
        r = http_set_header(r, "Content-Type", "application/vnd.openxmlformats-officedocument.wordprocessingml.document")
    }
    if format == "odt" {
        r = http_set_header(r, "Content-Type", "application/vnd.oasis.opendocument.text")
    }
    r = http_set_header(r, "Content-Disposition", concat(concat("attachment; filename=\"", fname), "\""))
    return fmr_out(r, d)
}
