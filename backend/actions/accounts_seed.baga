// actions/accounts_seed.baga — двоен сметкоплан на НАП (NRA_Nom_Accounts)
// в таблица accounts. Липсващите кодове се добавят; съществуващите се пропускат.
// Сметкопланът е общ (няма company_id). Първата фирма пълни 360 сметки.

import "../models/account.baga"
import "../models/saft_nom.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "std/str/str.baga"

struct AccountSeed {
    db: OrmDb,
    created: i64,
    skipped: i64,
    ok: i64,
    err: str
}

fn account_seed_fail(db: OrmDb, err: str) -> AccountSeed {
    return AccountSeed { db: db, created: 0, skipped: 0, ok: 0, err: err }
}

fn account_seed_has(nums: Vec<str>, number: str) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(nums) {
        if vec_get(nums, i) == number {
            return 1
        }
        i = i + 1
    }
    return 0
}

fn account_seed_from_saft(db: OrmDb) -> AccountSeed !IO !Net {
    let q = account_all(db)?
    if orm_ok_q(q) == 0 {
        return account_seed_fail(orm_db_q(q), orm_err_q(q))
    }
    let mut nums: Vec<str> = vec_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        vec_push(nums, orm_cell_by(q, i, "number"))
        i = i + 1
    }
    let mut d = orm_db_q(q)
    let catalog = saft_nra_account_rows()
    let mut created: i64 = 0
    let mut skipped: i64 = 0
    i = 0
    while i < vec_len(catalog) {
        let line = vec_get(catalog, i)
        let p = str_split(line, "|")
        let code = saft_nom_at(p, 0)
        let name = saft_nom_at(p, 1)
        if code == "" {
            i = i + 1
            continue
        }
        if account_seed_has(nums, code) == 1 {
            skipped = skipped + 1
        } else {
            let ins = account_create(d, code, name, code, "none", 0, 1)?
            if orm_ok_q(ins) == 0 {
                return account_seed_fail(orm_db_q(ins), orm_err_q(ins))
            }
            d = orm_db_q(ins)
            vec_push(nums, code)
            created = created + 1
        }
        i = i + 1
    }
    return AccountSeed { db: d, created: created, skipped: skipped, ok: 1, err: "" }
}

fn account_seed_json(s: AccountSeed) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "created", s.created)
    o = jobj_i64(o, "skipped", s.skipped)
    o = jobj_i64(o, "total", s.created + s.skipped)
    return o
}

fn act_accounts_seed_saft(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let s = account_seed_from_saft(db)?
    if s.ok == 0 {
        return act_err(s.db, 500, s.err)
    }
    return act_ok(s.db, account_seed_json(s))
}
