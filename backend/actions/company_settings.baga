// actions/company_settings.baga — настройки на активната фирма за SAF-T BG:
// GET пакет (фирма + обекти + собственици + майки) и CRUD по свързаните таблици.

import "../models/company.baga"
import "../models/company_related.baga"
import "../models/document_series.baga"
import "../models/invoice.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"

fn act_company_settings_get(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let q = company_find(db, id)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    if orm_nrows(q) < 1 {
        return act_404(orm_db_q(q), "Company not found")
    }
    let mut o = jobj_new()
    o = jobj_obj(o, "company", company_to_json(q, 0))
    let mut d = orm_db_q(q)
    let lq = cloc_by_company(d, id)?
    if orm_ok_q(lq) == 0 {
        return act_err(orm_db_q(lq), 500, orm_err_q(lq))
    }
    o = jobj_arr(o, "locations", rel_filter_active(lq, "cloc"))
    d = orm_db_q(lq)
    let oq = bown_by_company(d, id)?
    if orm_ok_q(oq) == 0 {
        return act_err(orm_db_q(oq), 500, orm_err_q(oq))
    }
    o = jobj_arr(o, "beneficial_owners", rel_filter_active(oq, "bown"))
    d = orm_db_q(oq)
    let pq = upar_by_company(d, id)?
    if orm_ok_q(pq) == 0 {
        return act_err(orm_db_q(pq), 500, orm_err_q(pq))
    }
    o = jobj_arr(o, "ultimate_parents", rel_filter_active(pq, "upar"))
    d = orm_db_q(pq)
    let sq = dser_by_company(d, id)?
    if orm_ok_q(sq) == 0 {
        return act_err(orm_db_q(sq), 500, orm_err_q(sq))
    }
    d = orm_db_q(sq)
    let nq = invoice_numbers_by_type(d)?
    if orm_ok_q(nq) == 0 {
        return act_err(orm_db_q(nq), 500, orm_err_q(nq))
    }
    o = jobj_arr(o, "document_series", dser_active_list(sq, nq))
    return act_ok(orm_db_q(nq), o)
}

fn act_cloc_create(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let company_id = fmr_param_i64(ctx, "id")
    if company_id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let name = jreq_str(b.doc, b.root, "name")
    if name.ok == 0 {
        return act_422_field(db, "name", name)
    }
    let location_type = jopt_str(b.doc, b.root, "location_type", "OFFICE")
    if cloc_type_ok(location_type.val) == 0 {
        return act_err(db, 422, "location_type трябва да е OFFICE/STORE/WAREHOUSE/BRANCH/OTHER")
    }
    let street_name = jopt_str(b.doc, b.root, "street_name", "")
    let building_number = jopt_str(b.doc, b.root, "building_number", "")
    let city = jopt_str(b.doc, b.root, "city", "")
    let post_code = jopt_str(b.doc, b.root, "post_code", "")
    let region = jopt_str(b.doc, b.root, "region", "")
    let country = jopt_str(b.doc, b.root, "country", "BG")
    let im = jreq_bool(b.doc, b.root, "is_main")
    let mut is_main: i64 = 0
    if im.present == 1 {
        if im.ok == 0 {
            return act_422_field(db, "is_main", im)
        }
        is_main = im.num
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let cq = company_find(db, company_id)?
    if orm_ok_q(cq) == 0 {
        return act_err(orm_db_q(cq), 500, orm_err_q(cq))
    }
    if orm_nrows(cq) < 1 {
        return act_404(orm_db_q(cq), "Company not found")
    }
    let ins = cloc_create(orm_db_q(cq), company_id, name.val, location_type.val, street_name.val, building_number.val, city.val, post_code.val, region.val, country.val, is_main)?
    if orm_ok(ins) == 0 {
        return act_err(orm_db_exec(ins), 409, orm_err_exec(ins))
    }
    let q = cloc_by_company(orm_db_exec(ins), company_id)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_err(orm_db_q(q), 500, "insert ok but row missing")
    }
    return act_created(orm_db_q(q), cloc_to_json(q, orm_nrows(q) - 1))
}

fn act_cloc_update(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let cols = vec_new()
    let vals = vec_new()
    let name = jreq_str(b.doc, b.root, "name")
    if name.present == 1 {
        if name.ok == 0 { return act_422_field(db, "name", name) }
        vec_push(cols, "name")
        vec_push(vals, name.val)
    }
    let location_type = jreq_str(b.doc, b.root, "location_type")
    if location_type.present == 1 {
        if location_type.ok == 0 { return act_422_field(db, "location_type", location_type) }
        if cloc_type_ok(location_type.val) == 0 {
            return act_err(db, 422, "location_type трябва да е OFFICE/STORE/WAREHOUSE/BRANCH/OTHER")
        }
        vec_push(cols, "location_type")
        vec_push(vals, location_type.val)
    }
    let street_name = jreq_str(b.doc, b.root, "street_name")
    if street_name.present == 1 {
        if street_name.ok == 0 { return act_422_field(db, "street_name", street_name) }
        vec_push(cols, "street_name")
        vec_push(vals, street_name.val)
    }
    let building_number = jreq_str(b.doc, b.root, "building_number")
    if building_number.present == 1 {
        if building_number.ok == 0 { return act_422_field(db, "building_number", building_number) }
        vec_push(cols, "building_number")
        vec_push(vals, building_number.val)
    }
    let city = jreq_str(b.doc, b.root, "city")
    if city.present == 1 {
        if city.ok == 0 { return act_422_field(db, "city", city) }
        vec_push(cols, "city")
        vec_push(vals, city.val)
    }
    let post_code = jreq_str(b.doc, b.root, "post_code")
    if post_code.present == 1 {
        if post_code.ok == 0 { return act_422_field(db, "post_code", post_code) }
        vec_push(cols, "post_code")
        vec_push(vals, post_code.val)
    }
    let region = jreq_str(b.doc, b.root, "region")
    if region.present == 1 {
        if region.ok == 0 { return act_422_field(db, "region", region) }
        vec_push(cols, "region")
        vec_push(vals, region.val)
    }
    let country = jreq_str(b.doc, b.root, "country")
    if country.present == 1 {
        if country.ok == 0 { return act_422_field(db, "country", country) }
        vec_push(cols, "country")
        vec_push(vals, country.val)
    }
    let im = jreq_bool(b.doc, b.root, "is_main")
    if im.present == 1 {
        if im.ok == 0 { return act_422_field(db, "is_main", im) }
        vec_push(cols, "is_main")
        vec_push(vals, int_to_str(im.num))
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    if vec_len(cols) == 0 {
        let q0 = cloc_find(db, id)?
        if orm_ok_q(q0) == 0 { return act_err(orm_db_q(q0), 500, orm_err_q(q0)) }
        if orm_nrows(q0) < 1 { return act_404(orm_db_q(q0), "Location not found") }
        return act_ok(orm_db_q(q0), cloc_to_json(q0, 0))
    }
    let upd = orm_update_by_id(db, cloc_table(), id, cols, vals)?
    if orm_ok(upd) == 0 {
        return act_err(orm_db_exec(upd), 500, orm_err_exec(upd))
    }
    let q = cloc_find(orm_db_exec(upd), id)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_404(orm_db_q(q), "Location not found")
    }
    return act_ok(orm_db_q(q), cloc_to_json(q, 0))
}

fn act_cloc_delete(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let q = cloc_find(db, id)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    if orm_nrows(q) < 1 {
        return act_404(orm_db_q(q), "Location not found")
    }
    let del = cloc_soft_delete(orm_db_q(q), id)?
    if orm_ok(del) == 0 {
        return act_err(orm_db_exec(del), 500, orm_err_exec(del))
    }
    return act_no_content(orm_db_exec(del))
}

fn act_bown_create(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let company_id = fmr_param_i64(ctx, "id")
    if company_id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let first_name_bg = jreq_str(b.doc, b.root, "first_name_bg")
    if first_name_bg.ok == 0 {
        return act_422_field(db, "first_name_bg", first_name_bg)
    }
    let last_name_bg = jreq_str(b.doc, b.root, "last_name_bg")
    if last_name_bg.ok == 0 {
        return act_422_field(db, "last_name_bg", last_name_bg)
    }
    let egn = jopt_str(b.doc, b.root, "egn", "")
    let first_name_latin = jopt_str(b.doc, b.root, "first_name_latin", "")
    let last_name_latin = jopt_str(b.doc, b.root, "last_name_latin", "")
    let country = jopt_str(b.doc, b.root, "country", "BG")
    let perc = jopt_str(b.doc, b.root, "ownership_percentage", "0")
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let cq = company_find(db, company_id)?
    if orm_ok_q(cq) == 0 {
        return act_err(orm_db_q(cq), 500, orm_err_q(cq))
    }
    if orm_nrows(cq) < 1 {
        return act_404(orm_db_q(cq), "Company not found")
    }
    let ins = bown_create(orm_db_q(cq), company_id, first_name_bg.val, last_name_bg.val, egn.val, first_name_latin.val, last_name_latin.val, country.val, perc.val)?
    if orm_ok(ins) == 0 {
        return act_err(orm_db_exec(ins), 409, orm_err_exec(ins))
    }
    let q = bown_by_company(orm_db_exec(ins), company_id)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_err(orm_db_q(q), 500, "insert ok but row missing")
    }
    return act_created(orm_db_q(q), bown_to_json(q, orm_nrows(q) - 1))
}

