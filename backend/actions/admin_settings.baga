// actions/admin_settings.baga — глобални настройки + SMTP/S3 през Python sidecar.

import "../models/setting.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "std/json/json.baga"
import "std/json/json_write.baga"
import "std/net/http_client.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn sidecar_url() -> str !IO {
    let u = env("BAGABUCH_SIDECAR")?
    if u != "" {
        return u
    }
    return "http://127.0.0.1:5050"
}

fn sidecar_post(path: str, body: str) -> HttpResponse !IO !Net !Random {
    let url = concat(sidecar_url()?, path)
    let headers: Map<str, str> = map_new()
    map_set(headers, "content-type", "application/json")
    return http_request("POST", url, headers, body, 60)?
}

fn sidecar_down(db: OrmDb) -> FmrOut {
    return act_err(db, 503, "Python sidecar не отговаря (:5050). pip install -r scripts/py/requirements.txt && python3 scripts/py/sidecar.py")
}

fn sidecar_result(db: OrmDb, resp: HttpResponse) -> FmrOut {
    if resp.ok == 0 {
        return sidecar_down(db)
    }
    let parsed = jbody_parse_str(resp.body)
    if parsed.ok == 0 {
        return act_err(db, 502, concat("sidecar: ", resp.body))
    }
    let mut o = jobj_new()
    let suc = json_get(parsed.doc, parsed.root, "success")
    let mut ok: i64 = 0
    if suc >= 0 && json_tag(parsed.doc, suc) == 2 {
        ok = 1
    }
    let msg = jopt_str(parsed.doc, parsed.root, "message", "").val
    o = jobj_i64(o, "ok", ok)
    o = jobj_str(o, "message", msg)
    let items = json_get(parsed.doc, parsed.root, "items")
    if items >= 0 {
        o = jobj_raw(o, "items", json_serialize(parsed.doc, items))
    }
    let fnm = jopt_str(parsed.doc, parsed.root, "filename", "").val
    if fnm != "" {
        o = jobj_str(o, "filename", fnm)
    }
    if ok == 0 {
        return act_err(db, 400, msg)
    }
    return act_ok(db, o)
}

fn act_system_settings_get(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let q = setting_all(db)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    return act_ok(orm_db_q(q), setting_list_json(q))
}

fn act_system_settings_put(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let items = json_get(b.doc, b.root, "items")
    if items < 0 || json_tag(b.doc, items) != 5 {
        return act_err(db, 400, "items е задължителен масив")
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let mut d = db
    let n = json_count(b.doc, items)
    let mut i: i64 = 0
    while i < n {
        let el = json_at(b.doc, items, i)
        let key = str_trim(jopt_str(b.doc, el, "key", "").val)
        let val = jopt_str(b.doc, el, "value", "").val
        if key != "" {
            let up = setting_set_by_key(d, key, val)?
            if orm_ok(up) == 0 {
                return act_err(orm_db_exec(up), 500, orm_err_exec(up))
            }
            d = orm_db_exec(up)
        }
        i = i + 1
    }
    let q = setting_all(d)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    return act_ok(orm_db_q(q), setting_list_json(q))
}

fn smtp_cfg_from_settings(q: OrmQuery) -> JObj {
    let mut cfg = jobj_new()
    cfg = jobj_str(cfg, "host", setting_map_get(q, "smtp.host"))
    let port = parse_int(setting_map_get(q, "smtp.port"))
    if port <= 0 {
        cfg = jobj_i64(cfg, "port", 587)
    } else {
        cfg = jobj_i64(cfg, "port", port)
    }
    cfg = jobj_str(cfg, "username", setting_map_get(q, "smtp.username"))
    cfg = jobj_str(cfg, "password", setting_map_get(q, "smtp.password"))
    cfg = jobj_str(cfg, "from_email", setting_map_get(q, "smtp.from_email"))
    cfg = jobj_str(cfg, "from_name", setting_map_get(q, "smtp.from_name"))
    let tls = setting_map_get(q, "smtp.use_tls")
    if tls == "0" || tls == "false" {
        cfg = jobj_i64(cfg, "use_tls", 0)
    } else {
        cfg = jobj_i64(cfg, "use_tls", 1)
    }
    return cfg
}

fn s3_cfg_from_settings(q: OrmQuery) -> JObj {
    let mut cfg = jobj_new()
    cfg = jobj_str(cfg, "endpoint", setting_map_get(q, "s3.endpoint"))
    cfg = jobj_str(cfg, "bucket", setting_map_get(q, "s3.bucket"))
    cfg = jobj_str(cfg, "access_key", setting_map_get(q, "s3.access_key"))
    cfg = jobj_str(cfg, "secret_key", setting_map_get(q, "s3.secret_key"))
    let region = setting_map_get(q, "s3.region")
    if region == "" {
        cfg = jobj_str(cfg, "region", "us-east-1")
    } else {
        cfg = jobj_str(cfg, "region", region)
    }
    let prefix = setting_map_get(q, "s3.prefix")
    if prefix == "" {
        cfg = jobj_str(cfg, "prefix", "backups/")
    } else {
        cfg = jobj_str(cfg, "prefix", prefix)
    }
    return cfg
}

fn act_smtp_test(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Random {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let to = jreq_str(b.doc, b.root, "to")
    if to.ok == 0 {
        return act_422_field(db, "to", to)
    }
    let q = setting_all(db)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    let mut payload = jobj_new()
    payload = jobj_raw(payload, "smtp_config", jobj_encode(smtp_cfg_from_settings(q)))
    payload = jobj_str(payload, "to", to.val)
    let app_name = setting_map_get(q, "app.name")
    if app_name == "" {
        payload = jobj_str(payload, "app_name", "bagabuch")
    } else {
        payload = jobj_str(payload, "app_name", app_name)
    }
    let resp = sidecar_post("/smtp/test", jobj_encode(payload))?
    return sidecar_result(orm_db_q(q), resp)
}

fn act_s3_test(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Random {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let q = setting_all(db)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    let resp = sidecar_post("/s3/test", jobj_encode(s3_cfg_from_settings(q)))?
    return sidecar_result(orm_db_q(q), resp)
}

fn act_s3_backup(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Random {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let q = setting_all(db)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    let mut cfg = s3_cfg_from_settings(q)
    let db_path = env("BOILA_PATH")?
    cfg = jobj_str(cfg, "db_path", db_path)
    let resp = sidecar_post("/s3/backup", jobj_encode(cfg))?
    return sidecar_result(orm_db_q(q), resp)
}

fn act_s3_list(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Random {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let q = setting_all(db)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    let resp = sidecar_post("/s3/list", jobj_encode(s3_cfg_from_settings(q)))?
    return sidecar_result(orm_db_q(q), resp)
}

fn act_s3_delete(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Random {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let key = jreq_str(b.doc, b.root, "s3_key")
    if key.ok == 0 {
        return act_422_field(db, "s3_key", key)
    }
    let q = setting_all(db)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    let mut cfg = s3_cfg_from_settings(q)
    cfg = jobj_str(cfg, "s3_key", key.val)
    let resp = sidecar_post("/s3/delete", jobj_encode(cfg))?
    return sidecar_result(orm_db_q(q), resp)
}
