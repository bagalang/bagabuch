// actions/reports.baga — JSON справки и файл PDF/XLSX/ODS през reportbaga.
// Същият път като печата на фактури: XHTML таблица → report_from_html_io.

import "../models/journal.baga"
import "../models/account.baga"
import "../models/opening_balance.baga"
import "../models/company.baga"
import "../models/fs_formula_store.baga"
import "reports_util.baga"
import "acl.baga"
import "active_company.baga"
import "reports_trial.baga"
import "reports_book.baga"
import "reports_corr.baga"
import "reports_fs.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "httpdbaga/http.baga"
import "reportbaga/report.baga"
import "std/str/str.baga"

fn rpt_file_resp(db: OrmDb, data: bytes, mime: str, filename: str) -> FmrOut {
    let mut r = http_response_bytes(200, data)
    r = http_set_header(r, "Content-Type", mime)
    r = http_set_header(r, "Content-Disposition", concat(concat("attachment; filename=\"", filename), "\""))
    return fmr_out(r, db)
}

fn rpt_empty() -> RptBuilt {
    return RptBuilt { body: jobj_new(), html: "", title: "", slug: "" }
}

fn rpt_run(kind: str, aq: OrmQuery, obq: OrmQuery, jq: OrmQuery, lq: OrmQuery, from: str, to: str, account: str, cpid: i64, firm: str) -> RptBuilt {
    if kind == "trial_balance" {
        return rpt_trial_build(kind, aq, obq, jq, lq, from, to, account, 0, firm)
    }
    if kind == "counterpart_trial" {
        return rpt_trial_build(kind, aq, obq, jq, lq, from, to, account, cpid, firm)
    }
    if kind == "chronological" {
        return rpt_chrono_build(kind, aq, jq, lq, from, to, account, 0, firm)
    }
    if kind == "counterpart_chrono" {
        return rpt_chrono_build(kind, aq, jq, lq, from, to, account, cpid, firm)
    }
    if kind == "general_ledger" {
        return rpt_gl_build(kind, aq, obq, jq, lq, from, to, account, 0, firm)
    }
    if kind == "correspondence_ledger" {
        return rpt_corr_build(kind, aq, obq, jq, lq, from, to, account, firm)
    }
    return rpt_empty()
}

fn rpt_prepare(ctx: FmrCtx, db: OrmDb, want_file: i64) -> FmrOut !IO !Net {
    let auth = act_require_perm(ctx, db, "report:read")?
    if auth.ok == 0 {
        return auth.out
    }
    let mut kind = fmr_query(ctx, "kind")
    if kind == "" {
        kind = "trial_balance"
    }
    if rpt_kind_ok(kind) == 0 {
        return act_err(db, 400, "непознат kind")
    }
    let from = rpt_day(fmr_query(ctx, "from"))
    let to = rpt_day(fmr_query(ctx, "to"))
    if rpt_date_ok(from) == 0 || rpt_date_ok(to) == 0 {
        return act_err(db, 400, "from и to са задължителни (YYYY-MM-DD)")
    }
    if rpt_from_after_to(from, to) == 1 {
        return act_err(db, 400, "from трябва да е преди to")
    }
    let account = fmr_query(ctx, "account")
    let cpid = parse_int(fmr_query(ctx, "counterpart_id"))
    if kind == "counterpart_trial" || kind == "counterpart_chrono" {
        if cpid <= 0 {
            return act_err(db, 400, "counterpart_id е задължителен")
        }
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    let mut firm_name = ""
    let mut firm_eik = ""
    let mut d0 = ac.db
    if ac.id > 0 {
        let cq = company_find(d0, ac.id)?
        if orm_ok_q(cq) == 0 {
            return act_err(orm_db_q(cq), 500, orm_err_q(cq))
        }
        d0 = orm_db_q(cq)
        if orm_nrows(cq) > 0 {
            firm_name = orm_cell_by(cq, 0, "name")
            firm_eik = orm_cell_by(cq, 0, "eik")
        }
    }
    let firm = rpt_firm_line(firm_name, firm_eik)
    let year = parse_int(substr(from, 0, 4))
    let aq = account_all(d0)?
    if orm_ok_q(aq) == 0 {
        return act_err(orm_db_q(aq), 500, orm_err_q(aq))
    }
    let obq = ob_by_year(orm_db_q(aq), year)?
    if orm_ok_q(obq) == 0 {
        return act_err(orm_db_q(obq), 500, orm_err_q(obq))
    }
    let jq = journal_all_dated(orm_db_q(obq))?
    if orm_ok_q(jq) == 0 {
        return act_err(orm_db_q(jq), 500, orm_err_q(jq))
    }
    let lq = journal_lines_all(orm_db_q(jq))?
    if orm_ok_q(lq) == 0 {
        return act_err(orm_db_q(lq), 500, orm_err_q(lq))
    }
    let mut fmap: Map<str, str> = map_new()
    let mut d1 = orm_db_q(lq)
    if kind == "balance_sheet" || kind == "income_statement" || kind == "cash_flow" || kind == "equity" {
        if ac.id > 0 {
            let fq = fsf_by_company(d1, ac.id)?
            if orm_ok_q(fq) == 0 {
                return act_err(orm_db_q(fq), 500, orm_err_q(fq))
            }
            let want = fs_kind_to_rpt(kind)
            let mut fi: i64 = 0
            while fi < orm_nrows(fq) {
                if orm_cell_by(fq, fi, "statement") == want {
                    map_set(fmap, orm_cell_by(fq, fi, "line_code"), orm_cell_by(fq, fi, "formula"))
                }
                fi = fi + 1
            }
            d1 = orm_db_q(fq)
        }
    }
    let mut built = rpt_empty()
    if kind == "balance_sheet" || kind == "income_statement" || kind == "cash_flow" || kind == "equity" {
        built = rpt_fs_build(kind, aq, obq, jq, lq, fmap, from, to, firm)
    } else {
        built = rpt_run(kind, aq, obq, jq, lq, from, to, account, cpid, firm)
    }
    let mut body = built.body
    body = jobj_str(body, "company_name", firm_name)
    body = jobj_str(body, "company_eik", firm_eik)
    if want_file == 0 {
        return act_ok(d1, body)
    }
    let format = fmr_query(ctx, "format")
    if rpt_format_ok(format) == 0 {
        return act_err(d1, 400, "format трябва да е pdf, xlsx или ods")
    }
    let mut html = built.html
    if format == "xlsx" || format == "ods" {
        html = rpt_html_firm_row(html, firm)
    }
    let out = report_from_html_io(html, format)?
    if out.ok == 0 {
        return act_err(d1, 500, out.err)
    }
    let mut fname = built.slug
    if firm_name != "" {
        fname = concat(concat(fname, "-"), str_replace(firm_name, " ", "_"))
    }
    if firm_eik != "" {
        fname = concat(concat(fname, "-"), firm_eik)
    }
    fname = concat(concat(fname, "-"), concat(from, concat("-", to)))
    fname = concat(fname, concat(".", format))
    return rpt_file_resp(d1, out.data, rpt_mime(format), fname)
}

fn act_reports(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    return rpt_prepare(ctx, db, 0)?
}

fn act_reports_export(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    return rpt_prepare(ctx, db, 1)?
}
