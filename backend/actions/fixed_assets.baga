}

// ---------- амортизация ----------

// Месечна амортизация на един актив (счетоводна). Връща десетичен стринг.
fn dep_monthly(cost: Decimal, salvage: Decimal, accumulated: Decimal, rate: Decimal, method: str) -> DecResult {
    // база: линеен → (цена − остатъчна); намаляващ → (цена − натрупана)
    let mut base = dec_sub(cost, salvage)
    if method == "declining" {
        base = dec_sub(cost, accumulated)
    }
    if base.ok == 0 {
        return base
    }
    if dec_is_negative(base.value) == 1 {
        return dec_ok(dec_zero())
    }
    // месечна = база * норма / 100 / 12
    let pct = dec_div(rate, dec_from_i64(100))
    if pct.ok == 0 {
        return pct
    }
    let amt = dec_mul(base.value, pct.value)
    if amt.ok == 0 {
        return amt
    }
    let monthly = dec_div(amt.value, dec_from_i64(12))
    if monthly.ok == 0 {
        return monthly
    }
    return dec_round_dp(monthly.value, 2)
}

fn act_fa_depreciation_preview(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let q = fa_all(db)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    let mut arr = jarr_new()
    let mut total = dec_zero()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        let status = orm_cell_by(q, i, "status")
        let conserved = orm_cell_by_i64(q, i, "is_conserved")
        if status == "active" && conserved == 0 {
            let cost = dec_parse(orm_cell_by(q, i, "cost"))
            let salvage = dec_parse(orm_cell_by(q, i, "salvage_value"))
            let accum = dec_parse(orm_cell_by(q, i, "accumulated_depreciation"))
            let rate = dec_parse(orm_cell_by(q, i, "accounting_depreciation_rate"))
            let method = orm_cell_by(q, i, "depreciation_method")
            if cost.ok == 1 && salvage.ok == 1 && accum.ok == 1 && rate.ok == 1 {
                let m = dep_monthly(cost.value, salvage.value, accum.value, rate.value, method)
                if m.ok == 1 {
                    let mut o = jobj_new()
                    o = jobj_i64(o, "id", orm_cell_by_i64(q, i, "id"))
                    o = jobj_str(o, "name", orm_cell_by(q, i, "name"))
                    o = jobj_str(o, "method", method)
                    o = jobj_str(o, "monthly_amount", dec_to_string(m.value))
                    arr = jarr_obj(arr, o)
                    let t = dec_add(total, m.value)
                    if t.ok == 1 {
                        total = t.value
                    }
                }
            }
        }
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_arr(o, "items", arr)
    o = jobj_str(o, "total_amount", dec_to_string(total))
    return act_ok(orm_db_q(q), o)
}

fn act_fa_depreciation_post(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let period = jreq_str(b.doc, b.root, "period")
    if period.ok == 0 {
        return act_422_field(db, "period", period)
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    // Сметки: 603 (разход) и 241 (амортизация) — по номер.
    let e_ids: Vec<i64> = vec_new()
    let eq = account_by_number(db, "603")?
    if orm_ok_q(eq) == 0 {
        return act_err(orm_db_q(eq), 500, orm_err_q(eq))
    }
    if orm_nrows(eq) < 1 {
        return act_err(orm_db_q(eq), 422, "липсва сметка 603 (разход за амортизации)")
    }
    vec_push(e_ids, orm_cell_by_i64(eq, 0, "id"))
    let mut db2 = orm_db_q(eq)
    let d_ids: Vec<i64> = vec_new()
    let dq = account_by_number(db2, "241")?
    if orm_ok_q(dq) == 0 {
        return act_err(orm_db_q(dq), 500, orm_err_q(dq))
    }
    if orm_nrows(dq) < 1 {
        return act_err(orm_db_q(dq), 422, "липсва сметка 241 (амортизация на ДМА)")
    }
    vec_push(d_ids, orm_cell_by_i64(dq, 0, "id"))
    db2 = orm_db_q(dq)
    // Изчисляване на месечните суми и обновяване на натрупаното.
    let q = fa_all(db2)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    db2 = orm_db_q(q)
    let mut total = dec_zero()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        let status = orm_cell_by(q, i, "status")
        let conserved = orm_cell_by_i64(q, i, "is_conserved")
        if status == "active" && conserved == 0 {
            let faid = orm_cell_by_i64(q, i, "id")
            let cost = dec_parse(orm_cell_by(q, i, "cost"))
            let salvage = dec_parse(orm_cell_by(q, i, "salvage_value"))
            let accum = dec_parse(orm_cell_by(q, i, "accumulated_depreciation"))
            let rate = dec_parse(orm_cell_by(q, i, "accounting_depreciation_rate"))
            let method = orm_cell_by(q, i, "depreciation_method")
            if cost.ok == 1 && salvage.ok == 1 && accum.ok == 1 && rate.ok == 1 {
                let m = dep_monthly(cost.value, salvage.value, accum.value, rate.value, method)
                if m.ok == 1 {
                    let na = dec_add(accum.value, m.value)
                    if na.ok == 1 {
                        let up = fa_update_accumulated(db2, faid, dec_to_string(na.value), dec_to_string(na.value))?
                        if orm_ok(up) == 0 {
                            return act_err(orm_db_exec(up), 500, orm_err_exec(up))
                        }
                        db2 = orm_db_exec(up)
                        let t = dec_add(total, m.value)
                        if t.ok == 1 {
                            total = t.value
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    // Счетоводен запис Дт 603 / Кт 241.
    let total_s = dec_to_string(total)
    let eq2 = journal_entry_insert(db2, period.val, "depreciation", 0, "Месечна амортизация на ДМА", "no_vat", 0, "", "", "", period.val, period.val, total_s, "0")?
    if orm_ok_q(eq2) == 0 || orm_nrows(eq2) < 1 {
        return act_err(orm_db_q(eq2), 500, "journal entry insert failed")
    }
    let entry_id = orm_cell_by_i64(eq2, 0, "id")
    db2 = orm_db_q(eq2)
    let l1 = journal_line_insert(db2, entry_id, vec_get(e_ids, 0), "debit", total_s, "0", 0, 0)?
    if orm_ok(l1) == 0 {
        return act_err(orm_db_exec(l1), 500, orm_err_exec(l1))
    }
    db2 = orm_db_exec(l1)
    let l2 = journal_line_insert(db2, entry_id, vec_get(d_ids, 0), "credit", total_s, "0", 0, 0)?
    if orm_ok(l2) == 0 {
        return act_err(orm_db_exec(l2), 500, orm_err_exec(l2))
    }
    db2 = orm_db_exec(l2)
    let jq = journal_find(db2, entry_id)?
    if orm_ok_q(jq) == 0 || orm_nrows(jq) < 1 {
        return act_err(orm_db_q(jq), 500, "journal entry missing after post")
    }
    let mut o = journal_entry_to_json(jq, 0)
    let lq = journal_lines_by_entry(orm_db_q(jq), entry_id)?
    o = jobj_arr(o, "lines", journal_lines_list_json(lq))
    return act_created(orm_db_q(lq), o)
}
