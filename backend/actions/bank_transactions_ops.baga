// actions/bank_transactions_ops.baga — осчетоводяване и разнасяне.
// Контрагентът се търси в UI и идва като counterpart_id; записва се в
// journal_entries и в кореспондиращия ред (не в банковия).
import "../models/bank_account.baga"
import "../models/bank_transaction.baga"
import "../models/account.baga"
import "../models/journal.baga"
import "../models/counterpart.baga"
import "active_company.baga"
import "txn.baga"
import "periods.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "std/str/str.baga"
import "bagadecimal/src/decimal.baga"

fn bank_tx_opt_i64(d: JsonDoc, root: i64, key: str) -> JField {
    return jreq_i64(d, root, key)
}

// Ръчно осчетоводяване. Предпочитан payload: {contra_account_id, counterpart_id?}.
// Старият {debit_account_id, credit_account_id} остава.
fn act_bank_transactions_book(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let cp_f = bank_tx_opt_i64(b.doc, b.root, "counterpart_id")
    let mut counterpart_id: i64 = 0
    if cp_f.present == 1 {
        if cp_f.ok == 0 {
            return act_422_field(db, "counterpart_id", cp_f)
        }
        counterpart_id = cp_f.num
    }
    let contra_f = bank_tx_opt_i64(b.doc, b.root, "contra_account_id")
    let mut contra_id: i64 = 0
    if contra_f.present == 1 {
        if contra_f.ok == 0 {
            return act_422_field(db, "contra_account_id", contra_f)
        }
        contra_id = contra_f.num
    }
    let debit_f = bank_tx_opt_i64(b.doc, b.root, "debit_account_id")
    let credit_f = bank_tx_opt_i64(b.doc, b.root, "credit_account_id")
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    if ac.id <= 0 {
        return act_err(ac.db, 422, "няма избрана активна фирма")
    }
    let tq = bank_tx_find(ac.db, id)?
    if orm_ok_q(tq) == 0 {
        return act_err(orm_db_q(tq), 500, orm_err_q(tq))
    }
    if orm_nrows(tq) < 1 {
        return act_404(orm_db_q(tq), "Транзакцията не е намерена")
    }
    if orm_cell_by_i64(tq, 0, "company_id") != ac.id {
        return act_404(orm_db_q(tq), "Транзакцията не е намерена")
    }
    if orm_cell_by_i64(tq, 0, "is_booked") != 0 {
        return act_err(orm_db_q(tq), 409, "транзакцията вече е осчетоводена")
    }
    let mut d0 = orm_db_q(tq)
    let tx_date = orm_cell_by(tq, 0, "txn_date")
    let tx_amount = orm_cell_by(tq, 0, "amount")
    let tx_desc = orm_cell_by(tq, 0, "description")
    let tx_contra = orm_cell_by(tq, 0, "counterpart_name")
    let tx_ref = orm_cell_by(tq, 0, "reference")
    let ba_id = orm_cell_by_i64(tq, 0, "bank_account_id")
    let ap = dec_parse(tx_amount)
    if ap.ok == 0 {
        return act_err(d0, 422, "невалидна сума на транзакцията")
    }
    let mut is_deposit: i64 = 1
    if dec_is_negative(ap.value) != 0 {
        is_deposit = 0
    }
    let abs = dec_abs(ap.value)
    let abs_s = dec_to_string(abs)
    let mut debit_id: i64 = 0
    let mut credit_id: i64 = 0
    let mut debit_cp: i64 = 0
    let mut credit_cp: i64 = 0
    if contra_id > 0 {
        let baq = bank_account_find(d0, ba_id)?
        if orm_ok_q(baq) == 0 {
            return act_err(orm_db_q(baq), 500, orm_err_q(baq))
        }
        if orm_nrows(baq) < 1 {
            return act_404(orm_db_q(baq), "Банковата сметка не е намерена")
        }
        let gl_id = orm_cell_by_i64(baq, 0, "gl_account_id")
        if gl_id <= 0 {
            return act_err(orm_db_q(baq), 422, "Банковата сметка няма свързана GL сметка")
        }
        d0 = orm_db_q(baq)
        if is_deposit == 1 {
            debit_id = gl_id
            credit_id = contra_id
            credit_cp = counterpart_id
        } else {
            debit_id = contra_id
            credit_id = gl_id
            debit_cp = counterpart_id
        }
    } else {
        if debit_f.ok == 0 {
            return act_422_field(d0, "debit_account_id", debit_f)
        }
        if credit_f.ok == 0 {
            return act_422_field(d0, "credit_account_id", credit_f)
        }
        debit_id = debit_f.num
        credit_id = credit_f.num
        debit_cp = counterpart_id
        credit_cp = counterpart_id
    }
    let mut cp_name = tx_contra
    let mut cp_vat = ""
    if counterpart_id > 0 {
        let cq = counterpart_find(d0, counterpart_id)?
        if orm_ok_q(cq) == 0 {
            return act_err(orm_db_q(cq), 500, orm_err_q(cq))
        }
        if orm_nrows(cq) < 1 {
            return act_404(orm_db_q(cq), "Контрагентът не е намерен")
        }
        cp_name = orm_cell_by(cq, 0, "name")
        cp_vat = orm_cell_by(cq, 0, "vat_number")
        d0 = orm_db_q(cq)
    }
    let pc = period_assert_open(d0, tx_date)?
    if pc.ok == 0 {
        return act_err(pc.db, 422, pc.err)
    }
    d0 = pc.db
    let mut desc = "Ръчно осчетоводяване"
    if tx_desc != "" {
        desc = tx_desc
    }
    if tx_contra != "" {
        desc = concat(concat(desc, " - "), tx_contra)
    }
    let bgn = bb_begin(d0)?
    if orm_ok(bgn) == 0 {
        return act_err(orm_db_exec(bgn), 500, orm_err_exec(bgn))
    }
    let mut db2 = orm_db_exec(bgn)
    let eq = journal_entry_insert(db2, tx_date, "bank", 0, desc, "no_vat", counterpart_id, cp_name, cp_vat, tx_ref, tx_date, "", abs_s, "0", ac.id)?
    if orm_ok_q(eq) == 0 || orm_nrows(eq) < 1 {
        return act_err_rb(orm_db_q(eq), 500, "journal entry insert failed")
    }
    let entry_id = orm_cell_by_i64(eq, 0, "id")
    db2 = orm_db_q(eq)
    let l1 = journal_line_insert(db2, entry_id, debit_id, "debit", abs_s, "0", debit_cp, 0, 0)?
    if orm_ok(l1) == 0 {
        return act_err_rb(orm_db_exec(l1), 500, orm_err_exec(l1))
    }
    db2 = orm_db_exec(l1)
    let l2 = journal_line_insert(db2, entry_id, credit_id, "credit", abs_s, "0", credit_cp, 0, 0)?
    if orm_ok(l2) == 0 {
        return act_err_rb(orm_db_exec(l2), 500, orm_err_exec(l2))
    }
    db2 = orm_db_exec(l2)
    let tcols = vec_new()
    vec_push(tcols, "is_booked")
    vec_push(tcols, "is_allocated")
    vec_push(tcols, "journal_entry_id")
    let tvals = vec_new()
    vec_push(tvals, "1")
    vec_push(tvals, "1")
    vec_push(tvals, int_to_str(entry_id))
    let tup = orm_update_by_id(db2, bank_tx_table(), id, tcols, tvals)?
    if orm_ok(tup) == 0 {
        return act_err_rb(orm_db_exec(tup), 500, orm_err_exec(tup))
    }
    db2 = orm_db_exec(tup)
    let cmt = bb_commit(db2)?
    if orm_ok(cmt) == 0 {
        return act_err_rb(orm_db_exec(cmt), 500, orm_err_exec(cmt))
    }
    let mut o = jobj_new()
    o = jobj_str(o, "message", "транзакцията е осчетоводена")
    o = jobj_i64(o, "journal_entry_id", entry_id)
    if counterpart_id > 0 {
        o = jobj_i64(o, "counterpart_id", counterpart_id)
    }
    return act_ok(orm_db_exec(cmt), o)
}

// Разнасяне: буферната сметка се заменя с реална; контрагентът отива на този ред.
fn act_bank_transactions_reallocate(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let new_acc = jreq_i64(b.doc, b.root, "account_id")
    if new_acc.ok == 0 {
        return act_422_field(db, "account_id", new_acc)
    }
    let cp_f = bank_tx_opt_i64(b.doc, b.root, "counterpart_id")
    let mut counterpart_id: i64 = 0
    if cp_f.present == 1 {
        if cp_f.ok == 0 {
            return act_422_field(db, "counterpart_id", cp_f)
        }
        counterpart_id = cp_f.num
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    if ac.id <= 0 {
        return act_err(ac.db, 422, "няма избрана активна фирма")
    }
    let tq = bank_tx_find(ac.db, id)?
    if orm_ok_q(tq) == 0 {
        return act_err(orm_db_q(tq), 500, orm_err_q(tq))
    }
    if orm_nrows(tq) < 1 {
        return act_404(orm_db_q(tq), "Транзакцията не е намерена")
    }
    if orm_cell_by_i64(tq, 0, "company_id") != ac.id {
        return act_404(orm_db_q(tq), "Транзакцията не е намерена")
    }
    let entry_id = orm_cell_by_i64(tq, 0, "journal_entry_id")
    if entry_id <= 0 {
        return act_err(orm_db_q(tq), 422, "Транзакцията няма счетоводен запис")
    }
    let ba_id = orm_cell_by_i64(tq, 0, "bank_account_id")
    let mut d0 = orm_db_q(tq)
    let baq = bank_account_find(d0, ba_id)?
    if orm_ok_q(baq) == 0 {
        return act_err(orm_db_q(baq), 500, orm_err_q(baq))
    }
    if orm_nrows(baq) < 1 {
        return act_404(orm_db_q(baq), "Банковата сметка не е намерена")
    }
    let buffer_id = orm_cell_by_i64(baq, 0, "buffer_account_id")
    if buffer_id <= 0 {
        return act_err(orm_db_q(baq), 422, "Няма буферна сметка")
    }
    d0 = orm_db_q(baq)
    let mut cp_name = ""
    let mut cp_vat = ""
    if counterpart_id > 0 {
        let cq = counterpart_find(d0, counterpart_id)?
        if orm_ok_q(cq) == 0 {
            return act_err(orm_db_q(cq), 500, orm_err_q(cq))
        }
        if orm_nrows(cq) < 1 {
            return act_404(orm_db_q(cq), "Контрагентът не е намерен")
        }
        cp_name = orm_cell_by(cq, 0, "name")
        cp_vat = orm_cell_by(cq, 0, "vat_number")
        d0 = orm_db_q(cq)
    }
    let lq = journal_lines_by_entry(d0, entry_id)?
    if orm_ok_q(lq) == 0 {
        return act_err(orm_db_q(lq), 500, orm_err_q(lq))
    }
    d0 = orm_db_q(lq)
    let bgn = bb_begin(d0)?
    if orm_ok(bgn) == 0 {
        return act_err(orm_db_exec(bgn), 500, orm_err_exec(bgn))
    }
    let mut db2 = orm_db_exec(bgn)
    let mut i: i64 = 0
    let mut replaced: i64 = 0
    while i < orm_nrows(lq) {
        if orm_cell_by_i64(lq, i, "account_id") == buffer_id {
            let line_id = orm_cell_by_i64(lq, i, "id")
            let cols = vec_new()
            vec_push(cols, "account_id")
            let vals = vec_new()
            vec_push(vals, int_to_str(new_acc.num))
            if counterpart_id > 0 {
                vec_push(cols, "counterpart_id")
                vec_push(vals, int_to_str(counterpart_id))
            }
            let up = orm_update_by_id(db2, journal_line_table(), line_id, cols, vals)?
            if orm_ok(up) == 0 {
                return act_err_rb(orm_db_exec(up), 500, orm_err_exec(up))
            }
            db2 = orm_db_exec(up)
            replaced = replaced + 1
        }
        i = i + 1
    }
    if replaced == 0 {
        return act_err_rb(db2, 422, "Не е намерен ред с буферна сметка")
    }
    if counterpart_id > 0 {
        let jcols = vec_new()
        vec_push(jcols, "counterpart_id")
        vec_push(jcols, "counterpart_name")
        vec_push(jcols, "counterpart_vat_number")
        let jvals = vec_new()
        vec_push(jvals, int_to_str(counterpart_id))
        vec_push(jvals, cp_name)
        vec_push(jvals, cp_vat)
        let jup = orm_update_by_id(db2, journal_entry_table(), entry_id, jcols, jvals)?
        if orm_ok(jup) == 0 {
            return act_err_rb(orm_db_exec(jup), 500, orm_err_exec(jup))
        }
        db2 = orm_db_exec(jup)
    }
    let tcols = vec_new()
    vec_push(tcols, "is_allocated")
    let tvals = vec_new()
    vec_push(tvals, "1")
    let tup = orm_update_by_id(db2, bank_tx_table(), id, tcols, tvals)?
    if orm_ok(tup) == 0 {
        return act_err_rb(orm_db_exec(tup), 500, orm_err_exec(tup))
    }
    db2 = orm_db_exec(tup)
    let cmt = bb_commit(db2)?
    if orm_ok(cmt) == 0 {
        return act_err_rb(orm_db_exec(cmt), 500, orm_err_exec(cmt))
    }
    db2 = orm_db_exec(cmt)
    let aq = account_find(db2, new_acc.num)?
    let mut acc_name = ""
    if orm_ok_q(aq) == 1 && orm_nrows(aq) > 0 {
        acc_name = orm_cell_by(aq, 0, "number")
        let an = orm_cell_by(aq, 0, "name")
        if an != "" {
            acc_name = concat(concat(acc_name, " "), an)
        }
        db2 = orm_db_q(aq)
    }
    if acc_name == "" {
        acc_name = int_to_str(new_acc.num)
    }
    let mut o = jobj_new()
    o = jobj_str(o, "message", concat("Транзакцията е разнесена към ", acc_name))
    o = jobj_str(o, "account_name", acc_name)
    o = jobj_i64(o, "replaced_lines", replaced)
    if counterpart_id > 0 {
        o = jobj_i64(o, "counterpart_id", counterpart_id)
    }
    return act_ok(db2, o)
}
