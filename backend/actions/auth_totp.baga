// actions/auth_totp.baga — 2FA през otpbaga (TOTP + резервни кодове).

import "../models/user.baga"
import "../models/auth_tokens.baga"
import "auth.baga"
import "otpbaga/otp.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "jwtbaga/jwt.baga"
import "std/str/str.baga"
import "std/time/time.baga"
import "std/random/random.baga"

fn totp_user_set(db: OrmDb, id: i64, enabled: i64, secret: str, pending: str) -> OrmExec !IO !Net {
    let cols = vec_new()
    vec_push(cols, "totp_enabled")
    vec_push(cols, "totp_secret_b32")
    vec_push(cols, "totp_pending_b32")
    let vals = vec_new()
    vec_push(vals, int_to_str(enabled))
    vec_push(vals, secret)
    vec_push(vals, pending)
    return orm_update_by_id(db, user_table(), id, cols, vals)?
}

fn totp_try_code(secret_b32: str, code: str) -> i64 !Time {
    if secret_b32 == "" || code == "" {
        return 0
    }
    let secret = otp_secret_from_b32(secret_b32)
    return totp_verify_now(secret, code, otp_cfg_default())?
}

fn totp_try_recovery(db: OrmDb, user_id: i64, code: str) -> i64 !IO !Net {
    let q = rec_unused(db, user_id)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return 0 - 1
    }
    let hashes = vec_new()
    let ids = vec_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        if orm_cell_by_i64(q, i, "used") == 0 {
            vec_push(hashes, orm_cell_by(q, i, "code_hash"))
            vec_push(ids, int_to_str(orm_cell_by_i64(q, i, "id")))
        }
        i = i + 1
    }
    let hit = recovery_match(code, hashes)
    if hit < 0 {
        return 0 - 1
    }
    let rid = parse_int(vec_get(ids, hit))
    let mk = rec_mark_used(orm_db_q(q), rid)?
    if orm_ok(mk) == 0 {
        return 0 - 1
    }
    return 1
}

fn act_mfa(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Time {
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let tok = jreq_str(b.doc, b.root, "mfa_token")
    if tok.ok == 0 || tok.val == "" {
        return act_err(db, 422, "mfa_token е задължителен")
    }
    let code = jreq_str(b.doc, b.root, "code")
    if code.ok == 0 || code.val == "" {
        return act_err(db, 422, "кодът е задължителен")
    }
    let now = time_now_ms()? / 1000
    if jwt_accept_hs256(ctx.jwt_secret, tok.val, now, "", "") == 0 {
        return act_err(db, 401, "изтекъл или невалиден 2FA токен")
    }
    if jwt_claim_int(tok.val, "mfa") != 1 {
        return act_err(db, 401, "изтекъл или невалиден 2FA токен")
    }
    let sub = jwt_claim_str(tok.val, "sub")
    if sub == "" {
        return act_err(db, 401, "изтекъл или невалиден 2FA токен")
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let uq = user_by_email(db, sub)?
    if orm_ok_q(uq) == 0 || orm_nrows(uq) < 1 {
        return act_err(orm_db_q(uq), 401, "грешен код")
    }
    let uid = orm_cell_by_i64(uq, 0, "id")
    let secret = orm_cell_by(uq, 0, "totp_secret_b32")
    if totp_try_code(secret, code.val)? == 1 {
        return auth_issue(ctx, orm_db_q(uq), sub)
    }
    if totp_try_recovery(orm_db_q(uq), uid, code.val)? == 1 {
        return auth_issue(ctx, orm_db_q(uq), sub)
    }
    return act_err(orm_db_q(uq), 401, "грешен код")
}

fn act_totp_start(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Random {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let uq = user_by_email(db, auth.ctx.user_sub)?
    if orm_ok_q(uq) == 0 || orm_nrows(uq) < 1 {
        return act_err(orm_db_q(uq), 404, "потребителят не е намерен")
    }
    if orm_cell_by_i64(uq, 0, "totp_enabled") == 1 {
        return act_err(orm_db_q(uq), 409, "2FA вече е включена")
    }
    let uid = orm_cell_by_i64(uq, 0, "id")
    let email = orm_cell_by(uq, 0, "email")
    let secret = otp_secret_new(20)?
    let b32 = otp_secret_b32(secret)
    let uri = otp_uri(secret, "bagabuch", email, otp_cfg_default())
    let rs = recovery_make(10)?
    let wipe = rec_delete_user(orm_db_q(uq), uid)?
    if orm_ok(wipe) == 0 {
        return act_err(orm_db_exec(wipe), 500, orm_err_exec(wipe))
    }
    let mut d = orm_db_exec(wipe)
    let mut i: i64 = 0
    while i < vec_len(rs.hashes) {
        let ins = rec_insert(d, uid, vec_get(rs.hashes, i))?
        if orm_ok(ins) == 0 {
            return act_err(orm_db_exec(ins), 500, orm_err_exec(ins))
        }
        d = orm_db_exec(ins)
        i = i + 1
    }
    let up = totp_user_set(d, uid, 0, "", b32)?
    if orm_ok(up) == 0 {
        return act_err(orm_db_exec(up), 500, orm_err_exec(up))
    }
    let mut codes = jarr_new()
    i = 0
    while i < vec_len(rs.codes) {
        codes = jarr_str(codes, vec_get(rs.codes, i))
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_str(o, "secret", b32)
    o = jobj_str(o, "uri", uri)
    o = jobj_raw(o, "recovery_codes", jarr_encode(codes))
    o = jobj_str(o, "message", "Сканирай URI в приложението и потвърди с код. Резервните кодове се показват само сега.")
    return act_ok(orm_db_exec(up), o)
}

fn act_totp_confirm(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Time {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let code = jreq_str(b.doc, b.root, "code")
    if code.ok == 0 {
        return act_422_field(db, "code", code)
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let uq = user_by_email(db, auth.ctx.user_sub)?
    if orm_ok_q(uq) == 0 || orm_nrows(uq) < 1 {
        return act_err(orm_db_q(uq), 404, "потребителят не е намерен")
    }
    let pending = orm_cell_by(uq, 0, "totp_pending_b32")
    if pending == "" {
        return act_err(orm_db_q(uq), 400, "няма започнато включване на 2FA")
    }
    if totp_try_code(pending, code.val)? == 0 {
        return act_err(orm_db_q(uq), 401, "грешен код")
    }
    let uid = orm_cell_by_i64(uq, 0, "id")
    let up = totp_user_set(orm_db_q(uq), uid, 1, pending, "")?
    if orm_ok(up) == 0 {
        return act_err(orm_db_exec(up), 500, orm_err_exec(up))
    }
    let mut o = jobj_new()
    o = jobj_i64(o, "ok", 1)
    o = jobj_i64(o, "totp_enabled", 1)
    o = jobj_str(o, "message", "2FA е включена")
    return act_ok(orm_db_exec(up), o)
}

fn act_totp_disable(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Time {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let password = jreq_str(b.doc, b.root, "password")
    if password.ok == 0 {
        return act_422_field(db, "password", password)
    }
    let code = jreq_str(b.doc, b.root, "code")
    if code.ok == 0 {
        return act_422_field(db, "code", code)
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let uq = user_by_email(db, auth.ctx.user_sub)?
    if orm_ok_q(uq) == 0 || orm_nrows(uq) < 1 {
        return act_err(orm_db_q(uq), 404, "потребителят не е намерен")
    }
    let email = orm_cell_by(uq, 0, "email")
    let hash = orm_cell_by(uq, 0, "password_hash")
    if user_hash_password(email, password.val) != hash {
        return act_err(orm_db_q(uq), 401, "грешна парола")
    }
    let uid = orm_cell_by_i64(uq, 0, "id")
    let secret = orm_cell_by(uq, 0, "totp_secret_b32")
    let mut okc: i64 = totp_try_code(secret, code.val)?
    if okc == 0 {
        if totp_try_recovery(orm_db_q(uq), uid, code.val)? == 1 {
            okc = 1
        }
    }
    if okc == 0 {
        return act_err(orm_db_q(uq), 401, "грешен код")
    }
    let wipe = rec_delete_user(orm_db_q(uq), uid)?
    if orm_ok(wipe) == 0 {
        return act_err(orm_db_exec(wipe), 500, orm_err_exec(wipe))
    }
    let up = totp_user_set(orm_db_exec(wipe), uid, 0, "", "")?
    if orm_ok(up) == 0 {
        return act_err(orm_db_exec(up), 500, orm_err_exec(up))
    }
    let mut o = jobj_new()
    o = jobj_i64(o, "ok", 1)
    o = jobj_i64(o, "totp_enabled", 0)
    o = jobj_str(o, "message", "2FA е изключена")
    return act_ok(orm_db_exec(up), o)
}
