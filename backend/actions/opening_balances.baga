// actions/opening_balances.baga — начални салда по НСС клас и аналитичност.
// Не се пишат в дневника (салдо ≠ оборот).

import "../models/opening_balance.baga"
import "../models/account.baga"
import "../models/counterpart.baga"
import "../models/product.baga"
import "periods.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "bagadecimal/src/decimal.baga"
import "std/str/str.baga"

fn ob_zero(s: str) -> i64 {
    if s == "" || s == "0" || s == "0.0" || s == "0.00" {
        return 1
    }
    let p = dec_parse(s)
    if p.ok == 0 {
        return 1
    }
    if dec_cmp(p.value, dec_zero()) == 0 {
        return 1
    }
    return 0
}

fn ob_year_start_key(year: i64) -> str {
    return concat(int_to_str(year), "-01")
}

fn ob_enrich(o: JObj, acc_q: OrmQuery, cp_q: OrmQuery, pr_q: OrmQuery, account_id: i64, counterpart_id: i64, product_id: i64) -> JObj {
    let mut out = o
    let mut i: i64 = 0
    while i < orm_nrows(acc_q) {
        if orm_cell_by_i64(acc_q, i, "id") == account_id {
            let num = orm_cell_by(acc_q, i, "number")
            out = jobj_str(out, "account_number", num)
            out = jobj_str(out, "account_name", orm_cell_by(acc_q, i, "name"))
            out = jobj_str(out, "analytic_type", orm_cell_by(acc_q, i, "analytic_type"))
            out = jobj_str(out, "natural_side", ob_natural_side(num))
            out = jobj_str(out, "account_kind", ob_account_kind(num))
        }
        i = i + 1
    }
    if counterpart_id > 0 {
        i = 0
        while i < orm_nrows(cp_q) {
            if orm_cell_by_i64(cp_q, i, "id") == counterpart_id {
                out = jobj_str(out, "counterpart_name", orm_cell_by(cp_q, i, "name"))
            }
            i = i + 1
        }
    }
    if product_id > 0 {
        i = 0
        while i < orm_nrows(pr_q) {
            if orm_cell_by_i64(pr_q, i, "id") == product_id {
                out = jobj_str(out, "product_name", orm_cell_by(pr_q, i, "name"))
                out = jobj_str(out, "product_code", orm_cell_by(pr_q, i, "code"))
            }
            i = i + 1
        }
    }
    return out
}

fn act_ob_index(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let ys = fmr_query(ctx, "year")
    let mut year = parse_int(ys)
    if year < 2000 {
        year = 2026
    }
    let q = ob_by_year(db, year)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    let mut db2 = orm_db_q(q)
    let aq = account_all(db2)?
    if orm_ok_q(aq) == 0 {
        return act_err(orm_db_q(aq), 500, orm_err_q(aq))
    }
    db2 = orm_db_q(aq)
    let cq = counterpart_all(db2)?
    if orm_ok_q(cq) == 0 {
        return act_err(orm_db_q(cq), 500, orm_err_q(cq))
    }
    db2 = orm_db_q(cq)
    let pq = product_all(db2)?
    if orm_ok_q(pq) == 0 {
        return act_err(orm_db_q(pq), 500, orm_err_q(pq))
    }
    let mut arr = jarr_new()
    let mut td = dec_zero()
    let mut tc = dec_zero()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        let mut o = ob_to_json(q, i)
        let aid = orm_cell_by_i64(q, i, "account_id")
        let cpid = orm_cell_by_i64(q, i, "counterpart_id")
        let prid = orm_cell_by_i64(q, i, "product_id")
        o = ob_enrich(o, aq, cq, pq, aid, cpid, prid)
        arr = jarr_obj(arr, o)
        let dp = dec_parse(orm_cell_by(q, i, "debit"))
        if dp.ok == 1 {
            let a = dec_add(td, dp.value)
            if a.ok == 1 {
                td = a.value
            }
        }
        let cp = dec_parse(orm_cell_by(q, i, "credit"))
        if cp.ok == 1 {
            let a = dec_add(tc, cp.value)
            if a.ok == 1 {
                tc = a.value
            }
        }
        i = i + 1
    }
    let mut out = jobj_new()
    out = jobj_raw(out, "items", jarr_encode(arr))
    out = jobj_i64(out, "count", orm_nrows(q))
    out = jobj_i64(out, "fiscal_year", year)
    out = jobj_str(out, "total_debit", dec_to_string(td))
    out = jobj_str(out, "total_credit", dec_to_string(tc))
    let diff = dec_sub(td, tc)
    if diff.ok == 1 {
        out = jobj_str(out, "difference", dec_to_string(diff.value))
    }
    return act_ok(orm_db_q(pq), out)
}

fn act_ob_create(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let yf = jreq_i64(b.doc, b.root, "fiscal_year")
    if yf.ok == 0 {
        return act_422_field(db, "fiscal_year", yf)
    }
    let aid = jreq_i64(b.doc, b.root, "account_id")
    if aid.ok == 0 {
        return act_422_field(db, "account_id", aid)
    }
    let debit = jopt_str(b.doc, b.root, "debit", "0")
    let credit = jopt_str(b.doc, b.root, "credit", "0")
    let cpid = jreq_i64(b.doc, b.root, "counterpart_id")
    let mut counterpart_id: i64 = 0
    if cpid.present == 1 {
        if cpid.ok == 0 {
            return act_422_field(db, "counterpart_id", cpid)
        }
        counterpart_id = cpid.num
    }
    let prid = jreq_i64(b.doc, b.root, "product_id")
    let mut product_id: i64 = 0
    if prid.present == 1 {
        if prid.ok == 0 {
            return act_422_field(db, "product_id", prid)
        }
        product_id = prid.num
    }
    let quantity = jopt_str(b.doc, b.root, "quantity", "0")
    let description = jopt_str(b.doc, b.root, "description", "")
    if ob_zero(debit.val) == 1 && ob_zero(credit.val) == 1 {
        return act_err(db, 422, "въведете дебит или кредит")
    }
    if ob_zero(debit.val) == 0 && ob_zero(credit.val) == 0 {
        return act_err(db, 422, "салдото е или дебит, или кредит — не и двете")
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let key = ob_year_start_key(yf.num)
    let pc = period_assert_open(db, key)?
    if pc.ok == 0 {
        return act_err(pc.db, 422, pc.err)
    }
    let aq = account_find(pc.db, aid.num)?
    if orm_ok_q(aq) == 0 {
        return act_err(orm_db_q(aq), 500, orm_err_q(aq))
    }
    if orm_nrows(aq) < 1 {
        return act_404(orm_db_q(aq), "Account not found")
    }
    let number = orm_cell_by(aq, 0, "number")
    let analytic = orm_cell_by(aq, 0, "analytic_type")
    let side = ob_natural_side(number)
    if side == "debit" && ob_zero(credit.val) == 0 {
        return act_err(orm_db_q(aq), 422, concat(number, " е дебитна по НСС — началното салдо е в дебит"))
    }
    if side == "credit" && ob_zero(debit.val) == 0 {
        return act_err(orm_db_q(aq), 422, concat(number, " е кредитна по НСС — началното салдо е в кредит"))
    }
    if analytic == "counterpart" && counterpart_id <= 0 {
        return act_err(orm_db_q(aq), 422, concat(number, " е аналитична към контрагент"))
    }
    if analytic == "product" && product_id <= 0 {
        return act_err(orm_db_q(aq), 422, concat(number, " е аналитична към продукт"))
    }
    let ins = ob_insert(orm_db_q(aq), yf.num, aid.num, debit.val, credit.val, counterpart_id, product_id, quantity.val, description.val)?
    if orm_ok(ins) == 0 {
        return act_err(orm_db_exec(ins), 500, orm_err_exec(ins))
    }
    let mut o = jobj_new()
    o = jobj_str(o, "status", "created")
    o = jobj_str(o, "natural_side", side)
    o = jobj_str(o, "account_kind", ob_account_kind(number))
    return act_created(orm_db_exec(ins), o)
}

fn act_ob_update(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let q0 = ob_find(db, id)?
    if orm_ok_q(q0) == 0 {
        return act_err(orm_db_q(q0), 500, orm_err_q(q0))
    }
    if orm_nrows(q0) < 1 {
        return act_404(orm_db_q(q0), "Opening balance not found")
    }
    let year = orm_cell_by_i64(q0, 0, "fiscal_year")
    let key = ob_year_start_key(year)
    let pc = period_assert_open(orm_db_q(q0), key)?
    if pc.ok == 0 {
        return act_err(pc.db, 422, pc.err)
    }
    let cols = vec_new()
    let vals = vec_new()
    let debit = jreq_str(b.doc, b.root, "debit")
    if debit.present == 1 {
        if debit.ok == 0 {
            return act_422_field(pc.db, "debit", debit)
        }
        vec_push(cols, "debit")
        vec_push(vals, debit.val)
    }
    let credit = jreq_str(b.doc, b.root, "credit")
    if credit.present == 1 {
        if credit.ok == 0 {
            return act_422_field(pc.db, "credit", credit)
        }
        vec_push(cols, "credit")
        vec_push(vals, credit.val)
    }
    let desc = jreq_str(b.doc, b.root, "description")
    if desc.present == 1 {
        if desc.ok == 0 {
            return act_422_field(pc.db, "description", desc)
        }
        vec_push(cols, "description")
        vec_push(vals, desc.val)
    }
    let qty = jreq_str(b.doc, b.root, "quantity")
    if qty.present == 1 {
        if qty.ok == 0 {
            return act_422_field(pc.db, "quantity", qty)
        }
        vec_push(cols, "quantity")
        vec_push(vals, qty.val)
    }
    let cpid = jreq_i64(b.doc, b.root, "counterpart_id")
    if cpid.present == 1 {
        if cpid.ok == 0 {
            return act_422_field(pc.db, "counterpart_id", cpid)
        }
        vec_push(cols, "counterpart_id")
        vec_push(vals, int_to_str(cpid.num))
    }
    let prid = jreq_i64(b.doc, b.root, "product_id")
    if prid.present == 1 {
        if prid.ok == 0 {
            return act_422_field(pc.db, "product_id", prid)
        }
        vec_push(cols, "product_id")
        vec_push(vals, int_to_str(prid.num))
    }
    if vec_len(cols) == 0 {
        return act_ok(pc.db, ob_to_json(q0, 0))
    }
    let up = orm_update_by_id(pc.db, ob_table(), id, cols, vals)?
    if orm_ok(up) == 0 {
        return act_err(orm_db_exec(up), 500, orm_err_exec(up))
    }
    let q = ob_find(orm_db_exec(up), id)?
    return act_ok(orm_db_q(q), ob_to_json(q, 0))
}

fn act_ob_delete(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let q0 = ob_find(db, id)?
    if orm_ok_q(q0) == 0 {
        return act_err(orm_db_q(q0), 500, orm_err_q(q0))
    }
    if orm_nrows(q0) < 1 {
        return act_404(orm_db_q(q0), "Opening balance not found")
    }
    let year = orm_cell_by_i64(q0, 0, "fiscal_year")
    let key = ob_year_start_key(year)
    let pc = period_assert_open(orm_db_q(q0), key)?
    if pc.ok == 0 {
        return act_err(pc.db, 422, pc.err)
    }
    let del = ob_delete(pc.db, id)?
    if orm_ok(del) == 0 {
        return act_err(orm_db_exec(del), 500, orm_err_exec(del))
    }
    return act_no_content(orm_db_exec(del))
}
