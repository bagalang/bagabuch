    return "-----BEGIN CERTIFICATE-----\nMIIDYTCCAuagAwIBAgIQErBki+jiuRB0IWwdrpxXlTAKBggqhkjOPQQDAzBfMQsw\nCQYDVQQGEwJHQjEYMBYGA1UEChMPU2VjdGlnbyBMaW1pdGVkMTYwNAYDVQQDEy1T\nZWN0aWdvIFB1YmxpYyBTZXJ2ZXIgQXV0aGVudGljYXRpb24gUm9vdCBFNDYwHhcN\nMjEwMzIyMDAwMDAwWhcNMzYwMzIxMjM1OTU5WjBgMQswCQYDVQQGEwJHQjEYMBYG\nA1UEChMPU2VjdGlnbyBMaW1pdGVkMTcwNQYDVQQDEy5TZWN0aWdvIFB1YmxpYyBT\nZXJ2ZXIgQXV0aGVudGljYXRpb24gQ0EgT1YgRTM2MFkwEwYHKoZIzj0CAQYIKoZI\nzj0DAQcDQgAEKIA1qzb43W7zPI9TjMdrumjY1lKryzYH+v7UwQZGYVECtNNkECbY\nA+wvHGoNHyEOoZt9q6GnibgfG3GMoeNNxKOCAYEwggF9MB8GA1UdIwQYMBaAFNEi\n2kxZ8UtfJjiqndbu6w3D+6lhMB0GA1UdDgQWBBRMOHolNGv9+Y8aYByScapn+YI3\n6zAOBgNVHQ8BAf8EBAMCAYYwEgYDVR0TAQH/BAgwBgEB/wIBADAdBgNVHSUEFjAU\nBggrBgEFBQcDAQYIKwYBBQUHAwIwGwYDVR0gBBQwEjAGBgRVHSAAMAgGBmeBDAEC\nAjBUBgNVHR8ETTBLMEmgR6BFhkNodHRwOi8vY3JsLnNlY3RpZ28uY29tL1NlY3Rp\nZ29QdWJsaWNTZXJ2ZXJBdXRoZW50aWNhdGlvblJvb3RFNDYuY3JsMIGEBggrBgEF\nBQcBAQR4MHYwTwYIKwYBBQUHMAKGQ2h0dHA6Ly9jcnQuc2VjdGlnby5jb20vU2Vj\ndGlnb1B1YmxpY1NlcnZlckF1dGhlbnRpY2F0aW9uUm9vdEU0Ni5wN2MwIwYIKwYB\nBQUHMAGGF2h0dHA6Ly9vY3NwLnNlY3RpZ28uY29tMAoGCCqGSM49BAMDA2kAMGYC\nMQDcmhP3tfiaomkRqm9hBvF1jP3ljBVl1fVCcvYu5FxnqtuOrHieAjyLTRexVWwd\nAxMCMQDIaTv6uF+2ibHuCynk6MD2D+MZszaJxXkic4iWU8cqaCkZOAGEDoso4Rdf\n/Us0jdQ=\n-----END CERTIFICATE-----\n"
}

fn ecb_anchor_der() -> bytes !IO {
    let f = env("BAGABUCH_ECB_ANCHOR_FILE")?
    if f != "" {
        if file_readable(f)? == 1 {
            let pem = read_file(f)?
            return pem_der_block(pem, "CERTIFICATE")
        }
    }
    return pem_der_block(ecb_anchor_pem(), "CERTIFICATE")
}

fn act_exchange_rates_index(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let mut date = fmr_query(ctx, "date")
    let mut d0 = db
    if date == "" {
        let aq = exchange_rate_latest_q(db)?
        if orm_ok_q(aq) == 0 {
            return act_err(orm_db_q(aq), 500, orm_err_q(aq))
        }
        d0 = orm_db_q(aq)
        if orm_nrows(aq) < 1 {
            let mut o0 = jobj_new()
            o0 = jobj_str(o0, "date", "")
            o0 = jobj_arr(o0, "items", jarr_new())
            return act_ok(d0, o0)
        }
        date = orm_cell_by(aq, 0, "date")
    }
    let q = exchange_rate_by_date(d0, date)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, exchange_rate_to_json(q, i))
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_str(o, "date", date)
    o = jobj_str(o, "base", "EUR")
    o = jobj_arr(o, "items", arr)
    return act_ok(orm_db_q(q), o)
}

// Единичен курс: ?currency=USD&date=2026-08-21 (при липса на деня — най-близък по-ранен).
fn act_exchange_rates_rate(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let currency = fmr_query(ctx, "currency")
    if currency == "" {
        return act_err(db, 400, "currency е задължителен")
    }
    let date = fmr_query(ctx, "date")
    if date == "" {
        return act_err(db, 400, "date е задължителен (YYYY-MM-DD)")
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let q = exchange_rate_by_currency(db, currency)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    let row = exchange_rate_asof_pick(q, date)
    if row < 0 {
        return act_404(orm_db_q(q), "няма курс за тази валута")
    }
    let mut o = jobj_new()
    o = jobj_str(o, "currency_code", currency)
    o = jobj_str(o, "date", orm_cell_by(q, row, "date"))
    o = jobj_str(o, "rate", orm_cell_by(q, row, "rate"))
    o = jobj_str(o, "base", "EUR")
    return act_ok(orm_db_q(q), o)
}

// Импорт от ЕЦБ: body {mode: "daily"|"history"} (по подразбиране daily).
fn act_exchange_rates_import(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Random {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let mut mode = "daily"
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 1 {
        let b = jbody_require_object(body)
        if b.ok == 1 {
            mode = jopt_str(b.doc, b.root, "mode", "daily").val
        }
    }
    let mut url = ecb_url_daily()
    if mode == "history" {
        url = ecb_url_history()
    }
    let headers: Map<str, str> = map_new()
    map_set(headers, "user-agent", "bagabuch/0.1")
    let anchor = ecb_anchor_der()?
    let resp = http_request_anchor("GET", url, headers, "", 30, anchor)?
    if resp.status != 200 {
        return act_err(db, 502, concat(concat("ЕЦБ фидът върна статус ", int_to_str(resp.status)), " — опитайте пак"))
    }
    // Cube елементи: <Cube time="YYYY-MM-DD"> → <Cube currency="USD" rate="1.23"/>
    // Едно SELECT за целия импорт; ъпсъртите решаваме в приложението.
    let aq = exchange_rate_all(db)?
    if orm_ok_q(aq) == 0 {
        return act_err(orm_db_q(aq), 500, orm_err_q(aq))
    }
    let p = xml_parser(resp.body)
    let mut cur_date = ""
    let mut inserted: i64 = 0
    let mut updated: i64 = 0
    let mut same: i64 = 0
    let mut first_date = ""
    let mut last_date = ""
    let mut d0 = orm_db_q(aq)
    let mut running: i64 = 1
    while running == 1 {
        let ev = xml_next(p)
        if ev.kind == 1 {
            if xml_local_name(ev.name) == "Cube" {
                if map_has(ev.attrs, "time") == 1 {
                    cur_date = map_get(ev.attrs, "time")
                    if first_date == "" {
                        first_date = cur_date
                    }
                    last_date = cur_date
                } else {
                    if map_has(ev.attrs, "currency") == 1 && map_has(ev.attrs, "rate") == 1 {
                        if cur_date != "" {
                            let out: Vec<i64> = vec_new()
                            d0 = exchange_rate_upsert(d0, aq, map_get(ev.attrs, "currency"), map_get(ev.attrs, "rate"), cur_date, out)?
                            if vec_len(out) > 0 {
                                let r = vec_get(out, 0)
                                if r == 1 {
                                    inserted = inserted + 1
                                }
                                if r == 0 {
                                    updated = updated + 1
                                }
                                if r == 2 {
                                    same = same + 1
                                }
                                if r < 0 {
                                    return act_err(d0, 500, "запис на курс се провали")
                                }
                            }
                        }
                    }
                }
            }
        }
        if ev.kind <= 0 {
            running = 0
            if ev.kind < 0 {
                return act_err(d0, 502, concat("невалиден XML от ЕЦБ: ", ev.err))
            }
        }
    }
    let mut o = jobj_new()
    o = jobj_str(o, "mode", mode)
    o = jobj_i64(o, "inserted", inserted)
    o = jobj_i64(o, "updated", updated)
    o = jobj_i64(o, "unchanged", same)
    o = jobj_str(o, "from_date", first_date)
    o = jobj_str(o, "to_date", last_date)
    return act_ok(d0, o)
}
