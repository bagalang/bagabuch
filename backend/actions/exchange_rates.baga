// actions/exchange_rates.baga — обменни курсове от Европейската централна банка.
// Фид: eurofxref-daily.xml (днешни) и eurofxref-hist-90d.xml (90 дни история),
// курсове за 1 EUR. XML се парси с pull-парсъра на xmlbaga (Cube елементи).

import "../models/exchange_rate.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "xmlbaga/xml.baga"
import "std/net/http_client.baga"
import "std/os/os.baga"
import "std/crypto/pkey.baga"

fn ecb_url_daily() -> str {
    return "https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml"
}

fn ecb_url_history() -> str {
    return "https://www.ecb.europa.eu/stats/eurofxref/eurofxref-hist-90d.xml"
}

// Sectigo Public Server Authentication CA OV E36 — издателят на листовия
// сертификат на www.ecb.europa.eu (клиентът пази само листото, затова
// котвата е прякият издател). При ротация: BAGABUCH_ECB_ANCHOR_FILE=<pem път>.
