// actions/saft_src.baga — клиенти, доставчици и фактури за месечния SAF-T.
// Клиентът е CompanyStructure + CustomerID + сметка 411. Доставчикът е 401.
// Фактурата е CustomerInfo/SupplierInfo, редове и InvoiceDocumentTotals.
// Салдата на контрагента са 0.00: аналитичното салдо по лице още не се смята.

import "../models/counterpart.baga"
import "../models/invoice.baga"
import "../models/product.baga"
import "../models/doc_type.baga"
import "../models/addr_saft.baga"
import "../models/account.baga"
import "../models/journal.baga"
import "../models/opening_balance.baga"
import "vat_fmt.baga"
import "bagadecimal/src/decimal.baga"
import "xmlbaga/xml.baga"
import "std/str/str.baga"

struct SftSrc {
    ok: i64,
    err: str,
    db: OrmDb,
    xml: str,
    sales: str,
    purchases: str
}
fn sfts_open(name: str) -> str {
    return xml_open(name, xml_attrs_new())
}
fn sfts_text(name: str, text: str) -> str {
    return xml_elem(name, xml_attrs_new(), text)
}

fn sfts_opt(name: str, text: str) -> str {
    if text == "" {
        return ""
    }
    return sfts_text(name, text)
}

fn sfts_clip(s: str, n: i64) -> str {
    let t = str_trim(s)
    if t == "" || n <= 0 {
        return ""
    }
    if len(t) <= n {
        return t
    }
    return substr(t, 0, n)
}

fn sfts_co(row_co: i64, cid: i64) -> i64 {
    if cid <= 0 {
        return 1
    }
    if row_co == 0 || row_co == cid {
        return 1
    }
    return 0
}

fn sfts_cyr(s: str) -> i64 {
    let mut i: i64 = 0
    while i < len(s) {
        if char_at(s, i) > 127 {
            return 1
        }
        i = i + 1
    }
    return 0
}

fn sfts_digits2(s: str) -> i64 {
    if len(s) != 2 {
        return 0
    }
    let mut i: i64 = 0
    while i < 2 {
        let c = char_at(s, i)
        if c < 48 || c > 57 {
            return 0
        }
        i = i + 1
    }
    return 1
}

fn sfts_amount(name: str, amount: str, currency: str) -> str {
    let text = vat_money(vat_parse_amt(amount))
    let mut out = ""
    out = concat(out, sfts_open(name))
    out = concat(out, sfts_text("nsSAFT:Amount", text))
    out = concat(out, sfts_text("nsSAFT:CurrencyCode", currency))
    out = concat(out, sfts_text("nsSAFT:CurrencyAmount", text))
    out = concat(out, xml_close(name))
    return out
}

fn sfts_id(eik: str) -> str {
    let t = sfts_clip(eik, 35)
    if t == "" {
        return "0"
    }
    return t
}

fn sfts_address(q: OrmQuery, row: i64) -> str {
    let country = adr_country(orm_cell_by(q, row, "country"), "BG")
    let rn = adr_region_norm(orm_cell_by(q, row, "region"), country)
    let mut region = ""
    if rn.ok == 1 {
        region = rn.code
    }
    let tn = adr_type_norm(orm_cell_by(q, row, "address_type"))
    let mut at = ""
    if tn.ok == 1 {
        at = tn.code
    }
    let mut out = ""
    out = concat(out, sfts_open("nsSAFT:Address"))
    out = concat(out, sfts_opt("nsSAFT:StreetName", adr_clip(orm_cell_by(q, row, "street_name"), 70)))
    out = concat(out, sfts_opt("nsSAFT:Number", adr_clip(orm_cell_by(q, row, "building_number"), 18)))
    out = concat(out, sfts_opt("nsSAFT:AdditionalAddressDetail", adr_clip(orm_cell_by(q, row, "additional_address_detail"), 70)))
    out = concat(out, sfts_opt("nsSAFT:Building", adr_clip(orm_cell_by(q, row, "address_building"), 35)))
    out = concat(out, sfts_text("nsSAFT:City", adr_clip(orm_cell_by(q, row, "city"), 35)))
    out = concat(out, sfts_opt("nsSAFT:PostalCode", adr_clip(orm_cell_by(q, row, "post_code"), 18)))
    out = concat(out, sfts_opt("nsSAFT:Region", region))
    out = concat(out, sfts_text("nsSAFT:Country", country))
    out = concat(out, sfts_opt("nsSAFT:AddressType", at))
    out = concat(out, xml_close("nsSAFT:Address"))
    return out
}

fn sfts_company(q: OrmQuery, row: i64) -> str {
    let name = sfts_clip(orm_cell_by(q, row, "name"), 70)
    let mut out = ""
    out = concat(out, sfts_open("nsSAFT:CompanyStructure"))
    out = concat(out, sfts_text("nsSAFT:RegistrationNumber", sfts_id(orm_cell_by(q, row, "eik"))))
    if sfts_cyr(name) == 1 || name == "" {
        let mut shown = name
        if shown == "" {
            shown = "—"
        }
        out = concat(out, sfts_text("nsSAFT:Name", shown))
    } else {
        out = concat(out, sfts_text("nsSAFT:NameLatin", name))
    }
    out = concat(out, sfts_address(q, row))
    out = concat(out, sfts_text("nsSAFT:RelatedParty", "N"))
    out = concat(out, xml_close("nsSAFT:CompanyStructure"))
    return out
}

fn sfts_pref(nra: str, pref: str) -> i64 {
    if nra == pref {
        return 1
    }
    if len(nra) > len(pref) && substr(nra, 0, len(pref)) == pref {
        return 1
    }
    return 0
}

fn sfts_bal_xml(bal: Map<str, str>, id: str, role: str) -> str {
    let od = map_get(bal, concat(concat(id, role), "od"))
    let oc = map_get(bal, concat(concat(id, role), "oc"))
    let pd = map_get(bal, concat(concat(id, role), "pd"))
    let pc = map_get(bal, concat(concat(id, role), "pc"))
    let open = sftg_side(od, oc)
    let close = sftg_side(sftg_sum(od, pd), sftg_sum(oc, pc))
    return concat(sftg_bal("nsSAFT:OpeningDebitBalance", "nsSAFT:OpeningCreditBalance", open), sftg_bal("nsSAFT:ClosingDebitBalance", "nsSAFT:ClosingCreditBalance", close))
}

fn sfts_add_role(bal: Map<str, str>, id: str, role: str, kind: str, direction: str, amount: str) {
    let mut side = "d"
    if direction != "debit" {
        side = "c"
    }
    sftg_map_add(bal, concat(concat(concat(id, role), kind), side), amount)
}

fn sft_parties(db: OrmDb, company_id: i64, year: i64, month: i64, fys: i64) -> SftSrc !IO !Net {
    let kq = counterpart_all(db)?
    if orm_ok_q(kq) == 0 {
        return SftSrc { ok: 0, err: orm_err_q(kq), db: orm_db_q(kq), xml: "", sales: "", purchases: "" }
    }
    let aq = account_all(orm_db_q(kq))?
    if orm_ok_q(aq) == 0 {
        return SftSrc { ok: 0, err: orm_err_q(aq), db: orm_db_q(aq), xml: "", sales: "", purchases: "" }
    }
    let nra: Map<str, str> = map_new()
    let mut i: i64 = 0
    while i < orm_nrows(aq) {
        let packed = sftg_code(orm_cell_by(aq, i, "saft_account_type"), orm_cell_by(aq, i, "number"))
        if packed != "" {
            map_set(nra, int_to_str(orm_cell_by_i64(aq, i, "id")), sftg_nra(packed))
        }
        i = i + 1
    }
    let mut start_m = fys
    if start_m < 1 || start_m > 12 {
        start_m = 1
    }
    let mut fy = year
    if month < start_m {
        fy = year - 1
    }
    let fy_start = sftg_ymd(fy, start_m, 1)
    let start = sftg_ymd(year, month, 1)
    let mut ny = year
    let mut nm = month + 1
    if nm > 12 {
        nm = 1
        ny = year + 1
    }
    let next = sftg_ymd(ny, nm, 1)
    let oq = ob_by_year(orm_db_q(aq), fy)?
    if orm_ok_q(oq) == 0 {
        return SftSrc { ok: 0, err: orm_err_q(oq), db: orm_db_q(oq), xml: "", sales: "", purchases: "" }
    }
    let bal: Map<str, str> = map_new()
    i = 0
    while i < orm_nrows(oq) {
        let cid = orm_cell_by_i64(oq, i, "counterpart_id")
        let code = map_get(nra, int_to_str(orm_cell_by_i64(oq, i, "account_id")))
        if cid > 0 {
            let id = int_to_str(cid)
            if sfts_pref(code, "411") == 1 {
                sfts_add_role(bal, id, ":c:", "o", "debit", orm_cell_by(oq, i, "debit"))
                sfts_add_role(bal, id, ":c:", "o", "credit", orm_cell_by(oq, i, "credit"))
            }
            if sfts_pref(code, "401") == 1 {
                sfts_add_role(bal, id, ":s:", "o", "debit", orm_cell_by(oq, i, "debit"))
                sfts_add_role(bal, id, ":s:", "o", "credit", orm_cell_by(oq, i, "credit"))
            }
        }
        i = i + 1
    }
    let lq = journal_lines_for_saft(orm_db_q(oq))?
    if orm_ok_q(lq) == 0 {
        return SftSrc { ok: 0, err: orm_err_q(lq), db: orm_db_q(lq), xml: "", sales: "", purchases: "" }
    }
    i = 0
    while i < orm_nrows(lq) {
        let cid = orm_cell_by_i64(lq, i, "counterpart_id")
        let day = orm_cell_by(lq, i, "entry_date")
        let code = map_get(nra, int_to_str(orm_cell_by_i64(lq, i, "account_id")))
        if cid > 0 && len(day) >= 10 && sfts_co(orm_cell_by_i64(lq, i, "company_id"), company_id) == 1 {
            let date = substr(day, 0, 10)
            let mut kind = ""
            if sftg_ge(date, fy_start) == 1 && sftg_ge(date, start) == 0 {
                kind = "o"
            }
            if sftg_ge(date, start) == 1 && sftg_ge(date, next) == 0 {
                kind = "p"
            }
            if kind != "" {
                let id = int_to_str(cid)
                let dir = orm_cell_by(lq, i, "direction")
                let amt = orm_cell_by(lq, i, "amount")
                if sfts_pref(code, "411") == 1 {
                    sfts_add_role(bal, id, ":c:", kind, dir, amt)
                }
                if sfts_pref(code, "401") == 1 {
                    sfts_add_role(bal, id, ":s:", kind, dir, amt)
                }
            }
        }
        i = i + 1
    }
    let mut customers = ""
    let mut suppliers = ""
    i = 0
    while i < orm_nrows(kq) {
        if sfts_co(orm_cell_by_i64(kq, i, "company_id"), company_id) == 1 {
            let id = sfts_id(orm_cell_by(kq, i, "eik"))
            let cid = int_to_str(orm_cell_by_i64(kq, i, "id"))
            if orm_cell_by_i64(kq, i, "is_client") == 1 {
                customers = concat(customers, sfts_open("nsSAFT:Customer"))
                customers = concat(customers, sfts_company(kq, i))
                customers = concat(customers, sfts_text("nsSAFT:CustomerID", id))
                customers = concat(customers, sfts_text("nsSAFT:AccountID", "411"))
                customers = concat(customers, sfts_bal_xml(bal, cid, ":c:"))
                customers = concat(customers, xml_close("nsSAFT:Customer"))
            }
            if orm_cell_by_i64(kq, i, "is_supplier") == 1 {
                suppliers = concat(suppliers, sfts_open("nsSAFT:Supplier"))
                suppliers = concat(suppliers, sfts_company(kq, i))
                suppliers = concat(suppliers, sfts_text("nsSAFT:SupplierID", id))
                suppliers = concat(suppliers, sfts_text("nsSAFT:AccountID", "401"))
                suppliers = concat(suppliers, sfts_bal_xml(bal, cid, ":s:"))
                suppliers = concat(suppliers, xml_close("nsSAFT:Supplier"))
            }
        }
        i = i + 1
    }
    let mut xml = ""
    xml = concat(xml, sfts_open("nsSAFT:Customers"))
    xml = concat(xml, customers)
    xml = concat(xml, xml_close("nsSAFT:Customers"))
    xml = concat(xml, sfts_open("nsSAFT:Suppliers"))
    xml = concat(xml, suppliers)
    xml = concat(xml, xml_close("nsSAFT:Suppliers"))
    return SftSrc { ok: 1, err: "", db: orm_db_q(lq), xml: xml, sales: "", purchases: "" }
}

fn sfts_find_cp(q: OrmQuery, id: i64) -> i64 {
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        if orm_cell_by_i64(q, i, "id") == id {
            return i
        }
        i = i + 1
    }
    return -1
}

fn sfts_tax_code(rate: str, vat_amt: str, reason: str) -> str {
    let r = vat_parse_amt(rate)
    if dec_eq(r, dec_from_i64(20)) == 1 {
        return "100211"
    }
    if dec_eq(r, dec_from_i64(9)) == 1 {
        return "100213"
    }
    if dec_is_zero(vat_parse_amt(vat_amt)) == 1 && str_trim(reason) != "" {
        return "100219"
    }
    if dec_is_zero(r) == 1 {
        return "100214"
    }
    return "100211"
}

fn sfts_party_info(kind: str, id: str, name: str, city: str, country: str) -> str {
    let mut tag = "nsSAFT:CustomerInfo"
    let mut id_tag = "nsSAFT:CustomerID"
    if kind == "in" {
        tag = "nsSAFT:SupplierInfo"
        id_tag = "nsSAFT:SupplierID"
    }
    let mut shown = sfts_clip(name, 70)
    if shown == "" {
        shown = "—"
    }
    let cc = adr_country(country, "BG")
    let mut out = ""
    out = concat(out, sfts_open(tag))
    out = concat(out, sfts_text(id_tag, sfts_id(id)))
    out = concat(out, sfts_text("nsSAFT:Name", shown))
    out = concat(out, sfts_open("nsSAFT:BillingAddress"))
    out = concat(out, sfts_text("nsSAFT:City", adr_clip(city, 35)))
    out = concat(out, sfts_text("nsSAFT:Country", cc))
    out = concat(out, xml_close("nsSAFT:BillingAddress"))
    out = concat(out, xml_close(tag))
    return out
}

fn sfts_line(number: str, account: str, goods: str, code: str, desc: str, qty: str, unit: str, price: str, net: str, vat: str, rate: str, reason: str, day: str, indicator: str, currency: str) -> str {
    let mut text = sfts_clip(desc, 256)
    if text == "" {
        text = "Ред"
    }
    let mut u = sfts_clip(unit, 9)
    if u == "" {
        u = "C62"
    }
    let mut q = str_trim(qty)
    if q == "" {
        q = "1"
    }
    let mut out = ""
    out = concat(out, sfts_open("nsSAFT:InvoiceLine"))
    out = concat(out, sfts_text("nsSAFT:LineNumber", number))
    out = concat(out, sfts_text("nsSAFT:AccountID", account))
    out = concat(out, sfts_text("nsSAFT:GoodsServicesID", goods))
    out = concat(out, sfts_text("nsSAFT:ProductCode", sfts_clip(code, 70)))
    out = concat(out, sfts_text("nsSAFT:ProductDescription", text))
    out = concat(out, sfts_text("nsSAFT:Quantity", q))
    out = concat(out, sfts_text("nsSAFT:InvoiceUOM", u))
    out = concat(out, sfts_text("nsSAFT:UnitPrice", vat_money(vat_parse_amt(price))))
    out = concat(out, sfts_text("nsSAFT:TaxPointDate", day))
    out = concat(out, sfts_text("nsSAFT:Description", text))
    out = concat(out, sfts_amount("nsSAFT:InvoiceLineAmount", net, currency))
    out = concat(out, sfts_text("nsSAFT:DebitCreditIndicator", indicator))
    out = concat(out, sfts_open("nsSAFT:TaxInformation"))
    out = concat(out, sfts_text("nsSAFT:TaxType", "100"))
    out = concat(out, sfts_text("nsSAFT:TaxCode", sfts_tax_code(rate, vat, reason)))
    out = concat(out, sfts_text("nsSAFT:TaxBase", vat_money(vat_parse_amt(net))))
    out = concat(out, sfts_amount("nsSAFT:TaxAmount", vat, currency))
    out = concat(out, xml_close("nsSAFT:TaxInformation"))
    out = concat(out, xml_close("nsSAFT:InvoiceLine"))
    return out
}

fn sft_invoices(db: OrmDb, company_id: i64, year: i64, month: i64, cur: str) -> SftSrc !IO !Net {
    let mut ms = int_to_str(month)
    if len(ms) == 1 {
        ms = concat("0", ms)
    }
    let period = concat(concat(concat(concat(int_to_str(year), "-"), ms), "-"), "01")
    let aq = account_all(db)?
    if orm_ok_q(aq) == 0 {
        return SftSrc { ok: 0, err: orm_err_q(aq), db: orm_db_q(aq), xml: "", sales: "", purchases: "" }
    }
    let anra: Map<str, str> = map_new()
    let mut ai: i64 = 0
    while ai < orm_nrows(aq) {
        let packed = sftg_code(orm_cell_by(aq, ai, "saft_account_type"), orm_cell_by(aq, ai, "number"))
        if packed != "" {
            map_set(anra, int_to_str(orm_cell_by_i64(aq, ai, "id")), sftg_nra(packed))
        }
        ai = ai + 1
    }
    let pq = product_all(orm_db_q(aq))?
    if orm_ok_q(pq) == 0 {
        return SftSrc { ok: 0, err: orm_err_q(pq), db: orm_db_q(pq), xml: "", sales: "", purchases: "" }
    }
    let goods: Map<str, str> = map_new()
    let mut i: i64 = 0
    while i < orm_nrows(pq) {
        let mut code = sfts_clip(orm_cell_by(pq, i, "code"), 70)
        if code == "" {
            code = "0"
        }
        let mut flag = "01"
        if orm_cell_by_i64(pq, i, "is_service") == 1 {
            flag = "02"
        }
        map_set(goods, int_to_str(orm_cell_by_i64(pq, i, "id")), concat(concat(code, "|"), flag))
        i = i + 1
    }
    let kq = counterpart_all(orm_db_q(pq))?
    if orm_ok_q(kq) == 0 {
        return SftSrc { ok: 0, err: orm_err_q(kq), db: orm_db_q(kq), xml: "", sales: "", purchases: "" }
    }
    let iq = invoice_all(orm_db_q(kq))?
    if orm_ok_q(iq) == 0 {
        return SftSrc { ok: 0, err: orm_err_q(iq), db: orm_db_q(iq), xml: "", sales: "", purchases: "" }
    }
    let month_key = substr(period, 0, 7)
    let mut db2 = orm_db_q(iq)
    let mut sales = ""
    let mut purchases = ""
    let mut ns: i64 = 0
    let mut np: i64 = 0
    let mut credit = dec_zero()
    let mut debit = dec_zero()
    i = 0
    while i < orm_nrows(iq) {
        let direction = orm_cell_by(iq, i, "direction")
        let dtype = orm_cell_by(iq, i, "document_type")
        let raw_date = orm_cell_by(iq, i, "issue_date")
        let am = orm_cell_by(iq, i, "accounting_month")
        let mut key = ""
        if len(am) >= 7 {
            key = substr(am, 0, 7)
        } else {
            if len(raw_date) >= 7 {
                key = substr(raw_date, 0, 7)
            }
        }
        if doc_type_is_proforma(dtype) == 0 && key == month_key && len(raw_date) >= 10 && sfts_co(orm_cell_by_i64(iq, i, "company_id"), company_id) == 1 && (direction == "out" || direction == "in") {
            let day = substr(raw_date, 0, 10)
            let mut tax_day = orm_cell_by(iq, i, "tax_event_date")
            if len(tax_day) < 10 {
                tax_day = day
            } else {
                tax_day = substr(tax_day, 0, 10)
            }
            let reason = orm_cell_by(iq, i, "vat_exemption_reason")
            let mut icur = str_trim(orm_cell_by(iq, i, "currency"))
            if icur == "" {
                icur = cur
            }
            let mut indicator = "C"
            let mut header_acc = "411"
            let mut line_acc = "702"
            if direction == "in" {
                indicator = "D"
                header_acc = "401"
                line_acc = "601"
            }
            let lineacc: Map<str, str> = map_new()
            let jid = orm_cell_by_i64(iq, i, "journal_entry_id")
            if jid > 0 {
                let jl = journal_lines_by_entry(db2, jid)?
                db2 = orm_db_q(jl)
                let mut want_h = "debit"
                let mut want_l = "credit"
                if direction == "in" {
                    want_h = "credit"
                    want_l = "debit"
                }
                let mut ji: i64 = 0
                while ji < orm_nrows(jl) {
                    let code = map_get(anra, int_to_str(orm_cell_by_i64(jl, ji, "account_id")))
                    if code != "" {
                        if orm_cell_by_i64(jl, ji, "product_id") == 0 && orm_cell_by_i64(jl, ji, "counterpart_id") > 0 && orm_cell_by(jl, ji, "direction") == want_h {
                            header_acc = code
                        }
                        if orm_cell_by_i64(jl, ji, "product_id") > 0 && orm_cell_by(jl, ji, "direction") == want_l {
                            map_set(lineacc, int_to_str(orm_cell_by_i64(jl, ji, "product_id")), code)
                        }
                    }
                    ji = ji + 1
                }
            }
            let cp = sfts_find_cp(kq, orm_cell_by_i64(iq, i, "counterpart_id"))
            let mut eik = ""
            let mut cname = ""
            let mut city = ""
            let mut country = "BG"
            if cp >= 0 {
                eik = orm_cell_by(kq, cp, "eik")
                cname = orm_cell_by(kq, cp, "name")
                city = orm_cell_by(kq, cp, "city")
                country = orm_cell_by(kq, cp, "country")
            }
            let lq = invoice_lines_by_invoice(db2, orm_cell_by_i64(iq, i, "id"))?
            db2 = orm_db_q(lq)
            let mut lines = ""
            let mut nline: i64 = 0
            let mut li: i64 = 0
            while li < orm_nrows(lq) {
                let pid = int_to_str(orm_cell_by_i64(lq, li, "product_id"))
                let packed = map_get(goods, pid)
                let bar = str_find(packed, "|")
                let mut code = "0"
                let mut g = "01"
                if bar > 0 {
                    code = substr(packed, 0, bar)
                    g = substr(packed, bar + 1, len(packed))
                }
                nline = nline + 1
                let mut acc = map_get(lineacc, pid)
                if acc == "" {
                    acc = line_acc
                }
                lines = concat(lines, sfts_line(int_to_str(nline), acc, g, code, orm_cell_by(lq, li, "description"), orm_cell_by(lq, li, "quantity"), orm_cell_by(lq, li, "unit"), orm_cell_by(lq, li, "unit_price"), orm_cell_by(lq, li, "net_amount"), orm_cell_by(lq, li, "vat_amount"), orm_cell_by(lq, li, "vat_rate"), reason, tax_day, indicator, icur))
                li = li + 1
            }
            if nline == 0 {
                lines = sfts_line("1", line_acc, "01", "0", "Фактура", "1", "C62", orm_cell_by(iq, i, "net_amount"), orm_cell_by(iq, i, "net_amount"), orm_cell_by(iq, i, "vat_amount"), "20", reason, tax_day, indicator, icur)
            }
            let mut dtype_out = dtype
            if sfts_digits2(dtype) == 0 {
                dtype_out = "01"
            }
            let mut txn = int_to_str(orm_cell_by_i64(iq, i, "journal_entry_id"))
            if txn == "0" {
                txn = int_to_str(orm_cell_by_i64(iq, i, "id"))
            }
            let mut inv = ""
            inv = concat(inv, sfts_open("nsSAFT:Invoice"))
            inv = concat(inv, sfts_text("nsSAFT:InvoiceNo", sfts_clip(orm_cell_by(iq, i, "number"), 70)))
            inv = concat(inv, sfts_party_info(direction, eik, cname, city, country))
            inv = concat(inv, sfts_text("nsSAFT:AccountID", header_acc))
            inv = concat(inv, sfts_text("nsSAFT:Period", int_to_str(month)))
            inv = concat(inv, sfts_text("nsSAFT:PeriodYear", int_to_str(year)))
            inv = concat(inv, sfts_text("nsSAFT:InvoiceDate", day))
            inv = concat(inv, sfts_text("nsSAFT:InvoiceType", dtype_out))
            inv = concat(inv, sfts_text("nsSAFT:SelfBillingIndicator", "N"))
            inv = concat(inv, sfts_text("nsSAFT:TransactionID", txn))
            inv = concat(inv, lines)
            inv = concat(inv, sfts_open("nsSAFT:InvoiceDocumentTotals"))
            inv = concat(inv, sfts_text("nsSAFT:NetTotal", vat_money(vat_parse_amt(orm_cell_by(iq, i, "net_amount")))))
            inv = concat(inv, sfts_text("nsSAFT:GrossTotal", vat_money(vat_parse_amt(orm_cell_by(iq, i, "total_amount")))))
            inv = concat(inv, xml_close("nsSAFT:InvoiceDocumentTotals"))
            inv = concat(inv, xml_close("nsSAFT:Invoice"))
            let gross = vat_parse_amt(orm_cell_by(iq, i, "total_amount"))
            if direction == "out" {
                sales = concat(sales, inv)
                credit = vat_dadd(credit, gross)
                ns = ns + 1
            } else {
                purchases = concat(purchases, inv)
                debit = vat_dadd(debit, gross)
                np = np + 1
            }
        }
        i = i + 1
    }
    let mut sales_xml = ""
    sales_xml = concat(sales_xml, sfts_open("nsSAFT:SalesInvoices"))
    sales_xml = concat(sales_xml, sfts_text("nsSAFT:NumberOfEntries", int_to_str(ns)))
    sales_xml = concat(sales_xml, sfts_text("nsSAFT:TotalDebit", "0.00"))
    sales_xml = concat(sales_xml, sfts_text("nsSAFT:TotalCredit", vat_money(credit)))
    sales_xml = concat(sales_xml, sales)
    sales_xml = concat(sales_xml, xml_close("nsSAFT:SalesInvoices"))
    let mut buy_xml = ""
    buy_xml = concat(buy_xml, sfts_open("nsSAFT:PurchaseInvoices"))
    buy_xml = concat(buy_xml, sfts_text("nsSAFT:NumberOfEntries", int_to_str(np)))
    buy_xml = concat(buy_xml, sfts_text("nsSAFT:TotalDebit", vat_money(debit)))
    buy_xml = concat(buy_xml, sfts_text("nsSAFT:TotalCredit", "0.00"))
    buy_xml = concat(buy_xml, purchases)
    buy_xml = concat(buy_xml, xml_close("nsSAFT:PurchaseInvoices"))
    return SftSrc { ok: 1, err: "", db: db2, xml: "", sales: sales_xml, purchases: buy_xml }
}
