// actions/ubl_fmt.baga — суми, ДДС ставка, вид документ и VATEX за UBL импорт.
// Чисти функции. Парсерът е в ubl_parse.baga.

import "../models/unit.baga"
import "../models/vat_exemption.baga"
import "bagadecimal/src/decimal.baga"
import "std/str/str.baga"

fn ubl_upper(s: str) -> str {
    let mut out = ""
    let mut i: i64 = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c >= 97 && c <= 122 {
            out = concat(out, chr(c - 32))
        } else {
            out = concat(out, substr(s, i, i + 1))
        }
        i = i + 1
    }
    return out
}

fn ubl_compact(s: str) -> str {
    let t = str_trim(s)
    let mut out = ""
    let mut i: i64 = 0
    while i < len(t) {
        let c = char_at(t, i)
        if c != 32 && c != 9 && c != 10 && c != 13 {
            out = concat(out, substr(t, i, i + 1))
        }
        i = i + 1
    }
    return out
}

fn ubl_dot(s: str) -> str {
    let t = ubl_compact(s)
    let mut out = ""
    let mut i: i64 = 0
    while i < len(t) {
        let c = char_at(t, i)
        if c == 44 {
            out = concat(out, ".")
        } else {
            out = concat(out, substr(t, i, i + 1))
        }
        i = i + 1
    }
    return out
}

fn ubl_force2(s: str) -> str {
    let dot = str_find(s, ".")
    if dot < 0 {
        return concat(s, ".00")
    }
    let frac = len(s) - dot - 1
    if frac <= 0 {
        return concat(s, "00")
    }
    if frac == 1 {
        return concat(s, "0")
    }
    return s
}

fn ubl_money(s: str) -> str {
    let t = ubl_dot(s)
    if t == "" {
        return "0.00"
    }
    let p = dec_parse(t)
    if p.ok == 0 {
        return t
    }
    let r = dec_round_dp(p.value, 2)
    if r.ok == 0 {
        return ubl_force2(dec_to_string(p.value))
    }
    return ubl_force2(dec_to_string(r.value))
}

fn ubl_trim_qty(s: str) -> str {
    let t = ubl_dot(s)
    let dot = str_find(t, ".")
    if dot < 0 {
        return t
    }
    let mut end = len(t)
    while end > dot + 1 && char_at(t, end - 1) == 48 {
        end = end - 1
    }
    if end == dot + 1 {
        end = dot
    }
    if end <= 0 {
        return "0"
    }
    return substr(t, 0, end)
}

fn ubl_add(a: str, b: str) -> str {
    let x = dec_parse(ubl_dot(a))
    let y = dec_parse(ubl_dot(b))
    if x.ok == 0 || y.ok == 0 {
        return ubl_money(a)
    }
    let s = dec_add(x.value, y.value)
    if s.ok == 0 {
        return ubl_money(a)
    }
    return ubl_money(dec_to_string(s.value))
}

fn ubl_mul_pct(net: str, pct: str) -> str {
    let n = dec_parse(ubl_dot(net))
    let r = dec_parse(ubl_dot(pct))
    let h = dec_parse("100")
    if n.ok == 0 || r.ok == 0 || h.ok == 0 {
        return "0.00"
    }
    if dec_is_zero(n.value) == 1 || dec_is_zero(r.value) == 1 {
        return "0.00"
    }
    let m = dec_mul(n.value, r.value)
    if m.ok == 0 {
        return "0.00"
    }
    let d = dec_div(m.value, h.value)
    if d.ok == 0 {
        return "0.00"
    }
    return ubl_money(dec_to_string(d.value))
}

fn ubl_pct(s: str) -> str {
    let t = ubl_dot(s)
    if t == "" {
        return ""
    }
    let p = dec_parse(t)
    if p.ok == 0 {
        return "20"
    }
    if dec_is_zero(p.value) == 1 || dec_is_negative(p.value) == 1 {
        return "0"
    }
    let mid = dec_parse("14")
    if mid.ok == 1 && dec_cmp(p.value, mid.value) >= 0 {
        return "20"
    }
    return "9"
}

fn ubl_date(s: str) -> str {
    let t = str_trim(s)
    let tpos = str_find(t, "T")
    if tpos == 10 {
        return substr(t, 0, 10)
    }
    return t
}

fn ublx_unit(code: str) -> str {
    let t = str_trim(code)
    if t == "" {
        return "C62"
    }
    if unit_known(t) == 1 {
        return t
    }
    if len(t) >= 2 && len(t) <= 3 {
        return t
    }
    return "C62"
}

fn ubl_is_root(par: str) -> i64 {
    if par == "Invoice" || par == "CreditNote" || par == "DebitNote" {
        return 1
    }
    return 0
}

fn ubl_doc_type(root: str, code: str) -> str {
    if root == "CreditNote" || code == "381" || code == "396" {
        return "03"
    }
    if root == "DebitNote" || code == "383" {
        return "02"
    }
    if code == "325" {
        return "proforma"
    }
    return "01"
}

fn ubl_pay(code: str) -> str {
    if code == "10" || code == "20" {
        return "в брой"
    }
    if code == "48" || code == "54" || code == "55" {
        return "карта"
    }
    if code == "97" {
        return "компенсация"
    }
    return "банков превод"
}

fn ubl_vatex_from_cat(category: str) -> str {
    if category == "AE" {
        return "VATEX-EU-AE"
    }
    if category == "G" {
        return "VATEX-EU-G"
    }
    if category == "K" {
        return "VATEX-EU-IC"
    }
    if category == "O" {
        return "VATEX-EU-O"
    }
    return ""
}

fn ubl_vatex_code(raw: str, category: str) -> str {
    let code = ubl_upper(str_trim(raw))
    if code == "" {
        return ubl_vatex_from_cat(category)
    }
    if vatex_find_line(code) != "" {
        return code
    }
    let want = vatex_ascii_lower(code)
    let rows = vatex_catalog_rows()
    let mut i: i64 = 0
    let mut hit = ""
    let mut n: i64 = 0
    while i < vec_len(rows) {
        let p = str_split(vec_get(rows, i), "|")
        let mut ubl = ""
        let mut cat = ""
        let mut c = ""
        if vec_len(p) > 0 { c = vec_get(p, 0) }
        if vec_len(p) > 5 { cat = vec_get(p, 5) }
        if vec_len(p) > 6 { ubl = vec_get(p, 6) }
        if vatex_ascii_lower(ubl) == want || vatex_ascii_lower(c) == want {
            if hit == "" || cat == category {
                hit = c
            }
            n = n + 1
        }
        i = i + 1
    }
    if n == 1 {
        return hit
    }
    if n > 1 && category != "E" && category != "Z" && category != "O" && hit != "" {
        return hit
    }
    let fb = ubl_vatex_from_cat(category)
    if fb != "" {
        return fb
    }
    return ""
}

fn ubl_norm_vat(raw: str, country: str) -> str {
    let t = ubl_upper(ubl_compact(raw))
    if t == "" {
        return ""
    }
    if len(t) >= 2 {
        let c0 = char_at(t, 0)
        let c1 = char_at(t, 1)
        if c0 >= 65 && c0 <= 90 && c1 >= 65 && c1 <= 90 {
            return t
        }
    }
    let mut cc = ubl_upper(str_trim(country))
    if cc == "GR" {
        cc = "EL"
    }
    if len(cc) == 2 && len(t) >= 8 {
        return concat(cc, t)
    }
    return t
}
