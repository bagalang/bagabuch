// actions/bank_transactions.baga — банкови транзакции: преглед на файл,
// импорт с авто-осчетоводяване, ръчно осчетоводяване, разнасяне и изтриване.
// Сумите са десимални (bagadecimal) като стрингове. Порт на su-doxis
// bank_transactions.rs, адаптиран към bagabuch (journal_entries/lines).
import "../models/bank_account.baga"
import "../models/bank_transaction.baga"
import "../models/account.baga"
import "../models/journal.baga"
import "bank_parse.baga"
import "active_company.baga"
import "txn.baga"
import "periods.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "std/json/json.baga"
import "std/str/str.baga"
import "bagadecimal/src/decimal.baga"
// ─── Извличане на транзакции ───
fn act_bank_transactions_index(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    if ac.id <= 0 {
        return act_err(ac.db, 422, "няма избрана активна фирма")
    }
    let account_id = parse_int(fmr_query(ctx, "bank_account_id"))
    let mut q = bank_tx_by_company(ac.db, ac.id)?
    if account_id > 0 {
        q = bank_tx_by_account(orm_db_q(q), ac.id, account_id)?
    }
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    // Филтър по статус (new/booked/allocated) — в приложението, за да не се
    // разчита на две '=' условия в BoilaSQL.
    let status = fmr_query(ctx, "status")
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        let booked = orm_cell_by_i64(q, i, "is_booked")
        let allocated = orm_cell_by_i64(q, i, "is_allocated")
        let mut keep: i64 = 1
        if status == "new" {
            if booked != 0 {
                keep = 0
            }
        } else {
            if status == "booked" {
                if booked == 0 || allocated != 0 {
                    keep = 0
                }
            } else {
                if status == "allocated" {
                    if allocated == 0 {
                        keep = 0
                    }
                }
            }
        }
        if keep == 1 {
            arr = jarr_obj(arr, bank_tx_to_json(q, i))
        }
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", vec_len(arr.items))
    return act_ok(orm_db_q(q), o)
}
// ─── Преглед на файл (парсинг + откриване на дубликати) ───
fn act_bank_transactions_preview(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let ba_id = jreq_i64(b.doc, b.root, "bank_account_id")
    if ba_id.ok == 0 {
        return act_422_field(db, "bank_account_id", ba_id)
    }
    let content = jreq_str(b.doc, b.root, "file_content")
    if content.ok == 0 {
        return act_422_field(db, "file_content", content)
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let result = bp_detect_and_parse(content.val)
    if result.format_name == "" {
        return act_err(db, 422, "Непознат формат на файла. Поддържаните формати са: OBB XML, ISO camt.053, PostBank XML, MT-940, CSV.")
    }
    // Съществуващите референции за сметката (за дубликати).
    let rq = bank_tx_references_by_account(db, ba_id.num)?
    if orm_ok_q(rq) == 0 {
        return act_err(orm_db_q(rq), 500, orm_err_q(rq))
    }
    let mut db2 = orm_db_q(rq)
    let mut dup: i64 = 0
    let mut i: i64 = 0
    while i < vec_len(result.txs) {
        let mut tx = vec_get(result.txs, i)
        if tx.reference != "" {
            let mut j: i64 = 0
            while j < orm_nrows(rq) {
                if orm_cell_by(rq, j, "reference") == tx.reference {
                    tx.is_duplicate = 1
                    dup = dup + 1
                    j = orm_nrows(rq)
                } else {
                    j = j + 1
                }
            }
        }
        vec_set(result.txs, i, tx)
        i = i + 1
    }
    result.total_count = vec_len(result.txs)
    result.duplicate_count = dup
    result.new_count = result.total_count - dup
    return act_ok(db2, bp_result_to_json(result))
}
// ─── Импорт (с авто-осчетоводяване при конфигурирани ГЛ + буферна) ───
fn act_bank_transactions_import(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let ba_id = jreq_i64(b.doc, b.root, "bank_account_id")
    if ba_id.ok == 0 {
        return act_422_field(db, "bank_account_id", ba_id)
    }
    let content = jreq_str(b.doc, b.root, "file_content")
    if content.ok == 0 {
        return act_422_field(db, "file_content", content)
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    if ac.id <= 0 {
        return act_err(ac.db, 422, "няма избрана активна фирма")
    }
    // Банковата сметка трябва да е на фирмата.
    let baq = bank_account_find(ac.db, ba_id.num)?
    if orm_ok_q(baq) == 0 {
        return act_err(orm_db_q(baq), 500, orm_err_q(baq))
    }
    if orm_nrows(baq) < 1 {
        return act_404(orm_db_q(baq), "Банковата сметка не е намерена")
    }
    let mut d0 = orm_db_q(baq)
    let ba_name = orm_cell_by(baq, 0, "name")
    let gl_id = orm_cell_by_i64(baq, 0, "gl_account_id")
    let buf_id = orm_cell_by_i64(baq, 0, "buffer_account_id")
    let mut auto_journal: i64 = 0
    if gl_id > 0 && buf_id > 0 {
        auto_journal = 1
    }
    let result = bp_detect_and_parse(content.val)
    if result.format_name == "" {
        return act_err(d0, 422, "Непознат формат на файла. Поддържаните формати са: OBB XML, ISO camt.053, PostBank XML, MT-940, CSV.")
    }
    let rq = bank_tx_references_by_account(d0, ba_id.num)?
    if orm_ok_q(rq) == 0 {
        return act_err(orm_db_q(rq), 500, orm_err_q(rq))
    }
    d0 = orm_db_q(rq)
    let bgn = bb_begin(d0)?
    if orm_ok(bgn) == 0 {
        return act_err(orm_db_exec(bgn), 500, orm_err_exec(bgn))
    }
    let mut db2 = orm_db_exec(bgn)
    let mut imported: i64 = 0
    let mut journal_count: i64 = 0
    let mut i: i64 = 0
    while i < vec_len(result.txs) {
        let tx = vec_get(result.txs, i)
        // Пропускаме дубликати (по референция).
        let mut is_dup: i64 = 0
        if tx.reference != "" {
            let mut j: i64 = 0
            while j < orm_nrows(rq) {
                if orm_cell_by(rq, j, "reference") == tx.reference {
                    is_dup = 1
                    j = orm_nrows(rq)
                } else {
                    j = j + 1
                }
            }
        }
        if is_dup == 0 {
            let ap = dec_parse(tx.amount)
            if ap.ok == 1 {
                let mut tx_type = "DEPOSIT"
                if dec_is_negative(ap.value) != 0 {
                    tx_type = "WITHDRAWAL"
                }
                // period check при авто-осчетоводяване.
                if auto_journal == 1 {
                    let pc = period_assert_open(db2, tx.date)?
                    if pc.ok == 0 {
                        return act_err_rb(pc.db, 422, pc.err)
                    }
                    db2 = pc.db
                }
                let ins = bank_tx_create(db2, ba_id.num, tx.date, tx.amount, tx.currency, tx.contra_name, tx.contra_iban, tx.description, tx.reference, tx_type, auto_journal, 0, 0, ac.id)?
                if orm_ok_q(ins) == 0 || orm_nrows(ins) < 1 {
                    return act_err_rb(orm_db_q(ins), 500, "bank transaction insert failed")
                }
                let tx_id = orm_cell_by_i64(ins, 0, "id")
                db2 = orm_db_q(ins)
                imported = imported + 1
                if auto_journal == 1 {
                    let abs = dec_abs(ap.value)
                    let abs_s = dec_to_string(abs)
                    let mut desc = "Банково извлечение"
                    if ba_name != "" {
                        desc = concat(concat(desc, " "), ba_name)
                    }
                    if tx.description != "" {
                        desc = concat(concat(desc, " — "), tx.description)
                    }
                    // Дебит/кредит по знака на сумата (DEPOSIT → ГЛ дебит, буфер кредит).
                    let mut debit_acc = buf_id
                    let mut credit_acc = gl_id
                    if tx_type == "DEPOSIT" {
                        debit_acc = gl_id
                        credit_acc = buf_id
                    }
                    let eq = journal_entry_insert(db2, tx.date, "bank", 0, desc, "no_vat", 0, tx.contra_name, "", tx.reference, tx.date, "", abs_s, "0")?
                    if orm_ok_q(eq) == 0 || orm_nrows(eq) < 1 {
                        return act_err_rb(orm_db_q(eq), 500, "journal entry insert failed")
                    }
                    let entry_id = orm_cell_by_i64(eq, 0, "id")
                    db2 = orm_db_q(eq)
                    let l1 = journal_line_insert(db2, entry_id, debit_acc, "debit", abs_s, "0", 0, 0, 0)?
                    if orm_ok(l1) == 0 {
                        return act_err_rb(orm_db_exec(l1), 500, orm_err_exec(l1))
                    }
                    db2 = orm_db_exec(l1)
                    let l2 = journal_line_insert(db2, entry_id, credit_acc, "credit", abs_s, "0", 0, 0, 0)?
                    if orm_ok(l2) == 0 {
                        return act_err_rb(orm_db_exec(l2), 500, orm_err_exec(l2))
                    }
                    db2 = orm_db_exec(l2)
                    let tcols = vec_new()
                    vec_push(tcols, "journal_entry_id")
                    let tvals = vec_new()
                    vec_push(tvals, int_to_str(entry_id))
                    let tup = orm_update_by_id(db2, bank_tx_table(), tx_id, tcols, tvals)?
                    if orm_ok(tup) == 0 {
                        return act_err_rb(orm_db_exec(tup), 500, orm_err_exec(tup))
                    }
                    db2 = orm_db_exec(tup)
                    journal_count = journal_count + 1
                }
            }
        }
        i = i + 1
    }
    let cmt = bb_commit(db2)?
    if orm_ok(cmt) == 0 {
        return act_err_rb(orm_db_exec(cmt), 500, orm_err_exec(cmt))
    }
    let mut o = jobj_new()
    o = jobj_i64(o, "imported", imported)
    o = jobj_i64(o, "journal_count", journal_count)
    return act_ok(orm_db_exec(cmt), o)
}
// ─── Ръчно осчетоводяване на единична транзакция ───
fn act_bank_transactions_book(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let debit_id = jreq_i64(b.doc, b.root, "debit_account_id")
    if debit_id.ok == 0 {
        return act_422_field(db, "debit_account_id", debit_id)
    }
    let credit_id = jreq_i64(b.doc, b.root, "credit_account_id")
    if credit_id.ok == 0 {
        return act_422_field(db, "credit_account_id", credit_id)
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let tq = bank_tx_find(db, id)?
    if orm_ok_q(tq) == 0 {
        return act_err(orm_db_q(tq), 500, orm_err_q(tq))
    }
    if orm_nrows(tq) < 1 {
        return act_404(orm_db_q(tq), "Транзакцията не е намерена")
    }
    if orm_cell_by_i64(tq, 0, "is_booked") != 0 {
        return act_err(orm_db_q(tq), 409, "транзакцията вече е осчетоводена")
    }
    let mut d0 = orm_db_q(tq)
    let tx_date = orm_cell_by(tq, 0, "txn_date")
    let tx_amount = orm_cell_by(tq, 0, "amount")
    let tx_desc = orm_cell_by(tq, 0, "description")
    let tx_contra = orm_cell_by(tq, 0, "counterpart_name")
    let ap = dec_parse(tx_amount)
    if ap.ok == 0 {
        return act_err(d0, 422, "невалидна сума на транзакцията")
    }
    let abs = dec_abs(ap.value)
    let abs_s = dec_to_string(abs)
    let pc = period_assert_open(d0, tx_date)?
    if pc.ok == 0 {
        return act_err(pc.db, 422, pc.err)
    }
    d0 = pc.db
    let mut desc = "Ръчно осчетоводяване"
    if tx_desc != "" {
        desc = concat(concat(desc, ": "), tx_desc)
    }
    let bgn = bb_begin(d0)?
    if orm_ok(bgn) == 0 {
        return act_err(orm_db_exec(bgn), 500, orm_err_exec(bgn))
    }
    let mut db2 = orm_db_exec(bgn)
    let eq = journal_entry_insert(db2, tx_date, "bank", 0, desc, "no_vat", 0, tx_contra, "", "", tx_date, "", abs_s, "0")?
    if orm_ok_q(eq) == 0 || orm_nrows(eq) < 1 {
        return act_err_rb(orm_db_q(eq), 500, "journal entry insert failed")
    }
    let entry_id = orm_cell_by_i64(eq, 0, "id")
    db2 = orm_db_q(eq)
    let l1 = journal_line_insert(db2, entry_id, debit_id.num, "debit", abs_s, "0", 0, 0, 0)?
    if orm_ok(l1) == 0 {
        return act_err_rb(orm_db_exec(l1), 500, orm_err_exec(l1))
    }
    db2 = orm_db_exec(l1)
    let l2 = journal_line_insert(db2, entry_id, credit_id.num, "credit", abs_s, "0", 0, 0, 0)?
    if orm_ok(l2) == 0 {
        return act_err_rb(orm_db_exec(l2), 500, orm_err_exec(l2))
    }
    db2 = orm_db_exec(l2)
    let tcols = vec_new()
    vec_push(tcols, "is_booked")
    vec_push(tcols, "is_allocated")
    vec_push(tcols, "journal_entry_id")
    let tvals = vec_new()
    vec_push(tvals, "1")
    vec_push(tvals, "1")
    vec_push(tvals, int_to_str(entry_id))
    let tup = orm_update_by_id(db2, bank_tx_table(), id, tcols, tvals)?
    if orm_ok(tup) == 0 {
        return act_err_rb(orm_db_exec(tup), 500, orm_err_exec(tup))
    }
    db2 = orm_db_exec(tup)
    let cmt = bb_commit(db2)?
    if orm_ok(cmt) == 0 {
        return act_err_rb(orm_db_exec(cmt), 500, orm_err_exec(cmt))
    }
    return act_msg(orm_db_exec(cmt), "транзакцията е осчетоводена")
}
// ─── Разнасяне (замяна на буферната сметка с реална) ───
fn act_bank_transactions_reallocate(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let new_acc = jreq_i64(b.doc, b.root, "account_id")
    if new_acc.ok == 0 {
        return act_422_field(db, "account_id", new_acc)
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let tq = bank_tx_find(db, id)?
    if orm_ok_q(tq) == 0 {
        return act_err(orm_db_q(tq), 500, orm_err_q(tq))
    }
    if orm_nrows(tq) < 1 {
        return act_404(orm_db_q(tq), "Транзакцията не е намерена")
    }
    let entry_id = orm_cell_by_i64(tq, 0, "journal_entry_id")
    if entry_id <= 0 {
        return act_err(orm_db_q(tq), 422, "Транзакцията няма счетоводен запис")
    }
    let ba_id = orm_cell_by_i64(tq, 0, "bank_account_id")
    let mut d0 = orm_db_q(tq)
    let baq = bank_account_find(d0, ba_id)?
    if orm_ok_q(baq) == 0 {
        return act_err(orm_db_q(baq), 500, orm_err_q(baq))
    }
    if orm_nrows(baq) < 1 {
        return act_404(orm_db_q(baq), "Банковата сметка не е намерена")
    }
    let buffer_id = orm_cell_by_i64(baq, 0, "buffer_account_id")
    if buffer_id <= 0 {
        return act_err(orm_db_q(baq), 422, "Няма буферна сметка")
    }
    d0 = orm_db_q(baq)
    let lq = journal_lines_by_entry(d0, entry_id)?
    if orm_ok_q(lq) == 0 {
        return act_err(orm_db_q(lq), 500, orm_err_q(lq))
    }
    d0 = orm_db_q(lq)
    let bgn = bb_begin(d0)?
    if orm_ok(bgn) == 0 {
        return act_err(orm_db_exec(bgn), 500, orm_err_exec(bgn))
    }
    let mut db2 = orm_db_exec(bgn)
    // Замени буферната сметка във всички редове на записа.
    let mut i: i64 = 0
    let mut replaced: i64 = 0
    while i < orm_nrows(lq) {
        if orm_cell_by_i64(lq, i, "account_id") == buffer_id {
            let line_id = orm_cell_by_i64(lq, i, "id")
            let cols = vec_new()
            vec_push(cols, "account_id")
            let vals = vec_new()
            vec_push(vals, int_to_str(new_acc.num))
            let up = orm_update_by_id(db2, journal_line_table(), line_id, cols, vals)?
            if orm_ok(up) == 0 {
                return act_err_rb(orm_db_exec(up), 500, orm_err_exec(up))
            }
            db2 = orm_db_exec(up)
            replaced = replaced + 1
        }
        i = i + 1
    }
    let tcols = vec_new()
    vec_push(tcols, "is_allocated")
    let tvals = vec_new()
    vec_push(tvals, "1")
    let tup = orm_update_by_id(db2, bank_tx_table(), id, tcols, tvals)?
    if orm_ok(tup) == 0 {
        return act_err_rb(orm_db_exec(tup), 500, orm_err_exec(tup))
    }
    db2 = orm_db_exec(tup)
    let cmt = bb_commit(db2)?
    if orm_ok(cmt) == 0 {
        return act_err_rb(orm_db_exec(cmt), 500, orm_err_exec(cmt))
    }
    db2 = orm_db_exec(cmt)
    // Име на новата сметка (номер + име) за съобщението.
    let aq = account_find(db2, new_acc.num)?
    let mut acc_name = ""
    if orm_ok_q(aq) == 1 && orm_nrows(aq) > 0 {
        acc_name = orm_cell_by(aq, 0, "number")
        let an = orm_cell_by(aq, 0, "name")
        if an != "" {
            acc_name = concat(concat(acc_name, " "), an)
        }
    }
    if acc_name == "" {
        acc_name = int_to_str(new_acc.num)
    }
    let mut o = jobj_new()
    o = jobj_str(o, "message", concat("Транзакцията е разнесена към ", acc_name))
    o = jobj_str(o, "account_name", acc_name)
    o = jobj_i64(o, "replaced_lines", replaced)
    return act_ok(db2, o)
}
// ─── Изтриване на транзакция (със свързания запис) ───
fn act_bank_transactions_delete(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let tq = bank_tx_find(db, id)?
    if orm_ok_q(tq) == 0 {
        return act_err(orm_db_q(tq), 500, orm_err_q(tq))
    }
    if orm_nrows(tq) < 1 {
        return act_404(orm_db_q(tq), "Транзакцията не е намерена")
    }
    let entry_id = orm_cell_by_i64(tq, 0, "journal_entry_id")
    let mut d0 = orm_db_q(tq)
    let bgn = bb_begin(d0)?
    if orm_ok(bgn) == 0 {
        return act_err(orm_db_exec(bgn), 500, orm_err_exec(bgn))
    }
    let mut db2 = orm_db_exec(bgn)
    // Изтрий свързания счетоводен запис (редове + запис).
    if entry_id > 0 {
        let ldel = orm_delete_lit(db2, journal_line_table(), "entry_id", int_to_str(entry_id))?
        if orm_ok(ldel) == 0 {
            return act_err_rb(orm_db_exec(ldel), 500, orm_err_exec(ldel))
        }
        db2 = orm_db_exec(ldel)
        let jdel = orm_delete_by_id(db2, journal_entry_table(), entry_id)?
        if orm_ok(jdel) == 0 {
            return act_err_rb(orm_db_exec(jdel), 500, orm_err_exec(jdel))
        }
        db2 = orm_db_exec(jdel)
    }
    let del = bank_tx_delete(db2, id)?
    if orm_ok(del) == 0 {
        return act_err_rb(orm_db_exec(del), 500, orm_err_exec(del))
    }
    db2 = orm_db_exec(del)
    let cmt = bb_commit(db2)?
    if orm_ok(cmt) == 0 {
        return act_err_rb(orm_db_exec(cmt), 500, orm_err_exec(cmt))
    }
    return act_no_content(orm_db_exec(cmt))
}
