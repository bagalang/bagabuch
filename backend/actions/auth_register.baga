// actions/auth_register.baga — публична регистрация с нова фирма (като baraba).

import "../models/user.baga"
import "../models/company.baga"
import "../models/setting.baga"
import "accounts_seed.baga"
import "active_company.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "std/str/str.baga"

fn auth_reg_enabled(db: OrmDb) -> i64 !IO !Net {
    let q = setting_get_by_key(db, "auth.registration_enabled")?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return 1
    }
    let v = orm_cell_by(q, 0, "value")
    if v == "0" || v == "false" {
        return 0
    }
    return 1
}

fn auth_email_ok(s: str) -> i64 {
    if str_find(s, "@") < 1 {
        return 0
    }
    return 1
}

fn act_reg_status(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let en = auth_reg_enabled(db)?
    let mut o = jobj_new()
    o = jobj_i64(o, "ok", 1)
    o = jobj_i64(o, "registration_enabled", en)
    return act_ok(db, o)
}

fn act_register(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    if auth_reg_enabled(db)? == 0 {
        return act_err(db, 403, "Регистрацията е спряна.")
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let email = jreq_str(b.doc, b.root, "email")
    if email.ok == 0 || auth_email_ok(email.val) == 0 {
        return act_err(db, 422, "валиден email е задължителен")
    }
    let name = jreq_str(b.doc, b.root, "name")
    if name.ok == 0 || str_trim(name.val) == "" {
        return act_err(db, 422, "името е задължително")
    }
    let password = jreq_str(b.doc, b.root, "password")
    if password.ok == 0 || len(password.val) < 8 {
        return act_err(db, 422, "паролата трябва да е поне 8 символа")
    }
    let confirm = jopt_str(b.doc, b.root, "password_confirmation", password.val)
    if confirm.val != password.val {
        return act_err(db, 422, "паролите не съвпадат")
    }
    let cname = jreq_str(b.doc, b.root, "company_name")
    if cname.ok == 0 || str_trim(cname.val) == "" {
        return act_err(db, 422, "име на фирмата е задължително")
    }
    let eik = jreq_str(b.doc, b.root, "company_eik")
    if eik.ok == 0 || str_trim(eik.val) == "" {
        return act_err(db, 422, "ЕИК е задължителен")
    }
    let vat = jopt_str(b.doc, b.root, "company_vat_number", "")
    let addr = jopt_str(b.doc, b.root, "company_address", "")
    let city = jopt_str(b.doc, b.root, "company_city", "")
    let em = str_trim(email.val)
    let uq = user_by_email(db, em)?
    if orm_ok_q(uq) == 0 {
        return act_err(orm_db_q(uq), 500, orm_err_q(uq))
    }
    if orm_nrows(uq) > 0 {
        return act_err(orm_db_q(uq), 422, "потребител с този email вече съществува")
    }
    let hash = user_hash_password(em, password.val)
    let ins = user_create(orm_db_q(uq), em, str_trim(name.val), hash, "admin", 1, 0, 0)?
    if orm_ok_q(ins) == 0 || orm_nrows(ins) < 1 {
        return act_err(orm_db_q(ins), 500, "неуспешно създаване на потребител")
    }
    let co = company_create(orm_db_q(ins), str_trim(cname.val), str_trim(eik.val), vat.val, 0, "monthly", "EUR", addr.val, city.val, "", "", em, "", "", "", "", "", "", "", "", "", "WAC", 1)?
    if orm_ok(co) == 0 {
        return act_err(orm_db_exec(co), 409, orm_err_exec(co))
    }
    let cq = company_all(orm_db_exec(co))?
    if orm_ok_q(cq) == 0 || orm_nrows(cq) < 1 {
        return act_err(orm_db_q(cq), 500, "фирмата липсва след създаване")
    }
    let cid = orm_cell_by_i64(cq, orm_nrows(cq) - 1, "id")
    let seed = account_seed_from_saft(orm_db_q(cq))?
    let up = setting_set_by_key(seed.db, active_company_key(em), int_to_str(cid))?
    if orm_ok(up) == 0 {
        return act_err(orm_db_exec(up), 500, orm_err_exec(up))
    }
    let mut o = jobj_new()
    o = jobj_i64(o, "ok", 1)
    o = jobj_str(o, "message", "Регистрацията е успешна. Можете да влезете.")
    o = jobj_i64(o, "company_id", cid)
    return act_created(orm_db_exec(up), o)
}
