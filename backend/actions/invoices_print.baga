// actions/invoices_print.baga — следващ номер + печат/експорт.
// Един добре формиран XHTML документ → reportbaga (HTML → PDF / XLSX / ODS / DOCX / ODT).

import "../models/invoice.baga"
import "../models/counterpart.baga"
import "../models/company.baga"
import "../models/setting.baga"
import "../models/doc_type.baga"
import "../models/vat_exemption.baga"
import "document_series.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "httpdbaga/http.baga"
import "xmlbaga/xml.baga"
import "reportbaga/report.baga"
import "chronobaga/src/chrono.baga"
import "std/str/str.baga"

fn inv_type_title(t: str) -> str {
    return doc_type_title(t)
}

fn inv_type_prefix(t: str) -> str {
    return doc_type_prefix(t)
}

fn inv_h(s: str) -> str {
    return xml_escape_text(s)
}

fn inv_date(s: str) -> str {
    return xml_escape_text(dt_to_bg_or(s))
}

fn inv_cell(tag: str, s: str) -> str {
    return concat(concat(concat(concat("<", tag), ">"), inv_h(s)), concat("</", concat(tag, ">")))
}

fn inv_row2(tag: str, a: str, b: str) -> str {
    let mut o = "<tr>"
    o = concat(o, inv_cell(tag, a))
    o = concat(o, inv_cell(tag, b))
    o = concat(o, "</tr>")
    return o
}

fn inv_row6(tag: str, a: str, b: str, c: str, d: str, e: str, f: str) -> str {
    let mut o = "<tr>"
    o = concat(o, inv_cell(tag, a))
    o = concat(o, inv_cell(tag, b))
    o = concat(o, inv_cell(tag, c))
    o = concat(o, inv_cell(tag, d))
    o = concat(o, inv_cell(tag, e))
    o = concat(o, inv_cell(tag, f))
    o = concat(o, "</tr>")
    return o
}

fn inv_w_ones(n: i64, fem: i64) -> str {
    if n == 1 {
        if fem == 1 {
            return "една"
        }
        return "един"
    }
    if n == 2 {
        if fem == 1 {
            return "две"
        }
        return "два"
    }
    if n == 3 { return "три" }
    if n == 4 { return "четири" }
    if n == 5 { return "пет" }
    if n == 6 { return "шест" }
    if n == 7 { return "седем" }
    if n == 8 { return "осем" }
    if n == 9 { return "девет" }
    return ""
}

fn inv_w_under100(n: i64, fem: i64) -> str {
    if n <= 0 { return "" }
    if n < 10 { return inv_w_ones(n, fem) }
    if n == 10 { return "десет" }
    if n == 11 { return "единадесет" }
    if n == 12 { return "дванадесет" }
    if n == 13 { return "тринадесет" }
    if n == 14 { return "четиринадесет" }
    if n == 15 { return "петнадесет" }
    if n == 16 { return "шестнадесет" }
    if n == 17 { return "седемнадесет" }
    if n == 18 { return "осемнадесет" }
    if n == 19 { return "деветнадесет" }
    let ten = n / 10
    let one = n - ten * 10
    let mut t = ""
    if ten == 2 { t = "двадесет" }
    if ten == 3 { t = "тридесет" }
    if ten == 4 { t = "четиридесет" }
    if ten == 5 { t = "петдесет" }
    if ten == 6 { t = "шестдесет" }
    if ten == 7 { t = "седемдесет" }
    if ten == 8 { t = "осемдесет" }
    if ten == 9 { t = "деветдесет" }
    if one == 0 { return t }
    return concat(t, concat(" и ", inv_w_ones(one, fem)))
}

fn inv_w_hundreds(n: i64, fem: i64) -> str {
    if n <= 0 { return "" }
    if n < 100 { return inv_w_under100(n, fem) }
    let h = n / 100
    let rest = n - h * 100
    let mut hs = ""
    if h == 1 { hs = "сто" }
    if h == 2 { hs = "двеста" }
    if h == 3 { hs = "триста" }
    if h == 4 { hs = "четиристотин" }
    if h == 5 { hs = "петстотин" }
    if h == 6 { hs = "шестстотин" }
    if h == 7 { hs = "седемстотин" }
    if h == 8 { hs = "осемстотин" }
    if h == 9 { hs = "деветстотин" }
    if rest == 0 { return hs }
    if rest < 20 {
        return concat(hs, concat(" и ", inv_w_under100(rest, fem)))
    }
    return concat(hs, concat(" ", inv_w_under100(rest, fem)))
}

fn inv_w_int(n: i64, fem: i64) -> str {
    if n == 0 { return "нула" }
    if n < 1000 { return inv_w_hundreds(n, fem) }
    let th = n / 1000
    let rest = n - th * 1000
    let mut head = ""
    if th == 1 {
        head = "хиляда"
    } else {
        if th == 2 {
            head = "две хиляди"
        } else {
            head = concat(inv_w_hundreds(th, 1), " хиляди")
        }
    }
    if rest == 0 { return head }
    if rest < 100 {
        return concat(head, concat(" и ", inv_w_hundreds(rest, fem)))
    }
    return concat(head, concat(" ", inv_w_hundreds(rest, fem)))
}

fn inv_slovom(amount: str, currency: str) -> str {
    let s = str_replace(amount, ",", ".")
    let parts = str_split(s, ".")
    let whole = parse_int(vec_get(parts, 0))
    let mut cents: i64 = 0
    if vec_len(parts) > 1 {
        let c = vec_get(parts, 1)
        if len(c) == 1 {
            cents = parse_int(c) * 10
        } else {
            if len(c) >= 2 {
                cents = parse_int(substr(c, 0, 2))
            }
        }
    }
    let mut fem: i64 = 0
    let mut cur = currency
    let mut centn = "стотинки"
    if currency == "BGN" {
        fem = 1
        if whole == 1 {
            cur = "лев"
        } else {
            cur = "лева"
        }
        centn = "стотинки"
    }
    if currency == "EUR" {
        cur = "евро"
        centn = "евроцента"
    }
    let mut out = concat(inv_w_int(whole, fem), concat(" ", cur))
    if cents > 0 {
        out = concat(out, concat(" и ", concat(int_to_str(cents), concat(" ", centn))))
    }
    return out
}

fn inv_mime(format: str) -> str {
    if format == "pdf" {
        return "application/pdf"
    }
    if format == "docx" {
        return "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
    }
    if format == "odt" {
        return "application/vnd.oasis.opendocument.text"
    }
    return "application/octet-stream"
}

fn act_invoices_next_number(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let mut document_type = fmr_query(ctx, "document_type")
    if document_type == "" {
        document_type = "01"
    }
    let mut direction = fmr_query(ctx, "direction")
    if direction == "" {
        direction = "out"
    }
    if direction != "in" && direction != "out" {
        return act_err(db, 422, "direction must be 'in' or 'out'")
    }
    if doc_type_valid_for(direction, document_type) == 0 {
        return act_err(db, 422, "невалиден вид данъчен документ за тази посока (код по ППДДС)")
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let mut number = ""
    if direction == "out" {
        number = invoice_auto_number(db, document_type)?
    }
    let mut o = jobj_new()
    o = jobj_str(o, "number", number)
    o = jobj_str(o, "document_type", document_type)
    o = jobj_str(o, "direction", direction)
    return act_ok(db, o)
}

fn inv_file_resp(db: OrmDb, data: bytes, mime: str, filename: str) -> FmrOut {
    let mut r = http_response_bytes(200, data)
    r = http_set_header(r, "Content-Type", mime)
    r = http_set_header(r, "Content-Disposition", concat(concat("attachment; filename=\"", filename), "\""))
    return fmr_out(r, db)
}

fn act_invoices_print(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    let mut format = fmr_query(ctx, "format")
    if format == "" {
        format = "pdf"
    }
    if format != "pdf" && format != "docx" && format != "odt" {
        return act_err(db, 422, "format трябва да е pdf/docx/odt")
    }
    let is_copy = fmr_query(ctx, "copy")
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let q = invoice_find(db, id)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    if orm_nrows(q) < 1 {
        return act_404(orm_db_q(q), "Invoice not found")
    }
    let number = orm_cell_by(q, 0, "number")
    let document_type = orm_cell_by(q, 0, "document_type")
    let direction = orm_cell_by(q, 0, "direction")
    let issue_date = orm_cell_by(q, 0, "issue_date")
    let tax_event_date = orm_cell_by(q, 0, "tax_event_date")
    let due_date = orm_cell_by(q, 0, "due_date")
    let currency = orm_cell_by(q, 0, "currency")
    let net_amount = orm_cell_by(q, 0, "net_amount")
    let vat_amount = orm_cell_by(q, 0, "vat_amount")
    let total_amount = orm_cell_by(q, 0, "total_amount")
    let payment_method = orm_cell_by(q, 0, "payment_method")
    let notes = orm_cell_by(q, 0, "notes")
    let vat_ex = orm_cell_by(q, 0, "vat_exemption_reason")
    let status = orm_cell_by(q, 0, "status")
    let cid = orm_cell_by_i64(q, 0, "counterpart_id")
    let mut d = orm_db_q(q)
    let mut cp_name = ""
    let mut cp_eik = ""
    let mut cp_vat = ""
    let mut cp_addr = ""
    let mut cp_city = ""
    if cid > 0 {
        let cq = counterpart_find(d, cid)?
        if orm_ok_q(cq) == 1 {
            if orm_nrows(cq) > 0 {
                cp_name = orm_cell_by(cq, 0, "name")
                cp_eik = orm_cell_by(cq, 0, "eik")
                cp_vat = orm_cell_by(cq, 0, "vat_number")
                cp_addr = orm_cell_by(cq, 0, "address")
                cp_city = orm_cell_by(cq, 0, "city")
            }
            d = orm_db_q(cq)
        }
    }
    let mut co_name = ""
    let mut co_eik = ""
    let mut co_vat = ""
    let mut co_addr = ""
    let mut co_city = ""
    let mut co_mol = ""
    let mut co_iban = ""
    let mut co_bic = ""
    let key = concat("активна_фирма:", auth.ctx.user_sub)
    let sq = setting_get_by_key(d, key)?
    if orm_ok_q(sq) == 1 {
        d = orm_db_q(sq)
        if orm_nrows(sq) > 0 {
            let coid = parse_int(orm_cell_by(sq, 0, "value"))
            if coid > 0 {
                let coq = company_find(d, coid)?
                if orm_ok_q(coq) == 1 {
                    if orm_nrows(coq) > 0 {
                        co_name = orm_cell_by(coq, 0, "name")
                        co_eik = orm_cell_by(coq, 0, "eik")
                        co_vat = orm_cell_by(coq, 0, "vat_number")
                        co_addr = orm_cell_by(coq, 0, "address")
                        co_city = orm_cell_by(coq, 0, "city")
                        co_mol = orm_cell_by(coq, 0, "mol")
                        co_iban = orm_cell_by(coq, 0, "iban")
                        co_bic = orm_cell_by(coq, 0, "bic")
                    }
                    d = orm_db_q(coq)
                }
            }
        }
    }
    let lq = invoice_lines_by_invoice(d, id)?
    if orm_ok_q(lq) == 0 {
        return act_err(orm_db_q(lq), 500, orm_err_q(lq))
    }
    let d2 = orm_db_q(lq)
    let title = inv_type_title(document_type)
    let full_no = concat(inv_type_prefix(document_type), number)
    let mut copy_label = "ОРИГИНАЛ"
    if is_copy == "1" {
        copy_label = "КОПИЕ"
    }
    let mut rec_name = cp_name
    let mut rec_eik = cp_eik
    let mut rec_vat = cp_vat
    let mut rec_addr = cp_addr
    let mut rec_city = cp_city
    let mut sup_name = co_name
    let mut sup_eik = co_eik
    let mut sup_vat = co_vat
    let mut sup_addr = co_addr
    let mut sup_city = co_city
    let mut sup_mol = co_mol
    if direction == "in" {
        rec_name = co_name
        rec_eik = co_eik
        rec_vat = co_vat
        rec_addr = co_addr
        rec_city = co_city
        sup_name = cp_name
        sup_eik = cp_eik
        sup_vat = cp_vat
        sup_addr = cp_addr
        sup_city = cp_city
        sup_mol = ""
    }
    let heading = concat(title, concat(" № ", full_no))
    let mut rec_addr_s = rec_addr
    if rec_city != "" {
        rec_addr_s = concat(rec_addr, concat(" ", rec_city))
    }
    let mut sup_addr_s = sup_addr
    if sup_city != "" {
        sup_addr_s = concat(sup_addr, concat(" ", sup_city))
    }
    let mut sup_vat_s = concat("ДДС №: ", sup_vat)
    if sup_mol != "" {
        sup_vat_s = concat(sup_vat_s, concat(" · МОЛ: ", sup_mol))
    }
    let mut html = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
    html = concat(html, "<html xmlns=\"http://www.w3.org/1999/xhtml\"><head><meta charset=\"utf-8\"/><title>")
    html = concat(html, inv_h(heading))
    html = concat(html, "</title></head><body>")
    if status == "cancelled" {
        html = concat(html, "<p>АНУЛИРАНА</p>")
    }
    html = concat(html, concat("<h1>", concat(inv_h(title), "</h1>")))
    html = concat(html, concat("<p>( ", concat(inv_h(copy_label), " )</p>")))
    html = concat(html, concat("<p>№ ", concat(inv_h(full_no), "</p>")))
    html = concat(html, concat("<p>Дата: ", concat(inv_date(issue_date), "</p>")))
    if tax_event_date != "" {
        html = concat(html, concat("<p>Дан. дата: ", concat(inv_date(tax_event_date), "</p>")))
    }
    html = concat(html, "<table>")
    html = concat(html, inv_row2("th", "ПОЛУЧАТЕЛ", "ДОСТАВЧИК"))
    html = concat(html, inv_row2("td", rec_name, sup_name))
    html = concat(html, inv_row2("td", rec_addr_s, sup_addr_s))
    html = concat(html, inv_row2("td", concat("ЕИК: ", rec_eik), concat("ЕИК: ", sup_eik)))
    html = concat(html, inv_row2("td", concat("ДДС №: ", rec_vat), sup_vat_s))
    html = concat(html, "</table>")
    html = concat(html, "<table>")
    html = concat(html, inv_row6("th", "No", "Стока / услуга", "К-во", "Мярка", "Ед. цена", "Общо"))
    let mut i: i64 = 0
    while i < orm_nrows(lq) {
        html = concat(html, inv_row6("td", int_to_str(i + 1), orm_cell_by(lq, i, "description"), orm_cell_by(lq, i, "quantity"), orm_cell_by(lq, i, "unit"), orm_cell_by(lq, i, "unit_price"), orm_cell_by(lq, i, "net_amount")))
        i = i + 1
    }
    html = concat(html, "</table>")
    html = concat(html, "<table>")
    html = concat(html, inv_row2("td", "Данъчна основа", concat(net_amount, concat(" ", currency))))
    html = concat(html, inv_row2("td", "ДДС", concat(vat_amount, concat(" ", currency))))
    html = concat(html, inv_row2("td", "ОБЩО ЗА ПЛАЩАНЕ", concat(total_amount, concat(" ", currency))))
    html = concat(html, "</table>")
    if co_iban != "" {
        let mut bank = concat("IBAN: ", co_iban)
        if co_bic != "" {
            bank = concat(bank, concat(" · BIC: ", co_bic))
        }
        html = concat(html, concat("<p>БАНКОВА СМЕТКА · ", concat(inv_h(bank), "</p>")))
    }
    if payment_method != "" {
        html = concat(html, concat("<p>Начин на плащане: ", concat(inv_h(payment_method), "</p>")))
    }
    if due_date != "" {
        html = concat(html, concat("<p>Срок за плащане: ", concat(inv_h(due_date), "</p>")))
    }
    if notes != "" {
        html = concat(html, concat("<p>Забележка: ", concat(inv_h(notes), "</p>")))
    }
    if vat_ex != "" {
        let mut vat_label = vat_ex
        if vatex_find_line(vat_ex) != "" {
            vat_label = concat(vatex_name(vat_ex), concat(" — ", vatex_field(vat_ex, 3)))
        }
        html = concat(html, concat("<p>Основание за неначисляване на ДДС: ", concat(inv_h(vat_label), "</p>")))
    }
    html = concat(html, concat("<p>Словом: ", concat(inv_h(inv_slovom(total_amount, currency)), "</p>")))
    html = concat(html, "</body></html>")
    let fname = concat(concat("faktura-", number), concat(".", format))
    let out = report_from_html_io(html, format)?
    if out.ok == 0 {
        return act_err(d2, 500, out.err)
    }
    return inv_file_resp(d2, out.data, inv_mime(format), fname)
}
