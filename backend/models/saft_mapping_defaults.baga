// models/saft_mapping_defaults.baga — примерни Дт/Кт за българския сметкоплан.
// Ред: type_code|debit|credit|description. Вътрешен трансфер е същата сметка
// (302/302, 304/304), не Дт 302 / Кт 304.

fn smap_def_push(rows: Vec<str>, line: str) -> Vec<str> {
    vec_push(rows, line)
    return rows
}

fn smap_default_stock() -> Vec<str> {
    let mut r = vec_new()
    r = smap_def_push(r, "10|302|401|Материали от доставчици")
    r = smap_def_push(r, "10|303|401|Продукция от доставчици")
    r = smap_def_push(r, "10|304|401|Стоки от доставчици")
    r = smap_def_push(r, "10|301|401|Материални запаси от доставчици")
    r = smap_def_push(r, "20|303|611|Продукция от производство")
    r = smap_def_push(r, "20|302|611|Материали от производство")
    r = smap_def_push(r, "30|701|304|Продажба на стоки")
    r = smap_def_push(r, "30|701|303|Продажба на продукция")
    r = smap_def_push(r, "30|702|304|Приходи от продажби на стоки")
    r = smap_def_push(r, "30|411|701|Вземания от клиенти")
    r = smap_def_push(r, "40|304|701|Върнати стоки")
    r = smap_def_push(r, "40|303|701|Върната продукция")
    r = smap_def_push(r, "50|401|302|Върнати материали към доставчик")
    r = smap_def_push(r, "50|401|304|Върнати стоки към доставчик")
    r = smap_def_push(r, "70|601|302|Разход на материали за производство")
    r = smap_def_push(r, "70|611|302|Вложени материали в производство")
    r = smap_def_push(r, "80|302|302|Вътрешен трансфер на материали")
    r = smap_def_push(r, "80|304|304|Вътрешен трансфер на стоки")
    r = smap_def_push(r, "110|302|709|Излишък на материали")
    r = smap_def_push(r, "110|304|709|Излишък на стоки")
    r = smap_def_push(r, "120|609|302|Липса на материали")
    r = smap_def_push(r, "120|609|304|Липса на стоки")
    r = smap_def_push(r, "160|609|302|Бракувани материали")
    r = smap_def_push(r, "160|609|304|Бракувани стоки")
    return r
}

fn smap_default_asset() -> Vec<str> {
    let mut r = vec_new()
    r = smap_def_push(r, "10|203|401|Придобиване на машини от доставчик")
    r = smap_def_push(r, "10|204|401|Придобиване на съоръжения от доставчик")
    r = smap_def_push(r, "10|205|401|Придобиване на транспортни средства")
    r = smap_def_push(r, "10|206|401|Придобиване на стопански инвентар")
    r = smap_def_push(r, "10|207|401|Придобиване на компютърна техника")
    r = smap_def_push(r, "10|201|401|Придобиване на земи")
    r = smap_def_push(r, "10|202|401|Придобиване на сгради")
    r = smap_def_push(r, "10|20*|613|Придобиване със собствени сили")
    r = smap_def_push(r, "20|411|705|Продажба на ДМА - приход")
    r = smap_def_push(r, "20|241|20*|Отписване на амортизация при продажба")
    r = smap_def_push(r, "20|705|20*|Отписване на балансова стойност")
    r = smap_def_push(r, "30|603|241|Начисляване на амортизация на машини")
    r = smap_def_push(r, "30|603|242|Начисляване на амортизация на сгради")
    r = smap_def_push(r, "30|603|24*|Начисляване на амортизация (общо)")
    r = smap_def_push(r, "40|20*|20*|Вътрешен трансфер между поделения")
    r = smap_def_push(r, "50|241|20*|Отписване на амортизация при брак")
    r = smap_def_push(r, "50|609|20*|Отписване на остатъчна стойност при брак")
    r = smap_def_push(r, "60|608|20*|Отрицателна преоценка на ДМА")
    r = smap_def_push(r, "70|20*|112|Положителна преоценка на ДМА")
    r = smap_def_push(r, "80|20*|709|Установен излишък на ДМА")
    r = smap_def_push(r, "90|609|20*|Установена липса на ДМА")
    r = smap_def_push(r, "90|241|20*|Отписване на амортизация при липса")
    r = smap_def_push(r, "100|608|20*|Обезценка на ДМА")
    r = smap_def_push(r, "110|20*|709|Възстановяване на обезценка")
    r = smap_def_push(r, "120|609|20*|Безвъзмездно предоставени ДМА")
    r = smap_def_push(r, "120|241|20*|Отписване амортизация при дарение")
    r = smap_def_push(r, "130|20*|499|Други транзакции с ДМА")
    return r
}

fn smap_default_cash() -> Vec<str> {
    let mut r = vec_new()
    r = smap_def_push(r, "10|501|411|Каса от клиенти")
    r = smap_def_push(r, "10|501|709|Каса други приходи")
    r = smap_def_push(r, "10|501|721|Каса лихви")
    r = smap_def_push(r, "11|401|501|Каса към доставчици")
    r = smap_def_push(r, "11|602|501|Каса външни услуги")
    r = smap_def_push(r, "11|604|501|Каса заплати")
    r = smap_def_push(r, "11|609|501|Каса други разходи")
    r = smap_def_push(r, "42|503|411|Банка от клиенти")
    r = smap_def_push(r, "42|503|709|Банка други приходи")
    r = smap_def_push(r, "42|503|721|Банка лихви")
    r = smap_def_push(r, "42|503|752|Банка фин. приходи")
    r = smap_def_push(r, "43|401|503|Банка към доставчици")
    r = smap_def_push(r, "43|602|503|Банка външни услуги")
    r = smap_def_push(r, "43|604|503|Банка заплати")
    r = smap_def_push(r, "43|609|503|Банка други разходи")
    r = smap_def_push(r, "43|621|503|Банка лихви по кредити")
    r = smap_def_push(r, "43|629|503|Банка такси")
    r = smap_def_push(r, "48|503|411|Карта от клиенти")
    r = smap_def_push(r, "49|401|503|Карта към доставчици")
    r = smap_def_push(r, "80|503|501|Внасяне каса в банка")
    r = smap_def_push(r, "80|501|503|Теглене от банка в каса")
    r = smap_def_push(r, "80|503|503|Между банкови сметки")
    r = smap_def_push(r, "90|503|724|Положителна валутна разлика")
    r = smap_def_push(r, "91|624|503|Отрицателна валутна разлика")
    r = smap_def_push(r, "97|401|411|Прихващане доставчик-клиент")
    r = smap_def_push(r, "99|422|501|Служебен аванс")
    r = smap_def_push(r, "99|501|422|Отчитане служебен аванс")
    return r
}

fn smap_default_rows(kind: str) -> Vec<str> {
    if kind == "stock" {
        return smap_default_stock()
    }
    if kind == "asset" {
        return smap_default_asset()
    }
    if kind == "cash" {
        return smap_default_cash()
    }
    return vec_new()
}
