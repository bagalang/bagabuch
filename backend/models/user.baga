// models/user.baga — потребители (email login, роля, супер-админ).

import "ormbaga/orm.baga"
import "ormbaga/sql.baga"
import "fmrbaga/jsonx.baga"
import "pgbaga/pg.baga"
import "std/str/str.baga"
import "std/os/os.baga"
import "std/crypto/sha256.baga"

fn user_table() -> str {
    return "users"
}

fn user_backend_boila() -> i64 !IO {
    let be = env("ORM_BACKEND")?
    if be == "boila" || be == "boiladb" || be == "boilaDB" {
        return 1
    }
    return 0
}

fn user_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return orm_count_sql(db, "SELECT MAX(id) AS count FROM users")?
}

fn user_hash_password(email: str, password: str) -> str {
    return sha256_hex(concat(concat("bagabuch|", email), concat("|", password)))
}

fn user_select_sql() -> str {
    return "SELECT id, email, name, password_hash, role, is_active, is_super_admin, role_id, created_at FROM users"
}

fn user_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_str(o, "email", orm_cell_by(q, row, "email"))
    o = jobj_str(o, "name", orm_cell_by(q, row, "name"))
    o = jobj_str(o, "role", orm_cell_by(q, row, "role"))
    o = jobj_i64(o, "is_active", orm_cell_by_i64(q, row, "is_active"))
    o = jobj_i64(o, "is_super_admin", orm_cell_by_i64(q, row, "is_super_admin"))
    o = jobj_i64(o, "role_id", orm_cell_by_i64(q, row, "role_id"))
    let ca = orm_cell_by(q, row, "created_at")
    if ca != "" {
        o = jobj_str(o, "created_at", ca)
    }
    return o
}

fn user_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net {
    let sql = concat(user_select_sql(), " WHERE id = $1")
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, id)
    return orm_query_params(db, sql, vals, nulls)?
}

fn user_by_email(db: OrmDb, email: str) -> OrmQuery !IO !Net {
    let sql = concat(user_select_sql(), " WHERE email = $1")
    let vals = vec_new()
    vec_push(vals, email)
    let nulls = vec_new()
    vec_push(nulls, 0)
    return orm_query_params(db, sql, vals, nulls)?
}

fn user_all(db: OrmDb) -> OrmQuery !IO !Net {
    return orm_query(db, concat(user_select_sql(), " ORDER BY name"))?
}

fn user_create(db: OrmDb, email: str, name: str, password_hash: str, role: str, is_active: i64, is_super_admin: i64, role_id: i64) -> OrmQuery !IO !Net {
    if user_backend_boila()? == 1 {
        let c = user_next_id(db)?
        if orm_ok_c(c) == 0 {
            return OrmQErr(OrmQueryFail { err: orm_err_c(c), tag: "", db: orm_db_c(c) })
        }
        let nid = orm_count_n(c) + 1
        let d = orm_db_c(c)
        let cols = vec_new()
        vec_push(cols, "id")
        vec_push(cols, "email")
        vec_push(cols, "name")
        vec_push(cols, "password_hash")
        vec_push(cols, "role")
        vec_push(cols, "is_active")
        vec_push(cols, "is_super_admin")
        vec_push(cols, "role_id")
        let vals = vec_new()
        vec_push(vals, int_to_str(nid))
        vec_push(vals, email)
        vec_push(vals, name)
        vec_push(vals, password_hash)
        vec_push(vals, role)
        vec_push(vals, int_to_str(is_active))
        vec_push(vals, int_to_str(is_super_admin))
        vec_push(vals, int_to_str(role_id))
        let nulls = vec_new()
        vec_push(nulls, 0)
        vec_push(nulls, 0)
        vec_push(nulls, 0)
        vec_push(nulls, 0)
        vec_push(nulls, 0)
        vec_push(nulls, 0)
        vec_push(nulls, 0)
        vec_push(nulls, 0)
        return orm_insert_returning_full(d, user_table(), cols, vals, nulls)?
    }
    let cols = vec_new()
    vec_push(cols, "email")
    vec_push(cols, "name")
    vec_push(cols, "password_hash")
    vec_push(cols, "role")
    vec_push(cols, "is_active")
    vec_push(cols, "is_super_admin")
    vec_push(cols, "role_id")
    let vals = vec_new()
    vec_push(vals, email)
    vec_push(vals, name)
    vec_push(vals, password_hash)
    vec_push(vals, role)
    vec_push(vals, int_to_str(is_active))
    vec_push(vals, int_to_str(is_super_admin))
    vec_push(vals, int_to_str(role_id))
    let nulls = vec_new()
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    return orm_insert_returning_full(db, user_table(), cols, vals, nulls)?
}

fn user_delete(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    return orm_delete_by_id(db, user_table(), id)?
}

fn user_list_json(q: OrmQuery) -> JObj {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, user_to_json(q, i))
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", orm_nrows(q))
    return o
}
