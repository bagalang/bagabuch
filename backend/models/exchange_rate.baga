// models/exchange_rate.baga — обменни курсове на ЕЦБ (за 1 EUR).
// Курсът е TEXT (десимална точност, без float). Уникалност (currency_code, date)
// се пази в приложението: boila не поддържа две '=' условия в WHERE.

import "ormbaga/orm.baga"
import "ormbaga/sql.baga"
import "fmrbaga/jsonx.baga"
import "pgbaga/pg.baga"
import "std/str/str.baga"
import "std/os/os.baga"

fn exchange_rate_table() -> str {
    return "exchange_rates"
}

fn exchange_rate_backend_boila() -> i64 !IO {
    let be = env("ORM_BACKEND")?
    if be == "boila" || be == "boiladb" || be == "boilaDB" {
        return 1
    }
    return 0
}

fn exchange_rate_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return orm_count_sql(db, "SELECT MAX(id) AS count FROM exchange_rates")?
}

fn exchange_rate_select_sql() -> str {
    return "SELECT id, currency_code, rate, date, created_at FROM exchange_rates"
}

fn exchange_rate_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_str(o, "currency_code", orm_cell_by(q, row, "currency_code"))
    o = jobj_str(o, "rate", orm_cell_by(q, row, "rate"))
    o = jobj_str(o, "date", orm_cell_by(q, row, "date"))
    return o
}

fn exchange_rate_all(db: OrmDb) -> OrmQuery !IO !Net {
    return orm_query(db, concat(exchange_rate_select_sql(), " ORDER BY date DESC, currency_code"))?
}

fn exchange_rate_by_date(db: OrmDb, date: str) -> OrmQuery !IO !Net {
    let sql = concat(exchange_rate_select_sql(), " WHERE date = $1 ORDER BY currency_code")
    let vals = vec_new()
    vec_push(vals, date)
    let nulls = vec_new()
    vec_push(nulls, 0)
    return orm_query_params(db, sql, vals, nulls)?
}

// Лексикографско сравнение (низовите < > в baga гледат само първия байт).
// -1 / 0 / 1. ISO датите са с равна дължина, затова байт-по-байт е точно.
fn er_str_cmp(a: str, b: str) -> i64 {
    let mut n = len(a)
    if len(b) < n {
        n = len(b)
    }
    let mut i: i64 = 0
    while i < n {
        let ca = char_at(a, i)
        let cb = char_at(b, i)
        if ca < cb {
            return 0 - 1
        }
        if ca > cb {
            return 1
        }
        i = i + 1
    }
    if len(a) < len(b) {
        return 0 - 1
    }
    if len(a) > len(b) {
        return 1
    }
    return 0
}

// Последната дата с курсове в таблицата; "" ако е празна.
fn exchange_rate_latest_date(q: OrmQuery) -> str {
    let mut best = ""
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        let d = orm_cell_by(q, i, "date")
        if er_str_cmp(d, best) > 0 {
            best = d
        }
        i = i + 1
    }
    return best
}

// Ред на (currency, date) в резултат от заявка; -1 ако липсва.
fn exchange_rate_row_of_pair(q: OrmQuery, currency: str, date: str) -> i64 {
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        if orm_cell_by(q, i, "currency_code") == currency {
            if orm_cell_by(q, i, "date") == date {
                return i
            }
        }
        i = i + 1
    }
    return 0 - 1
}

// Курс на currency за date; при липса — най-близка по-ранна дата.
// Връща "date|rate" или "" при пълна липса. (ISO датите се сравняват низово.)
fn exchange_rate_lookup(q: OrmQuery, currency: str, date: str) -> str {
    let mut best_date = ""
    let mut best_rate = ""
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        if orm_cell_by(q, i, "currency_code") == currency {
            let d = orm_cell_by(q, i, "date")
            if er_str_cmp(d, date) <= 0 {
                if er_str_cmp(d, best_date) > 0 {
                    best_date = d
                    best_rate = orm_cell_by(q, i, "rate")
                }
            }
        }
        i = i + 1
    }
    if best_date == "" {
        return ""
    }
    return concat(concat(best_date, "|"), best_rate)
}

fn exchange_rate_insert(db: OrmDb, currency: str, rate: str, date: str) -> OrmExec !IO !Net {
    if exchange_rate_backend_boila()? == 1 {
        let c = exchange_rate_next_id(db)?
        if orm_ok_c(c) == 0 {
            return OrmEErr(OrmExecFail { err: orm_err_c(c), tag: "", db: orm_db_c(c) })
        }
        let nid = orm_count_n(c) + 1
        let d = orm_db_c(c)
        let cols = vec_new()
        vec_push(cols, "id")
        vec_push(cols, "currency_code")
        vec_push(cols, "rate")
        vec_push(cols, "date")
        let vals = vec_new()
        vec_push(vals, int_to_str(nid))
        vec_push(vals, currency)
        vec_push(vals, rate)
        vec_push(vals, date)
        let nulls = vec_new()
        vec_push(nulls, 0)
        vec_push(nulls, 0)
        vec_push(nulls, 0)
        vec_push(nulls, 0)
        return orm_insert_full(d, exchange_rate_table(), cols, vals, nulls)?
    }
    let cols = vec_new()
    vec_push(cols, "currency_code")
    vec_push(cols, "rate")
    vec_push(cols, "date")
    let vals = vec_new()
    vec_push(vals, currency)
    vec_push(vals, rate)
    vec_push(vals, date)
    let nulls = vec_new()
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    return orm_insert_full(db, exchange_rate_table(), cols, vals, nulls)?
}

// Ъпсърт по (currency, date) срещу предварително заредена заявка q
// (едно SELECT за целия импорт — 90-дневният фид е ~3000 реда).
// out: 1 insert, 0 update, 2 без промяна, -1 грешка. Връща обновената db.
fn exchange_rate_upsert(db: OrmDb, q: OrmQuery, currency: str, rate: str, date: str, out: Vec<i64>) -> OrmDb !IO !Net {
    let row = exchange_rate_row_of_pair(q, currency, date)
    if row >= 0 {
        if orm_cell_by(q, row, "rate") == rate {
            vec_push(out, 2)
            return db
        }
        let id = orm_cell_by_i64(q, row, "id")
        let cols = vec_new()
        vec_push(cols, "rate")
        let vals = vec_new()
        vec_push(vals, rate)
        let u = orm_update_by_id(db, exchange_rate_table(), id, cols, vals)?
        if orm_ok(u) == 0 {
            vec_push(out, 0 - 1)
        } else {
            vec_push(out, 0)
        }
        return orm_db_exec(u)
    }
    let ins = exchange_rate_insert(db, currency, rate, date)?
    if orm_ok(ins) == 0 {
        vec_push(out, 0 - 1)
    } else {
        vec_push(out, 1)
    }
    return orm_db_exec(ins)
}
