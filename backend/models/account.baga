// models/account.baga — accounts (сметкоплан) table helpers over ormbaga.
// Table DDL живее в schema.baga на bagabuch. parent_id е nullable (йерархия).

import "ormbaga/orm.baga"
import "ormbaga/sql.baga"
import "fmrbaga/jsonx.baga"
import "pgbaga/pg.baga"
import "std/str/str.baga"
import "std/os/os.baga"

fn account_table() -> str {
    return "accounts"
}

fn account_backend_boila() -> i64 !IO {
    let be = env("ORM_BACKEND")?
    if be == "boila" || be == "boiladb" || be == "boilaDB" {
        return 1
    }
    return 0
}

// Следващ PK: таблицата е създадена преди P20 (без BIGSERIAL). NULL max → 0.
fn account_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return orm_count_sql(db, "SELECT MAX(id) AS count FROM accounts")?
}

fn account_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_str(o, "number", orm_cell_by(q, row, "number"))
    o = jobj_str(o, "name", orm_cell_by(q, row, "name"))
    o = jobj_str(o, "saft_account_type", orm_cell_by(q, row, "saft_account_type"))
    o = jobj_str(o, "analytic_type", orm_cell_by(q, row, "analytic_type"))
    let pid = orm_cell_by_i64(q, row, "parent_id")
    if pid > 0 {
        o = jobj_i64(o, "parent_id", pid)
    }
    let ca = orm_cell_by(q, row, "created_at")
    if ca != "" {
        o = jobj_str(o, "created_at", ca)
    }
    return o
}

// Dual-safe: без ::text кастове (граматиката на boila за кастове е по-тясна).
fn account_select_sql() -> str {
    return "SELECT id, number, name, saft_account_type, analytic_type, parent_id, created_at FROM accounts"
}

fn account_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net {
    let sql = concat(account_select_sql(), " WHERE id = $1")
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, id)
    return orm_query_params(db, sql, vals, nulls)?
}

fn account_by_number(db: OrmDb, number: str) -> OrmQuery !IO !Net {
    let sql = concat(account_select_sql(), " WHERE number = $1")
    let vals = vec_new()
    vec_push(vals, number)
    let nulls = vec_new()
    vec_push(nulls, 0)
    return orm_query_params(db, sql, vals, nulls)?
}

fn account_all(db: OrmDb) -> OrmQuery !IO !Net {
    return orm_query(db, concat(account_select_sql(), " ORDER BY number"))?
}

// parent_null==1 → parent_id е NULL (йерархичен корен).
// Връща реда през RETURNING (id вътре) — еднозначно кой е новият ред.
fn account_create(db: OrmDb, number: str, name: str, saft_account_type: str, analytic_type: str, parent_id: i64, parent_null: i64) -> OrmQuery !IO !Net {
    if account_backend_boila()? == 1 {
        let c = account_next_id(db)?
        if orm_ok_c(c) == 0 {
            return OrmQErr(OrmQueryFail { err: orm_err_c(c), tag: "", db: orm_db_c(c) })
        }
        let nid = orm_count_n(c) + 1
        let mut d = orm_db_c(c)
        let cols = vec_new()
        vec_push(cols, "id")
        vec_push(cols, "number")
        vec_push(cols, "name")
        vec_push(cols, "saft_account_type")
        vec_push(cols, "analytic_type")
        vec_push(cols, "parent_id")
        let vals = vec_new()
        vec_push(vals, int_to_str(nid))
        vec_push(vals, number)
        vec_push(vals, name)
        vec_push(vals, saft_account_type)
        vec_push(vals, analytic_type)
        vec_push(vals, int_to_str(parent_id))
        let nulls = vec_new()
        vec_push(nulls, 0)
        vec_push(nulls, 0)
        vec_push(nulls, 0)
        vec_push(nulls, 0)
        vec_push(nulls, 0)
        vec_push(nulls, parent_null)
        return orm_insert_returning_full(d, account_table(), cols, vals, nulls)?
    }
    let cols = vec_new()
    vec_push(cols, "number")
    vec_push(cols, "name")
    vec_push(cols, "saft_account_type")
    vec_push(cols, "analytic_type")
    vec_push(cols, "parent_id")
    let vals = vec_new()
    vec_push(vals, number)
    vec_push(vals, name)
    vec_push(vals, saft_account_type)
    vec_push(vals, analytic_type)
    vec_push(vals, int_to_str(parent_id))
    let nulls = vec_new()
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    vec_push(nulls, parent_null)
    return orm_insert_returning_full(db, account_table(), cols, vals, nulls)?
}

fn account_delete(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    return orm_delete_by_id(db, account_table(), id)?
}

fn account_list_json(q: OrmQuery) -> JObj {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, account_to_json(q, i))
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", orm_nrows(q))
    return o
}
