    return o
}

fn mfg_find(db: OrmDb, sql0: str, id: i64) -> OrmQuery !IO !Net {
    let sql = concat(sql0, " WHERE id = $1")
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, id)
    return orm_query_params(db, sql, vals, nulls)?
}

fn mfg_by_company(db: OrmDb, sql0: str, company_id: i64, order: str) -> OrmQuery !IO !Net {
    let sql = concat(concat(sql0, " WHERE company_id = $1 "), order)
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, company_id)
    return orm_query_params(db, sql, vals, nulls)?
}

fn mfg_by_parent(db: OrmDb, sql0: str, col: str, pid: i64) -> OrmQuery !IO !Net {
    let sql = concat(concat(sql0, concat(" WHERE ", col)), " = $1 ORDER BY id")
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, pid)
    return orm_query_params(db, sql, vals, nulls)?
}

fn recipe_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net { return mfg_find(db, recipe_select_sql(), id)? }
fn pord_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net { return mfg_find(db, pord_select_sql(), id)? }
fn recipe_by_company(db: OrmDb, company_id: i64) -> OrmQuery !IO !Net {
    return mfg_by_company(db, recipe_select_sql(), company_id, "ORDER BY name, id")?
}
fn pord_by_company(db: OrmDb, company_id: i64) -> OrmQuery !IO !Net {
    return mfg_by_company(db, pord_select_sql(), company_id, "ORDER BY id DESC")?
}
fn rline_by_recipe(db: OrmDb, recipe_id: i64) -> OrmQuery !IO !Net {
    return mfg_by_parent(db, rline_select_sql(), "recipe_id", recipe_id)?
}
fn pline_by_order(db: OrmDb, order_id: i64) -> OrmQuery !IO !Net {
    return mfg_by_parent(db, pline_select_sql(), "order_id", order_id)?
}

fn mfg_next(db: OrmDb, table: str) -> OrmCount !IO !Net {
    return orm_count_sql(db, concat("SELECT MAX(id) AS count FROM ", table))?
}

fn mfg_insert(db: OrmDb, table: str, cols: Vec<str>, vals: Vec<str>) -> OrmQuery !IO !Net {
    let nulls = vec_new()
    let mut i: i64 = 0
    let n = vec_len(cols)
    if mfg_backend_boila()? == 1 {
        let c = mfg_next(db, table)?
        if orm_ok_c(c) == 0 {
            return OrmQErr(OrmQueryFail { err: orm_err_c(c), tag: "", db: orm_db_c(c) })
        }
        let nid = orm_count_n(c) + 1
        let mut d = orm_db_c(c)
        let allc = vec_new()
        vec_push(allc, "id")
        i = 0
        while i < n {
            vec_push(allc, vec_get(cols, i))
            i = i + 1
        }
        let allv = vec_new()
        vec_push(allv, int_to_str(nid))
        i = 0
        while i < n {
            vec_push(allv, vec_get(vals, i))
            i = i + 1
        }
        i = 0
        while i < n + 1 {
            vec_push(nulls, 0)
            i = i + 1
        }
        return orm_insert_returning_full(d, table, allc, allv, nulls)?
    }
    i = 0
    while i < n {
        vec_push(nulls, 0)
        i = i + 1
    }
    return orm_insert_returning_full(db, table, cols, vals, nulls)?
}

fn recipe_create(db: OrmDb, company_id: i64, code: str, name: str, output_product_id: i64, output_quantity: str, output_unit: str, notes: str) -> OrmQuery !IO !Net {
    let cols = vec_new()
    vec_push(cols, "company_id")
    vec_push(cols, "code")
    vec_push(cols, "name")
    vec_push(cols, "output_product_id")
    vec_push(cols, "output_quantity")
    vec_push(cols, "output_unit")
    vec_push(cols, "notes")
    vec_push(cols, "is_active")
    let vals = vec_new()
    vec_push(vals, int_to_str(company_id))
    vec_push(vals, code)
    vec_push(vals, name)
    vec_push(vals, int_to_str(output_product_id))
    vec_push(vals, output_quantity)
    vec_push(vals, output_unit)
    vec_push(vals, notes)
    vec_push(vals, "1")
    return mfg_insert(db, recipe_table(), cols, vals)?
}

fn rline_create(db: OrmDb, recipe_id: i64, product_id: i64, quantity: str, unit: str, wastage: str, line_no: i64) -> OrmQuery !IO !Net {
    let cols = vec_new()
    vec_push(cols, "recipe_id")
    vec_push(cols, "product_id")
    vec_push(cols, "quantity")
    vec_push(cols, "unit")
    vec_push(cols, "wastage_percent")
    vec_push(cols, "line_no")
    let vals = vec_new()
    vec_push(vals, int_to_str(recipe_id))
    vec_push(vals, int_to_str(product_id))
    vec_push(vals, quantity)
    vec_push(vals, unit)
    vec_push(vals, wastage)
    vec_push(vals, int_to_str(line_no))
    return mfg_insert(db, rline_table(), cols, vals)?
}

fn pord_create(db: OrmDb, company_id: i64, number: str, recipe_id: i64, output_product_id: i64, quantity: str, location_id: i64, order_date: str, notes: str) -> OrmQuery !IO !Net {
    let cols = vec_new()
    vec_push(cols, "company_id")
    vec_push(cols, "number")
    vec_push(cols, "recipe_id")
    vec_push(cols, "output_product_id")
    vec_push(cols, "quantity")
    vec_push(cols, "location_id")
    vec_push(cols, "order_date")
    vec_push(cols, "status")
    vec_push(cols, "notes")
    vec_push(cols, "material_cost")
    vec_push(cols, "journal_entry_id")
    let vals = vec_new()
    vec_push(vals, int_to_str(company_id))
    vec_push(vals, number)
    vec_push(vals, int_to_str(recipe_id))
    vec_push(vals, int_to_str(output_product_id))
    vec_push(vals, quantity)
    vec_push(vals, int_to_str(location_id))
    vec_push(vals, order_date)
    vec_push(vals, "draft")
    vec_push(vals, notes)
    vec_push(vals, "0")
    vec_push(vals, "0")
    return mfg_insert(db, pord_table(), cols, vals)?
}

fn pline_create(db: OrmDb, order_id: i64, product_id: i64, product_name: str, quantity: str, unit: str) -> OrmQuery !IO !Net {
    let cols = vec_new()
    vec_push(cols, "order_id")
    vec_push(cols, "product_id")
    vec_push(cols, "product_name")
    vec_push(cols, "quantity")
    vec_push(cols, "unit")
    vec_push(cols, "unit_cost")
    vec_push(cols, "amount")
    let vals = vec_new()
    vec_push(vals, int_to_str(order_id))
    vec_push(vals, int_to_str(product_id))
    vec_push(vals, product_name)
    vec_push(vals, quantity)
    vec_push(vals, unit)
    vec_push(vals, "0")
    vec_push(vals, "0")
    return mfg_insert(db, pline_table(), cols, vals)?
}

fn rline_delete_by_recipe(db: OrmDb, recipe_id: i64) -> OrmExec !IO !Net {
    let sql = "DELETE FROM recipe_lines WHERE recipe_id = $1"
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, recipe_id)
    return orm_exec_params(db, sql, vals, nulls)?
}

fn pline_delete_by_order(db: OrmDb, order_id: i64) -> OrmExec !IO !Net {
    let sql = "DELETE FROM production_order_lines WHERE order_id = $1"
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, order_id)
    return orm_exec_params(db, sql, vals, nulls)?
}

fn recipe_delete(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    return orm_delete_by_id(db, recipe_table(), id)?
}

fn pord_delete(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    return orm_delete_by_id(db, pord_table(), id)?
}

fn rline_list_json(q: OrmQuery) -> JArr {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, rline_to_json(q, i))
        i = i + 1
    }
    return arr
}

fn pline_list_json(q: OrmQuery) -> JArr {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, pline_to_json(q, i))
        i = i + 1
    }
    return arr
}
