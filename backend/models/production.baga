// models/production.baga — рецепти (BOM) и производствени поръчки.
// Суми и количества са NUMERIC като стринг.

import "ormbaga/orm.baga"
import "ormbaga/sql.baga"
import "fmrbaga/jsonx.baga"
import "pgbaga/pg.baga"
import "std/str/str.baga"
import "std/os/os.baga"

fn mfg_backend_boila() -> i64 !IO {
    let be = env("ORM_BACKEND")?
    if be == "boila" || be == "boiladb" || be == "boilaDB" {
        return 1
    }
    return 0
}

fn recipe_table() -> str { return "recipes" }
fn rline_table() -> str { return "recipe_lines" }
fn pord_table() -> str { return "production_orders" }
fn pline_table() -> str { return "production_order_lines" }

fn recipe_select_sql() -> str {
    return "SELECT id, company_id, code, name, output_product_id, output_quantity, output_unit, notes, is_active, created_at FROM recipes"
}

fn rline_select_sql() -> str {
    return "SELECT id, recipe_id, product_id, quantity, unit, wastage_percent, line_no FROM recipe_lines"
}

fn pord_select_sql() -> str {
    return "SELECT id, company_id, number, recipe_id, output_product_id, quantity, location_id, order_date, status, notes, material_cost, journal_entry_id, created_at FROM production_orders"
}

fn pline_select_sql() -> str {
    return "SELECT id, order_id, product_id, product_name, quantity, unit, unit_cost, amount FROM production_order_lines"
}

fn recipe_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_i64(o, "company_id", orm_cell_by_i64(q, row, "company_id"))
    o = jobj_str(o, "code", orm_cell_by(q, row, "code"))
    o = jobj_str(o, "name", orm_cell_by(q, row, "name"))
    o = jobj_i64(o, "output_product_id", orm_cell_by_i64(q, row, "output_product_id"))
    o = jobj_str(o, "output_quantity", orm_cell_by(q, row, "output_quantity"))
    o = jobj_str(o, "output_unit", orm_cell_by(q, row, "output_unit"))
    o = jobj_str(o, "notes", orm_cell_by(q, row, "notes"))
    o = jobj_i64(o, "is_active", orm_cell_by_i64(q, row, "is_active"))
    return o
}

