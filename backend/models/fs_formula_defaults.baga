// models/fs_formula_defaults.baga — стандартни формули по националния сметкоплан.
// Ред: line_code|formula

fn fs_def_push(rows: Vec<str>, line: str) -> Vec<str> {
    vec_push(rows, line)
    return rows
}

fn fs_defaults_balance() -> Vec<str> {
    let mut r = vec_new()
    r = fs_def_push(r, "bal.b.ii.1a|+201Д")
    r = fs_def_push(r, "bal.b.ii.1b|+202Д-242К")
    r = fs_def_push(r, "bal.b.ii.1|+201Д+202Д-242К")
    r = fs_def_push(r, "bal.b.ii.2|+203Д+204Д+205Д-241К")
    r = fs_def_push(r, "bal.b.ii.3|+206Д+207Д+209Д")
    r = fs_def_push(r, "bal.b.ii.4|+207Д")
    r = fs_def_push(r, "bal.b.iii.5|+221Д+222Д")
    r = fs_def_push(r, "bal.b.iii.6|+226Д")
    r = fs_def_push(r, "bal.b.iv|+242Д")
    r = fs_def_push(r, "bal.b.t|+@bal.b.i.t+@bal.b.ii.t+@bal.b.iii.t+@bal.b.iv")
    r = fs_def_push(r, "bal.c.i.1|+302Д+301Д")
    r = fs_def_push(r, "bal.c.i.2|+611Д")
    r = fs_def_push(r, "bal.c.i.3a|+303Д")
    r = fs_def_push(r, "bal.c.i.3b|+304Д")
    r = fs_def_push(r, "bal.c.i.3|+303Д+304Д")
    r = fs_def_push(r, "bal.c.i.4|+302Д")
    r = fs_def_push(r, "bal.c.ii.1|+411Д+413Д")
    r = fs_def_push(r, "bal.c.ii.4|+412Д+421Д+422Д+4531Д")
    r = fs_def_push(r, "bal.c.iii.3|+231Д+232Д")
    r = fs_def_push(r, "bal.c.iv.a|+501Д+502Д")
    r = fs_def_push(r, "bal.c.iv.b|+503Д+504Д+505Д+506Д")
    r = fs_def_push(r, "bal.c.t|+@bal.c.i.t+@bal.c.ii.t+@bal.c.iii.t+@bal.c.iv.t")
    r = fs_def_push(r, "bal.d|+651Д")
    r = fs_def_push(r, "bal.t|+@bal.a+@bal.b.t+@bal.c.t+@bal.d")
    r = fs_def_push(r, "bal.p.a.i|+101К")
    r = fs_def_push(r, "bal.p.a.ii|+102К")
    r = fs_def_push(r, "bal.p.a.iii|+112К")
    r = fs_def_push(r, "bal.p.a.iv.1|+111К")
    r = fs_def_push(r, "bal.p.a.iv.4|+119К")
    r = fs_def_push(r, "bal.p.a.v.1|+122К")
    r = fs_def_push(r, "bal.p.a.v.2|+121Д")
    r = fs_def_push(r, "bal.p.a.vi|+123К-123Д")
    r = fs_def_push(r, "bal.p.a.t|+@bal.p.a.i+@bal.p.a.ii+@bal.p.a.iii+@bal.p.a.iv.t+@bal.p.a.v.t+@bal.p.a.vi")
    r = fs_def_push(r, "bal.p.b.2|+496К")
    r = fs_def_push(r, "bal.p.b.3|+498К")
    r = fs_def_push(r, "bal.p.c.2|+151К+152К")
    r = fs_def_push(r, "bal.p.c.3|+412К")
    r = fs_def_push(r, "bal.p.c.4|+401К+402К")
    r = fs_def_push(r, "bal.p.c.8|+421К+422К+424К+425К+4532К+455К+459К")
    r = fs_def_push(r, "bal.p.d|+151К+496К")
    r = fs_def_push(r, "bal.p.t|+@bal.p.a.t+@bal.p.b.t+@bal.p.c.t+@bal.p.d")
    return r
}

fn fs_defaults_pl() -> Vec<str> {
    let mut r = vec_new()
    r = fs_def_push(r, "pl.e.2a|+601ОД")
    r = fs_def_push(r, "pl.e.2b|+602ОД")
    r = fs_def_push(r, "pl.e.2|+601ОД+602ОД")
    r = fs_def_push(r, "pl.e.3a|+604ОД")
    r = fs_def_push(r, "pl.e.3b|+605ОД")
    r = fs_def_push(r, "pl.e.3|+604ОД+605ОД")
    r = fs_def_push(r, "pl.e.4|+603ОД")
    r = fs_def_push(r, "pl.e.5a|+702Д/304К+701Д/303К")
    r = fs_def_push(r, "pl.e.5|+609ОД+@pl.e.5a")
    r = fs_def_push(r, "pl.e.op|+@pl.e.1+@pl.e.2+@pl.e.3+@pl.e.4+@pl.e.5")
    r = fs_def_push(r, "pl.e.6|+624ОД")
    r = fs_def_push(r, "pl.e.7|+621ОД+629ОД")
    r = fs_def_push(r, "pl.e.fin|+@pl.e.6+@pl.e.7")
    r = fs_def_push(r, "pl.e.t|+@pl.e.op+@pl.e.fin")
    r = fs_def_push(r, "pl.e.tax|+608ОД")
    r = fs_def_push(r, "pl.i.1a|+701ОК")
    r = fs_def_push(r, "pl.i.1b|+702ОК")
    r = fs_def_push(r, "pl.i.1c|+703ОК")
    r = fs_def_push(r, "pl.i.1|+701ОК+702ОК+703ОК")
    r = fs_def_push(r, "pl.i.4|+709ОК")
    r = fs_def_push(r, "pl.i.op|+@pl.i.1+@pl.i.2+@pl.i.3+@pl.i.4")
    r = fs_def_push(r, "pl.i.7|+721ОК+724ОК")
    r = fs_def_push(r, "pl.i.fin|+@pl.i.5+@pl.i.6+@pl.i.7")
    r = fs_def_push(r, "pl.i.t|+@pl.i.op+@pl.i.fin")
    r = fs_def_push(r, "pl.e.profit|+@pl.i.t-@pl.e.t-@pl.e.tax")
    r = fs_def_push(r, "pl.i.loss|+@pl.e.t-@pl.i.t")
    return r
}

fn fs_defaults_cash() -> Vec<str> {
    let mut r = vec_new()
    r = fs_def_push(r, "cf.op.in.cust|+50*Д/411К")
    r = fs_def_push(r, "cf.op.out.sup|+401Д/50*К")
    r = fs_def_push(r, "cf.op.out.staff|+421Д/50*К+604Д/50*К")
    r = fs_def_push(r, "cf.op.out.tax|+4532Д/50*К+459Д/50*К")
    r = fs_def_push(r, "cf.op.net|+@cf.op.in.cust-@cf.op.out.sup-@cf.op.out.staff-@cf.op.out.tax-@cf.op.out.other")
    r = fs_def_push(r, "cf.inv.out.ppe|+20*Д/50*К")
    r = fs_def_push(r, "cf.inv.in.ppe|+50*Д/20*К")
    r = fs_def_push(r, "cf.inv.net|+@cf.inv.in.ppe-@cf.inv.out.ppe")
    r = fs_def_push(r, "cf.fin.in.cap|+50*Д/101К")
    r = fs_def_push(r, "cf.fin.in.loan|+50*Д/151К")
    r = fs_def_push(r, "cf.fin.out.loan|+151Д/50*К")
    r = fs_def_push(r, "cf.fin.out.div|+455Д/50*К")
    r = fs_def_push(r, "cf.fin.net|+@cf.fin.in.cap+@cf.fin.in.loan-@cf.fin.out.loan-@cf.fin.out.div")
    r = fs_def_push(r, "cf.change|+@cf.op.net+@cf.inv.net+@cf.fin.net")
    r = fs_def_push(r, "cf.open|+501НД+502НД+503НД")
    r = fs_def_push(r, "cf.close|+@cf.open+@cf.change")
    return r
}

fn fs_defaults_equity() -> Vec<str> {
    let mut r = vec_new()
    r = fs_def_push(r, "eq.open|+101НК+111НК+112НК+119НК+122НК-121НД")
    r = fs_def_push(r, "eq.after|+@eq.open+@eq.policy+@eq.errors")
    r = fs_def_push(r, "eq.owners|+101К-101НК")
    r = fs_def_push(r, "eq.result|+123К-123Д")
    r = fs_def_push(r, "eq.div|+123Д/455К")
    r = fs_def_push(r, "eq.close|+@eq.after+@eq.owners+@eq.result-@eq.div+@eq.reval+@eq.other")
    return r
}

fn fs_defaults_rows(statement: str) -> Vec<str> {
    if statement == "balance" {
        return fs_defaults_balance()
    }
    if statement == "pl" {
        return fs_defaults_pl()
    }
    if statement == "cashflow" {
        return fs_defaults_cash()
    }
    if statement == "equity" {
        return fs_defaults_equity()
    }
    return vec_new()
}
