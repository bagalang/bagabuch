// models/company.baga — companies table helpers over ormbaga.
// Table DDL живее в schema.baga на bagabuch (bagabuch_migrations / bagabuch_boila_migrations).

import "ormbaga/orm.baga"
import "ormbaga/sql.baga"
import "fmrbaga/jsonx.baga"
import "pgbaga/pg.baga"
import "std/str/str.baga"
import "std/os/os.baga"

fn company_table() -> str {
    return "companies"
}

fn company_backend_boila() -> i64 !IO {
    let be = env("ORM_BACKEND")?
    if be == "boila" || be == "boiladb" || be == "boilaDB" {
        return 1
    }
    return 0
}

// Следващ PK за backend без SERIAL (boila). NULL max → 0.
fn company_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return orm_count_sql(db, "SELECT MAX(id) AS count FROM companies")?
}

fn company_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_str(o, "name", orm_cell_by(q, row, "name"))
    o = jobj_str(o, "eik", orm_cell_by(q, row, "eik"))
    o = jobj_str(o, "vat_number", orm_cell_by(q, row, "vat_number"))
    o = jobj_str(o, "address", orm_cell_by(q, row, "address"))
    o = jobj_str(o, "city", orm_cell_by(q, row, "city"))
    o = jobj_str(o, "mol", orm_cell_by(q, row, "mol"))
    o = jobj_str(o, "iban", orm_cell_by(q, row, "iban"))
    o = jobj_str(o, "bic", orm_cell_by(q, row, "bic"))
    let ca = orm_cell_by(q, row, "created_at")
    if ca != "" {
        o = jobj_str(o, "created_at", ca)
    }
    return o
}

// Dual-safe: без ::text кастове (граматиката на boila за кастове е по-тясна).
fn company_select_sql() -> str {
    return "SELECT id, name, eik, vat_number, address, city, mol, iban, bic, created_at FROM companies"
}

fn company_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net {
    let sql = concat(company_select_sql(), " WHERE id = $1")
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, id)
    return orm_query_params(db, sql, vals, nulls)?
}

fn company_all(db: OrmDb) -> OrmQuery !IO !Net {
    return orm_query(db, concat(company_select_sql(), " ORDER BY id"))?
}

fn company_create(db: OrmDb, name: str, eik: str, vat_number: str, address: str, city: str, mol: str, iban: str, bic: str) -> OrmExec !IO !Net {
    if company_backend_boila()? == 1 {
        let c = company_next_id(db)?
        if orm_ok_c(c) == 0 {
            return OrmEErr(OrmExecFail { err: orm_err_c(c), tag: "", db: orm_db_c(c) })
        }
        let nid = orm_count_n(c) + 1
        let mut d = orm_db_c(c)
        let cols = vec_new()
        vec_push(cols, "id")
        vec_push(cols, "name")
        vec_push(cols, "eik")
        vec_push(cols, "vat_number")
        vec_push(cols, "address")
        vec_push(cols, "city")
        vec_push(cols, "mol")
        vec_push(cols, "iban")
        vec_push(cols, "bic")
        let vals = vec_new()
        vec_push(vals, int_to_str(nid))
        vec_push(vals, name)
        vec_push(vals, eik)
        vec_push(vals, vat_number)
        vec_push(vals, address)
        vec_push(vals, city)
        vec_push(vals, mol)
        vec_push(vals, iban)
        vec_push(vals, bic)
        return orm_insert_strs(d, company_table(), cols, vals)?
    }
    let cols = vec_new()
    vec_push(cols, "name")
    vec_push(cols, "eik")
    vec_push(cols, "vat_number")
    vec_push(cols, "address")
    vec_push(cols, "city")
    vec_push(cols, "mol")
    vec_push(cols, "iban")
    vec_push(cols, "bic")
    let vals = vec_new()
    vec_push(vals, name)
    vec_push(vals, eik)
    vec_push(vals, vat_number)
    vec_push(vals, address)
    vec_push(vals, city)
    vec_push(vals, mol)
    vec_push(vals, iban)
    vec_push(vals, bic)
    return orm_insert_strs(db, company_table(), cols, vals)?
}

fn company_update(db: OrmDb, id: i64, name: str, eik: str, vat_number: str, address: str, city: str, mol: str, iban: str, bic: str) -> OrmExec !IO !Net {
    let cols = vec_new()
    vec_push(cols, "name")
    vec_push(cols, "eik")
    vec_push(cols, "vat_number")
    vec_push(cols, "address")
    vec_push(cols, "city")
    vec_push(cols, "mol")
    vec_push(cols, "iban")
    vec_push(cols, "bic")
    let vals = vec_new()
    vec_push(vals, name)
    vec_push(vals, eik)
    vec_push(vals, vat_number)
    vec_push(vals, address)
    vec_push(vals, city)
    vec_push(vals, mol)
    vec_push(vals, iban)
    vec_push(vals, bic)
    return orm_update_by_id(db, company_table(), id, cols, vals)?
}

fn company_delete(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    return orm_delete_by_id(db, company_table(), id)?
}

fn company_list_json(q: OrmQuery) -> JObj {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, company_to_json(q, i))
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", orm_nrows(q))
    return o
}
