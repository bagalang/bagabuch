// models/auth_tokens.baga — password-reset tokens + TOTP recovery hashes.

import "ormbaga/orm.baga"
import "ormbaga/sql.baga"
import "pgbaga/pg.baga"
import "std/str/str.baga"
import "std/os/os.baga"

fn rec_table() -> str {
    return "user_recovery_codes"
}

fn prt_table() -> str {
    return "password_reset_tokens"
}

fn auth_tok_boila() -> i64 !IO {
    let be = env("ORM_BACKEND")?
    if be == "boila" || be == "boiladb" || be == "boilaDB" {
        return 1
    }
    return 0
}

fn rec_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return orm_count_sql(db, "SELECT MAX(id) AS count FROM user_recovery_codes")?
}

fn prt_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return orm_count_sql(db, "SELECT MAX(id) AS count FROM password_reset_tokens")?
}

fn rec_delete_user(db: OrmDb, user_id: i64) -> OrmExec !IO !Net {
    let sql = "DELETE FROM user_recovery_codes WHERE user_id = $1"
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, user_id)
    return orm_exec_params(db, sql, vals, nulls)?
}

fn rec_insert(db: OrmDb, user_id: i64, code_hash: str) -> OrmExec !IO !Net {
    if auth_tok_boila()? == 1 {
        let c = rec_next_id(db)?
        if orm_ok_c(c) == 0 {
            return OrmEErr(OrmExecFail { err: orm_err_c(c), tag: "", db: orm_db_c(c) })
        }
        let nid = orm_count_n(c) + 1
        let cols = vec_new()
        vec_push(cols, "id")
        vec_push(cols, "user_id")
        vec_push(cols, "code_hash")
        vec_push(cols, "used")
        let vals = vec_new()
        vec_push(vals, int_to_str(nid))
        vec_push(vals, int_to_str(user_id))
        vec_push(vals, code_hash)
        vec_push(vals, "0")
        return orm_insert_strs(orm_db_c(c), rec_table(), cols, vals)?
    }
    let cols = vec_new()
    vec_push(cols, "user_id")
    vec_push(cols, "code_hash")
    vec_push(cols, "used")
    let vals = vec_new()
    vec_push(vals, int_to_str(user_id))
    vec_push(vals, code_hash)
    vec_push(vals, "0")
    return orm_insert_strs(db, rec_table(), cols, vals)?
}

fn rec_unused(db: OrmDb, user_id: i64) -> OrmQuery !IO !Net {
    let sql = "SELECT id, user_id, code_hash, used FROM user_recovery_codes WHERE user_id = $1"
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, user_id)
    return orm_query_params(db, sql, vals, nulls)?
}

fn rec_mark_used(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    let cols = vec_new()
    vec_push(cols, "used")
    let vals = vec_new()
    vec_push(vals, "1")
    return orm_update_by_id(db, rec_table(), id, cols, vals)?
}

fn prt_insert(db: OrmDb, user_id: i64, token_hash: str, expires_at: i64) -> OrmExec !IO !Net {
    if auth_tok_boila()? == 1 {
        let c = prt_next_id(db)?
        if orm_ok_c(c) == 0 {
            return OrmEErr(OrmExecFail { err: orm_err_c(c), tag: "", db: orm_db_c(c) })
        }
        let nid = orm_count_n(c) + 1
        let cols = vec_new()
        vec_push(cols, "id")
        vec_push(cols, "user_id")
        vec_push(cols, "token_hash")
        vec_push(cols, "expires_at")
        vec_push(cols, "used")
        let vals = vec_new()
        vec_push(vals, int_to_str(nid))
        vec_push(vals, int_to_str(user_id))
        vec_push(vals, token_hash)
        vec_push(vals, int_to_str(expires_at))
        vec_push(vals, "0")
        return orm_insert_strs(orm_db_c(c), prt_table(), cols, vals)?
    }
    let cols = vec_new()
    vec_push(cols, "user_id")
    vec_push(cols, "token_hash")
    vec_push(cols, "expires_at")
    vec_push(cols, "used")
    let vals = vec_new()
    vec_push(vals, int_to_str(user_id))
    vec_push(vals, token_hash)
    vec_push(vals, int_to_str(expires_at))
    vec_push(vals, "0")
    return orm_insert_strs(db, prt_table(), cols, vals)?
}

fn prt_by_hash(db: OrmDb, token_hash: str) -> OrmQuery !IO !Net {
    let sql = "SELECT id, user_id, token_hash, expires_at, used FROM password_reset_tokens WHERE token_hash = $1"
    let vals = vec_new()
    vec_push(vals, token_hash)
    let nulls = vec_new()
    vec_push(nulls, 0)
    return orm_query_params(db, sql, vals, nulls)?
}

fn prt_mark_used(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    let cols = vec_new()
    vec_push(cols, "used")
    let vals = vec_new()
    vec_push(vals, "1")
    return orm_update_by_id(db, prt_table(), id, cols, vals)?
}
