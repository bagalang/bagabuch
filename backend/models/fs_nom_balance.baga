// models/fs_nom_balance.baga — СС 1 Приложение 1, двустранен баланс.
// Ред: code|parent|kind|side|name  kind=line|total|header  side=asset|liability

fn fs_bal_push(rows: Vec<str>, line: str) -> Vec<str> {
    vec_push(rows, line)
    return rows
}

fn fs_nom_balance_rows() -> Vec<str> {
    let mut r = vec_new()
    r = fs_bal_push(r, "bal.a||line|asset|А. Записан, но невнесен капитал")
    r = fs_bal_push(r, "bal.b||header|asset|Б. Нетекущи (дълготрайни) активи")
    r = fs_bal_push(r, "bal.b.i|bal.b|header|asset|I. Нематериални активи")
    r = fs_bal_push(r, "bal.b.i.1|bal.b.i|line|asset|1. Продукти от развойна дейност")
    r = fs_bal_push(r, "bal.b.i.2|bal.b.i|line|asset|2. Концесии, патенти, лицензии, търговски марки, програмни продукти")
    r = fs_bal_push(r, "bal.b.i.3|bal.b.i|line|asset|3. Търговска репутация")
    r = fs_bal_push(r, "bal.b.i.4|bal.b.i|line|asset|4. Предоставени аванси и нематериални активи в процес на изграждане")
    r = fs_bal_push(r, "bal.b.i.t|bal.b.i|total|asset|Общо за група I")
    r = fs_bal_push(r, "bal.b.ii|bal.b|header|asset|II. Дълготрайни материални активи")
    r = fs_bal_push(r, "bal.b.ii.1|bal.b.ii|line|asset|1. Земи и сгради")
    r = fs_bal_push(r, "bal.b.ii.1a|bal.b.ii.1|line|asset|— земи")
    r = fs_bal_push(r, "bal.b.ii.1b|bal.b.ii.1|line|asset|— сгради")
    r = fs_bal_push(r, "bal.b.ii.2|bal.b.ii|line|asset|2. Машини, производствено оборудване и апаратура")
    r = fs_bal_push(r, "bal.b.ii.3|bal.b.ii|line|asset|3. Съоръжения и други")
    r = fs_bal_push(r, "bal.b.ii.4|bal.b.ii|line|asset|4. Предоставени аванси и ДМА в процес на изграждане")
    r = fs_bal_push(r, "bal.b.ii.t|bal.b.ii|total|asset|Общо за група II")
    r = fs_bal_push(r, "bal.b.iii|bal.b|header|asset|III. Дългосрочни финансови активи")
    r = fs_bal_push(r, "bal.b.iii.1|bal.b.iii|line|asset|1. Акции и дялове в предприятия от група")
    r = fs_bal_push(r, "bal.b.iii.5|bal.b.iii|line|asset|5. Дългосрочни инвестиции")
    r = fs_bal_push(r, "bal.b.iii.6|bal.b.iii|line|asset|6. Други заеми")
    r = fs_bal_push(r, "bal.b.iii.t|bal.b.iii|total|asset|Общо за група III")
    r = fs_bal_push(r, "bal.b.iv|bal.b|line|asset|IV. Отсрочени данъци")
    r = fs_bal_push(r, "bal.b.t|bal.b|total|asset|Общо за раздел Б")
    r = fs_bal_push(r, "bal.c||header|asset|В. Текущи (краткотрайни) активи")
    r = fs_bal_push(r, "bal.c.i|bal.c|header|asset|I. Материални запаси")
    r = fs_bal_push(r, "bal.c.i.1|bal.c.i|line|asset|1. Суровини и материали")
    r = fs_bal_push(r, "bal.c.i.2|bal.c.i|line|asset|2. Незавършено производство")
    r = fs_bal_push(r, "bal.c.i.3|bal.c.i|line|asset|3. Продукция и стоки")
    r = fs_bal_push(r, "bal.c.i.3a|bal.c.i.3|line|asset|— продукция")
    r = fs_bal_push(r, "bal.c.i.3b|bal.c.i.3|line|asset|— стоки")
    r = fs_bal_push(r, "bal.c.i.4|bal.c.i|line|asset|4. Предоставени аванси")
    r = fs_bal_push(r, "bal.c.i.t|bal.c.i|total|asset|Общо за група I")
    r = fs_bal_push(r, "bal.c.ii|bal.c|header|asset|II. Вземания")
    r = fs_bal_push(r, "bal.c.ii.1|bal.c.ii|line|asset|1. Вземания от клиенти и доставчици")
    r = fs_bal_push(r, "bal.c.ii.4|bal.c.ii|line|asset|4. Други вземания")
    r = fs_bal_push(r, "bal.c.ii.t|bal.c.ii|total|asset|Общо за група II")
    r = fs_bal_push(r, "bal.c.iii|bal.c|header|asset|III. Инвестиции")
    r = fs_bal_push(r, "bal.c.iii.3|bal.c.iii|line|asset|3. Други инвестиции")
    r = fs_bal_push(r, "bal.c.iii.t|bal.c.iii|total|asset|Общо за група III")
    r = fs_bal_push(r, "bal.c.iv|bal.c|header|asset|IV. Парични средства")
    r = fs_bal_push(r, "bal.c.iv.a|bal.c.iv|line|asset|— в брой")
    r = fs_bal_push(r, "bal.c.iv.b|bal.c.iv|line|asset|— в безсрочни сметки (депозити)")
    r = fs_bal_push(r, "bal.c.iv.t|bal.c.iv|total|asset|Общо за група IV")
    r = fs_bal_push(r, "bal.c.t|bal.c|total|asset|Общо за раздел В")
    r = fs_bal_push(r, "bal.d||line|asset|Г. Разходи за бъдещи периоди")
    r = fs_bal_push(r, "bal.t||total|asset|Сума на актива (А+Б+В+Г)")
    r = fs_bal_push(r, "bal.p.a||header|liability|А. Собствен капитал")
    r = fs_bal_push(r, "bal.p.a.i|bal.p.a|line|liability|I. Записан капитал")
    r = fs_bal_push(r, "bal.p.a.ii|bal.p.a|line|liability|II. Премии от емисии")
    r = fs_bal_push(r, "bal.p.a.iii|bal.p.a|line|liability|III. Резерв от последващи оценки")
    r = fs_bal_push(r, "bal.p.a.iv|bal.p.a|header|liability|IV. Резерви")
    r = fs_bal_push(r, "bal.p.a.iv.1|bal.p.a.iv|line|liability|1. Законови резерви")
    r = fs_bal_push(r, "bal.p.a.iv.4|bal.p.a.iv|line|liability|4. Други резерви")
    r = fs_bal_push(r, "bal.p.a.iv.t|bal.p.a.iv|total|liability|Общо за група IV")
    r = fs_bal_push(r, "bal.p.a.v|bal.p.a|header|liability|V. Натрупана печалба (загуба) от минали години")
    r = fs_bal_push(r, "bal.p.a.v.1|bal.p.a.v|line|liability|— неразпределена печалба")
    r = fs_bal_push(r, "bal.p.a.v.2|bal.p.a.v|line|liability|— непокрита загуба")
    r = fs_bal_push(r, "bal.p.a.v.t|bal.p.a.v|total|liability|Общо за група V")
    r = fs_bal_push(r, "bal.p.a.vi|bal.p.a|line|liability|VI. Текуща печалба (загуба)")
    r = fs_bal_push(r, "bal.p.a.t|bal.p.a|total|liability|Общо за раздел А")
    r = fs_bal_push(r, "bal.p.b||header|liability|Б. Провизии и сходни задължения")
    r = fs_bal_push(r, "bal.p.b.1|bal.p.b|line|liability|1. Провизии за пенсии и други подобни задължения")
    r = fs_bal_push(r, "bal.p.b.2|bal.p.b|line|liability|2. Провизии за данъци")
    r = fs_bal_push(r, "bal.p.b.3|bal.p.b|line|liability|3. Други провизии и сходни задължения")
    r = fs_bal_push(r, "bal.p.b.t|bal.p.b|total|liability|Общо за раздел Б")
    r = fs_bal_push(r, "bal.p.c||header|liability|В. Задължения")
    r = fs_bal_push(r, "bal.p.c.2|bal.p.c|line|liability|2. Задължения към финансови предприятия")
    r = fs_bal_push(r, "bal.p.c.3|bal.p.c|line|liability|3. Получени аванси")
    r = fs_bal_push(r, "bal.p.c.4|bal.p.c|line|liability|4. Задължения към доставчици")
    r = fs_bal_push(r, "bal.p.c.8|bal.p.c|line|liability|8. Други задължения")
    r = fs_bal_push(r, "bal.p.c.t|bal.p.c|total|liability|Общо за раздел В")
    r = fs_bal_push(r, "bal.p.d||line|liability|Г. Финансирания и приходи за бъдещи периоди")
    r = fs_bal_push(r, "bal.p.t||total|liability|Сума на пасива (А+Б+В+Г)")
    return r
}
