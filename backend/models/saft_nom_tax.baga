// models/saft_nom_tax.baga — SAF-T BG TAX-IMP: видове данъци и данъчни кодове (част 1).
// TaxType + TaxCode от Structure_Definition_V_1.0.1. 000/000000 = неприложимо.
// Ред тип: code|name   Ред код: tax_type|code|description|rate|note

fn saft_tax_type_push(rows: Vec<str>, line: str) -> Vec<str> {
    vec_push(rows, line)
    return rows
}

fn saft_tax_type_rows() -> Vec<str> {
    let mut r = vec_new()
    r = saft_tax_type_push(r, "000|Неприложимо")
    r = saft_tax_type_push(r, "100|ДАНЪК ВЪРХУ ДОБАВЕНАТА СТОЙНОСТ")
    r = saft_tax_type_push(r, "200|КОРПОРАТИВЕН ДАНЪК")
    r = saft_tax_type_push(r, "300|ДАНЪК ВЪРХУ ПРИХОДИТЕ НА БЮДЖЕТНИТЕ ПРЕДПРИЯТИЯ ПО ЗКПО")
    r = saft_tax_type_push(r, "400|ДАНЪК ВЪРХУ ДОПЪЛНИТЕЛНИТЕ РАЗХОДИ НА НАРОДНИТЕ ПРЕДСТАВИТЕЛИ ПО ЗКПО")
    r = saft_tax_type_push(r, "500|ДАНЪК ВЪРХУ ХАЗАРТНАТА ДЕЙНОСТ ПО ЗКПО")
    r = saft_tax_type_push(r, "600|ДАНЪК ВЪРХУ РАЗХОДИТЕ")
    r = saft_tax_type_push(r, "700|ДАНЪК ПРИ ИЗТОЧНИКА")
    r = saft_tax_type_push(r, "800|ДАНЪК ВЪРХУ ДЕЙНОСТТА ОТ ОПЕРИРАНЕ НА КОРАБИ")
    r = saft_tax_type_push(r, "900|ВРЕМЕННА СОЛИДАРНА ВНОСКА ПО РЕГЛАМЕНТ 2022/1854")
    r = saft_tax_type_push(r, "910|ДАНЪК ВЪРХУ ЗАСТРАХОВАТЕЛНИТЕ ПРЕМИИ")
    r = saft_tax_type_push(r, "915|ДОПЪЛНИТЕЛЕН ДАНЪК И НАЦИОНАЛЕН ДОПЪЛНИТЕЛЕН ДАНЪК ПО ГЛАВА ПЕТА \"А\" ОТ ЗКПО")
    r = saft_tax_type_push(r, "920|ДАНЪК ВЪРХУ ОБЩАТА ГОДИШНА ДАНЪЧНА ОСНОВА ПО ЗДДФЛ")
    r = saft_tax_type_push(r, "930|ДАНЪК ВЪРХУ ГОДИШНАТА ДАНЪЧНА ОСНОВА ЗА ДОХОДИ ОТ СТОПАНСКА ДЕЙНОСТ КАТО ЕДНОЛИЧЕН ТЪРГОВЕЦ ПО ЗДДФЛ")
    r = saft_tax_type_push(r, "940|ДЪРЖАВНО ОБЩЕСТВЕНО ОСИГУРЯВАНЕ")
    r = saft_tax_type_push(r, "950|ФОНД ДЗПО")
    r = saft_tax_type_push(r, "960|ЗДРАВНО ОСИГУРЯВАНЕ")
    r = saft_tax_type_push(r, "970|УЧИТЕЛСКИ ПЕНСИОНЕН ФОНД")
    r = saft_tax_type_push(r, "980|ФОНД ГВРС")
    r = saft_tax_type_push(r, "990|ТАКСИ ПО ЗАКОНА ЗА ХАЗАРТА")
    r = saft_tax_type_push(r, "1000|Закон за акцизите и данъчните складове")
    return r
}

fn saft_tax_code_push(rows: Vec<str>, line: str) -> Vec<str> {
    vec_push(rows, line)
    return rows
}

fn saft_tax_code_rows_a() -> Vec<str> {
    let mut r = vec_new()
    r = saft_tax_code_push(r, "000|000000|Неприложим код||Когато няма код от номенклатурата")
