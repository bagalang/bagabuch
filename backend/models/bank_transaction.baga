// models/bank_transaction.baga — банкови транзакции: helpers над ormbaga.
// Сумата е TEXT (десимална точност). transaction_type е 'DEPOSIT'/'WITHDRAWAL',
// is_booked/is_allocated са флагове (BIGINT 0/1), journal_entry_id сочи към
// journal_entries. company_id дава мултитенанта.
import "ormbaga/orm.baga"
import "ormbaga/sql.baga"
import "fmrbaga/jsonx.baga"
import "pgbaga/pg.baga"
import "std/str/str.baga"
import "std/os/os.baga"
fn bank_tx_table() -> str {
    return "bank_transactions"
}
fn bank_tx_backend_boila() -> i64 !IO {
    let be = env("ORM_BACKEND")?
    if be == "boila" || be == "boiladb" || be == "boilaDB" {
        return 1
    }
    return 0
}
// Следващ PK: таблицата е създадена с BIGSERIAL (pg); boila ползва MAX+1.
fn bank_tx_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return orm_count_sql(db, "SELECT MAX(id) AS count FROM bank_transactions")?
}
fn bank_tx_select_sql() -> str {
    return "SELECT id, bank_account_id, txn_date, amount, currency, counterpart_name, counterpart_iban, description, reference, transaction_type, is_booked, is_allocated, journal_entry_id, company_id, created_at FROM bank_transactions"
}
fn bank_tx_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_i64(o, "bank_account_id", orm_cell_by_i64(q, row, "bank_account_id"))
    o = jobj_str(o, "transaction_date", orm_cell_by(q, row, "txn_date"))
    o = jobj_str(o, "amount", orm_cell_by(q, row, "amount"))
    o = jobj_str(o, "currency", orm_cell_by(q, row, "currency"))
    o = jobj_str(o, "counterpart_name", orm_cell_by(q, row, "counterpart_name"))
    o = jobj_str(o, "counterpart_iban", orm_cell_by(q, row, "counterpart_iban"))
    o = jobj_str(o, "description", orm_cell_by(q, row, "description"))
    o = jobj_str(o, "reference", orm_cell_by(q, row, "reference"))
    o = jobj_str(o, "transaction_type", orm_cell_by(q, row, "transaction_type"))
    o = jobj_bool(o, "is_booked", orm_cell_by_i64(q, row, "is_booked"))
    o = jobj_bool(o, "is_allocated", orm_cell_by_i64(q, row, "is_allocated"))
    o = jobj_i64(o, "journal_entry_id", orm_cell_by_i64(q, row, "journal_entry_id"))
    o = jobj_i64(o, "company_id", orm_cell_by_i64(q, row, "company_id"))
    let ca = orm_cell_by(q, row, "created_at")
    if ca != "" {
        o = jobj_str(o, "created_at", ca)
    }
    return o
}
fn bank_tx_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net {
    let sql = concat(bank_tx_select_sql(), " WHERE id = $1")
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, id)
    return orm_query_params(db, sql, vals, nulls)?
}
// Транзакции по сметка (или всички, ако account_id == 0).
fn bank_tx_by_account(db: OrmDb, company_id: i64, account_id: i64) -> OrmQuery !IO !Net {
    let mut sql = bank_tx_select_sql()
    if account_id > 0 {
        sql = concat(sql, " WHERE company_id = $1 AND bank_account_id = $2 ORDER BY txn_date DESC, id DESC")
        let vals = vec_new()
        let nulls = vec_new()
        pg_param_i64(vals, nulls, company_id)
        pg_param_i64(vals, nulls, account_id)
        return orm_query_params(db, sql, vals, nulls)?
    }
    sql = concat(sql, " WHERE company_id = $1 ORDER BY txn_date DESC, id DESC")
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, company_id)
    return orm_query_params(db, sql, vals, nulls)?
}
fn bank_tx_by_company(db: OrmDb, company_id: i64) -> OrmQuery !IO !Net {
    let sql = concat(bank_tx_select_sql(), " WHERE company_id = $1 ORDER BY txn_date DESC, id DESC")
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, company_id)
    return orm_query_params(db, sql, vals, nulls)?
}
// Съществуващите референции за сметка (за откриване на дубликати при импорт).
fn bank_tx_references_by_account(db: OrmDb, account_id: i64) -> OrmQuery !IO !Net {
    let sql = "SELECT reference FROM bank_transactions WHERE bank_account_id = $1 AND reference != ''"
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, account_id)
    return orm_query_params(db, sql, vals, nulls)?
}
// Вмъква и връща реда през RETURNING (id вътре).
fn bank_tx_create(db: OrmDb, bank_account_id: i64, txn_date: str, amount: str, currency: str, counterpart_name: str, counterpart_iban: str, description: str, reference: str, transaction_type: str, is_booked: i64, is_allocated: i64, journal_entry_id: i64, company_id: i64) -> OrmQuery !IO !Net {
    if bank_tx_backend_boila()? == 1 {
        let c = bank_tx_next_id(db)?
        if orm_ok_c(c) == 0 {
            return OrmQErr(OrmQueryFail { err: orm_err_c(c), tag: "", db: orm_db_c(c) })
        }
        let nid = orm_count_n(c) + 1
        let mut d = orm_db_c(c)
        let cols = vec_new()
        vec_push(cols, "id")
        vec_push(cols, "bank_account_id")
        vec_push(cols, "txn_date")
        vec_push(cols, "amount")
        vec_push(cols, "currency")
        vec_push(cols, "counterpart_name")
        vec_push(cols, "counterpart_iban")
        vec_push(cols, "description")
        vec_push(cols, "reference")
        vec_push(cols, "transaction_type")
        vec_push(cols, "is_booked")
        vec_push(cols, "is_allocated")
        vec_push(cols, "journal_entry_id")
        vec_push(cols, "company_id")
        let vals = vec_new()
        vec_push(vals, int_to_str(nid))
        vec_push(vals, int_to_str(bank_account_id))
        vec_push(vals, txn_date)
        vec_push(vals, amount)
        vec_push(vals, currency)
        vec_push(vals, counterpart_name)
        vec_push(vals, counterpart_iban)
        vec_push(vals, description)
        vec_push(vals, reference)
        vec_push(vals, transaction_type)
        vec_push(vals, int_to_str(is_booked))
        vec_push(vals, int_to_str(is_allocated))
        vec_push(vals, int_to_str(journal_entry_id))
        vec_push(vals, int_to_str(company_id))
        let nulls = vec_new()
        let mut i: i64 = 0
        while i < 14 {
            vec_push(nulls, 0)
            i = i + 1
        }
        return orm_insert_returning_full(d, bank_tx_table(), cols, vals, nulls)?
    }
    let cols = vec_new()
    vec_push(cols, "bank_account_id")
    vec_push(cols, "txn_date")
    vec_push(cols, "amount")
    vec_push(cols, "currency")
    vec_push(cols, "counterpart_name")
    vec_push(cols, "counterpart_iban")
    vec_push(cols, "description")
    vec_push(cols, "reference")
    vec_push(cols, "transaction_type")
    vec_push(cols, "is_booked")
    vec_push(cols, "is_allocated")
    vec_push(cols, "journal_entry_id")
    vec_push(cols, "company_id")
    let vals = vec_new()
    vec_push(vals, int_to_str(bank_account_id))
    vec_push(vals, txn_date)
    vec_push(vals, amount)
    vec_push(vals, currency)
    vec_push(vals, counterpart_name)
    vec_push(vals, counterpart_iban)
    vec_push(vals, description)
    vec_push(vals, reference)
    vec_push(vals, transaction_type)
    vec_push(vals, int_to_str(is_booked))
    vec_push(vals, int_to_str(is_allocated))
    vec_push(vals, int_to_str(journal_entry_id))
    vec_push(vals, int_to_str(company_id))
    let nulls = vec_new()
    let mut i: i64 = 0
    while i < 13 {
        vec_push(nulls, 0)
        i = i + 1
    }
    return orm_insert_returning_full(db, bank_tx_table(), cols, vals, nulls)?
}
fn bank_tx_delete(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    return orm_delete_by_id(db, bank_tx_table(), id)?
}
fn bank_tx_list_json(q: OrmQuery) -> JObj {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, bank_tx_to_json(q, i))
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", orm_nrows(q))
    return o
}
