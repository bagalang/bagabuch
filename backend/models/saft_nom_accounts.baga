// models/saft_nom_accounts.baga — SAF-T BG NRA_Nom_Accounts (част 1).
// AccountID в XML. Ред: code|name|section|section_name|group|group_name

fn saft_nra_account_push(rows: Vec<str>, line: str) -> Vec<str> {
    vec_push(rows, line)
    return rows
}

