// models/role.baga — роли и права (permissions е JSON текст).

import "ormbaga/orm.baga"
import "ormbaga/sql.baga"
import "fmrbaga/jsonx.baga"
import "pgbaga/pg.baga"
import "std/str/str.baga"
import "std/os/os.baga"

fn role_table() -> str {
    return "roles"
}

fn role_backend_boila() -> i64 !IO {
    let be = env("ORM_BACKEND")?
    if be == "boila" || be == "boiladb" || be == "boilaDB" {
        return 1
    }
    return 0
}

fn role_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return orm_count_sql(db, "SELECT MAX(id) AS count FROM roles")?
}

fn role_select_sql() -> str {
    return "SELECT id, name, description, permissions, created_at FROM roles"
}

fn role_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_str(o, "name", orm_cell_by(q, row, "name"))
    o = jobj_str(o, "description", orm_cell_by(q, row, "description"))
    let perms = orm_cell_by(q, row, "permissions")
    if perms == "" {
        o = jobj_raw(o, "permissions", "[]")
    } else {
        o = jobj_raw(o, "permissions", perms)
    }
    return o
}

fn role_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net {
    let sql = concat(role_select_sql(), " WHERE id = $1")
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, id)
    return orm_query_params(db, sql, vals, nulls)?
}

fn role_all(db: OrmDb) -> OrmQuery !IO !Net {
    return orm_query(db, concat(role_select_sql(), " ORDER BY name"))?
}

fn role_create(db: OrmDb, name: str, description: str, permissions: str) -> OrmQuery !IO !Net {
    let mut perms = permissions
    if perms == "" {
        perms = "[]"
    }
    if role_backend_boila()? == 1 {
        let c = role_next_id(db)?
        if orm_ok_c(c) == 0 {
            return OrmQErr(OrmQueryFail { err: orm_err_c(c), tag: "", db: orm_db_c(c) })
        }
        let nid = orm_count_n(c) + 1
        let d = orm_db_c(c)
        let cols = vec_new()
        vec_push(cols, "id")
        vec_push(cols, "name")
        vec_push(cols, "description")
        vec_push(cols, "permissions")
        let vals = vec_new()
        vec_push(vals, int_to_str(nid))
        vec_push(vals, name)
        vec_push(vals, description)
        vec_push(vals, perms)
        let nulls = vec_new()
        vec_push(nulls, 0)
        vec_push(nulls, 0)
        vec_push(nulls, 0)
        vec_push(nulls, 0)
        return orm_insert_returning_full(d, role_table(), cols, vals, nulls)?
    }
    let cols = vec_new()
    vec_push(cols, "name")
    vec_push(cols, "description")
    vec_push(cols, "permissions")
    let vals = vec_new()
    vec_push(vals, name)
    vec_push(vals, description)
    vec_push(vals, perms)
    let nulls = vec_new()
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    return orm_insert_returning_full(db, role_table(), cols, vals, nulls)?
}

fn role_delete(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    return orm_delete_by_id(db, role_table(), id)?
}

fn role_list_json(q: OrmQuery) -> JObj {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, role_to_json(q, i))
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", orm_nrows(q))
    return o
}
