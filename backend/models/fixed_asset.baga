        vec_push(cols, "model")
        vec_push(cols, "responsible_person")
        vec_push(cols, "is_conserved")
        let vals = vec_new()
        vec_push(vals, int_to_str(nid))
        vec_push(vals, name)
        vec_push(vals, inventory_number)
        vec_push(vals, int_to_str(category_id))
        vec_push(vals, acquisition_date)
        vec_push(vals, put_into_service_date)
        vec_push(vals, cost)
        vec_push(vals, salvage_value)
        vec_push(vals, useful_life_months)
        vec_push(vals, depreciation_method)
        vec_push(vals, accounting_depreciation_rate)
        vec_push(vals, tax_depreciation_rate)
        vec_push(vals, "0")
        vec_push(vals, "0")
        vec_push(vals, status)
        vec_push(vals, serial_number)
        vec_push(vals, manufacturer)
        vec_push(vals, model)
        vec_push(vals, responsible_person)
        vec_push(vals, int_to_str(is_conserved))
        let nulls = vec_new()
        let mut i: i64 = 0
        while i < 20 {
            vec_push(nulls, 0)
            i = i + 1
        }
        return orm_insert_returning_full(d, fa_table(), cols, vals, nulls)?
    }
    let cols = vec_new()
    vec_push(cols, "name")
    vec_push(cols, "inventory_number")
    vec_push(cols, "category_id")
    vec_push(cols, "acquisition_date")
    vec_push(cols, "put_into_service_date")
    vec_push(cols, "cost")
    vec_push(cols, "salvage_value")
    vec_push(cols, "useful_life_months")
    vec_push(cols, "depreciation_method")
    vec_push(cols, "accounting_depreciation_rate")
    vec_push(cols, "tax_depreciation_rate")
    vec_push(cols, "accumulated_depreciation")
    vec_push(cols, "tax_accumulated_depreciation")
    vec_push(cols, "status")
    vec_push(cols, "serial_number")
    vec_push(cols, "manufacturer")
    vec_push(cols, "model")
    vec_push(cols, "responsible_person")
    vec_push(cols, "is_conserved")
    let vals = vec_new()
    vec_push(vals, name)
    vec_push(vals, inventory_number)
    vec_push(vals, int_to_str(category_id))
    vec_push(vals, acquisition_date)
    vec_push(vals, put_into_service_date)
    vec_push(vals, cost)
    vec_push(vals, salvage_value)
    vec_push(vals, useful_life_months)
    vec_push(vals, depreciation_method)
    vec_push(vals, accounting_depreciation_rate)
