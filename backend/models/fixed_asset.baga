// models/fixed_asset.baga — ДМА: категории (ЗКПО) + активи + помощници.
// Table DDL живее в schema.baga на bagabuch. Сумите са NUMERIC като стрингове.

import "ormbaga/orm.baga"
import "ormbaga/sql.baga"
import "fmrbaga/jsonx.baga"
import "pgbaga/pg.baga"
import "std/str/str.baga"
import "std/os/os.baga"

fn fa_backend_boila() -> i64 !IO {
    let be = env("ORM_BACKEND")?
    if be == "boila" || be == "boiladb" || be == "boilaDB" {
        return 1
    }
    return 0
}

// ---------- категории ----------

fn fac_table() -> str {
    return "fixed_asset_categories"
}

fn fac_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return orm_count_sql(db, "SELECT MAX(id) AS count FROM fixed_asset_categories")?
}

fn fac_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_str(o, "name", orm_cell_by(q, row, "name"))
    o = jobj_str(o, "cita_category", orm_cell_by(q, row, "cita_category"))
    o = jobj_str(o, "min_depreciation_rate", orm_cell_by(q, row, "min_depreciation_rate"))
    o = jobj_str(o, "max_depreciation_rate", orm_cell_by(q, row, "max_depreciation_rate"))
    o = jobj_str(o, "default_method", orm_cell_by(q, row, "default_method"))
    let aa = orm_cell_by_i64(q, row, "asset_account_id")
    if aa > 0 {
        o = jobj_i64(o, "asset_account_id", aa)
    }
    let da = orm_cell_by_i64(q, row, "depreciation_account_id")
    if da > 0 {
        o = jobj_i64(o, "depreciation_account_id", da)
    }
    let ea = orm_cell_by_i64(q, row, "expense_account_id")
    if ea > 0 {
        o = jobj_i64(o, "expense_account_id", ea)
    }
    return o
}

fn fac_select_sql() -> str {
    return "SELECT id, name, cita_category, min_depreciation_rate, max_depreciation_rate, default_method, asset_account_id, depreciation_account_id, expense_account_id FROM fixed_asset_categories"
}

fn fac_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net {
    let sql = concat(fac_select_sql(), " WHERE id = $1")
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, id)
    return orm_query_params(db, sql, vals, nulls)?
}

fn fac_all(db: OrmDb) -> OrmQuery !IO !Net {
    return orm_query(db, concat(fac_select_sql(), " ORDER BY id"))?
}

fn fac_create(db: OrmDb, name: str, cita_category: str, min_rate: str, max_rate: str, default_method: str, asset_acc: i64, dep_acc: i64, exp_acc: i64) -> OrmQuery !IO !Net {
    if fa_backend_boila()? == 1 {
        let c = fac_next_id(db)?
        if orm_ok_c(c) == 0 {
            return OrmQErr(OrmQueryFail { err: orm_err_c(c), tag: "", db: orm_db_c(c) })
        }
        let nid = orm_count_n(c) + 1
        let mut d = orm_db_c(c)
        let cols = vec_new()
        vec_push(cols, "id")
        vec_push(cols, "name")
        vec_push(cols, "cita_category")
        vec_push(cols, "min_depreciation_rate")
        vec_push(cols, "max_depreciation_rate")
        vec_push(cols, "default_method")
        vec_push(cols, "asset_account_id")
        vec_push(cols, "depreciation_account_id")
        vec_push(cols, "expense_account_id")
        let vals = vec_new()
        vec_push(vals, int_to_str(nid))
        vec_push(vals, name)
        vec_push(vals, cita_category)
        vec_push(vals, min_rate)
        vec_push(vals, max_rate)
        vec_push(vals, default_method)
        vec_push(vals, int_to_str(asset_acc))
        vec_push(vals, int_to_str(dep_acc))
        vec_push(vals, int_to_str(exp_acc))
        let nulls = vec_new()
        let mut i: i64 = 0
        while i < 9 {
            vec_push(nulls, 0)
            i = i + 1
        }
        return orm_insert_returning_full(d, fac_table(), cols, vals, nulls)?
    }
    let cols = vec_new()
    vec_push(cols, "name")
    vec_push(cols, "cita_category")
    vec_push(cols, "min_depreciation_rate")
    vec_push(cols, "max_depreciation_rate")
    vec_push(cols, "default_method")
    vec_push(cols, "asset_account_id")
    vec_push(cols, "depreciation_account_id")
    vec_push(cols, "expense_account_id")
    let vals = vec_new()
    vec_push(vals, name)
    vec_push(vals, cita_category)
    vec_push(vals, min_rate)
    vec_push(vals, max_rate)
    vec_push(vals, default_method)
    vec_push(vals, int_to_str(asset_acc))
    vec_push(vals, int_to_str(dep_acc))
    vec_push(vals, int_to_str(exp_acc))
    let nulls = vec_new()
    let mut i: i64 = 0
    while i < 8 {
        vec_push(nulls, 0)
        i = i + 1
    }
    return orm_insert_returning_full(db, fac_table(), cols, vals, nulls)?
}

fn fac_delete(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    return orm_delete_by_id(db, fac_table(), id)?
}

fn fac_list_json(q: OrmQuery) -> JObj {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, fac_to_json(q, i))
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", orm_nrows(q))
    return o
}

// ---------- активи ----------

fn fa_table() -> str {
    return "fixed_assets"
}

fn fa_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return orm_count_sql(db, "SELECT MAX(id) AS count FROM fixed_assets")?
}

fn fa_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_str(o, "name", orm_cell_by(q, row, "name"))
    o = jobj_str(o, "inventory_number", orm_cell_by(q, row, "inventory_number"))
    let cid = orm_cell_by_i64(q, row, "category_id")
    if cid > 0 {
        o = jobj_i64(o, "category_id", cid)
    }
    o = jobj_str(o, "acquisition_date", orm_cell_by(q, row, "acquisition_date"))
    o = jobj_str(o, "put_into_service_date", orm_cell_by(q, row, "put_into_service_date"))
    o = jobj_str(o, "cost", orm_cell_by(q, row, "cost"))
    o = jobj_str(o, "salvage_value", orm_cell_by(q, row, "salvage_value"))
    o = jobj_str(o, "useful_life_months", orm_cell_by(q, row, "useful_life_months"))
    o = jobj_str(o, "depreciation_method", orm_cell_by(q, row, "depreciation_method"))
    o = jobj_str(o, "accounting_depreciation_rate", orm_cell_by(q, row, "accounting_depreciation_rate"))
    o = jobj_str(o, "tax_depreciation_rate", orm_cell_by(q, row, "tax_depreciation_rate"))
    o = jobj_str(o, "accumulated_depreciation", orm_cell_by(q, row, "accumulated_depreciation"))
    o = jobj_str(o, "tax_accumulated_depreciation", orm_cell_by(q, row, "tax_accumulated_depreciation"))
    o = jobj_str(o, "status", orm_cell_by(q, row, "status"))
    o = jobj_str(o, "serial_number", orm_cell_by(q, row, "serial_number"))
    o = jobj_str(o, "manufacturer", orm_cell_by(q, row, "manufacturer"))
    o = jobj_str(o, "model", orm_cell_by(q, row, "model"))
    o = jobj_str(o, "responsible_person", orm_cell_by(q, row, "responsible_person"))
    o = jobj_i64(o, "is_conserved", orm_cell_by_i64(q, row, "is_conserved"))
    o = jobj_i64(o, "location_id", orm_cell_by_i64(q, row, "location_id"))
    return o
}

fn fa_select_sql() -> str {
    return "SELECT id, name, inventory_number, category_id, acquisition_date, put_into_service_date, cost, salvage_value, useful_life_months, depreciation_method, accounting_depreciation_rate, tax_depreciation_rate, accumulated_depreciation, tax_accumulated_depreciation, status, serial_number, manufacturer, model, responsible_person, is_conserved, location_id FROM fixed_assets"
}

fn fa_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net {
    let sql = concat(fa_select_sql(), " WHERE id = $1")
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, id)
    return orm_query_params(db, sql, vals, nulls)?
}

fn fa_all(db: OrmDb) -> OrmQuery !IO !Net {
    return orm_query(db, concat(fa_select_sql(), " ORDER BY id"))?
}

fn fa_create(db: OrmDb, name: str, inventory_number: str, category_id: i64, acquisition_date: str, put_into_service_date: str, cost: str, salvage_value: str, useful_life_months: str, depreciation_method: str, accounting_depreciation_rate: str, tax_depreciation_rate: str, status: str, serial_number: str, manufacturer: str, model: str, responsible_person: str, is_conserved: i64) -> OrmQuery !IO !Net {
    if fa_backend_boila()? == 1 {
        let c = fa_next_id(db)?
        if orm_ok_c(c) == 0 {
            return OrmQErr(OrmQueryFail { err: orm_err_c(c), tag: "", db: orm_db_c(c) })
        }
        let nid = orm_count_n(c) + 1
