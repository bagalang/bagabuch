// models/bank_account.baga — банкови сметки: helpers над ormbaga.
// Таблицата bank_accounts е от phase 1 (BIGSERIAL) и беше обогатена
// (име, номер, ГЛ/буферна сметка, начално салдо, company_id). Салдото е
// TEXT (десимална точност, без float). Уникалността на IBAN е UNIQUE
// в DDL — при вмъкване на дубликат грешката се лови в action-а.
import "ormbaga/orm.baga"
import "ormbaga/sql.baga"
import "fmrbaga/jsonx.baga"
import "pgbaga/pg.baga"
import "std/str/str.baga"
import "std/os/os.baga"
fn bank_account_table() -> str {
    return "bank_accounts"
}
fn bank_account_backend_boila() -> i64 !IO {
    let be = env("ORM_BACKEND")?
    if be == "boila" || be == "boiladb" || be == "boilaDB" {
        return 1
    }
    return 0
}
// Следващ PK: таблицата е създадена с BIGSERIAL (pg); boila ползва MAX+1.
fn bank_account_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return orm_count_sql(db, "SELECT MAX(id) AS count FROM bank_accounts")?
}
// Без table alias и без `.` qualifier — BoilaSQL ги отказва в SELECT
// (`неочакван токен '.'`). Двоен JOIN към accounts също иска alias.
// Кодовете на ГЛ/буфер се слагат в UI от вече заредения сметкоплан.
fn bank_account_select_sql() -> str {
    return "SELECT id, iban, bic, bank_name, currency, name, account_number, gl_account_id, buffer_account_id, balance, company_id, created_at FROM bank_accounts"
}
fn bank_account_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_str(o, "iban", orm_cell_by(q, row, "iban"))
    o = jobj_str(o, "bic", orm_cell_by(q, row, "bic"))
    o = jobj_str(o, "bank_name", orm_cell_by(q, row, "bank_name"))
    o = jobj_str(o, "currency", orm_cell_by(q, row, "currency"))
    o = jobj_str(o, "name", orm_cell_by(q, row, "name"))
    o = jobj_str(o, "account_number", orm_cell_by(q, row, "account_number"))
    o = jobj_i64(o, "gl_account_id", orm_cell_by_i64(q, row, "gl_account_id"))
    o = jobj_i64(o, "buffer_account_id", orm_cell_by_i64(q, row, "buffer_account_id"))
    o = jobj_str(o, "balance", orm_cell_by(q, row, "balance"))
    o = jobj_i64(o, "company_id", orm_cell_by_i64(q, row, "company_id"))
    let gc = orm_cell_by(q, row, "gl_code")
    if gc != "" {
        o = jobj_str(o, "gl_account_code", gc)
    }
    let bc = orm_cell_by(q, row, "buffer_code")
    if bc != "" {
        o = jobj_str(o, "buffer_account_code", bc)
    }
    let ca = orm_cell_by(q, row, "created_at")
    if ca != "" {
        o = jobj_str(o, "created_at", ca)
    }
    return o
}
fn bank_account_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net {
    let sql = concat(bank_account_select_sql(), " WHERE id = $1")
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, id)
    return orm_query_params(db, sql, vals, nulls)?
}
fn bank_account_by_company(db: OrmDb, company_id: i64) -> OrmQuery !IO !Net {
    let sql = concat(bank_account_select_sql(), " WHERE company_id = $1 ORDER BY name, id")
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, company_id)
    return orm_query_params(db, sql, vals, nulls)?
}
fn bank_account_all(db: OrmDb) -> OrmQuery !IO !Net {
    return orm_query(db, concat(bank_account_select_sql(), " ORDER BY name, id"))?
}
// Вмъква и връща реда през RETURNING (id вътре).
fn bank_account_create(db: OrmDb, company_id: i64, iban: str, bic: str, bank_name: str, currency: str, name: str, account_number: str, gl_account_id: i64, buffer_account_id: i64, balance: str) -> OrmQuery !IO !Net {
    if bank_account_backend_boila()? == 1 {
        let c = bank_account_next_id(db)?
        if orm_ok_c(c) == 0 {
            return OrmQErr(OrmQueryFail { err: orm_err_c(c), tag: "", db: orm_db_c(c) })
        }
        let nid = orm_count_n(c) + 1
        let mut d = orm_db_c(c)
        let cols = vec_new()
        vec_push(cols, "id")
        vec_push(cols, "company_id")
        vec_push(cols, "iban")
        vec_push(cols, "bic")
        vec_push(cols, "bank_name")
        vec_push(cols, "currency")
        vec_push(cols, "name")
        vec_push(cols, "account_number")
        vec_push(cols, "gl_account_id")
        vec_push(cols, "buffer_account_id")
        vec_push(cols, "balance")
        let vals = vec_new()
        vec_push(vals, int_to_str(nid))
        vec_push(vals, int_to_str(company_id))
        vec_push(vals, iban)
        vec_push(vals, bic)
        vec_push(vals, bank_name)
        vec_push(vals, currency)
        vec_push(vals, name)
        vec_push(vals, account_number)
        vec_push(vals, int_to_str(gl_account_id))
        vec_push(vals, int_to_str(buffer_account_id))
        vec_push(vals, balance)
        let nulls = vec_new()
        let mut i: i64 = 0
        while i < 11 {
            vec_push(nulls, 0)
            i = i + 1
        }
        return orm_insert_returning_full(d, bank_account_table(), cols, vals, nulls)?
    }
    let cols = vec_new()
    vec_push(cols, "company_id")
    vec_push(cols, "iban")
    vec_push(cols, "bic")
    vec_push(cols, "bank_name")
    vec_push(cols, "currency")
    vec_push(cols, "name")
    vec_push(cols, "account_number")
    vec_push(cols, "gl_account_id")
    vec_push(cols, "buffer_account_id")
    vec_push(cols, "balance")
    let vals = vec_new()
    vec_push(vals, int_to_str(company_id))
    vec_push(vals, iban)
    vec_push(vals, bic)
    vec_push(vals, bank_name)
    vec_push(vals, currency)
    vec_push(vals, name)
    vec_push(vals, account_number)
    vec_push(vals, int_to_str(gl_account_id))
    vec_push(vals, int_to_str(buffer_account_id))
    vec_push(vals, balance)
    let nulls = vec_new()
    let mut i: i64 = 0
    while i < 10 {
        vec_push(nulls, 0)
        i = i + 1
    }
    return orm_insert_returning_full(db, bank_account_table(), cols, vals, nulls)?
}
fn bank_account_delete(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    return orm_delete_by_id(db, bank_account_table(), id)?
}
fn bank_account_list_json(q: OrmQuery) -> JObj {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, bank_account_to_json(q, i))
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", orm_nrows(q))
    return o
}
