fn unit_catalog_saft(rows: Vec<str>) -> Vec<str> {
    let mut r = rows
    r = unit_catalog_push(r, "XOS|Пръчка|Stick|пр.|PACKAGING|SAFT")
    r = unit_catalog_push(r, "XME|Отворена щайга|Open-topped crate|щайга|PACKAGING|SAFT")
    r = unit_catalog_push(r, "XPK|Пакет (Rec 21)|Pack|пак.|PACKAGING|SAFT")
    r = unit_catalog_push(r, "XBX|Кутия (Rec 21)|Box|кут.|PACKAGING|SAFT")
    r = unit_catalog_push(r, "XCT|Кашон (Rec 21)|Carton|каш.|PACKAGING|SAFT")
    r = unit_catalog_push(r, "XBG|Торба (Rec 21)|Bag|торба|PACKAGING|SAFT")
    r = unit_catalog_push(r, "XRO|Ролка (Rec 21)|Roll|рол.|PACKAGING|SAFT")
    r = unit_catalog_push(r, "XBO|Бутилка (Rec 21)|Bottle|бут.|PACKAGING|SAFT")
    r = unit_catalog_push(r, "XCR|Щайга (Rec 21)|Crate|щайга|PACKAGING|SAFT")
    r = unit_catalog_push(r, "XDR|Барабан (Rec 21)|Drum|барабан|PACKAGING|SAFT")
    r = unit_catalog_push(r, "XPL|Кофа (Rec 21)|Pail|кофа|PACKAGING|SAFT")
    r = unit_catalog_push(r, "XPX|Палет|Pallet|палет|PACKAGING|SAFT")
    r = unit_catalog_push(r, "XSA|Чувал|Sack|чувал|PACKAGING|SAFT")
    r = unit_catalog_push(r, "XTU|Тубичка (Rec 21)|Tube|тубичка|PACKAGING|SAFT")
    r = unit_catalog_push(r, "XJR|Буркан (Rec 21)|Jar|буркан|PACKAGING|SAFT")
    r = unit_catalog_push(r, "XCN|Контейнер|Container|конт.|PACKAGING|SAFT")
    r = unit_catalog_push(r, "XPC|Колет|Parcel|колет|PACKAGING|SAFT")
    r = unit_catalog_push(r, "XSW|Свита опаковка|Shrinkwrapped|свита|PACKAGING|SAFT")
    r = unit_catalog_push(r, "XPE|Палет (евро)|Pallet (EUR)|европалет|PACKAGING|SAFT")
    r = unit_catalog_push(r, "XCS|Каса (Rec 21)|Case|каса|PACKAGING|SAFT")
    return r
}

fn unit_catalog_rows() -> Vec<str> {
    return unit_catalog_saft(unit_catalog_unece(vec_new()))
}
