// models/unit_catalog.baga — комбиниран каталог мерни единици.
// UN/ECE Rec 20 (UBL/PEPPOL, secret/inv) + Rec 21 опаковки (SAF-T BG).
// Формат на ред: code|name_bg|name_en|symbol|category|source
// source: UNECE (Rec 20), SAFT (Rec 21), BOTH (и в двата).

fn unit_catalog_push(rows: Vec<str>, line: str) -> Vec<str> {
    vec_push(rows, line)
    return rows
}

