// models/accounting_period.baga — счетоводни месеци (open/closed).
// Липсващ ред = отворен период (като в su-doxis).

import "ormbaga/orm.baga"
import "ormbaga/sql.baga"
import "fmrbaga/jsonx.baga"
import "pgbaga/pg.baga"
import "std/str/str.baga"
import "std/os/os.baga"

fn aper_table() -> str { return "accounting_periods" }

fn aper_backend_boila() -> i64 !IO {
    let be = env("ORM_BACKEND")?
    if be == "boila" || be == "boiladb" || be == "boilaDB" {
        return 1
    }
    return 0
}

fn aper_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return orm_count_sql(db, "SELECT MAX(id) AS count FROM accounting_periods")?
}

fn aper_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_i64(o, "year", orm_cell_by_i64(q, row, "year"))
    o = jobj_i64(o, "month", orm_cell_by_i64(q, row, "month"))
    o = jobj_str(o, "status", orm_cell_by(q, row, "status"))
    o = jobj_str(o, "closed_at", orm_cell_by(q, row, "closed_at"))
    o = jobj_str(o, "notes", orm_cell_by(q, row, "notes"))
    return o
}

fn aper_select_sql() -> str {
    return "SELECT id, year, month, status, closed_at, notes FROM accounting_periods"
}

fn aper_by_year(db: OrmDb, year: i64) -> OrmQuery !IO !Net {
    let sql = concat(aper_select_sql(), " WHERE year = $1 ORDER BY month")
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, year)
    return orm_query_params(db, sql, vals, nulls)?
}

fn aper_insert(db: OrmDb, year: i64, month: i64, status: str, closed_at: str, notes: str) -> OrmExec !IO !Net {
    if aper_backend_boila()? == 1 {
        let c = aper_next_id(db)?
        if orm_ok_c(c) == 0 {
            return OrmEErr(OrmExecFail { err: orm_err_c(c), tag: "", db: orm_db_c(c) })
        }
        let nid = orm_count_n(c) + 1
        let mut d = orm_db_c(c)
        let cols = vec_new()
        vec_push(cols, "id")
        vec_push(cols, "year")
        vec_push(cols, "month")
        vec_push(cols, "status")
        vec_push(cols, "closed_at")
        vec_push(cols, "notes")
        let vals = vec_new()
        vec_push(vals, int_to_str(nid))
        vec_push(vals, int_to_str(year))
        vec_push(vals, int_to_str(month))
        vec_push(vals, status)
        vec_push(vals, closed_at)
        vec_push(vals, notes)
        return orm_insert_strs(d, aper_table(), cols, vals)?
    }
    let cols = vec_new()
    vec_push(cols, "year")
    vec_push(cols, "month")
    vec_push(cols, "status")
    vec_push(cols, "closed_at")
    vec_push(cols, "notes")
    let vals = vec_new()
    vec_push(vals, int_to_str(year))
    vec_push(vals, int_to_str(month))
    vec_push(vals, status)
    vec_push(vals, closed_at)
    vec_push(vals, notes)
    return orm_insert_strs(db, aper_table(), cols, vals)?
}

fn aper_list_json(q: OrmQuery, year: i64) -> JObj {
    let mut arr = jarr_new()
    let mut m: i64 = 1
    while m <= 12 {
        let mut status = "open"
        let mut closed_at = ""
        let mut notes = ""
        let mut id: i64 = 0
        let mut i: i64 = 0
        while i < orm_nrows(q) {
            if orm_cell_by_i64(q, i, "month") == m {
                let st = orm_cell_by(q, i, "status")
                if st != "" {
                    status = st
                }
                closed_at = orm_cell_by(q, i, "closed_at")
                notes = orm_cell_by(q, i, "notes")
                id = orm_cell_by_i64(q, i, "id")
            }
            i = i + 1
        }
        let mut o = jobj_new()
        if id > 0 {
            o = jobj_i64(o, "id", id)
        }
        o = jobj_i64(o, "year", year)
        o = jobj_i64(o, "month", m)
        o = jobj_str(o, "status", status)
        o = jobj_str(o, "closed_at", closed_at)
        o = jobj_str(o, "notes", notes)
        arr = jarr_obj(arr, o)
        m = m + 1
    }
    let mut out = jobj_new()
    out = jobj_raw(out, "items", jarr_encode(arr))
    out = jobj_i64(out, "year", year)
    return out
}
