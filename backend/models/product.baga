// models/product.baga — products (стоки/услуги) table helpers over ormbaga.
// Table DDL живее в schema.baga на bagabuch. price/vat_rate/cost са NUMERIC —
// подават се като стрингове за точност (без float загуби).

import "ormbaga/orm.baga"
import "ormbaga/sql.baga"
import "fmrbaga/jsonx.baga"
import "pgbaga/pg.baga"
import "std/str/str.baga"
import "std/os/os.baga"

fn product_table() -> str {
    return "products"
}

fn product_backend_boila() -> i64 !IO {
    let be = env("ORM_BACKEND")?
    if be == "boila" || be == "boiladb" || be == "boilaDB" {
        return 1
    }
    return 0
}

// Следващ PK: таблицата е създадена преди P20 (без BIGSERIAL). NULL max → 0.
fn product_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return orm_count_sql(db, "SELECT MAX(id) AS count FROM products")?
}

fn product_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_str(o, "name", orm_cell_by(q, row, "name"))
    o = jobj_str(o, "code", orm_cell_by(q, row, "code"))
    o = jobj_str(o, "description", orm_cell_by(q, row, "description"))
    o = jobj_str(o, "unit", orm_cell_by(q, row, "unit"))
    o = jobj_str(o, "price", orm_cell_by(q, row, "price"))
    o = jobj_str(o, "cost_price", orm_cell_by(q, row, "cost_price"))
    o = jobj_str(o, "vat_rate", orm_cell_by(q, row, "vat_rate"))
    o = jobj_i64(o, "is_service", orm_cell_by_i64(q, row, "is_service"))
    o = jobj_i64(o, "is_inventory", orm_cell_by_i64(q, row, "is_inventory"))
    o = jobj_i64(o, "inventory_account_id", orm_cell_by_i64(q, row, "inventory_account_id"))
    o = jobj_i64(o, "revenue_account_id", orm_cell_by_i64(q, row, "revenue_account_id"))
    o = jobj_str(o, "stock_quantity", orm_cell_by(q, row, "stock_quantity"))
    o = jobj_str(o, "stock_value", orm_cell_by(q, row, "stock_value"))
    let mut act = orm_cell_by_i64(q, row, "is_active")
    if orm_cell_by(q, row, "is_active") == "" {
        act = 1
    }
    o = jobj_i64(o, "is_active", act)
    let ca = orm_cell_by(q, row, "created_at")
    if ca != "" {
        o = jobj_str(o, "created_at", ca)
    }
    return o
}

// Dual-safe: без ::text кастове (граматиката на boila за кастове е по-тясна).
fn product_select_sql() -> str {
    return "SELECT id, name, code, description, unit, price, cost_price, vat_rate, is_service, is_inventory, inventory_account_id, revenue_account_id, stock_quantity, stock_value, is_active, created_at FROM products"
}

fn product_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net {
    let sql = concat(product_select_sql(), " WHERE id = $1")
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, id)
    return orm_query_params(db, sql, vals, nulls)?
}

fn product_all(db: OrmDb) -> OrmQuery !IO !Net {
    return orm_query(db, concat(product_select_sql(), " ORDER BY id"))?
}

fn product_cols() -> Vec<str> {
    let cols = vec_new()
    vec_push(cols, "name")
    vec_push(cols, "code")
    vec_push(cols, "description")
    vec_push(cols, "unit")
    vec_push(cols, "price")
    vec_push(cols, "cost_price")
    vec_push(cols, "vat_rate")
    vec_push(cols, "is_service")
    vec_push(cols, "is_inventory")
    vec_push(cols, "inventory_account_id")
    vec_push(cols, "revenue_account_id")
    vec_push(cols, "stock_quantity")
    vec_push(cols, "stock_value")
    vec_push(cols, "is_active")
    return cols
}

fn product_vals(name: str, code: str, description: str, unit: str, price: str, cost_price: str, vat_rate: str, is_service: i64, is_inventory: i64, inventory_account_id: i64, revenue_account_id: i64, stock_quantity: str, stock_value: str, is_active: i64) -> Vec<str> {
    let vals = vec_new()
    vec_push(vals, name)
    vec_push(vals, code)
    vec_push(vals, description)
    vec_push(vals, unit)
    vec_push(vals, price)
    vec_push(vals, cost_price)
    vec_push(vals, vat_rate)
    vec_push(vals, int_to_str(is_service))
    vec_push(vals, int_to_str(is_inventory))
    vec_push(vals, int_to_str(inventory_account_id))
    vec_push(vals, int_to_str(revenue_account_id))
    vec_push(vals, stock_quantity)
    vec_push(vals, stock_value)
    vec_push(vals, int_to_str(is_active))
    return vals
}

fn product_create(db: OrmDb, name: str, code: str, description: str, unit: str, price: str, cost_price: str, vat_rate: str, is_service: i64, is_inventory: i64, inventory_account_id: i64, revenue_account_id: i64, stock_quantity: str, stock_value: str, is_active: i64) -> OrmExec !IO !Net {
    if product_backend_boila()? == 1 {
        let c = product_next_id(db)?
        if orm_ok_c(c) == 0 {
            return OrmEErr(OrmExecFail { err: orm_err_c(c), tag: "", db: orm_db_c(c) })
        }
        let nid = orm_count_n(c) + 1
        let mut d = orm_db_c(c)
        let cols = product_cols()
        let head = vec_new()
        vec_push(head, "id")
        let mut i: i64 = 0
        while i < vec_len(cols) {
            vec_push(head, vec_get(cols, i))
            i = i + 1
        }
        let body = product_vals(name, code, description, unit, price, cost_price, vat_rate, is_service, is_inventory, inventory_account_id, revenue_account_id, stock_quantity, stock_value, is_active)
        let vals = vec_new()
        vec_push(vals, int_to_str(nid))
        i = 0
        while i < vec_len(body) {
            vec_push(vals, vec_get(body, i))
            i = i + 1
        }
        return orm_insert_strs(d, product_table(), head, vals)?
    }
    return orm_insert_strs(db, product_table(), product_cols(), product_vals(name, code, description, unit, price, cost_price, vat_rate, is_service, is_inventory, inventory_account_id, revenue_account_id, stock_quantity, stock_value, is_active))?
}

fn product_delete(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    return orm_delete_by_id(db, product_table(), id)?
}

fn product_set_stock(db: OrmDb, id: i64, qty: str, value: str, cost_price: str) -> OrmExec !IO !Net {
    let cols = vec_new()
    vec_push(cols, "stock_quantity")
    vec_push(cols, "stock_value")
    vec_push(cols, "cost_price")
    let vals = vec_new()
    vec_push(vals, qty)
    vec_push(vals, value)
    vec_push(vals, cost_price)
    return orm_update_by_id(db, product_table(), id, cols, vals)?
}

fn product_list_json(q: OrmQuery) -> JObj {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, product_to_json(q, i))
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", orm_nrows(q))
    return o
}
