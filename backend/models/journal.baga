// models/journal.baga — journal_entries + journal_lines helpers over ormbaga.
// Table DDL живее в schema.baga на bagabuch. direction е 'debit'/'credit'.

import "ormbaga/orm.baga"
import "ormbaga/sql.baga"
import "fmrbaga/jsonx.baga"
import "pgbaga/pg.baga"
import "std/str/str.baga"
import "std/os/os.baga"

fn journal_entry_table() -> str {
    return "journal_entries"
}

fn journal_line_table() -> str {
    return "journal_lines"
}

fn journal_backend_boila() -> i64 !IO {
    let be = env("ORM_BACKEND")?
    if be == "boila" || be == "boiladb" || be == "boilaDB" {
        return 1
    }
    return 0
}

fn journal_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return orm_count_sql(db, "SELECT MAX(id) AS count FROM journal_entries")?
}

fn journal_line_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return orm_count_sql(db, "SELECT MAX(id) AS count FROM journal_lines")?
}

fn journal_entry_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_str(o, "entry_date", orm_cell_by(q, row, "entry_date"))
    o = jobj_str(o, "document_type", orm_cell_by(q, row, "document_type"))
    o = jobj_i64(o, "document_id", orm_cell_by_i64(q, row, "document_id"))
    o = jobj_str(o, "description", orm_cell_by(q, row, "description"))
    o = jobj_str(o, "vat_type", orm_cell_by(q, row, "vat_type"))
    let cpid = orm_cell_by_i64(q, row, "counterpart_id")
    if cpid > 0 {
        o = jobj_i64(o, "counterpart_id", cpid)
    }
    o = jobj_str(o, "counterpart_name", orm_cell_by(q, row, "counterpart_name"))
    o = jobj_str(o, "counterpart_vat_number", orm_cell_by(q, row, "counterpart_vat_number"))
    o = jobj_str(o, "document_number", orm_cell_by(q, row, "document_number"))
    o = jobj_str(o, "document_date", orm_cell_by(q, row, "document_date"))
    o = jobj_str(o, "vat_period", orm_cell_by(q, row, "vat_period"))
    o = jobj_str(o, "total_vat_amount", orm_cell_by(q, row, "total_vat_amount"))
    o = jobj_str(o, "total_amount", orm_cell_by(q, row, "total_amount"))
    let ca = orm_cell_by(q, row, "created_at")
    if ca != "" {
        o = jobj_str(o, "created_at", ca)
    }
    return o
}

fn journal_line_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_i64(o, "entry_id", orm_cell_by_i64(q, row, "entry_id"))
    o = jobj_i64(o, "account_id", orm_cell_by_i64(q, row, "account_id"))
    o = jobj_str(o, "direction", orm_cell_by(q, row, "direction"))
    o = jobj_str(o, "amount", orm_cell_by(q, row, "amount"))
    let va = orm_cell_by(q, row, "vat_amount")
    if va != "" {
        o = jobj_str(o, "vat_amount", va)
    }
    let cp = orm_cell_by_i64(q, row, "counterpart_id")
    if cp > 0 {
        o = jobj_i64(o, "counterpart_id", cp)
    }
    let pr = orm_cell_by_i64(q, row, "product_id")
    if pr > 0 {
        o = jobj_i64(o, "product_id", pr)
    }
    o = jobj_i64(o, "location_id", orm_cell_by_i64(q, row, "location_id"))
    let mut an = orm_cell_by(q, row, "account_number")
    if an == "" {
        an = orm_cell_by(q, row, "number")
    }
    if an != "" {
        o = jobj_str(o, "account_number", an)
        let mut anm = orm_cell_by(q, row, "account_name")
        if anm == "" {
            anm = orm_cell_by(q, row, "name")
        }
        o = jobj_str(o, "account_name", anm)
    }
    return o
}

fn journal_select_sql() -> str {
    return "SELECT id, entry_date, document_type, document_id, description, vat_type, counterpart_id, counterpart_name, counterpart_vat_number, document_number, document_date, vat_period, total_amount, total_vat_amount, created_at FROM journal_entries"
}

fn journal_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net {
    let sql = concat(journal_select_sql(), " WHERE id = $1")
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, id)
    return orm_query_params(db, sql, vals, nulls)?
}

fn journal_all(db: OrmDb) -> OrmQuery !IO !Net {
    return orm_query(db, concat(journal_select_sql(), " ORDER BY id"))?
}

fn journal_all_dated(db: OrmDb) -> OrmQuery !IO !Net {
    return orm_query(db, concat(journal_select_sql(), " ORDER BY entry_date, id"))?
}

fn journal_lines_all(db: OrmDb) -> OrmQuery !IO !Net {
    return orm_query(db, "SELECT id, entry_id, account_id, direction, amount, vat_amount, counterpart_id, product_id, location_id FROM journal_lines ORDER BY id")?
}

fn journal_lines_by_entry(db: OrmDb, entry_id: i64) -> OrmQuery !IO !Net {
    let sql = "SELECT id, entry_id, account_id, direction, amount, vat_amount, counterpart_id, product_id, location_id, number, name FROM journal_lines LEFT JOIN accounts ON account_id = id WHERE entry_id = $1 ORDER BY id"
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, entry_id)
    return orm_query_params(db, sql, vals, nulls)?
}

// Вмъхва journal_entry и връща реда през RETURNING (id вътре).
fn journal_entry_insert(db: OrmDb, entry_date: str, document_type: str, document_id: i64, description: str, vat_type: str, counterpart_id: i64, counterpart_name: str, counterpart_vat_number: str, document_number: str, document_date: str, vat_period: str, total_amount: str, total_vat_amount: str) -> OrmQuery !IO !Net {
    if journal_backend_boila()? == 1 {
        let c = journal_next_id(db)?
        if orm_ok_c(c) == 0 {
            return OrmQErr(OrmQueryFail { err: orm_err_c(c), tag: "", db: orm_db_c(c) })
        }
        let nid = orm_count_n(c) + 1
        let mut d = orm_db_c(c)
        let cols = vec_new()
        vec_push(cols, "id")
        vec_push(cols, "entry_date")
        vec_push(cols, "document_type")
        vec_push(cols, "document_id")
        vec_push(cols, "description")
        vec_push(cols, "vat_type")
        vec_push(cols, "counterpart_id")
        vec_push(cols, "counterpart_name")
        vec_push(cols, "counterpart_vat_number")
        vec_push(cols, "document_number")
        vec_push(cols, "document_date")
        vec_push(cols, "vat_period")
        vec_push(cols, "total_amount")
        vec_push(cols, "total_vat_amount")
        let vals = vec_new()
        vec_push(vals, int_to_str(nid))
        vec_push(vals, entry_date)
        vec_push(vals, document_type)
        vec_push(vals, int_to_str(document_id))
        vec_push(vals, description)
        vec_push(vals, vat_type)
        vec_push(vals, int_to_str(counterpart_id))
        vec_push(vals, counterpart_name)
        vec_push(vals, counterpart_vat_number)
        vec_push(vals, document_number)
        vec_push(vals, document_date)
        vec_push(vals, vat_period)
        vec_push(vals, total_amount)
        vec_push(vals, total_vat_amount)
        let nulls = vec_new()
        let mut i: i64 = 0
        while i < 14 {
            vec_push(nulls, 0)
            i = i + 1
        }
        return orm_insert_returning_full(d, journal_entry_table(), cols, vals, nulls)?
    }
    let cols = vec_new()
    vec_push(cols, "entry_date")
    vec_push(cols, "document_type")
    vec_push(cols, "document_id")
    vec_push(cols, "description")
    vec_push(cols, "vat_type")
    vec_push(cols, "counterpart_id")
    vec_push(cols, "counterpart_name")
    vec_push(cols, "counterpart_vat_number")
    vec_push(cols, "document_number")
    vec_push(cols, "document_date")
    vec_push(cols, "vat_period")
    vec_push(cols, "total_amount")
    vec_push(cols, "total_vat_amount")
    let vals = vec_new()
    vec_push(vals, entry_date)
    vec_push(vals, document_type)
    vec_push(vals, int_to_str(document_id))
    vec_push(vals, description)
    vec_push(vals, vat_type)
    vec_push(vals, int_to_str(counterpart_id))
    vec_push(vals, counterpart_name)
    vec_push(vals, counterpart_vat_number)
    vec_push(vals, document_number)
    vec_push(vals, document_date)
    vec_push(vals, vat_period)
    vec_push(vals, total_amount)
    vec_push(vals, total_vat_amount)
    let nulls = vec_new()
    let mut i: i64 = 0
    while i < 13 {
        vec_push(nulls, 0)
        i = i + 1
    }
    return orm_insert_returning_full(db, journal_entry_table(), cols, vals, nulls)?
}

// Вмъква journal_line; counterpart_id/product_id са с нищо (0 → без стойност).
fn journal_line_insert(db: OrmDb, entry_id: i64, account_id: i64, direction: str, amount: str, vat_amount: str, counterpart_id: i64, product_id: i64, location_id: i64) -> OrmExec !IO !Net {
    if journal_backend_boila()? == 1 {
        let c = journal_line_next_id(db)?
        if orm_ok_c(c) == 0 {
            return OrmEErr(OrmExecFail { err: orm_err_c(c), tag: "", db: orm_db_c(c) })
        }
        let nid = orm_count_n(c) + 1
        let mut d = orm_db_c(c)
        let cols = vec_new()
        vec_push(cols, "id")
        vec_push(cols, "entry_id")
        vec_push(cols, "account_id")
        vec_push(cols, "direction")
        vec_push(cols, "amount")
        vec_push(cols, "vat_amount")
        vec_push(cols, "counterpart_id")
        vec_push(cols, "product_id")
        vec_push(cols, "location_id")
        let vals = vec_new()
        vec_push(vals, int_to_str(nid))
        vec_push(vals, int_to_str(entry_id))
        vec_push(vals, int_to_str(account_id))
        vec_push(vals, direction)
        vec_push(vals, amount)
        vec_push(vals, vat_amount)
        vec_push(vals, int_to_str(counterpart_id))
        vec_push(vals, int_to_str(product_id))
        vec_push(vals, int_to_str(location_id))
        return orm_insert_strs(d, journal_line_table(), cols, vals)?
    }
    let cols = vec_new()
    vec_push(cols, "entry_id")
    vec_push(cols, "account_id")
    vec_push(cols, "direction")
    vec_push(cols, "amount")
    vec_push(cols, "vat_amount")
    vec_push(cols, "counterpart_id")
    vec_push(cols, "product_id")
    vec_push(cols, "location_id")
    let vals = vec_new()
    vec_push(vals, int_to_str(entry_id))
    vec_push(vals, int_to_str(account_id))
    vec_push(vals, direction)
    vec_push(vals, amount)
    vec_push(vals, vat_amount)
    vec_push(vals, int_to_str(counterpart_id))
    vec_push(vals, int_to_str(product_id))
    vec_push(vals, int_to_str(location_id))
    return orm_insert_strs(db, journal_line_table(), cols, vals)?
}

// Записи по ДДС период (за дневниците покупки/продажби); филтърът по
// ДДС_тип е в приложението — boila не поддържа две '=' условия в WHERE.
fn journal_by_period(db: OrmDb, period: str) -> OrmQuery !IO !Net {
    let sql = concat(journal_select_sql(), " WHERE vat_period = $1 ORDER BY entry_date, id")
    let vals = vec_new()
    vec_push(vals, period)
    let nulls = vec_new()
    vec_push(nulls, 0)
    return orm_query_params(db, sql, vals, nulls)?
}

fn journal_list_json(q: OrmQuery) -> JObj {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, journal_entry_to_json(q, i))
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", orm_nrows(q))
    return o
}

fn journal_lines_list_json(q: OrmQuery) -> JArr {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, journal_line_to_json(q, i))
        i = i + 1
    }
    return arr
}
