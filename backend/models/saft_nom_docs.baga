// Данъчни режими по ДДС (TaxType в TaxIDStructure).
// Ред: code|name_bg|name_en

fn saft_tax_regime_push(rows: Vec<str>, line: str) -> Vec<str> {
    vec_push(rows, line)
    return rows
}

fn saft_tax_regime_rows() -> Vec<str> {
    let mut r = vec_new()
    r = saft_tax_regime_push(r, "100010|Данъчно задължено лице, регистрирано за целите на ДДС|Taxable person registered for VAT")
    r = saft_tax_regime_push(r, "100020|Всяко друго данъчно задължено лице|Any other taxable person")
    r = saft_tax_regime_push(r, "100030|Данъчно незадължено лице|Non-taxable person")
    return r
}

