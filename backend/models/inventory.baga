// models/inventory.baga — партиди (FIFO/LIFO) за складови артикули.
// Boila: една '=' в WHERE; филтърът по остатък е в приложението.

import "ormbaga/orm.baga"
import "ormbaga/sql.baga"
import "pgbaga/pg.baga"
import "std/str/str.baga"
import "std/os/os.baga"

fn lot_table() -> str {
    return "inventory_lots"
}

fn lot_backend_boila() -> i64 !IO {
    let be = env("ORM_BACKEND")?
    if be == "boila" || be == "boiladb" || be == "boilaDB" {
        return 1
    }
    return 0
}

fn lot_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return orm_count_sql(db, "SELECT MAX(id) AS count FROM inventory_lots")?
}

fn lot_select_sql() -> str {
    return "SELECT id, product_id, invoice_id, invoice_line_id, received_date, quantity, quantity_remaining, unit_cost, location_id FROM inventory_lots"
}

fn lot_by_product(db: OrmDb, product_id: i64) -> OrmQuery !IO !Net {
    let sql = concat(lot_select_sql(), " WHERE product_id = $1 ORDER BY id")
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, product_id)
    return orm_query_params(db, sql, vals, nulls)?
}

fn lot_insert(db: OrmDb, product_id: i64, invoice_id: i64, invoice_line_id: i64, received_date: str, quantity: str, quantity_remaining: str, unit_cost: str, location_id: i64) -> OrmExec !IO !Net {
    if lot_backend_boila()? == 1 {
        let c = lot_next_id(db)?
        if orm_ok_c(c) == 0 {
            return OrmEErr(OrmExecFail { err: orm_err_c(c), tag: "", db: orm_db_c(c) })
        }
        let nid = orm_count_n(c) + 1
        let mut d = orm_db_c(c)
        let cols = vec_new()
        vec_push(cols, "id")
        vec_push(cols, "product_id")
        vec_push(cols, "invoice_id")
        vec_push(cols, "invoice_line_id")
        vec_push(cols, "received_date")
        vec_push(cols, "quantity")
        vec_push(cols, "quantity_remaining")
        vec_push(cols, "unit_cost")
        vec_push(cols, "location_id")
        let vals = vec_new()
        vec_push(vals, int_to_str(nid))
        vec_push(vals, int_to_str(product_id))
        vec_push(vals, int_to_str(invoice_id))
        vec_push(vals, int_to_str(invoice_line_id))
        vec_push(vals, received_date)
        vec_push(vals, quantity)
        vec_push(vals, quantity_remaining)
        vec_push(vals, unit_cost)
        vec_push(vals, int_to_str(location_id))
        return orm_insert_strs(d, lot_table(), cols, vals)?
    }
    let cols = vec_new()
    vec_push(cols, "product_id")
    vec_push(cols, "invoice_id")
    vec_push(cols, "invoice_line_id")
    vec_push(cols, "received_date")
    vec_push(cols, "quantity")
    vec_push(cols, "quantity_remaining")
    vec_push(cols, "unit_cost")
    vec_push(cols, "location_id")
    let vals = vec_new()
    vec_push(vals, int_to_str(product_id))
    vec_push(vals, int_to_str(invoice_id))
    vec_push(vals, int_to_str(invoice_line_id))
    vec_push(vals, received_date)
    vec_push(vals, quantity)
    vec_push(vals, quantity_remaining)
    vec_push(vals, unit_cost)
    vec_push(vals, int_to_str(location_id))
    return orm_insert_strs(db, lot_table(), cols, vals)?
}

fn lot_all(db: OrmDb) -> OrmQuery !IO !Net {
    return orm_query(db, concat(lot_select_sql(), " ORDER BY product_id, id"))?
}

fn lot_set_remaining(db: OrmDb, id: i64, remaining: str) -> OrmExec !IO !Net {
    let cols = vec_new()
    vec_push(cols, "quantity_remaining")
    let vals = vec_new()
    vec_push(vals, remaining)
    return orm_update_by_id(db, lot_table(), id, cols, vals)?
}
