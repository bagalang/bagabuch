// routes.baga — route table + fmr_dispatch за bagabuch.
// Фаза 2 (пълна): system + auth + companies + accounts + counterparts +
// products + invoices (+post) + journal.

import "actions/system.baga"
import "actions/auth.baga"
import "actions/companies.baga"
import "actions/accounts.baga"
import "actions/counterparts.baga"
import "actions/products.baga"
import "actions/invoices.baga"
import "actions/journal.baga"
import "actions/active_company.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/deps.baga"
import "fmrbaga/config.baga"
import "ormbaga/orm.baga"

// Route ids (стабилни; не се пренареждат — OpenAPI operationIds ги ползват)
fn RID_HEALTH() -> i64 { return 1 }
fn RID_READY() -> i64 { return 2 }
fn RID_META() -> i64 { return 3 }
fn RID_OPENAPI() -> i64 { return 4 }
fn RID_METRICS() -> i64 { return 5 }
fn RID_TOKEN() -> i64 { return 10 }
fn RID_ME() -> i64 { return 11 }
fn RID_COMPANIES_INDEX() -> i64 { return 20 }
fn RID_COMPANIES_CREATE() -> i64 { return 21 }
fn RID_COMPANIES_SHOW() -> i64 { return 22 }
fn RID_COMPANIES_UPDATE() -> i64 { return 23 }
fn RID_COMPANIES_DELETE() -> i64 { return 24 }
fn RID_ACCOUNTS_INDEX() -> i64 { return 30 }
fn RID_ACCOUNTS_CREATE() -> i64 { return 31 }
fn RID_ACCOUNTS_SHOW() -> i64 { return 32 }
fn RID_ACCOUNTS_UPDATE() -> i64 { return 33 }
fn RID_ACCOUNTS_DELETE() -> i64 { return 34 }
fn RID_COUNTERPARTS_INDEX() -> i64 { return 40 }
fn RID_COUNTERPARTS_CREATE() -> i64 { return 41 }
fn RID_COUNTERPARTS_SHOW() -> i64 { return 42 }
fn RID_COUNTERPARTS_UPDATE() -> i64 { return 43 }
fn RID_COUNTERPARTS_DELETE() -> i64 { return 44 }
fn RID_PRODUCTS_INDEX() -> i64 { return 50 }
fn RID_PRODUCTS_CREATE() -> i64 { return 51 }
fn RID_PRODUCTS_SHOW() -> i64 { return 52 }
fn RID_PRODUCTS_UPDATE() -> i64 { return 53 }
fn RID_PRODUCTS_DELETE() -> i64 { return 54 }
fn RID_INVOICES_INDEX() -> i64 { return 60 }
fn RID_INVOICES_CREATE() -> i64 { return 61 }
fn RID_INVOICES_SHOW() -> i64 { return 62 }
fn RID_INVOICES_UPDATE() -> i64 { return 63 }
fn RID_INVOICES_DELETE() -> i64 { return 64 }
fn RID_INVOICES_POST() -> i64 { return 65 }
fn RID_JOURNAL_INDEX() -> i64 { return 70 }
fn RID_JOURNAL_SHOW() -> i64 { return 71 }
fn RID_ACTIVE_COMPANY_GET() -> i64 { return 80 }
fn RID_ACTIVE_COMPANY_SET() -> i64 { return 81 }

fn fmr_build_app() -> FmrApp !IO {
    let cfg = fmr_config_load()?
    let mut app = fmr_app_new(cfg.title, cfg.version)
    app = fmr_app_with_config(app, cfg)
    app = fmr_route_meta(app, "GET", "/health", RID_HEALTH(), "", "system", 1, "", "Status", "200", "")
    app = fmr_route_meta(app, "GET", "/ready", RID_READY(), "", "system", 1, "", "Ready", "200", "")
    app = fmr_route_meta(app, "GET", "/readyz", RID_READY(), "", "system", 1, "", "Ready", "200", "")
    app = fmr_route_meta(app, "GET", "/v1/meta", RID_META(), "", "system", 1, "", "Status", "200", "")
    app = fmr_route_meta(app, "GET", "/openapi.json", RID_OPENAPI(), "", "system", 1, "", "-", "200", "")
    app = fmr_route_meta(app, "GET", "/metrics", RID_METRICS(), "", "system", 0, "", "-", "200", "")
    app = fmr_route_meta(app, "POST", "/v1/auth/token", RID_TOKEN(), "", "auth", 1, "TokenRequest?", "TokenResponse", "200", "sub:s")
    app = fmr_route_meta(app, "GET", "/v1/me", RID_ME(), "", "auth", 0, "", "Me", "200", "")
    app = fmr_route_meta(app, "GET", "/v1/companies", RID_COMPANIES_INDEX(), "", "companies", 0, "", "CompanyList", "200", "limit,offset")
    app = fmr_route_meta(app, "POST", "/v1/companies", RID_COMPANIES_CREATE(), "", "companies", 0, "CompanyCreate", "Company", "201", "")
    app = fmr_route_meta(app, "GET", "/v1/companies/{id}", RID_COMPANIES_SHOW(), "", "companies", 0, "", "Company", "200", "")
    app = fmr_route_meta(app, "PATCH", "/v1/companies/{id}", RID_COMPANIES_UPDATE(), "", "companies", 0, "CompanyUpdate", "Company", "200", "")
    app = fmr_route_meta(app, "DELETE", "/v1/companies/{id}", RID_COMPANIES_DELETE(), "", "companies", 0, "", "-", "204", "")
    app = fmr_route_meta(app, "GET", "/v1/accounts", RID_ACCOUNTS_INDEX(), "", "accounts", 0, "", "AccountList", "200", "limit,offset")
    app = fmr_route_meta(app, "POST", "/v1/accounts", RID_ACCOUNTS_CREATE(), "", "accounts", 0, "AccountCreate", "Account", "201", "")
    app = fmr_route_meta(app, "GET", "/v1/accounts/{id}", RID_ACCOUNTS_SHOW(), "", "accounts", 0, "", "Account", "200", "")
    app = fmr_route_meta(app, "PATCH", "/v1/accounts/{id}", RID_ACCOUNTS_UPDATE(), "", "accounts", 0, "AccountUpdate", "Account", "200", "")
    app = fmr_route_meta(app, "DELETE", "/v1/accounts/{id}", RID_ACCOUNTS_DELETE(), "", "accounts", 0, "", "-", "204", "")
    app = fmr_route_meta(app, "GET", "/v1/counterparts", RID_COUNTERPARTS_INDEX(), "", "counterparts", 0, "", "CounterpartList", "200", "limit,offset")
    app = fmr_route_meta(app, "POST", "/v1/counterparts", RID_COUNTERPARTS_CREATE(), "", "counterparts", 0, "CounterpartCreate", "Counterpart", "201", "")
    app = fmr_route_meta(app, "GET", "/v1/counterparts/{id}", RID_COUNTERPARTS_SHOW(), "", "counterparts", 0, "", "Counterpart", "200", "")
    app = fmr_route_meta(app, "PATCH", "/v1/counterparts/{id}", RID_COUNTERPARTS_UPDATE(), "", "counterparts", 0, "CounterpartUpdate", "Counterpart", "200", "")
    app = fmr_route_meta(app, "DELETE", "/v1/counterparts/{id}", RID_COUNTERPARTS_DELETE(), "", "counterparts", 0, "", "-", "204", "")
    app = fmr_route_meta(app, "GET", "/v1/products", RID_PRODUCTS_INDEX(), "", "products", 0, "", "ProductList", "200", "limit,offset")
    app = fmr_route_meta(app, "POST", "/v1/products", RID_PRODUCTS_CREATE(), "", "products", 0, "ProductCreate", "Product", "201", "")
    app = fmr_route_meta(app, "GET", "/v1/products/{id}", RID_PRODUCTS_SHOW(), "", "products", 0, "", "Product", "200", "")
    app = fmr_route_meta(app, "PATCH", "/v1/products/{id}", RID_PRODUCTS_UPDATE(), "", "products", 0, "ProductUpdate", "Product", "200", "")
    app = fmr_route_meta(app, "DELETE", "/v1/products/{id}", RID_PRODUCTS_DELETE(), "", "products", 0, "", "-", "204", "")
    app = fmr_route_meta(app, "GET", "/v1/invoices", RID_INVOICES_INDEX(), "", "invoices", 0, "", "InvoiceList", "200", "limit,offset")
    app = fmr_route_meta(app, "POST", "/v1/invoices", RID_INVOICES_CREATE(), "", "invoices", 0, "InvoiceCreate", "Invoice", "201", "")
    app = fmr_route_meta(app, "GET", "/v1/invoices/{id}", RID_INVOICES_SHOW(), "", "invoices", 0, "", "Invoice", "200", "")
    app = fmr_route_meta(app, "PATCH", "/v1/invoices/{id}", RID_INVOICES_UPDATE(), "", "invoices", 0, "InvoiceUpdate", "Invoice", "200", "")
    app = fmr_route_meta(app, "DELETE", "/v1/invoices/{id}", RID_INVOICES_DELETE(), "", "invoices", 0, "", "-", "204", "")
    app = fmr_route_meta(app, "POST", "/v1/invoices/{id}/post", RID_INVOICES_POST(), "", "invoices", 0, "", "JournalEntry", "201", "")
    app = fmr_route_meta(app, "GET", "/v1/journal", RID_JOURNAL_INDEX(), "", "journal", 0, "", "JournalList", "200", "limit,offset")
    app = fmr_route_meta(app, "GET", "/v1/journal/{id}", RID_JOURNAL_SHOW(), "", "journal", 0, "", "JournalEntry", "200", "")
    app = fmr_route_meta(app, "GET", "/v1/active-company", RID_ACTIVE_COMPANY_GET(), "", "active-company", 0, "", "Company", "200", "")
    app = fmr_route_meta(app, "PUT", "/v1/active-company", RID_ACTIVE_COMPANY_SET(), "", "active-company", 0, "ActiveCompanySet", "Company", "200", "")
    return app
}

fn fmr_before(ctx: FmrCtx) -> DepResult {
    return dep_ok(ctx)
}

// bagabuch няма gRPC повърхност — dual hook връща празен UNIMPLEMENTED.
fn fmr_grpc_handle(path: str, body: bytes, db: OrmDb) -> FmrOut !IO !Net {
    let mut r = http_response_bytes(200, bytes_new(0))
    r = http_set_header(r, "Content-Type", "application/grpc")
    r = http_set_header(r, "grpc-status", "12")
    r = http_set_header(r, "grpc-message", "UNIMPLEMENTED")
    return fmr_out(r, db)
}

fn fmr_dispatch(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let id = ctx.route_id
    if id == RID_HEALTH() { return act_health(ctx, db) }
    if id == RID_READY() { return act_ready(ctx, db)? }
    if id == RID_META() { return act_meta(ctx, db) }
    if id == RID_OPENAPI() { return act_openapi(ctx, db) }
    if id == RID_METRICS() { return act_metrics(ctx, db)? }
    if id == RID_TOKEN() { return act_token(ctx, db) }
    if id == RID_ME() { return act_me(ctx, db) }
    if id == RID_COMPANIES_INDEX() { return act_companies_index(ctx, db)? }
    if id == RID_COMPANIES_CREATE() { return act_companies_create(ctx, db)? }
    if id == RID_COMPANIES_SHOW() { return act_companies_show(ctx, db)? }
    if id == RID_COMPANIES_UPDATE() { return act_companies_update(ctx, db)? }
    if id == RID_COMPANIES_DELETE() { return act_companies_delete(ctx, db)? }
    if id == RID_ACCOUNTS_INDEX() { return act_accounts_index(ctx, db)? }
    if id == RID_ACCOUNTS_CREATE() { return act_accounts_create(ctx, db)? }
    if id == RID_ACCOUNTS_SHOW() { return act_accounts_show(ctx, db)? }
    if id == RID_ACCOUNTS_UPDATE() { return act_accounts_update(ctx, db)? }
    if id == RID_ACCOUNTS_DELETE() { return act_accounts_delete(ctx, db)? }
    if id == RID_COUNTERPARTS_INDEX() { return act_counterparts_index(ctx, db)? }
    if id == RID_COUNTERPARTS_CREATE() { return act_counterparts_create(ctx, db)? }
    if id == RID_COUNTERPARTS_SHOW() { return act_counterparts_show(ctx, db)? }
    if id == RID_COUNTERPARTS_UPDATE() { return act_counterparts_update(ctx, db)? }
    if id == RID_COUNTERPARTS_DELETE() { return act_counterparts_delete(ctx, db)? }
    if id == RID_PRODUCTS_INDEX() { return act_products_index(ctx, db)? }
    if id == RID_PRODUCTS_CREATE() { return act_products_create(ctx, db)? }
    if id == RID_PRODUCTS_SHOW() { return act_products_show(ctx, db)? }
    if id == RID_PRODUCTS_UPDATE() { return act_products_update(ctx, db)? }
    if id == RID_PRODUCTS_DELETE() { return act_products_delete(ctx, db)? }
    if id == RID_INVOICES_INDEX() { return act_invoices_index(ctx, db)? }
    if id == RID_INVOICES_CREATE() { return act_invoices_create(ctx, db)? }
    if id == RID_INVOICES_SHOW() { return act_invoices_show(ctx, db)? }
    if id == RID_INVOICES_UPDATE() { return act_invoices_update(ctx, db)? }
    if id == RID_INVOICES_DELETE() { return act_invoices_delete(ctx, db)? }
    if id == RID_INVOICES_POST() { return act_invoices_post(ctx, db)? }
    if id == RID_JOURNAL_INDEX() { return act_journal_index(ctx, db)? }
    if id == RID_JOURNAL_SHOW() { return act_journal_show(ctx, db)? }
    if id == RID_ACTIVE_COMPANY_GET() { return act_active_company_get(ctx, db)? }
    if id == RID_ACTIVE_COMPANY_SET() { return act_active_company_set(ctx, db)? }
    return fmr_out(fmr_500("unhandled route"), db)
}
