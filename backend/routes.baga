    if id == RID_FA_END_CONSERVE() { return act_fa_end_conserve(ctx, db)? }
    if id == RID_FA_DISPOSE() { return act_fa_dispose(ctx, db)? }
    if id == RID_FA_EVENTS() { return act_fa_events(ctx, db)? }
    if id == RID_ACTIVE_COMPANY_GET() { return act_active_company_get(ctx, db)? }
    if id == RID_ACTIVE_COMPANY_SET() { return act_active_company_set(ctx, db)? }
    if id == RID_EXCHANGE_RATES_INDEX() { return act_exchange_rates_index(ctx, db)? }
    if id == RID_EXCHANGE_RATES_RATE() { return act_exchange_rates_rate(ctx, db)? }
    if id == RID_EXCHANGE_RATES_IMPORT() { return act_exchange_rates_import(ctx, db)? }
    return fmr_out(fmr_500("unhandled route"), db)
}
