fn fmr_build_app() -> FmrApp !IO {
    let cfg = fmr_config_load()?
    let mut app = fmr_app_new(cfg.title, cfg.version)
    app = fmr_app_with_config(app, cfg)
    app = fmr_route_meta(app, "GET", "/health", RID_HEALTH(), "", "system", 1, "", "Status", "200", "")
    app = fmr_route_meta(app, "GET", "/ready", RID_READY(), "", "system", 1, "", "Ready", "200", "")
    app = fmr_route_meta(app, "GET", "/readyz", RID_READY(), "", "system", 1, "", "Ready", "200", "")
    app = fmr_route_meta(app, "GET", "/v1/meta", RID_META(), "", "system", 1, "", "Status", "200", "")
    app = fmr_route_meta(app, "GET", "/openapi.json", RID_OPENAPI(), "", "system", 1, "", "-", "200", "")
    app = fmr_route_meta(app, "GET", "/metrics", RID_METRICS(), "", "system", 0, "", "-", "200", "")
    app = fmr_route_meta(app, "POST", "/v1/auth/token", RID_TOKEN(), "", "auth", 1, "TokenRequest?", "TokenResponse", "200", "sub:s")
    app = fmr_route_meta(app, "GET", "/v1/me", RID_ME(), "", "auth", 0, "", "Me", "200", "")
    app = fmr_route_meta(app, "GET", "/v1/companies", RID_COMPANIES_INDEX(), "", "companies", 0, "", "CompanyList", "200", "limit,offset")
    app = fmr_route_meta(app, "POST", "/v1/companies", RID_COMPANIES_CREATE(), "", "companies", 0, "CompanyCreate", "Company", "201", "")
    app = fmr_route_meta(app, "GET", "/v1/companies/{id}", RID_COMPANIES_SHOW(), "", "companies", 0, "", "Company", "200", "")
    app = fmr_route_meta(app, "PATCH", "/v1/companies/{id}", RID_COMPANIES_UPDATE(), "", "companies", 0, "CompanyUpdate", "Company", "200", "")
    app = fmr_route_meta(app, "DELETE", "/v1/companies/{id}", RID_COMPANIES_DELETE(), "", "companies", 0, "", "-", "204", "")
    app = fmr_route_meta(app, "GET", "/v1/companies/{id}/settings", RID_COMPANY_SETTINGS(), "", "companies", 0, "", "CompanySettings", "200", "")
    app = fmr_route_meta(app, "POST", "/v1/companies/{id}/locations", RID_CLOC_CREATE(), "", "companies", 0, "LocationCreate", "Location", "201", "")
    app = fmr_route_meta(app, "PATCH", "/v1/company-locations/{id}", RID_CLOC_UPDATE(), "", "companies", 0, "LocationUpdate", "Location", "200", "")
    app = fmr_route_meta(app, "DELETE", "/v1/company-locations/{id}", RID_CLOC_DELETE(), "", "companies", 0, "", "-", "204", "")
    app = fmr_route_meta(app, "POST", "/v1/companies/{id}/beneficial-owners", RID_BOWN_CREATE(), "", "companies", 0, "OwnerCreate", "Owner", "201", "")
    app = fmr_route_meta(app, "PATCH", "/v1/beneficial-owners/{id}", RID_BOWN_UPDATE(), "", "companies", 0, "OwnerUpdate", "Owner", "200", "")
    app = fmr_route_meta(app, "DELETE", "/v1/beneficial-owners/{id}", RID_BOWN_DELETE(), "", "companies", 0, "", "-", "204", "")
    app = fmr_route_meta(app, "POST", "/v1/companies/{id}/ultimate-parents", RID_UPAR_CREATE(), "", "companies", 0, "ParentCreate", "Parent", "201", "")
    app = fmr_route_meta(app, "PATCH", "/v1/ultimate-parents/{id}", RID_UPAR_UPDATE(), "", "companies", 0, "ParentUpdate", "Parent", "200", "")
    app = fmr_route_meta(app, "DELETE", "/v1/ultimate-parents/{id}", RID_UPAR_DELETE(), "", "companies", 0, "", "-", "204", "")
    app = fmr_route_meta(app, "POST", "/v1/companies/{id}/document-series", RID_DSER_CREATE(), "", "companies", 0, "SeriesCreate", "Series", "201", "")
    app = fmr_route_meta(app, "PATCH", "/v1/document-series/{id}", RID_DSER_UPDATE(), "", "companies", 0, "SeriesUpdate", "Series", "200", "")
    app = fmr_route_meta(app, "DELETE", "/v1/document-series/{id}", RID_DSER_DELETE(), "", "companies", 0, "", "-", "204", "")
    app = fmr_route_meta(app, "GET", "/v1/accounts", RID_ACCOUNTS_INDEX(), "", "accounts", 0, "", "AccountList", "200", "limit,offset")
    app = fmr_route_meta(app, "POST", "/v1/accounts", RID_ACCOUNTS_CREATE(), "", "accounts", 0, "AccountCreate", "Account", "201", "")
    app = fmr_route_meta(app, "POST", "/v1/accounts/seed-saft", RID_ACCOUNTS_SEED_SAFT(), "", "accounts", 0, "", "AccountSeed", "200", "")
    app = fmr_route_meta(app, "GET", "/v1/accounts/{id}", RID_ACCOUNTS_SHOW(), "", "accounts", 0, "", "Account", "200", "")
    app = fmr_route_meta(app, "PATCH", "/v1/accounts/{id}", RID_ACCOUNTS_UPDATE(), "", "accounts", 0, "AccountUpdate", "Account", "200", "")
    app = fmr_route_meta(app, "DELETE", "/v1/accounts/{id}", RID_ACCOUNTS_DELETE(), "", "accounts", 0, "", "-", "204", "")
    app = fmr_route_meta(app, "GET", "/v1/counterparts", RID_COUNTERPARTS_INDEX(), "", "counterparts", 0, "", "CounterpartList", "200", "limit,offset")
    app = fmr_route_meta(app, "POST", "/v1/counterparts", RID_COUNTERPARTS_CREATE(), "", "counterparts", 0, "CounterpartCreate", "Counterpart", "201", "")
    app = fmr_route_meta(app, "GET", "/v1/counterparts/vies-lookup", RID_COUNTERPARTS_VIES_LOOKUP(), "", "counterparts", 0, "", "ViesLookup", "200", "vat:s")
    app = fmr_route_meta(app, "POST", "/v1/counterparts/vies", RID_COUNTERPARTS_VIES_CREATE(), "", "counterparts", 0, "CounterpartViesCreate", "Counterpart", "201", "")
    app = fmr_route_meta(app, "GET", "/v1/counterparts/{id}", RID_COUNTERPARTS_SHOW(), "", "counterparts", 0, "", "Counterpart", "200", "")
    app = fmr_route_meta(app, "PATCH", "/v1/counterparts/{id}", RID_COUNTERPARTS_UPDATE(), "", "counterparts", 0, "CounterpartUpdate", "Counterpart", "200", "")
    app = fmr_route_meta(app, "DELETE", "/v1/counterparts/{id}", RID_COUNTERPARTS_DELETE(), "", "counterparts", 0, "", "-", "204", "")
    app = fmr_route_meta(app, "GET", "/v1/products", RID_PRODUCTS_INDEX(), "", "products", 0, "", "ProductList", "200", "limit,offset")
    app = fmr_route_meta(app, "POST", "/v1/products", RID_PRODUCTS_CREATE(), "", "products", 0, "ProductCreate", "Product", "201", "")
    app = fmr_route_meta(app, "GET", "/v1/products/{id}", RID_PRODUCTS_SHOW(), "", "products", 0, "", "Product", "200", "")
    app = fmr_route_meta(app, "PATCH", "/v1/products/{id}", RID_PRODUCTS_UPDATE(), "", "products", 0, "ProductUpdate", "Product", "200", "")
    app = fmr_route_meta(app, "DELETE", "/v1/products/{id}", RID_PRODUCTS_DELETE(), "", "products", 0, "", "-", "204", "")
    app = fmr_route_meta(app, "GET", "/v1/units", RID_UNITS_INDEX(), "", "products", 0, "", "UnitList", "200", "search:s")
    app = fmr_route_meta(app, "GET", "/v1/vat-exemptions", RID_VAT_EXEMPTIONS(), "", "invoices", 0, "", "VatExemptionList", "200", "search:s")
    app = fmr_route_meta(app, "GET", "/v1/invoices", RID_INVOICES_INDEX(), "", "invoices", 0, "", "InvoiceList", "200", "limit,offset")
    app = fmr_route_meta(app, "POST", "/v1/invoices", RID_INVOICES_CREATE(), "", "invoices", 0, "InvoiceCreate", "Invoice", "201", "")
    app = fmr_route_meta(app, "GET", "/v1/invoices/next-number", RID_INVOICES_NEXT_NUMBER(), "", "invoices", 0, "", "InvoiceNumber", "200", "document_type:s,direction:s")
    app = fmr_route_meta(app, "GET", "/v1/invoices/{id}", RID_INVOICES_SHOW(), "", "invoices", 0, "", "Invoice", "200", "")
    app = fmr_route_meta(app, "PATCH", "/v1/invoices/{id}", RID_INVOICES_UPDATE(), "", "invoices", 0, "InvoiceUpdate", "Invoice", "200", "")
    app = fmr_route_meta(app, "DELETE", "/v1/invoices/{id}", RID_INVOICES_DELETE(), "", "invoices", 0, "", "-", "204", "")
    app = fmr_route_meta(app, "POST", "/v1/invoices/{id}/post", RID_INVOICES_POST(), "", "invoices", 0, "", "JournalEntry", "201", "")
    app = fmr_route_meta(app, "GET", "/v1/invoices/{id}/print", RID_INVOICES_PRINT(), "", "invoices", 0, "", "-", "200", "format:s,copy:s")
    app = fmr_route_meta(app, "GET", "/v1/invoices/{id}/ubl", RID_INVOICES_UBL(), "", "invoices", 0, "", "-", "200", "")
    app = fmr_route_meta(app, "GET", "/v1/journal", RID_JOURNAL_INDEX(), "", "journal", 0, "", "JournalList", "200", "limit,offset")
    app = fmr_route_meta(app, "POST", "/v1/journal", RID_JOURNAL_CREATE(), "", "journal", 0, "JournalCreate", "JournalEntry", "201", "")
    app = fmr_route_meta(app, "GET", "/v1/journal/{id}", RID_JOURNAL_SHOW(), "", "journal", 0, "", "JournalEntry", "200", "")
    app = fmr_route_meta(app, "GET", "/v1/vat/registers", RID_VAT_REGISTERS(), "", "vat", 0, "", "VatRegisters", "200", "period")
    app = fmr_route_meta(app, "GET", "/v1/vat/return", RID_VAT_RETURN(), "", "vat", 0, "", "VatReturn", "200", "period")
    app = fmr_route_meta(app, "GET", "/v1/saft/export", RID_SAFT_EXPORT(), "", "saft", 0, "", "-", "200", "period,mode")
    app = fmr_route_meta(app, "GET", "/v1/saft/nomenclatures", RID_SAFT_NOMS(), "", "saft", 0, "", "SaftNomenclatureList", "200", "kind:s,search:s")
    app = fmr_route_meta(app, "GET", "/v1/fixed-asset-categories", RID_FA_CATEGORIES_INDEX(), "", "fixed-assets", 0, "", "FacList", "200", "")
    app = fmr_route_meta(app, "POST", "/v1/fixed-asset-categories", RID_FA_CATEGORIES_CREATE(), "", "fixed-assets", 0, "FacCreate", "Fac", "201", "")
    app = fmr_route_meta(app, "PATCH", "/v1/fixed-asset-categories/{id}", RID_FA_CATEGORIES_UPDATE(), "", "fixed-assets", 0, "FacUpdate", "Fac", "200", "")
    app = fmr_route_meta(app, "DELETE", "/v1/fixed-asset-categories/{id}", RID_FA_CATEGORIES_DELETE(), "", "fixed-assets", 0, "", "-", "204", "")
    app = fmr_route_meta(app, "GET", "/v1/fixed-assets", RID_FA_INDEX(), "", "fixed-assets", 0, "", "FaList", "200", "")
    app = fmr_route_meta(app, "POST", "/v1/fixed-assets", RID_FA_CREATE(), "", "fixed-assets", 0, "FaCreate", "Fa", "201", "")
    app = fmr_route_meta(app, "GET", "/v1/fixed-assets/{id}", RID_FA_SHOW(), "", "fixed-assets", 0, "", "Fa", "200", "")
    app = fmr_route_meta(app, "PATCH", "/v1/fixed-assets/{id}", RID_FA_UPDATE(), "", "fixed-assets", 0, "FaUpdate", "Fa", "200", "")
    app = fmr_route_meta(app, "DELETE", "/v1/fixed-assets/{id}", RID_FA_DELETE(), "", "fixed-assets", 0, "", "-", "204", "")
    app = fmr_route_meta(app, "POST", "/v1/fixed-assets/depreciation/preview", RID_FA_DEP_PREVIEW(), "", "fixed-assets", 0, "", "DepPreview", "200", "")
    app = fmr_route_meta(app, "POST", "/v1/fixed-assets/depreciation/post", RID_FA_DEP_POST(), "", "fixed-assets", 0, "DepPost", "JournalEntry", "201", "")
    app = fmr_route_meta(app, "POST", "/v1/fixed-assets/{id}/revalue", RID_FA_REVALUE(), "", "fixed-assets", 0, "FaRevalue", "Fa", "200", "")
    app = fmr_route_meta(app, "POST", "/v1/fixed-assets/{id}/move", RID_FA_MOVE(), "", "fixed-assets", 0, "FaMove", "Fa", "200", "")
    app = fmr_route_meta(app, "POST", "/v1/fixed-assets/{id}/conserve", RID_FA_CONSERVE(), "", "fixed-assets", 0, "FaConserve", "Fa", "200", "")
    app = fmr_route_meta(app, "POST", "/v1/fixed-assets/{id}/end-conserve", RID_FA_END_CONSERVE(), "", "fixed-assets", 0, "FaEndConserve", "Fa", "200", "")
    app = fmr_route_meta(app, "POST", "/v1/fixed-assets/{id}/dispose", RID_FA_DISPOSE(), "", "fixed-assets", 0, "FaDispose", "Fa", "200", "")
    app = fmr_route_meta(app, "GET", "/v1/fixed-assets/{id}/events", RID_FA_EVENTS(), "", "fixed-assets", 0, "", "FaEvents", "200", "")
    app = fmr_route_meta(app, "GET", "/v1/active-company", RID_ACTIVE_COMPANY_GET(), "", "active-company", 0, "", "Company", "200", "")
    app = fmr_route_meta(app, "PUT", "/v1/active-company", RID_ACTIVE_COMPANY_SET(), "", "active-company", 0, "ActiveCompanySet", "Company", "200", "")
    app = fmr_route_meta(app, "GET", "/v1/exchange-rates", RID_EXCHANGE_RATES_INDEX(), "", "exchange-rates", 0, "", "ExchangeRateList", "200", "date")
    app = fmr_route_meta(app, "GET", "/v1/exchange-rates/rate", RID_EXCHANGE_RATES_RATE(), "", "exchange-rates", 0, "", "ExchangeRate", "200", "currency:s,date:s")
    app = fmr_route_meta(app, "POST", "/v1/exchange-rates/import", RID_EXCHANGE_RATES_IMPORT(), "", "exchange-rates", 0, "ExchangeRateImport", "ExchangeRateImportResult", "200", "")
    app = fmr_route_meta(app, "GET", "/v1/internal-docs", RID_IDOC_INDEX(), "", "internal-docs", 0, "", "InternalDocList", "200", "")
    app = fmr_route_meta(app, "POST", "/v1/internal-docs", RID_IDOC_CREATE(), "", "internal-docs", 0, "InternalDocCreate", "InternalDoc", "201", "")
    app = fmr_route_meta(app, "GET", "/v1/internal-docs/next-number", RID_IDOC_NEXT(), "", "internal-docs", 0, "", "InternalDocNumber", "200", "")
    app = fmr_route_meta(app, "GET", "/v1/internal-docs/{id}", RID_IDOC_SHOW(), "", "internal-docs", 0, "", "InternalDoc", "200", "")
    app = fmr_route_meta(app, "PATCH", "/v1/internal-docs/{id}", RID_IDOC_UPDATE(), "", "internal-docs", 0, "InternalDocUpdate", "InternalDoc", "200", "")
    app = fmr_route_meta(app, "DELETE", "/v1/internal-docs/{id}", RID_IDOC_DELETE(), "", "internal-docs", 0, "", "-", "204", "")
    app = fmr_route_meta(app, "POST", "/v1/internal-docs/{id}/confirm", RID_IDOC_CONFIRM(), "", "internal-docs", 0, "", "InternalDoc", "200", "")
