fn bagabuch_backend_is_boila() -> i64 !IO {
    let be = env("ORM_BACKEND")?
    if be == "boila" || be == "boiladb" || be == "boilaDB" {
        return 1
    }
    return 0
}

// Избира набор миграции според конфигурирания backend.
fn bagabuch_migrations_auto() -> MigrationSet !IO {
    if bagabuch_backend_is_boila()? == 1 {
        return bagabuch_boila_migrations()
    }
    return bagabuch_migrations()
}
