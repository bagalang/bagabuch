# syntax=docker/dockerfile:1
# Компилира един Baga вход (serve_pg или bagabuch backend) от монорепото.
FROM debian:trixie-slim AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc libc6-dev make \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . /src
RUN make all
ARG BAGA_ENTRY
RUN test -n "$BAGA_ENTRY" \
 && ./baga --emit-c -I . -I app-product "$BAGA_ENTRY" > /tmp/app.c \
 && gcc -O2 -Iinclude -o /out-bin /tmp/app.c src/baga_par_rt.c -lm -pthread

FROM debian:trixie-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends bash \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /out-bin /usr/local/bin/app
EXPOSE 8080
CMD ["app"]
